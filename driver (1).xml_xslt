      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLaethb3"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. b. 3</fo:block>
            <fo:block>(Juel-Jensen 25, EMIP 03453)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment codex435×375 mm, 294 fols, 31 quires, 1730–1755.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e313LIT1560Gospel">
               <fo:inline>I) Fols 5ra–293vb: <fo:inline xml:lang="en" hyphenate="true">Four Gospels, CAe 1560.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e321LIT2705Introd">
               <fo:inline>I-1) Fols 5ra–14ra: <fo:inline xml:lang="en" hyphenate="true">Introduction to the Gospels, CAe 2705.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e327LIT4872MaqdemaWangel">
               <fo:inline>I-1-1) Fols 5ra–9vb: <fo:inline xml:lang="en" hyphenate="true">‘Introduction to the Gospels’ (​መቅ​ድመ፡ ​ወን​ጌል፡), CAe 4872.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                         ​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ​አሐ​ዱ፡ ​አም​ላክ ፨
                                         ​ንቀ​ድም፡ ​በረ​ድኤ​ተ፡ ​እግዚ ​አብ​ሔር፡ ​ይት​ባረ​ክ፡ ​ስሙ፡
                                         ​ወይ ​ትለ​ዓል፡ ​ዝክ​ሩ፡ ​ወፍ​ጽም​ናሁ፡ ​ዘእ ​ምኔ​ሁ፡ ​ኵሉ፡ ​ሢመ​ተ፡ ​ኃይ​ል፡ ​ወቦ​ቱ፡  ​ተፍ​ጻሜ​ተ፡ ​ኵሉ፡ ​ስእ​ለት።
                                             ​ወኀቤ ​ሁ፡ ​ምብ​ጻሐ፡ ​ኵሉ፡ ​አስ​ተብ​ቍዖ​ት፡ ​በጽ​ሒፈ፡ ​መቅ​ድመ፡  ፬  ​ወን​ጌላ​ት፡ ​ስቡ​ሐት፡ ወ ፲  ​አቅ​ማራ​ት፡
                                         ​በሰ​ላመ፡  ​እግ​ዚአ​ብሔ​ር፡  ​አሜን ፨
                                     </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                         
                                         ​ቀመ​ር፡ ​ዓሥ​ር፡ ​በዘ​ተሌ​ለየ፡ ​ቦቱ፡ ​ኵሉ፡  ፩  ​እም​ሰባ​ክያ​ን፡  ​፪፻፶  ​መስ​መር፡
                                         ​ማቴ​ዎስ፡  ​፷ወ፪  ​መስ​መር ፨ 
                                         ​ማር​ቆስ፡
                                          ​፲ወ፩  ​መስ​መር። ​ሉቃ​ስ፡  ​፸፪  ​መስ​መር ፨  ​ዮሐ​ንስ፡ ​፺ወ፰
                                         ​መስ​መር ፨
                                     </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e399LIT4873Stichometry">
               <fo:inline>I-1-2) Fol. 9vb: <fo:inline xml:lang="en" hyphenate="true">Stichometry, CAe 4873.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​ወን​ጌል፡ ​ቅዱ​ስ፡ ​ዘዜ​ነወ፡ ​ማቴ​ዎስ፡ ​ቃሉ፡  ​፳፻​ወ፯፻
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​ወም​ግባ​ራተ፡ ​ቃሎ​ሙ፡ ለ ፬  ​ወን​ጌላ​ት፡  ​፺፻ ወ ​፬፻፡፵ ወ ​፱።  ​ወከ​መዝ፡ ​ኃብ​ሩ፡ ​አር​ባዕ​ቲሆ​ሙ፡ ​ወን​ጌላ​ት፡
                                             ​ለዓ​ለመ፡ ​ዓለም ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e430LIT4870EvangelistsSymbols">
               <fo:inline>I-1-3) Fol. 9vb: <fo:inline xml:lang="en" hyphenate="true">The Evangelists and their Symbols, CAe 4870.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The entire text is reproduced below.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
         