      <fo:static-content flow-name="xsl-footnote-separator">
         <fo:block space-before="5mm" space-after="5mm">
            <fo:leader leader-length="30%" rule-thickness="0pt"/>
         </fo:block>
      </fo:static-content>
      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLaethg46"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. g. 46</fo:block>
            <fo:block/>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment codex77×70 mm (weight: 128g), ii+80 fols ( blank), twentieth century.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e125294LIT2246salotz">
               <fo:inline>I) Fols 1r–51r: <fo:inline xml:lang="en" hyphenate="true">The prayer of Our Lady Mary which she prayed at Golgotha on 21 Sane, CAe 2246.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ፩ ​አም​ላክ፡  ​ዛቲ፡
                                ​ጸሎ​ት፡ ​ዘእ​ግዝ​እት​ነ፡ ​ቅድ​ስት፡ ​ድን​ግል፡  ​ማር​ያም፡
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                
                                ​ወይ​ትባ​ረክ፡ ​መን​ግሥ​ትከ፡ ​ወሰ​ላም፡ ​ለአ​ቡከ፡ ​ኄር፡ ​ሰማ​ያዊ፡ ​ወመ​ንፈስ<fo:inline>[፡]</fo:inline> ​ቅዱ​ስ፡
                                ​ማኅ<fo:inline>[የ]</fo:inline>​ዊ፡ ​ይእ​ዜኒ፡ ​ወዘ​ልፈ​ኒ፡ ​ወለ​ዓለ​መ፡
                                ​ዓለ​ም፡ ​አሜን ፨
                            </fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                
                                ​ኦእግ<fo:inline> (!)</fo:inline>​እት​የ፡  ማ  (fol. 51r)  ​ርያ​ም፡ 
                                ​በኃ​ይለ፡ ​ኪዳ<fo:inline>[ን]</fo:inline>​ኪ፡ ​አድ​ኅን​ኒ፡
                                ​ለገ​ብርኪ ፨
                                <fo:inline id="d1e125344PRS15069MazgabaS">​መዝ​ገበ፡ ​ሥላ​ሴ፡</fo:inline>
                                ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​አሜን ፨
                            </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e125357LIT2444Temher">
               <fo:inline>II) Fols 51v–73r: <fo:inline xml:lang="en" hyphenate="true">‘Teaching of Mysteries Doctrine of Mysteries’ (​ትም​ህር​ተ፡ ​ኅቡ​ኣት፡), CAe 2444.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​በእ​ንተ፡ ​ትም​ሕር​ተ፡ ​ሕቡ​ዓት፡
                                    ​ቅድ​መ፡ ዘ ​ትት​ነገ​ር፡ ​እም​ጵር​ስፎ​ራ፡ ​ለም​ዕመ​ናን፡ <fo:inline>ኀ (!)</fo:inline>​ቡዓ​ት፡
                            </fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                
                                ት<fo:inline>[...]</fo:inline>​ምሕ​ርተ፡  (fol. 52r) 
                                <fo:inline>ኀ (!)</fo:inline>ቡ ​ዓት​ሰ፡ ​ከመ​ዝ፡ ​ንግ​ር፡ ​ዘቅ​ድመ፡
                                ​ሀሎ፡ ​ወይ​ሄሉ፡ ​ዘመ​ጽአ፡ ​ወሐ​መ፡
                                ​ወተ​ቀብ​ረ፡ ​ወተ​ንሥ​አ፡ ​ፃዕ​ረ፡ ​ዘሞ​ት፡ ​ፈት​ሐ፡ ​ወዘ​እሙ​ታን፡
                                ​ተን​ሥአ ፨
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                
                                ​በከ​መ፡ ​ይቤ፡ ​ሙሴ፡ ​ባእ​ዳን​ሂ፡ ​ነቢ​ያት፡ ​ንሕ​ነሂ፡
                                ​ተወ​ኪለ​ነ፡ ​ነሀ​ብ፡ ​ሎቱ፡ ​ስብ​ሐት፡  (fol. 73r)   ​ወጽ​ንእ፡ ​ለዓ​ለመ፡ ​ዓለ​ም፡
                                ​አሜን ፨
                            </fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                
                                ​እግ​ዚእ​የ፡ ​ኢየ​ሱስ፡ ​ክር​ስቶ​ስ፡ ​ዕቀ​በኒ፡ ​እመ​ከራ፡ ​ሥጋ፡ ​ወነ​ፍስ፡ ​ለገ​ብር​ከ፡
                                <fo:inline id="d1e125402PRS15069MazgabaS">​መዝ​ገበ፡ ​ሥላ​ሴ፡</fo:inline>
                                ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​አሜ​ን፡
                            </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e125412LIT5690MagicPrayer">
               <fo:inline>III) Fols 73v–80r: <fo:inline xml:lang="en" hyphenate="true">‘Protective prayer against eye disease’ (​ጸሎ​ተ፡ ​ነደ​ራ፡), CAe 5690.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">One version of the prayer.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ 
                                ፩ ​አም​ላክ፡ ​ጸሎ​ት፡ ​በእ​ንተ፡ ​ዓይ​ነ፡ ​ወር​ቅ፡ ​ወአ​ይነ፡ ​ጥላ፡ ​ወዓ​ይነ፡
                                ​ናስ፡ ​ዘው​እቱ፡ ​ንድ​ራ፡ ​ወእ​ንዘ፡ ​የሐ​ውር፡  (fol. 74r)  
                                ​እግ​ዚእ​ነ፡ ​ኢየ​ሱስ፡ ​ክር​ስቶ​ስ፡ ​ውስ​ተ፡ ​ባሕ​ረ፡
                                <fo:inline>ጥብርያያስ፡ (!)</fo:inline> ​፲ወ፪ ​አር​ዳኢ​ሁ፡ ​መጽ​ኡ፡
                                ​ወር​እዩ፡ ​መል​ክዓ፡ ​ብእ​ሲት፡ ​አረ​ጊት፡ ​እን​ዘ፡ ት ነ ​ብር፡ ​ዲበ፡ ​ባሕ​ር፡
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                
                                ​ኵል​ክሙ፡ ​ዛር፡ ​ወአ​ጋን​ንት፡ ​ፃኡ፡ ​ወተ​ቀለ ዱ ፡
                                ​ወወ​ፂአ​ክሙ፡ ​ኢት​ግብ​ኡ፡ ​ከመ፡ ​ኢት​ቅረ​ቡ፡ ​ኃበ፡ ​ነፍ​ስየ፡ ​ወሥ​ጋየ፡
                                ​ሊተ፡ ​ለገ​ብር​ከ፡ <fo:inline id="d1e125440PRS15069MazgabaS">​መዝ​ገበ፡ ሥ  (fol. 80r)  ስ ​ላሴ፡</fo:inline>
                                ​አሜ​ን።
                            </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Varia</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 144v: Scribbles in pen and pencil on the flyleaves and on fols 79v, 80r.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>
                                    The binding is enclosed in a coarse chemise of neutral-coloured fabric furnished with an external
                                    layer of thick leather, sewn to its borders.
                                  
                                    Chainstitch sewing on two sewing stations (one pair).
                                  </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Quire structure</fo:block>
         <fo:block>9 quires. A<fo:inline font-size="7pt" vertical-align="text-top">0+2 (Fols ir–iiv)</fo:inline> – I<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 1r–10v)</fo:inline> – II<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 11r–20v)</fo:inline> – III<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 21r–30v)</fo:inline> – IV<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 31r–40v)</fo:inline> – V<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 41r–50v)</fo:inline> – VI<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 51r–60v)</fo:inline> – VII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 61r–70v)</fo:inline> – VIII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 71r–80v)</fo:inline>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 1r–80r: 1
                                    column (9 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 2r.The characters per line are 5–9.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            78 × 54 mm (fol. 2r).
                                            </fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            53 × 36 mm (fol. 2r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 7 mm, bottom: 18 mm, right: 10 mm, left: 8 mm (fol. 2r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Ruling is visible, but the pricking appears to have been trimmed away. The upper and bottom lines are written above the ruling.
                                     Ruling pattern: 1J-1J/0-0/0-0/C.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->Fols 1ra–80r. 1900–1999. Modern bulky hand with elongated characters, mostly regularly spaced.<fo:block>Ink: Black, red.</fo:block>
                           <fo:block>Rubrication: Incipits of texts and sections; holy names; the name of
                                    the owner <fo:inline id="d1e125641PRS15069MazgabaS">Mazgaba Śǝllāse</fo:inline>;
                                    elements of numerals and punctuation marks.</fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>twentieth century</fo:inline>
                            The manuscript can be dated palaeographically to the twentieth century.
                            Its original owner was <fo:inline id="d1e125694PRS15069MazgabaS">Mazgaba Śǝllāse</fo:inline>.
                        </fo:block>
            <fo:block>The provenance of the manuscript is not known.</fo:block>
         </fo:block>
