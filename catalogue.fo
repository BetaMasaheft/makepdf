      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLeu4"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. e. 40</fo:block>
            <fo:block>(Bodleian Ullendorff 4)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment codex, composite210×195 mm (weight: 1774g), 154 fols, 20 quires.  Unit 1: , mid-fifteenth–mid-sixteenth century. Unit 2: , mid-fifteenth–mid-sixteenth century. </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>
                                The book is bound in wooden boards covered with dark brown blind-tooled leather. The inner sides of both boards are decorated with textile <fo:inline id="d1e119150">inlays</fo:inline>
                                featuring a floral motif outlined in yellow, white and green on a blue background.
                              
                                The boards are flush with the bookblock and present external shallow bevels.
                              
                                Full dark-brown leather cover.
                                The turn-ins have been trimmed out and at the corners they form butt mitres.
                                <fo:inline id="d1e119159">Additional leather patches</fo:inline> fill the gap between the turn-ins.
                                The cover shows a blind-tooled decoration, identical on both sides of the cover. The turn-ins and the edges are decorated as well.
                                The decoration consists of five concentric frames surrounding a central rectangular panel featuring a Latin cross.
                                Frames composed by the repetition of single tools, enclosed between <fo:inline id="d1e119162">triple straight lines</fo:inline>,
                                alternate with empty ones.
                                Proceeding from the outer to the inner frame, the repeating decoration motifs are <fo:inline id="d1e119165">criss-crosses</fo:inline>,
                                <fo:inline id="d1e119168">wavy lines</fo:inline>, and <fo:inline id="d1e119171">straight strapwork</fo:inline> elements.
                                The cross is formed by <fo:inline id="d1e119175">X-form</fo:inline> motifs between <fo:inline id="d1e119178">triple straight lines</fo:inline>.
                                At the ends of the arms of the cross there are <fo:inline id="d1e119181">corniform</fo:inline> motifs and six <fo:inline id="d1e119184">double circles</fo:inline>.
                                Triple straight lines outline the shape of the cross, dividing the surrounding area in four panels in which are stamped four <fo:inline id="d1e119187">double circles</fo:inline>
            <fo:inline id="d1e119190">Double circles</fo:inline> are stamped at the intersections of the straight lines and at the corners of the empty frames as well.
                                A <fo:inline id="d1e119194">single straight line</fo:inline> runs along the edges of the boards.
                                Turn-ins are decorated with concentric frames formed by <fo:inline id="d1e119197">triple straight lines</fo:inline>.
                              
                                Chainstitch sewing on four sewing stations (two pairs); periodic fold pattern; Z-plied threads.
                                Between each pair of sewing stations there are two lengths of thread.
                              </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Foliation</fo:block>
            <fo:block>Pencil foliation in the upper right corner.</fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Quire structure</fo:block>
         <fo:block>20 quires. I<fo:inline font-size="7pt" vertical-align="text-top">4+2 (Fols 1r–6v)</fo:inline> – II<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 7r–14v)</fo:inline> – III<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 15r–22v)</fo:inline> – IV<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 23r–30v)</fo:inline> – V<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 31r–38v)</fo:inline> – VI<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 39r–46v)</fo:inline> – VII<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 47r–54v)</fo:inline> – VIII<fo:inline font-size="7pt" vertical-align="text-top">6+2 (Fols 55r–62v)</fo:inline> – IX<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 63r–70v)</fo:inline> – X<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 71r–78v)</fo:inline> – XI<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 79r–86v)</fo:inline> – XII<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 87r–94v)</fo:inline> – XIII<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 95r–102v)</fo:inline> – XIV<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 103r–110v)</fo:inline> – XV<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 111r–118v)</fo:inline> – XVI<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 119r–126v)</fo:inline> – XVII<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 127r–134v)</fo:inline> – XVIII<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 135r–142v)</fo:inline> – XIX<fo:inline font-size="7pt" vertical-align="text-top">4+2 (Fols 143r–149v)</fo:inline> – XX<fo:inline font-size="7pt" vertical-align="text-top">2+3 (Fols 150r–154v)</fo:inline>
         </fo:block>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true"/>
         <fo:block space-before="2mm" space-after="3mm">Unit 1</fo:block>
         <fo:block>Parchment, 153 fols (fols 1,  fols 3–154).</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e119281LIT1146Argano">
               <fo:inline>I) Fols 7ra–149va: <fo:inline xml:lang="en" hyphenate="true">‘Harp of Praise’ (​አር​ጋኖ​ነ፡ ​ውዳ​ሴ፡), CAe 1146.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e119289LIT1146Argano#Monday">
               <fo:inline>I-1) Fols 7ra–33rb: <fo:inline xml:lang="en" hyphenate="true">Harp of Praise: for Monday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​በስ​መ፡ ​እግ​ዚአ​ብሔ​ር፡ 
                                        ​ሥሉ​ስ፡ ​ዘእ​ንበ​ለ፡ ​ፍል ​ጠት፡ ወ<fo:inline>[...]</fo:inline>​፩፡
                                        ​በጽ​ምረ​ት፡ ኅ ​ቡረ፡ ​ህላ​ዊ፡ ​ወዕ​ሩየ፡
                                         ​መለ​ኮት፡ ​ዘአ​ሐተ፡ ​ይሰ ​ግድ፡ ​እም​ኀበ፡ ​ሰብ​እ፡
                                        ​ወመ​ላእ​ክት ፨ 
                                        ​ንጽ​ሕፍ፡ ​እን​ከ፡ ​ዘን​ተ፡ ​መጽ​ሐፈ፡ ​ዘይ​ሠመ​ይ፡ ​አር​ጋኖ​ነ፡ ​ውዳሴ ፨ 
                                        ​ወመ​ሰን​ቆ፡ ​መዝ​ሙር፡ ​ወእ​ንዚ​ራ፡ ​ስብ​ሐት ፨ 
                                        ​ዘአ​ስተ​ብፅ​ዖ፡ ​ድን​ግል​ናሃ ፨ 
                                        ​ወነ​ጊረ፡ ​ዕበ​ያ፡ ​ወአ​ክብ​ሮ፡ ​ስማ ፨ 
                                        ​ወሰ​ብሖ፡ ​ቅድ​ስናሃ ፨ 
                                        ​ወግ​ናይ፡ ​ለን​ግሣ ፨ 
                                        ​ለቅ​ድስ​ት፡ ​ወቡር  (b)  ​ክት፡ ​ወን​ጽሕ​ት፡ ​ማር​ያም፡ 
                                        ​ዘበ​ዕብ​ራይ​ስጢ፡  ​ማሪ​ሃም፡ ​ድን​ግል፡ ​ወላ ​ዲተ፡
                                        ​አም​ላክ ፨ 
                                        ​እን​ተ፡ ይ ​እቲ፡ ​ሐመ​ረ፡ ​ወር​ቅ፡ ​እሞ ​ገደ፡ ​አስ​ራም፡ ​እን​ተ፡
                                        ​ኢት​ትሐ​ወክ፡ ​ወራ​ግና​ቲሃ፡ ​ሐብ​ለ፡ ​ሥላ​ሴ፡ ​ዘኢ​ይት​በተክ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ኦቅ​ድስ​ት፡ ​ድን​ግል፡ ​ሄሮ​ድስ፡ ​ፈቀ​ደ፡ ​ይዕ​ፁ፡ ​ነፋ​ሰ፡ ​ውስ​ተ፡ ​ጽር​ሑ፡ ​በአ​ይቴ፡ ​ይት​ከሀ​ል፡ ​ዓፂ​ወ፡
                                        ​ነፋ​ስ፡ ​ሄሮ​ድስ፡ ​ፈተ​ወ፡ ​ይጽ​ብጥ፡ ​ብር​ሃነ፡ ​ፀሐ​ይ፡ ​በእ​ዴሁ፡ ​በአ​ይቴ ፡ ​ኬ፡
                                        ​ይት​ከሀ​ል፡ ​ፀቢ​ጠ፡ ​ብር​ሃነ፡ ​ፀሐ​ይ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ተዓ​ንገ​ደ፡ ው  (b)  ​ስተ፡ ​ምድ​ረ፡ ​ግብ​ጽ፡
                                        ​ተሐ​ዚሎ፡ ​በዘ​ባንኪ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e119366LIT1146Argano#Tuesday">
               <fo:inline>I-2) Fols 33rb–57va: <fo:inline xml:lang="en" hyphenate="true">Harp of Praise: for Tuesday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ኦእ​ግዝ​እት​የ፡ ​ቅድስ ​ት፡ ​ት፡
                                        ​ድን​ግል፡ ​በክ​ልኤ ፨
                                        ​ማር​ያም፡ ​ዘበ​ዕብ​ራይ ​ስጢ፡  ​ማር​ያም፡ 
                                        ​ተማ​ኅፀ​ንኩ፡ ​በዝ​ተአ​ንግ​ዶ፡ ​አም​ላክ፡ ​ምስ​ሌኪ፡ ​ተዝ​ካረ፡ ​ጻማ​ኪ፡ ​በሐ​ዊረ፡ ​ፍኖ​ት፡
                                        ​ይቁ​ም፡ ​ቅድ​መ፡ ​ገጹ፡ ​ለወ​ልድኪ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        <!-- we could extend the explicit with the last lines of f. 57rb, but the image of fol. 57r is missing -->
                                        ​ዓለም ፨ 
                                        ​ወኢ​በዘ​ይመ​ጽእ፡ ​ዓለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e119412LIT1146Argano#Wednesday">
               <fo:inline>I-3) Fols 57va–81vb: <fo:inline xml:lang="en" hyphenate="true">Harp of Praise: for Wednesday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​አቀ​ድም፡ ​አእ​ኵቶ​ቶ፡  ​ለእ​ግዚ​አብሔ<fo:inline>[ር]</fo:inline>፡
                                        ​በእ​ንተ፡ እ ​ግዚ​እነ፡ ​ኢየ​ሱስ፡ ክ ​ርስ​ቶስ ፨ 
                                        ​ወበ​እን​ቲአ​ኪኒ፡ ​እስ​መ፡ ​ተሰ​ምዐ፡ ​ዜና፡ ​ውዳ​ሴኪ፡ ​ውስ​ተ፡ ​ኵሉ፡ ​ዓለም ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                     <fo:inline>መጠዓዊ፡ (!)</fo:inline> ​ወመ​ሰግ​ል፡ ​ይሠ​ረው፡ ​ዘስ​ራይ፡ ​ወመ​ስተ​ቃስ​ም፡ ​ይደ​ምስሱ ፨ 
                                        ​ወዘ​ያስ​ምክ፡ ​በእ​ጓለ፡ ​እመ​ሕያ​ው፡
                                        <fo:inline> (!)</fo:inline>
                  </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e119458LIT1146Argano#Thursday">
               <fo:inline>I-4) Fols 81vb–106vb: <fo:inline xml:lang="en" hyphenate="true">Harp of Praise: for Thursday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ወአ​ንቲ​ሂ፡ ​ካዕ​በ፡ ​ኦእ ​ግዝ ​ግዝ​እት​የ፡
                                         ​ማር​ያም፡  (fol. 82ra)  ​ዘበ​ዕብ​ራይ​ስጢ፡ ​ማሪ ​ሃም፡
                                        ​እሙ፡ ​ለገ​ባሬ፡ መ ​ላእ​ክት፡ ​ወወ​ላዲ​ቱ። ለ ​መስ​ተፅ​ዕነ፡ ​ኪሩ​ቤል፡
                                        ​ሰአ​ሊ፡ ​በእ​ንቲ​አየ፡ ​ከመ፡ ​እት​ባላ​ህ፡ ​በጸ​ሎት​ኪ፡ ​እመ​ናስ​ወ፡ ​ዓለም ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ወተ​ፈል​ጠ፡ ​ለት​ምህ​ርተ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ዘአ​ቅደ​መ፡ ነ  (b)  ​ጊረ፡ ​በአ​ፈ፡ ​ነቢ​ያቲ​ሁ፡ ​በእ​ንተ፡
                                        ​ዘተ​ወል​ደ፡ ​ወመ​ጽአ፡ ​እም​ዘር​አ፡ ​ዳዊ​ት፡ ​በሥ​ጋ፡ ​ሰብእ ፨ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e119503LIT1146Argano#Friday">
               <fo:inline>I-5) Fols 106vb–128rb: <fo:inline xml:lang="en" hyphenate="true">Harp of Praise: for Friday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ኦእ​ግዝ​እት​የ፡ ​ቅድስ ​ት፡ ​ት፡ ​ድን​ግል፡ ​በክ​ልኤ፡
                                         ​ማር​ያም፡ ​ዘበ​ዕብ​ራይ ​ስጢ፡ ​ማሪ​ሃም ፨ 
                                        ​ንዒ፡ ዝ ​የ፡ ​ምስ​ለ፡ ​ኵሎ​ሙ፡ ​ማኅበ ​ረ፡ ​ነቢ​ያት፡ ​ከመ፡ ​ታለ​ብወ​ኒ፡ ​ኃይ​ለ፡
                                        ​ቃል ፨  ​ዘወ​ፅአ፡ ​እም​አፉ​ሆሙ፡ ​ለስ​ብሐ​ተ፡ ​ዚአ​ኪ፡
                                        ​ኦድ​ንግ​ል፡ ​ንዒ፡ ​ኀቤ​የ፡ ​ምስ​ለ፡ ​ኵሎ​ሙ፡ ​ማኅ​በረ፡ ​ነቢ​ያት፡ ​ወሐ​ዋር​ያት፡
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ወእ​መሂ፡ ​በሕ​ሊና​ሁ፡ ​አነ፡ ​እፈ​ዲ፡ ​አስ​ተብ​ቍዖ፡ ​ወጸ​ሎተ፡ ​በእ​ንተ፡ ​ዕዳ፡ ​ዚአ​ሁ፡ ​ሣህ​ለ፡ ​ዚአ​ከ፡ ​ወም​ሕረ​ተ፡ ​አቡ​ከ፡
                                        ​ወኂ​ሩተ፡ ​መን​ፈስ፡ ​ቅዱ​ስ፡ ​ይመ​ግቦ ፨  ​በኵ​ሉ፡ ​መዋ​ዕሊ​ሁ፡   (b)  
                                        ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​አሜን ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e119548LIT1146Argano#Saturday">
               <fo:inline>I-6) Fols 128rb–138vb: <fo:inline xml:lang="en" hyphenate="true">Harp of Praise: for Saturday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​እት​ጋነ​ይ፡ ​ለዕ​በይ​ኪ፡ ኦ ​ወለ​ተ፡ ​ዳዊ​ት፡ ​ወእ​ሰግ​ድ፡
                                         ​ታሕ​ተ፡ ​መከ<fo:inline> (!)</fo:inline>​ደ፡ ​እገር ​ኪ፡ ​ኪ፡
                                        ​ወእ​ትመ​ሐለ​ል፡ ​ቅድ ​መ፡ ​ገጽ​ኪ፡ ​ኦወ​ለተ፡ ​ሣህ ​ል፡ ​ግሩ​ር፡ ​አነ፡ ​ለን​ግሠ፡ ​ወል​ድኪ፡ ​ኦወ​ለተ፡ ​ምሕ​ረት፡
                                        ​ለይ​ረድ፡ ​ላዕ​ሌየ፡ ​ጠለ፡ ​ምሕ​ረቱ፡ ​ለፍ​ቁርኪ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ተፀ​ወን​ኩ፡   (b)   ​ኪያ​ኪ፡ ​ከመ፡ ​ኢይ​ስሐ​ጠኒ፡ ​አሕ​ፃሆ​ሙ፡ ​ለመ​ኳን​ንተ፡ ​ጽል​መት፡ ​ወእ​ድኅ​ን፡ ​ካዕ​በ፡
                                        ​እም​አር​ማሐ፡ ​ዓላ​ዊያን ፨  ​ወእ​ምሰ​ይፈ፡ ​ነኪ​ራን፡
                                        ​ተፀ​ወን​ኩ፡ ​ኪያ​ኪ፡ ​ከመ፡ ​እት​ባላ​ህ፡ ​እመ​ናግ​ንቲ​ሆሙ፡ ​ለእ​ለ፡ ​ይት​ቃወ​ምዋ፡ ​ለፍ​ኖተ፡
                                        ​ጽድቅ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e119593LIT1146Argano#Sunday">
               <fo:inline>I-7) Fols 138vb–149va: <fo:inline xml:lang="en" hyphenate="true">Harp of Praise: for Sunday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​ኣሌ​ዕል፡ ​እደ​ውየ፡ ​ኀበ። ። 
                                    ​ወል​ድኪ፡ ​ወእ​ጸር​ኅ፡ ​እን​ዘ፡ 
                                        <fo:inline> (!)</fo:inline>
                                        ​ረድ፡ ​እግ​ዚኦ፡ እ ​ምጽ​ርሕ​ከ፡ ​ወእ​መቅ​ደስ​ከ፡ ​ከመ፡ ​ትባ​ልሐ​ኒ፡ ​እም​ኵሉ፡ ​መከ​ራ፡
                                    ​ወእ​ምኵ​ሉ፡ ​ምን​ዳቤ ፨ 
                                    ​ረድ፡ ​እግ​ዚኦ፡ ​እም​ድል​ው፡ ​ማኅ​ደር​ከ፡   (fol. 139ra)   ​ከመ፡ ​ታድ​ኅነ​ኒ፡ ​እመ​ቅሠ​ፍት፡ ​እን​ተ፡ ​ታጠ​ውቅ፡
                                     ወ ​እም​ድቀ​ት፡ ​እን​ተ፡ ​አል​ባቲ፡ ​ትን​ሣኤ ፨
                                </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    
                                    ​ወለ​ስም​ዓ፡ ​ቃላ​ቲሁ፡ ​ኅቡ​ረ፡ ​ይም​ሐረ​ነ፡ ​እግ​ዚአ​ብሔ​ር፡ ​እስ​ከ፡ ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​አሜ​ን፡
                                    ​ወአ​ሜን ፤ 
                                    ​ለይ​ኩን፡ ​ለይ​ኩን ፨ ፨
                                </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Varia</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>fols 7rb, 23rb, 32vb44rb, 79rb, 82r: </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Aids for identifying the section for each weekday are written in red ink in the upper margin encircled by red dots,
                                            sometimes next to erasures (see Varia note 3):
                                            <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ዘሰ​ኑይ</fo:inline> (fol. 7ra),
                                            <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ዘሠ​ሉስ፡</fo:inline> (fol. 33rb),
                                            <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ዘረ​ቡዕ፡</fo:inline> (fol. 57va),
                                            <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ዘሐ​ሙስ፡</fo:inline> (fol. 81vb),
                                            <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ዘዐ​ርብ፡</fo:inline> (fol. 106vb),
                                            <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ዘቀ​ዳሚ​ት፡ ​ሰን​በት፡</fo:inline> (fol. 128rb),
                                            <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ዘሰ​ንበ​ተ፡ ​ክር​ስቲ​ያን፡</fo:inline> (fol. 138vb).
                                        </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 33rb, 57va, 81vb, 106vb, 128rb, 138vb, 149va: Secondarily added supplication formulas mentioning <fo:inline id="d1e119831PRS15025Kenfa">Kǝnfa</fo:inline> have been
                                            erased at the end of each weekday section. The supplication formulas were sometimes found inside the
                                            textblock, sometimes next to the indications listed in Varia note 2.
                                        </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 3ra–153vb: 2
                                    columns (17 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 15r.The characters per line per column are 8–11.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            204 × 193 mm (fol. 15r).
                                            </fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            133 × 143 mm (fol. 15r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 30 mm, bottom: 43 mm, right: 34 mm, left: 16 mm, intercolumn: 18 mm (fol. 15r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Ruling and pricking are visible. Primary pricks are visible and ruling pricks are mostly visible. The upper and bottom lines are written above the
                                        ruling. Ruling pattern (fols 3r–154v): 1E-1E-1E1E/0-0/0-0/C.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->1600–1799. Trained and regular hand.<fo:block>Ink: Black, red.</fo:block>
                           <fo:block>Rubrication: Lines on incipit pages and incipit columns, alternating with black lines; holy names;
                                        elements of punctuation marks.</fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Other details</fo:block>
            <fo:block>Some holes from parchment making repaired by sewing are present, e.g. on fols 107, 138.</fo:block>
            <fo:block/>
            <fo:block/>
         </fo:block>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true"/>
         <fo:block space-before="2mm" space-after="3mm">Unit 2</fo:block>
         <fo:block>Parchment, 1 fols (fol. 2), mid-fifteenth–mid-sixteenth century.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e119858LIT1672Isaiah">
               <fo:inline>I) Fols 2va–2rb: <fo:inline xml:lang="en" hyphenate="true">‘’ ( ​መጽ​ሐፈ፡ ​ኢሳ​ይያ​ስ፡ ​ነቢ​ይ:), incomplete, CAe 1672.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The fragment contains the following portions of the text: Is
                                    65:11–14 (fols 2va),
                                    65:15–22 (2vb; the beginning of verse 22 has been omitted,
                                    possibly due to homoeoteleuton, as verse 21 begins similarly),
                                    65:23–66:3 (2ra),
                                    66:3–8 (2rb).</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                
                                ​መልኡ ፨  ​ወአ​ነ፡ ​እሜ​ጥወ​ክሙ፡ ​ለኲ​ናት፡
                                ​ወት​መው​ቱ፡ ​ኵል​ክሙ፡ ​በመ​ጥባ​ሕት፡ ​እስ​መ፡ ​ጸዋ​ዕኩ​ክሙ፡ ​ወኢ​ያው​ሣእ​ክሙ፡ ​ወነ​በብ​ኩክ​ሙ፡
                                ​ወተ​ጸመ​ምክ​ሙኒ፡ ​ወገ​በር​ክሙ፡ ​እኩ​የ፡ ​በቅ​ድሜ​የ፡ ​ወኢ​ፈቀ​ድክ​ሙ፡
                                ​አድ​ኅን​ክሙ ​፨=፨
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                
                                ​ስም​ዑ፡ ​ቃለ፡ ​እግ​ዚአ​ብሔ​ር፡ ​እለ፡ ​ትር​ዕዳ፡ ​እምቃ<fo:inline>[ሉ]</fo:inline>
                     <fo:inline>[...]</fo:inline>
                                ​በል​ዎሙ፡ ​አኃ​ዊነ፡ ​ለጸ​ላእ​ትክ​ሙ፡ ​ከመ፡ ​ይሴ​ባሕ፡ ​ስመ<fo:inline>[...]</fo:inline>
                                ​እግ​ዚኣ​ብሔ​ር፡ ​ቃለ፡ ​እግ​ዚኣ​ብሔ​ር፡ ​ዘይ​ትቤ​ቃል<fo:inline>[...]</fo:inline>
                                በ<fo:inline>[...]</fo:inline>​ለ፡ ​እም​ፀሩ፡ ​ዘእ​ንበለ<fo:inline>[...]</fo:inline>
                                ​ትለ​ድ፡ ​እን​ተ፡ ​ውስ​ተ፡ ​ማሕ​ምም፡ ​ወወ​ለደ​ት፡ ​ተባ​ዕተ፡ ​መኑ፡ ​ሰም​ዐ፡ ​ከመ​ዝ፡ ​ወመ​ኑ፡
                                ​ርእ​የ፡ ​ዘከ​መዝ፡ ​ይትወ<fo:inline>[​ለዱኑ]</fo:inline>፡ ​አሕ​ዛብ፡ ​በም​ዕር፡
                            </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 2: 2
                                    columns (20 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">The folio has been erroneously bound, so that the original outer part of the folio is now found
                                            in the gut. The lower and current outer part of the folio have been trimmed with loss of text.
                                        Based on the amount of text loss, the leaf must originally have contained an additional six to seven written lines.There are 10–12 characters per line.Due to the trimming of the folio, the extent of the ruling lines and the lower end of the vertical lines
                                            cannot be determined.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            204 × 193 mm.
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Ruling is visible; the areas expected to contain traces of pricking are
                                            now inaccessibly located inside the quire. Ruling pattern (fol. 2): 1A-1A-1A1A/0-0/0-0/?.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 2:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->Fols 2va–2rb. 1450–1550. 
                                        Regular hand with regularly spaced characters.
                                    <fo:block>Ink: Black.</fo:block>
                           <fo:block>Rubrication: 
                                        Elements of punctuation marks.
                                    </fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Other details</fo:block>
            <fo:block>Small holes from parchment making are present on fol. 2.</fo:block>
            <fo:block/>
            <fo:block/>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>mid-fifteenth–mid-sixteenth century</fo:inline>
                                Unit 2 can be dated palaeographically to the mid-fifteenth–mid-sixteenth century. It presumably became a part
                                of the current unit of circulation at the time of production of Unit 1.
                            </fo:block>
         </fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLeu4">https://betamasaheft.eu/BDLeu4</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
