      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLaethf23"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. f. 23</fo:block>
            <fo:block>(Juel-Jensen 47)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Paper codex158×128 mm (weight: 126g),  fols (13 p. blank), mid-twentieth century–1982.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e106925LIT4915PhysA">
               <fo:inline>I) Fols 1–123: <fo:inline xml:lang="en" hyphenate="true">‘Homily of the blessed Physiologus’ (​ድር​ሳን፡ ​ዘብ​ጹዕ፡ ​ፊሳ​ልጎ​ስ፡), CAe 4915.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                              ​ድር​ሳን፡ ​ዘብ​ፁዕ፡
                                  <fo:inline>ፊልጎስ። (!)</fo:inline>
                               ​ዘደ​ረሰ፡ ​በእ​ንተ፡ ​አራ​ዊት፡  ​ወአ​ዕዋ​ፍ፡ ​ከመ፡ ​ቦ፡ ​ላዕ​ሌሆ​ሙ፡ ​ብዙ​ኅ፡ ​አም​ሳል፡ ​ወብ​ዙኅ፡ ​ትእ​ምር​ት፡ ​ዘይ​ከው​ን፡ ​በቍ​ዔተ፡ ​ለዘ​ያነ​ብቦ።
                          </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e106947LIT4915PhysA#Lion">
               <fo:inline>I-1) Fols 1–5: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the lion</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ነገ​ር፡ ​ቀዳ​ሚ፡ ​በእ​ንተ፡ ​አን​በሳ፡ ​ንጉ​ሠ፡ ​አራ​ዊት። ​ወዝ፡ ​አን​በሳ፡ ​ያዕ​ቆብ፡ ​ውእ​ቱ። ​እስ​መ፡ ​ያዕ​ቆብ፡ ​እን​ዘ፡ ​ይባ​ርኮ፡ ​ለወ​ልዱ፡ ​ይቤ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ከማ​ሁ፡ ​አብ፡ ​አኃ​ዜ፡ ​ኵሉ፡ ​አን​ሥኦ፡ ​ለወ​ልዱ፡ ​በኵ​ሩ፡ ​ዘእ​ምቅ​ድመ፡ ​ዓለ​ም፡ ​ዘው​እቱ፡ ​እግ​ዚእ​ነ፡  ​ክር​ስቶ​ስ፡  ​ተን​ሥአ፡ ​በኃ​ይለ፡ ​መለ​ኮቱ፡
                                  ​ወአ​ንሥ​አ፡ ​ኵሎ፡ ​ሠና​የ። ​ይቤ፡ ​ያዕ​ቆብ፡ ​ዕጓ​ለ፡ ​አን​በሳ፡ ​ከመ፡ ​አል​ቦ፡ ​ዘያ​ነቅ​ሆ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e106969LIT4915PhysA#Lizard">
               <fo:inline>I-2) Fols 5–7: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the lizard</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​፪፡ ​ፍካ​ሬ፤ ​በእ​ንተ፡ ​ሕን​ጲን፡   (fol. 6)   ​እን​ተ፡ ​ተጸ​ሐየ​የት፡ ​ሕን​ጲን፡ ​ሶበ፡ ​ትረ​ስዕ፡ ​ይጼ​ልላ፡ ​አዕ​ይን​ቲሃ፡ ​ወተ​ዓው​ር፡ ​እስ​ከ፡ ​ትሬ​ኢ፡ ​ብር​ሃነ፡ ​ፀሐ​ይ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ሶበ፡ ​ተጸ​ለለ፡ ​ዓይ​ነ፡ ​ልብ​ከ፡ ​ኅሥ​ሥ፡   (fol. 7)   ​ዓረ​ፍተ፡ ​ርድ​ኤት፡ ​በት​ጋህ፡ ​እስ​ከ፡ ​ይሠ​ርቅ፡ ​ለከ፡ ​ፀሐ​የ፡ ​ምሕ​ረቱ፡ ​ለእ​ግዚ​እነ፡ ​ዘሰ​መዮ፡ ​ነቢ​ይ፡ ​ጽባ​ሐ፡
                                  ​ወይ​በር​ህ፡ ​ዓይነ<fo:inline>[፡]</fo:inline> ​ልብ​ከ፡ ​በዝ​ንቱ፡ ​አር​አያ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e106994LIT4915PhysA#Caladrius">
               <fo:inline>I-3) Fols 7–11: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the caladrius</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The chapter number is missing.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፤ ​በእ​ንተ፡ ​ዖፍ፡ ​ዘስ​ሙ፡ ​ከራ​ድዮ​ን፡  ​ዘጽ​ሑፍ፡ ​ውስ​ተ፡ ​ዳግ​ም፡ ​ሕግ፡ ​ተብ​ህለ፡  ​በእ​ንቲ​አሁ፡ ​ከመ፡ ​ኵለ​ንታ​ሁ፡ ​ፀዓ​ዳ፡ ​ዘአ​ልቦ፡ ​ምን​ትኒ፡ ​ጸሊ​ም፡ ​ላዕ​ሌሁ።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ከማ​ሁ፡ ​ሀለ​ዎ፡ ​ለወ​ልደ፡ ​እጓ​ለ፡ ​እመ​ሕያ​ው፡   (fol. 11)   ​ይሰ​ቀል፤ ​፪፡ ​እሙ​ንቱ፡ ​ፍጡ​ራን፡ ​፩፡ ​ዘይ​ትዌ​ደስ፡ ​ወ፩ ​ዘኢ​ይት​ዌደ​ስ፡ ​ሠና​የ፡ ​እን​ከ፡ ​ይቤ፡
                                  ​ዘይ​ቤ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107016LIT4915PhysA#Pelican">
               <fo:inline>I-4) Fols 11–13: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the pelican</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​፫፡ ​ፍካ​ሬ፡ ​በእ​ንተ፡ ​ዖፍ፡ ​ዘስ​ሙ፡ ​ጰል​ቃን፡ <fo:inline>[...]</fo:inline> ​ዘው​እቱ፡ ​ግራ​ብ።  ​ይቤ፡ ​ዳዊ​ት፡ ​ተመ​ሰል​ኩ፡ ​ጰል​ቃነ፡
                                  ​ዘገ​ዳም። ​ይቤ፡  ​ፊሳ​ልጎ​ስ፡  ​በእ​ንተ፡ ​ጰል​ቃን፡ ​ከመ፡ ​መፍ​ቀሬ፡ ​ደቂ​ቁ፡ ​ውእ​ቱ፡ ​በሕ​ቁ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ወን​ሕነ፡ ​ተራ​ኅር​ሃ፡ ​ከመ፡ ​እም፡ ​ወአ​ሪጎ፡ ​ዲበ፡ ​ኑኃ፡ ​መስ​ቀል፡ ​ወአ​ንጸ​ፍጸ​ፈ፡ ​ለነ፡ ​ደመ፡ ​ወማ​የ፡ ​ወጥ​ምቀ​ተ፡ ​ንስ​ሐ፡
                                  ​ወአ​ሕየ​ወነ፡ ​ሠና​የ። ​ይቤ፡ ​ዘይ​ቤ፡ ​በእ​ንተ፡ ​ጰል​ቃን።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107040LIT4915PhysA#Owl">
               <fo:inline>I-5) Fols 13–15: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the owl</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​፬፡ ​ፍካ​ሬ፡ ​በእ​ንተ፡ ​ኒቂ​ጢቆ፡  ​ዖፍ፡ ​ርኩ​ስ፡ ​ዘሰ​መዮ፡ ​ዳዊ​ት፡ ​ይቤ፡ ​ወኮ​ንኩ፡ ​ከመ፡ ​ጉጋ፡ ​ውስ​ተ፡ ​ቤት፡ ​ሌሊ​ተ።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​እስ​መ፡ ​ጉጋ፡   (fol. 15)   ​ርኩ​ስ፡ ​ውስ​ተ፡ <fo:inline>ፀግ፤ (!)</fo:inline> ​እፎ። ​ይቤ፡ ​ሐዋ​ርያ፡ ​ዘኢ​ያአ​ምር፡ ​ኃጢ​አተ፡
                                  ​በእ​ንቲ​አነ፡ ​ፆረ፡ ​ኀጢ​አተ፡ ​ወአ​ትሐ​ተ፡ ​ርእ​ሶ፡ ​ከመ፡ ​ኵሎ፡ ​ያል​ዕል፡ ​ሠና​የ፡ ​ይቤ፡ ​በእ​ንተ፡ ​ጉጋ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107063LIT4915PhysA#Eagle">
               <fo:inline>I-6) Fols 15–18: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the eagle</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​፭፡ ​ፍካ​ሬ፡ ​በእ​ንተ፡ ​ንስ​ር፡ ​ዳዊ​ት፡ ​ይቤ፡ ​ዘይ​ሔድ​ሳ፡ ​ከመ፡ ​ንስ​ር፡ ​ለው​ርዙ​ትየ፤   ​ፊሳ​ልጎ​ስ፡  ​ይቤ፡ ​ንስ​ር፡ ​ሶበ፡ ​ይረ​ስዕ፡ ​ይከ​ብዳ፡ ​ወይ​ጼል​ላ፡
                                  ​አዕ​ይን​ቲሁ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​በስ​መ፡  ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈስ<fo:inline>[፡]</fo:inline> ​ቅዱ​ስ፡  ​ይት​አተ​ት፡ ​ጽል​መት፡ ​ልብ​ሰተ፡ ​ዲያ​ብሎ​ስ፡
                                  ​ይት​ከደ​ን፡ ​ሐዲ​ሰ፡ ​ወብ​ሩሃ፡ ​ዘበ​እግ​ዚእ፡ ​ተፈ​ጥረ፡ ​ወይ​ትፌ​ጸም፡   (fol. 18)   ​ትን​ቢት፡ ​ዘይ​ቤ፤ ​ዘይ​ሔድ​ስ፡ ​ከመ፡ ​ንስ​ር፡ ​ለው​ርዙ​ትከ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107092LIT4915PhysA#Phoenix">
               <fo:inline>I-7) Fols 18–21: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the phoenix</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​፮፡ ​ፍካ​ሬ፡ ​በእ​ንተ፡ ​ዖፍ፡ ​ዘስ​ሙ፡ ​ፊን​ክስ፤ ​ይቤ፡ ​እግ​ዚእ​ነ፡ ​በወ​ንጌ​ል፡ ​ሥል​ጣን፡ ​ብየ፡ ​እሜ​ጡ፡ ​ነፍ​ስየ። ​ወካ​ዕበ፡ ​አን​ሥኦ። ​አይ​ሁድ፡ ​አን​ጐር​ጐሩ፡ ​በእ​ንተ፡
                                  ​ዝን​ቱ፡ ​ቃለ፡ ​ፊን​ክስ።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                     <fo:inline>ልንክስ፡ (!)</fo:inline> ​ኮነ፡ ​አር​አያ፡ ​ለመ​ድኃ​ኒነ፡ ፪ ​ክነ​ፊሁ፡ ​መል​አ፡ ​መዓ​ዛ፡ ​ኮነ፡   (fol. 21)   ​ወኃ​ይለ፡ ​ወመ​ጽአ፡
                                  ​ኀቤ​ነ፡ ​ንሕ​ነኒ፡ ​ንስ​ፋሕ፡ ​እግ​ዚእ​ነ፡ ​ለጸ​ሎት፡ ​ኀቤ​ሁ፡ ​ከመ፡ ​ንም​ላዕ፡ ​መዓ​ዛ፡ ​ጸጋ​ሁ፡ ​በሀ​ገሪ​ትነ፡ ​ሠና​ይት።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107116LIT4915PhysA#Hoopoe">
               <fo:inline>I-8) Fols 21–23: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the hoopoe</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​፯፡ ​ፍካ​ሬ፡ ​በእ​ንተ፡ ​ዖፍ፡ ​ዘስ​ሙ፡ ​ሔጲ​ጶስ፡ ​ጽሑ​ፍ፡ ​ውስ​ተ፡ ​ሕግ፡  ​ዘያ​ስተ​ዋዲ፡ ​አባ​ሁ፡ ​ወእ​ሞ፡ ​ሞተ፡ ​ለይ​ሙት፡ ​ሀለ​ዉ፡ ​ሰብ​አ፡ ​ቀት​ል፡ ​አብ፡ ​ወእ​ሙ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ከማ​ሁ፡ ​ንግ​በር፡ ​ለክ​ሙ፡ ​ከመ​ዝ፡ ​ይገ​ብሩ፡ ​እስ​ከ፡ ​ይት​ሔደ​ሱ፡ ​ወይ​ትሔ​ደሱ፡ ​ወይ​ከው​ኑ፡ ​ወራ​ዙተ፡ ​እፎ፡ ​ኢያፈ  (fol. 23)  ​ቅሩ፡ ​ነባ​ብያ​ን፡ ​ወላ​ድያ​ኒሆ​ሙ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107136LIT4915PhysA#WildDonkey">
               <fo:inline>I-9) Fols 23–25: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the wild donkey</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​፰፡ ​ፍካ​ሬ፡ ​በእ​ንተ፡ ​ሐለ​ስት​ዮ። ​ይቤ፡ ​ኢዮ​ብ፡  ​መኑ፡ ​አግ​ዓዞ፡ ​ለሐ​ለስ​ትዮ፡ ​ወመ​ኑ፡ ​ፈት​ሖ፡ ​ማዕ​ሠሮ፡ ​ወረ​ሰየ፡ ​ገዳ​መ፡ ​ምን​ባሮ።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ተዓ​ወዩ፡ ​ወት​ግዕ​ር፤ ​እን​ተ፡ <fo:inline>ኢተአምር፡ (!)</fo:inline> ​ሕማ​መ፤ ​እስ​መ፡ ​ብዙ​ኅ፡ ​ውሉ​ዳ፡ ​ለመ​ዓስ​ብ፡ ​እም​እን​ተ፡
                                  ​ባቲ፡ ​እስ​መ፡ ​ሥር​ዓት፡   (fol. 25)   ​ዘት​ካት፡ ​ይመ​ጽእ፡ ​ተስ​ፋ፡ ​ሐዳ​ስ፡ ​እን​ተ፡ ​ይሴ​ፈዋ፡ ​ጽን​ዕት፡ ​ላዕ​ሌሃ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107159LIT4915PhysA#Viper">
               <fo:inline>I-10) Fols 25–27: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the viper</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​፱፡ ​ፍካ​ሬ፡ ​በእ​ንተ፡ ​አር​ዌ፡ ​ምድ​ር፤ ​ዘስ​ሙ፡ ​አከ​ድና፡ ​ይቤ፡ ​ዮሐ​ንስ<fo:inline>[፡]</fo:inline> ​በእ​ንተ፡ ​ፈሪ​ሳዉ​ያን፡ ​ትው​ልደ፡ ​አራ​ዊተ፡ ​ምድ​ር፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ከማ​ሁ፡ ​እሙ​ንቱ፡ ​ቀተ​ሉ፡ ​አበ​ዊሆ​ሙ፡ ​ነቢ​ያተ። ​እግ​ዚእ​ነሂ፡ ​አቡ​ሆሙ፡ ​ወአ​ርዳ​ኢሁ፡ ​ወእ​ፎ፡ ​ይጐ​ይዩ፡ ​እሞ​ት፡ ​ዘይ​መጽ​እ፡ ​አን​በሳ፡ ​ወእ​ምሐ​ይዉ፡
                                  ​ዓለ​ም፡ ​እሙ​ንቱ፡ ​ይመ​ውቱ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107180LIT4915PhysA#Snake">
               <fo:inline>I-11) Fols 27–32: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the snake</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​፲፡ ​ፍካ​ሬ፡ ​በእ​ንተ፡ ​አር​ዌ፡ ​ምድ​ር፤ ​እግ​ዚእ​ነ፡ ​ይቤ፡ ​ኩኑ፡ ​ጠቢ​ባነ፡ ​ከመ፡ ​አር​ዌ፡ ​ምድ​ር፡   (fol. 28)   ​ወየ​ዋሃ​ነ፡ ​ከመ፡ ​ርግ​ብ፡ ​፬።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ከማ​ሁ፡ ​ንሕ​ነኒ፡ ​ንመ​ጡ፡ ​ኵሎ፡ ​ሥጋ​ነ፡ ​ለሕ​ማማ​ት፡ ​ወን​ዕቀ​ብ፡ ​ርእ​ሰነ፡ ​ዘው​እቱ፡
                                  ​ኢን​ክህ​ድ፡ ​ርእ​ሰነ፡ ​ክር​ስቶ​ስሃ፡ ​ከመ፡ ​ቅዱ​ሳን፡ ​ሰማ​ዕት፡ ​እስ​መ፡ ​ተብ​ህለ፡   (fol. 32)   ​ለኵ​ሉ፡ ​ብእ​ሲ፡ ​ርእ​ሰ፡ ​ክር​ስቶ​ስ፡ ​ወር​እሱ፡ ​ለክ​ርስ​ቶስ፡ ​እግ​ዚአ​ብሔ​ር።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107202LIT4915PhysA#Ant">
               <fo:inline>I-12) Fols 32–35: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the ant</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​፲፩፡ ​ፍካ​ሬ፡ ​በእ​ንተ፡ ​ቃሕ​ም፡ ​ዘአ​ልቦ፡ ​ኃይ​ል፡ ​ዘኢ​ይት​ሐከ​ይ፤ 
                                      <fo:inline>ወፊልጎስሰ፡ (!)</fo:inline>
                                   ​ይቤ፡ ፬ ​ጥበ​ቢሁ፡ ​ለቃ​ሕም፡ ​ቀዳ​ሚ፡ ​ሶበ፡ ​የሐ​ውር፡ ​ፆታ፡ ​፩፩ ​ይፀ​ውር፡ ​ኅጠ​ተ፡ ​በአ​ፉሁ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​አን​ተሂ፡ ​እን​ስሳ፡ ​ዘው​እቱ፡ ​ተመ​ሲሎ​ቶሙ፡ ​በተ​ቀን​ዮ፡ ​ለከ​ርሥ፤
                                  ​ወን​ሣእ፡ ​ስር​ናየ፡ ​ዘታ​ነብ​ር፡ ​ውስ​ተ፡ ​መዝ​ገብ፡ ​አዲ፡ ​አስ​ተማ​ሰለ፡ ​ሲሳ​የ፡ ​እን​ስሳ፡ ​ዘመ​ደል​ዋን፡ ​ትም​ህር​ተ፡ ​ወስ​ርና​የ፡ ​በር​ቱዕ፡ ​አሚ​ን፡ ​በክ​ርስ​ቶስ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107226LIT4915PhysA#SirenCentaur">
               <fo:inline>I-13) Fols 36–38: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the sirens and centaurs</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​፲፪፡ ​ፍካ​ሬ፡ ​በእ​ንተ፡ ​አን​ስሬ​ኒስ፡ ​ወአ​ንቅ​ጣው​ሮስ፤ ​እም​ታሕ​ተ፡ ​ኅን​ብር​ቶሙ፡ ​ወእ​ስከ፡ ​እግ​ሮሙ፡ ​ዘዖ​ፍ፤ ​ወእ​ምገ​ጾሙ፡ ​እስ​ከ፡ ​ኅን​ብር​ቶሙ፡ ​አም​ሳሊ​ሆሙ፡
                                  ​ዘፈ​ረስ።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​እም​እመ​ናን፡ ​ይመ​ስሉ፡ ​ወይ​ትቃ​ወሙ፡ ​ኃይ​ለ፡ ​ምሥ​ጢር፡ ​ወጣ​ዕመ፡ ​ቃሎ​ሙ፡ ​የዋ​ሃነ፡ ​ያስ​ሕቱ፡ ​በከ​መ፡ ​ጽሑ​ፍ፡ ​ነገ​ር፡ ​እኩ​ይ፡ ​ሠና​የ፡ ​ግዕ​ዘ፡ ​ያማ​ስን።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107245LIT4915PhysA#Hedgehog">
               <fo:inline>I-14) Fols 39–40: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the hedgehog</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፲ወ​፫፡ ​በእ​ንተ፡ <fo:inline>ቀንፋዝ፡ (!)</fo:inline> ​ዘበ​አም​ሳለ፡ ​ሰክ​ሮ፡ ​ውእ​ቱ። ​ይቤ፡  ​ፊሳ​ልጎ​ስ፡  ​ቀን​ፋዝ፡ ​ውስ​ተ፡ ​ዓፀ​ደ፡ ​ወይ​ን፡ ​ይወ​ፍር፡ ​ኀበ፡ ​ወድ​ቀ፡
                                  ​ኅን​ባባ​ተ፡ ​ወይ​ን።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ወን​ሣእ፡ ​ፍሬ​ያተ፡ ​ምሥ​ጢራ​ት፡ ​ተድ​ላ፡   (fol. 40)   ​ቤተ፡ ​መን​ግሥ​ት፤ ​ቅን​ፍዝ​ሰ፡
                                  ​ተኀድ ገ ፡ ​ዕራ​ቆ፡ ​አን​ተሰ፡ ​ከማ​ሁ፡ ​በአ​ምሳ​ለ፡ ​ውሉ​ዱ፡ ​ትሴ​ስዮ​ሙ፡ ​ለሕ​ዋሳ​ቲከ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107274LIT4915PhysA#Fox">
               <fo:inline>I-15) Fols 40–42: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the fox</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፲ወ​፬፡ ​በእ​ንተ፡
                                      <fo:inline>ቍቍንጽል፡ (!)</fo:inline>
                                   ​ውእ​ቱሰ፡ ​አር​ዌ፡ ​ጕሕ​ላዊ፡ ​እመ፡ ​ርኅ​በ፡ ​ወኢ​ረከ​በ፡ ​ዘይ​በል​ዕ፡ ​የኃ​ሥሥ፡ ​ምድ​ረ፡ ​ምው​ቀ፡ ​ወእ​መ፡ ​አኮ፡ ​ቤተ፡ ​ኃሠ​ር፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ሄሮ​ድስ​ኒ፡ ​ተመ​ሰለ፡ ​በቍ​ንጽ​ል። ​ወጽ​ሑፍ፡ ​ስም​ዕ፡ ​እም​ኀበ፡ ​መድ​ኃኒ​ነ፡ ​ዘተ​ብህ​ለ፡ ​ቈና​ጽል​ኒ፡ ​ግበ​ብ፡ ​ቦሙ። ​ሰሎ​ሞን​ኒ፡
                                  ​በመ​ኃል​ዩ፡   (fol. 42)   ​ይቤ፡ ​አሥ​ግሩ፡ ​ለነ፡ ​ቈና​ጽለ፡ ​ንኡ​ሳነ፡ ​እለ፡ ​ያማ​ስኑ፡ ​ዓፀ​ደ፡ ​ወይ​ንነ። ​ዳዊ​ትኒ፡ ​ይቤ፡  ​ክፍ​ለ፡  ​ቈና​ጽል።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107299LIT4915PhysA#Panther">
               <fo:inline>I-16) Fols 42–45: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the panther</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፲፭፡ ​በእ​ንተ፡ ​ጻሕ​ው፡ ​ውእ​ቱሰ፡ ​አር​ዌ፡ ​ንኡ​ስ። ​ይቤ፡ ​ነቢ​ይ፡ ​ኮን​ኩ፡ ​ከመ፡ ​ፃሕ​ው፡ ​ለኤ​ፍሬ​ም።   ​ፊሰ​ሊጎ​ስ፡  ​ይቤ፡ ​ከመ​ዝ፡ ​ፍጥ​ረቱ፡
                                  ​ለጻ​ሕው፡ ​እም​ኵሉ፡ ​አራ​ዊት፡ ​ውእ​ቱ፡ ​ይት​ፋቀ​ር፤
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ዓዲ፡ ​ቀታ​ሊሁ፡ ​ለከ​ይሲ፡ ​ዘው​ስተ፡ ​ሰማ​ይ፡ ​ውእ​ቱ፡ ​ወኢ​ምን​ትኒ፡   (fol. 45)   ​ጽሩ​ዕ፡ ​ኢተ​ጽሕ​ፈ፡ ​ዘተ​ጽሕ​ፈ፡ ​በእ​ንተ፡ ​አራ​ዊት፡ ​ወበ​እን​ተ፡ ​ወአ​ዕዋ​ፍ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107322LIT4915PhysA#Whale">
               <fo:inline>I-17) Fols 45–47: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the whale</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፲፮፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ጰዶ​ክሎ​ኒ፡ ​ዘው​እቱ፡ ​ርእ​ሰ፡ ​አራ​ዊተ፡ ​ምድ​ር፡ ​ስቁ​ር፡ ​ፍጥ​ረቱ። ​ሰሎ​ሞን፡ ​ይቤ፡ ​በም​ሳሌ፡ ​እን​ዘ፡ ​ይማ​ህር፡ ​ወያ​ርኢ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​አን​ተኒ፡ ​እመ<fo:inline>[፡]</fo:inline> ​ሰቀ​ልከ፡ ​ዲቤ​ከ፡ ​ርእ​ሶ፤ ​ይት​ፌሣ​ሕ፡ ​ዲያ​ብሎ​ስ፡ ​ወያ​ሠጥ​መከ፡ ​ምስ​ሌከ፡ ​ውስ​ተ፡ ​ቀላ​የ፡ ​ገሃ​ነም፡ ​ሠና​የ፡ ​ይቤ፡
                                   ​ፊሳ​ልጎ​ስ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107346LIT4915PhysA#Partridge">
               <fo:inline>I-18) Fols 48–49: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the partridge</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፲፯፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ቆቃ​ህ። ​ኤር​ምያ​ስ፡ ​ይቤ፡  ​ቆቃ​ሕ፡ ​ነዊ​ህ፡ ​ነቃ​ዊ፡ ​ያስ​ተጋ​ብእ፡ ​ሎቱ፡ ​ውሉ​ደ፡ ​ዘኢ​ውሉ​ደ፡ ​ይገ​ብር፡ ​ብዕ​ለ፡ ​ብዙ​ኃ፡ ​በፃ​ዕር፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ወው​እቶ​ሙ፡ ​ምእ​መና​ን፡ ​ወቅ​ዱሳ​ን፡ ​ሐዋ​ርያ​ት፡ ​የኀ​ድግ​ዎ፡ ​ለዲ​ያብ​ሎስ፡ ​አብ​ድ፡ ​ወየ​ሐው​ሩ፡ ​ኀበ፡  ​ክር​ስቶ​ስ፡  ​ሠና​የ። ​ይቤ፡
                                   ​ፊሳ​ልጎ​ስ፡  ​በእ​ንተ፡ ​ቆቃ​ሕ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107370LIT4915PhysA#Vulture">
               <fo:inline>I-19) Fols 49–52: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the vulture</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፲፰፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ጊጳ​ስ፡ ​ዘው​እቱ፡ ​አው​ስት። ​ይቤ፡ ​መድ​ኃኒ​ነ፡ ​በወ​ንጌ​ል፡ ​አሌ፡ ​ሎን፡   (fol. 50)   ​ለጽ​ኑሳ​ት።  ​ፊሳ​ልጎ​ስ፡ 
                                  ​ይቤ፡ ​ጊጳ​ስ፡ ​ትነ​ብር፡ ​ውስ​ተ፡ ​አድ​ባር፡ ​ነዋ​ኃት፡ ​ወየ​ዓይ​ል፡ ​ውስ​ተ፡ ​ዓበ​ያት፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ወዘ​እን​በለ፡ ​ዘር​እ፡ ​በሥ​ጋ፡ ​እም​ድን​ግል፡ ​ተወ​ልደ፡ ​እን​በለ፡ ​ሕማ​ም። ​ወበ​ከመ፡ ​አው​ጣኪ​ዮስ፡ ​እን​ተ፡ ​ውስ​ጡ፡ ​ካል​እ፡ ​ኃይ​ል፡ ​ቦቱ።
                                  ​እግ​ዚእ​ነሂ፡ ​ረቂ​ቅ፡  ​መለ​ኮት፡  ​ኅዱ ር ፡ ​በሥ​ጋሁ። ​ሠና​የ፡ ​ይቤ፡ ​ዘይ​ቤ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107400LIT4915PhysA#Ant-lion">
               <fo:inline>I-20) Fols 52–54: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the ant-lion</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፲፱፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​መር​ሜር​ቆሊ​ዎስ፡ ​ዘው​እቱ፡   (fol. 53)   ​ቃሕ​ም፡ ​ኤል​ፋዝ፡ ​ቴሜ​ናዊ፡ ​ንጉ​ሥ፡ ​ይቤ፡ ​ሰኳ​ዕት፡ ​ኃል​ቀ፡ ​ኃጢ​አ፡ ​ዘይ​በል​ዕ፡
                                   ​ፊሳ​ልጎ​ስ፡  ​ይቤ፡ ​ገጹ፡ ​ዘአ​ንበ​ሳ፡ ​ሐቌ​ሁ፡ ​ዘቃ​ሕም፡ ​አቡ​ሁ፡ ​በላ​ዔ፡ ​ሥጋ፡ ​ውእ​ቱ።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ከማ​ሁ፡   (fol. 54)   ​ኑፉ​ቀ፡ ​ልብ፡ ​ዘክ​ልኤ፡ ​ፍኖ​ቱ፡ ​ኢመ​ፍት​ው፡ ​ይን​በር፡ ​ውስ​ተ፡ ​ጸሎ​ት፡ ​እን​ዘ፡ ​ይና​ፍቅ፡ ​ዘአ​ልቦ፡ ​አሚ​ን፤ ​በከ​መ፡ ​ተብ​ህለ፡
                                  ​እመ​ኒ፡ ​እወ፡ ​እወ፡ ​ወእ​መኒ፡ ​አል​ቦ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107425LIT4915PhysA#Weasel">
               <fo:inline>I-21) Fols 54–55: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the weasel</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፳፡ ​ነገ​ር፡ ​በእ​ንተ፡  እ ​ጋሌ​ን፡ ​ዘስ​ሙ፡ ​ኅር​ስቲ​ዮስ፡ ​ይቤ፡ ​በሕ​ግ፡ ​ኢት​ብላ​ዕ፡ ​ጋሌ​ነ፡ ​ከመ​ዝ፡ ​ፍጥ​ረቱ፡ ​አን​ስቲ​ያዊ​ት፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ወያ​ወፅ​ኡ፡ ​ነገ​ረ፡ <fo:inline>[እ]</fo:inline>​ምዕ​ዘኒ​ሆሙ<fo:inline>[፡]</fo:inline>
                                  ​ወኢ​ይወ​ድይ​ዎ፡ ​ውስ​ተ፡ ​ልቦ​ሙ፡ ​በከ​መ፡ ​አም​ሳሊ​ሃ፡ ​ለጋ​ሌን፡ ​ኢት​ብላ​ዕ፡ ​ብሂ​ል፡ ​ኢት​ኅበ​ር፡ ​ግዕ​ዘ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107451LIT4915PhysA#Unicorn">
               <fo:inline>I-22) Fols 55–57: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the unicorn</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፳፩፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​አር​ዌ፡ ​ዘስ​ሙ፡ ​መኖ​ቅሪ​ጥስ፡   (fol. 56)   ​ዘው​እቱ፡ ​ርኢ​ም፡ ​ዘ፩ ​ቀር​ኑ፡ ​ይቤ፡ ​በመ​ዝሙ​ር፡ ​ወይ​ትሌ​ዓል፡ ​ቀር​ንየ፡ ​ከመ፡ ​ዘ፩፡ ​ቀር​ኑ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ኢክ​ህሉ፡ ​ኃይ​ላት፡ ​እለ፡ ​ውስ​ተ፡
                                  ​አር​ያም፡ ​ቀሪ​ቦቶ፡ ​ወለ​ኪፎ​ቶ፡ ​አጽ​ለለ፡ ​ውስ​ተ፡ ​ሕጽ​ነ፡ ​ድን​ግል፡  ​ማር​ያም፡  ​ቃል፡ ​ከዊ​ኖ፡ ​ሥጋ፡ ​ወኃ​ደረ፡ ​ምስ​ሌነ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107474LIT4915PhysA#Beaver">
               <fo:inline>I-23) Fols 58–59: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the beaver</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፳፪። ​ነገ​ር፡ ​በእ​ንተ፡ ​አር​ዌ፡ ​ዘስ​ሙ፡ ​ቀር​ጣር​ዮስ፡ ​የዋ​ህ፡ ​በህ​ቁ፡ ​ወጽ​ምው። ​በእ​ስኪ​ቱ፡ ​ይበ​ቍል፡ ​ጸጕ​ር፡ ​ነዊ​ህ፡ ​ዘይ​ከው​ን፡ ​ፈው​ሰ።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ዘው​እቱ፡ ​ፍት​ወተ፡ ​ሥጋ፡ ​ዝሙ​ት፡ ​ወስ​ስዕ​ት፡ ​ወት​ዕቢ​ት፡ ​ወዘ​ይመ​ስሎ፡ ​ወየ​ኀድ​ግ፡ ​ለነ​ዓዊ​ከ፡
                                  ​ዲያ​ብሎ​ስ፡ ​ከመ፡ ​ትበ​ል፡ ​ነፍ​ስነ​ሰ፡ ​እም​ሠጠ​ት፡ ​ከመ፡ ​ዖፍ፡ ​እመ​ስገ​ርት፡ ​ነዓ​ዊት።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107492LIT4915PhysA#Hyena">
               <fo:inline>I-24) Fols 59–60: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the hyena</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፳፫፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ዝዕ​ብ፡ ​ይቤ፡ ​በው​ስተ፡ ​ዝዕ​ብ፡ ​ቦ፡ ​አመ፡ ​ይከ​ውን፡ ​ተባ​ዕተ፡ ​ወቦ፡ ​አመ፡ ​ይከ​ውን፡ ​አን​ስተ፡ ​ወው​እቱ፡ ​ርኩ​ስ፡ ​እም​ኵሉ፡
                                  ​አራ  (fol. 60)  ​ዊት፡ ​በተ​ዋል​ጦ፡ ​ፍጥ​ረቱ።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​አን​ተሂ፡ ​ኢት​ኩን፡ ​ከመ፡ ​ዝዕ​ብ፡ ​ወጽ​ናዕ፡ ​በ፩​ሕግ። ​ጳው​ሎስ​ኒ፡ ​ይቤ፡ ​አን​ስት​ኒ፡ ​ኀደ​ጋ፡ ​ፍጥ​ረቶ​ን፡ ​ወተ​መሰ​ላ፡ ​በዘ​ኢኮ​ነ፡ ​ፍጥ​ረቶ​ን፡ ​ሠና​የ፡ ​ይቤ፡ ​ፊሳ​ልጐ​ስ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107512LIT4915PhysA#Hydrus">
               <fo:inline>I-25) Fols 60–62: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the hydrus</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፳፬፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ኢን​ድር​ዳኖ​ስ፡ ​ሀሎ፡ ​አር​ዌ፡ ​ንዑ​ስ፡ ​ዘይ​መስ​ል፡ ​ከል​በ፡ ​ፀሩ፡ ​ውእ​ቱ፡ ​ለሐ​ርገ​ጽ፡ ​ሶበ፡ ​ይነ​ውም፡ ​ሐር​ገፅ፡ ​አፉ​ሁ፡ ​ብቅ​ው፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ወበ​ከመ፡ ​ፀዓ​ቱ፡ ​ለአ​ርዌ፡ ​እም​ከር​ሠ፡ ​ሐር​ገፅ፡ ​እግ​ዚእ​ነሂ፡ ​ተን​ሥአ፡ ​እመ​ቃብ​ር፡ ​በሣ​ልስ​ት፡ ​ዕለ​ት፡ ​ሕያ​ወ፡ ​እን​በለ፡ ​ሙስ​ና።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107531LIT4915PhysA#Ichneumon">
               <fo:inline>I-26) Fols 62–64: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the ichneumon</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፳፭፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​አር​ዌ፡ ​ዘስ​ሙ፡ ​አኪ​ሞን፡ ​ፀሩ፡ ​ለከ​ይሲ፡ ​ውእ​ቱ። ​ይቤ፡  ​ፊሳ​ልጎ​ስ፡  ​ለእ​መ፡ ​ርእ​የ፡ ​ከይ​ሴ፡ ​ይት​ቀባ​ዕ፡ ​ፅቡ​ረ፤
                                  ​ወበ​ዘነ​ቡ፡ ​አን​ፎ፡ ​የዓ​ቅብ፡ ​ከመ፡ ​ኢይ​ንስ​ኮ፡ ​አር​ዌ፡ ​ምድ​ር።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ወኢ​ያእ​ምሮ፡ ​ክርስ  (fol. 64)  ​ቶስ​ኒ፡ ​ሶበ፡ ​ኢኮ​ነ፡ ​በሥ​ጋ፡ ​በእ​ፎ፡ ​እም​ተኃ​ጕሎ፡ ​ለዲ​ያብ​ሎስ፡ ​እን​ዘ፡ ​ኢይ​ሬኢ፡ ​ከመ፡ ​አም​ላክ፡
                                  ​እም​ይሴ<fo:inline>[አ]</fo:inline>​ሎ፡ ​አን​ተሰ፡ ​ኵሉ፡ ​በእ​ዴከ፡ ​አፍ​ርሃ​ኒ፡ ​ለቀ​ሪብ፡ ​እን​ከ፡ ​አላ፡ ​አት​ሐተ፡ ​ርእ​ሶ፡ ​ወአ​ድኀ​ነ፡ ​ኵሎ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107557LIT4915PhysA#Crow">
               <fo:inline>I-27) Fols 64–66: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the crow</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፳፮፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ቋዕ፡ ​ገዳ​መ፡ ​ባሕ​ቲት​የ፤ ​ገዳ​መ፡ ​ይቤ​ላ፡ ​ለኢ​የሩ​ሳሌ​ም፡  ​ፊሳ​ልጎ​ስ፡  ​ይቤ፡ ​ሶበ፡ ​ሞተ፡ ​ምታ፡ ​ቋዕ፡ ​ኢት​ነሥ​እ፡
                                  ​ካል​አ፡ ​ምተ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ወእ​መ፡   (fol. 66)   ​ወጽ​አ፡ ​ኃይ​ለ፡ ​ቃል፡ ​እም​ልብ​ነ፡ ​ያረ​ስሐ​ነ፡ ​መስ​ተቃ​ትል፡ ​እስ​መ፡ ​ይቤ፡ ​ኢይ​ነው​ም፡
                                  ​ወኢ​ይዴ​ቅስ፡ ​ዘየ​ዓቅ​ቦ፡ ​ለእ​ስራ​ኤል። ​እም​ይእ​ዜሰ፡ ​ኢይ​በው​ኡ፡ ​ፈያ​ት፡ ​ውስ​ተ፡ ​ሐዲ​ስ፡ ​ሀገ​ር፡ ​ዘው​እቱ፡ ​ልብ፡ ​ሠና​የ፡ ​ይቤ፡  ​ፊሳ​ልጎ​ስ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107583LIT4915PhysA#Turtledove">
               <fo:inline>I-28) Fols 66–68: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the turtledove</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፳፯፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ማዕ​ነቅ፡ ​ይቤ፡ ​በማ​ኃል​የ፡ ​መኃ​ልይ። ​ቃለ፡ ​ማዕ​ነቅ፡ ​ተሰ​ምዓ፡ ​በም​ድር​ነ፡  ​ፊሳ​ልጎ​ስ፡  ​ይቤ፡ ​ማዕ​ነቅ፡ ​ግሕ​ሥት፡
                                  ​ጥቀ፡ ው  (fol. 67)  ​ስተ፡ ​ገዳ​ም፡ ​ወኢ​ትሄ​ሉ፡ ​ምስ​ለ፡ ​ብዙ​ኃን።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ማዕ​ነቅ፡ ​ዖፍ፡ ​ዘስ​ሙ፡ ​ከል​ዳን፡ ​ወኵ​ሉ፡ ​አዕ​ዋፍ፡ ​ያፈ​ቅሩ፡ ​ጊዜ፡ ​ማዕ​ረር። ​ውእ​ቱሰ፡ ​ኢያ​ፈቅ​ር፡ ​ጊዜ፡ ​ማዕ​ረር። ​ሠና​የ፡ ​ይቤ፡
                                  ​ዘይ​ቤ፡ ​በእ​ንተ፡ ​ማዕ​ነቅ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107606LIT4915PhysA#Frog">
               <fo:inline>I-29) Fols 68–70: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the frog</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፳፰፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ቈር​ነነ​ዓት፡ ​ምድ​ራዊ፡  ​ፊሳ​ልጎ​ስ፡  ​ይቤ፡ ​ከመ፡ ​ውእ​ቱ፡ ​ይት​ዔገ​ሥ፡ ​ላህ​በ፡ ​ወሙ​ቀተ፡ ​ፀሓ​ይ።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ከመ፡ ​ይሣ​ወሩ፡ ​እም​ላህ​በ፡ ​ፀሐ​ይ፡ ​እለ፡ ​ውስ​ተ፡ ​ማይ፡ ​እሙ​ንቱ፡ ​እለ፡ ​እኁ​ዛን፡ ​በፍ​ቅረ፡ ​ተድ​ላ፡ ​ዓለ​ም፡ ​እመ<fo:inline>[፡]</fo:inline>
                                   (fol. 70)   ​ረከ​ቦሙ፡ ​ንስ​ቲት፡ ​ይት​ዔወ​ሩ፡ ​ወይ​ገብ​ኡ፡ ​ዳግ​መ፡ ​ውስ​ተ፡ ​ንዝ​ኅላ​ል፡ ​ሠና​የ፡ ​ይቤ፡ <fo:inline>ፊልሳጎስ፤ (!)</fo:inline>
                  </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107635LIT4915PhysA#Deer">
               <fo:inline>I-30) Fols 70–72: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the deer</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፳፱፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ኃየ​ል። ​ዳዊ​ት፡ ​ይቤ፡ ​ከመ፡ ​ያፈ​ቅር፡ ​ኃየ​ል፡ ​ኀበ፡ ​አን​ቅዕ​ተ፡ ​ማያ​ት፡ ​ከማ​ሁ፡ ​ታፈ​ቅር፡ ​ነፍ​ስየ፡ ​ኀበ፡ ​እግ​ዚአ​ብሔ​ር።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​እግ​ዚእ​ነ፡ ​ከዓ​ወ፡ ​እም​ገቦ​ሁ፡ ​ማየ፡ ​ወደ​መ፡ ​ወቀ​ተሎ፡ ​ለከ​ይሲ፡ ​ለነ​ሰ፡ ​ቤዛ​ነ፡ ​ዳግ​ም፡ ​ልደ​ቱ። ​ወመ​ሐረ​ነ፡ ​ኵሎ፡ ​ቀት​ለ፡ ​ኅቡ​ዓ፡ ​ምስ​ለ፡ ​ዲያ​ብሎ​ስ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107653LIT4915PhysA#Salamander">
               <fo:inline>I-31) Fols 73–74: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the salamander</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፴፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​አር​ዌ፡ ​ዘስ​ሙ፡ ​እል​መን​ደር። ​ይቤ፡ 
                                      <fo:inline>ፊልሳጎስ፡ (!)</fo:inline>
                                   ​በእ​ንቲ​አሁ፡ ​ለእ​መ፡ ​ቦአ፡ ​ውስ​ተ፡ ​ዕቶ​ነ፡ ​እሳ​ት፡ ​ይጠ​ፍዕ፡ ​እመ​ሂ፡ ​ውስ​ተ፡ ​ብለ​ኔ፡ ​ይጠ​ፍዕ።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​እፎ፡ ​ሀለ​ዉ፡ ​ሰብ​እ፡ ​እለ፡ ​ኢየ​አም​ኑ፡ ​እስ​ከ፡ ​ይእ​ዜ፡ ​በእ<fo:inline>[ን]</fo:inline>​ተ፡ ፫ ​ደቂ​ቅ፡
                                  ​ተወ​ድዮ​ሙ፡ ​ውስ​ተ፡ ​እሳ​ት፡ ​አቍ​ረር​ዎ፡ ​በኃ​ይለ፡ ​ልቦ​ሙ፡ ​አሜ​ን። ​ጽሑ​ፍ፡   (fol. 74)   ​ዘይ​ብል፡ ​እሳ​ትሂ፡ ​በላ​ህቡ፡ ​ኢያ​ውዕ​የከ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107683LIT4915PhysA#Diamond1">
               <fo:inline>I-32) Fols 74–77: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the diamond</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፴፩፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ዕን​ቍ፡ ​አድ​ማስ።  
                                      <fo:inline>ፊልሳጎስ፡ (!)</fo:inline>
                                   ​ይቤ፡ ​እስ​መ፡ ​በደ​ወ፡ ​ጽባ​ሕ፡ ​ይት​ረከ​ብ፡ ​አድ​ማስ፡ ​በመ​ዓል​ት፡ ​ኢይ​ትረ​ከብ፡ ​ዘእ​ንበ​ለ፡ ​በሌ​ሊት፡ ​ወስ​ሙ፡ ​አድ​ማስ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​እም​ኀበ፡ ​ፈያ​ት፡ ​ወሐ​ሳው​ያን፡ ​አኃ​ው፡ ​በም​ንዳ​ቤ። ​ወበ​ከመ፡ ​አድ​ማስ፡ ​ኢተ​መው​ዓ፡ ​እም​እለ፡ ​ይት​ቃረ​ንዎ። ​ከማ​ሁ፡ ​ኵሎ​ሙ፡ ​ማኅ​በረ፡
                                  ​ነቢ​ያት፡ ​ወኵ​ሎሙ፡   (fol. 77)   ​ቅዱ​ሳን፡ ​ይሌ​ብዉ፡ ​ዘን​ተ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107708LIT4915PhysA#Swallow">
               <fo:inline>I-33) Fols 77–78: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the swallow</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፴፪፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ዖፍ፡ ​ዘስ​ሙ፡ ​ካሊ​ዲን፡ ​ዝን​ቱ፡ ​አም​ሳሊ​ሆሙ፡ ​ለአ​በው፡ ​ዘአ​ስቄ​ጥስ፡ ​ፍጹ​ማን፡ ​ግብ​ሮሙ፡ ​ወይ​ነው​ም፡ ​እስ​ከ፡ ​የኃ​ልፍ፡ ​ክረ​ምት።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                ​ወተ​ቀን​ዩ፡ ​ለግ​ልፎ፡ ​ወለ​ፍት​ወት፡ ​ርኩ​ስ፡ ​በእ​ንቲ​አሆ​ሙ፡ ​ሠና​የ፡ ​ይቤ፡ 
                                      <fo:inline>ፋሶሌጎስ፡ (!)</fo:inline>
                                  
                                  ​ዖፍ​ሰ፡ ​ከሊ​ዲን፡ ​ይሄ​ሉ፡ ​ጽም​ወ፡ ​ውስ​ተ፡ ፩ ​መካ​ን፡ ​እስ​ከ፡ ​የኃ​ልፍ፡ ​ክረ​ምት።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107732LIT4915PhysA#Epidexion">
               <fo:inline>I-34) Fols 79–82: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the epidexion</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፴፫፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ዕፅ፡ ​ዘስ​ሙ፡ ​ኤጴ​ዲቅ​ስዮ፡ ​ዝብ​ሂል፡ ​የማ​ናዊ፡ ​ወሀ​ሎ፡ ​ብሔ​ረ፡ ​ህን​ዳኬ፡ ​ሠና​ይ፤ ​ዕፁ፡ ​ወፍ​ሬሁ፡ ​ጥዑ​ም፡ ​ወመ​ዓር​ዒር፡ ​ጥቀ።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ወይ​ብል፡ ​ሊተ​ሰ፡ ​ኢይ​ደል​ወኒ፡ ​ኢይ​ትሜ​ካሕ፡
                                  ​ዘእ​ንበ​ለ፡ ​በመ​ስቀ​ሉ፡ ​ለክ​ርስ​ቶስ፡ ​እስ​መ፡ ​ኀቤ​የ፡ ​ምው​ት፡ ​በኀ​በ፡ ​ዓለ​ም፡ ​ሠና​የ፡ ​ይቤ፡  
                                      <fo:inline>ፊልሳጎስ፡ (!)</fo:inline>
                                  
                                  ​በእ​ንተ<fo:inline>[፡]</fo:inline> ​ዕፅ፡ ​ኤጲ​ዴቅ​ስዮ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107759LIT4915PhysA#Dove">
               <fo:inline>I-35) Fols 82–89: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the dove</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፴፬፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ርግ​ብ። ​ዮሐ​ንስ፡ ​ይቤ፡ ​ርኢ​ኩ፡ ​ሰማ​የ፡ ​ርኅ​ወ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡   (fol. 83)   ​እን​ዘ፡ ​ይወ​ርድ፡ ​ከመ፡ ​ርግ​ብ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​እም​ከመ፡ ​ሀለ​ዋ፡ ​በዕ​ረና፡ ​ልብ፡ ​ጸል​ዮ፡ ​ኀበ፡ ​አም​ላኮ​ን፡ ​እን​ዘ፡ ​ኢያ​ጸር​ዑ፡
                                  ​ኢይ​ክሉ፡ ​መሢ​ጠ፡ ​ወኵ​ሎሙ፡ ​ክር​ስቲ​ያን፡ ​በዝ​ንቱ፡ ​አም​ሳል፡ ​ይኩ​ኑ፡ ​ወኢ​ይኅ​ድጉ፡ ​ማኅ​በረ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107779LIT4915PhysA#Antelope">
               <fo:inline>I-36) Fols 89–91: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the antelope</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፴፭፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​አር​ዌ፡ ​ዘስ​ሙ፡ ​እን​ድራ​ጶስ። ​ወው​እቱ፡ ​አር​ዌ፡ ​መሪ​ር፡ ​ጥቀ። ​ወኢ​ይክ​ል፡ ​ነዓ​ዊ፡ ​ቀሪ​ቦቶ፡ ​ወቦ​ቱ፡ ​አቅ​ርን​ት፡ ​ነዊ​ኃን፡
                                      <fo:inline>ወይወይዌሥር፡ (!)</fo:inline>
                                   ​ቦቱ፡ ​ዕፀ​ወ፡ ​ነዊ​ኃነ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ኢት​ትአ​ኃዝ፡ ​በአ​ዕፁ​ቀ፡ ​ዝማ​ት፡ ​ወት​ዝኅ​ርት፡ ​ወአ​ፍቅ​ሮ፡ ​ንዋ​ይ፡ ​ወኵ​ሉ፡ ​ፍት​ወታ​ት፡ ​ዘይ​ወስ​ድ፡ ​ኀበ፡ ​ኵነ​ኔ፡ ​ወኢ​ይረ​ክብ፡ ​ጸላ​ዒ፡ ​ዲያ​ብሎ​ስ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107802LIT4915PhysA#Fire-stones">
               <fo:inline>I-37) Fols 91–92: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the fire-stones</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፴፮፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ዕብ​ን፡ ​ዘስ​ሙ፡ ​ጸር​ጸሮ። ​ወእ​ምኔ​ሁ፡ ​ይወ​ጽእ፡ ​እሳ​ት፡   (fol. 92)   ​ወኵ​ሉ፡ ​ዘለ​ከፎ፡ ​ይወ​ዒ፡ ​ወ፩ ​ፍጥ​ረቱ፡ ​ለተ​ባዕ​ት፡ ​ወአ​ንስ​ት፡
                                  ​ወር​ኁቃ​ን፡ ​በበ​ይና​ቲሆ​ሙ።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ሶም​ሶን​ሂ፡ ​ተሞ​ዓ፡ ​በዝ፡ ​እስ​ከ፡ ​ላጸ​የት፡ ​ሥዕ​ርቶ፡ ​ወደ​ክመ፡ ​ጽን​ዑ፡ ​ወብ​ዙኃ​ን፡ ​ስሕ​ቱ፡ ​በአ​ንስ​ት፡ ​በከ​መ፡ ​ጽሑ​ፍ፡ ​በእ​ንተ፡ ​ስነ፡ ​አን​ስት።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107823LIT4915PhysA#Magnet">
               <fo:inline>I-38) Fols 93–94: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the magnet</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፴፯፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ዕብ​ን፡ ​ዘስ​ሙ፡ ​መጐ​ንጢ​ስ፡ ​ተብ​ህለ፡ ​ከመ፡ ​ይሰ​ቅሎ፡ ​ለሐ​ፃን፡ ​እም​ከመ፡ ​ለከ​ፎ፡ ​ውእ​ቱ፡ ​ዕብ​ን፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ወአ​ጽንዓ<fo:inline>[፡]</fo:inline> ​ዲበ፡ ​ማይ፡ ​በእ​ንቲ​አነ። ​ወው​እቱ፡ ​ተሰ​ቅለ፡ ​ከመ፡ ​ይቤ​ዝወ​ነ፡ ​ፈድ​ፋደ፡ ​ይደ​ልዎ፡ ​ሠና​የ፡   (fol. 94)  
                                  ​ይቤ፡  ​ፊሳ​ልጎ​ስ፡  ​በእ​ንተ፡ ​መጐ​ንጢ​ስ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107849LIT4915PhysA#Saw-fish">
               <fo:inline>I-39) Fols 94–95: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the saw-fish</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፴፰<fo:inline>[፡]</fo:inline> ​ነገ​ር፡ ​በእ​ንተ፡ ​አር​ዌ፡ ​ቂጦ​ስ፤ ​ዓዲ፡ ​ስሙ፡ ​ጵር​ያኖ​ስ፡ ​ወቦ​ቱ፡ ​አክ​ናፍ፡ ​ዓበ​ይት፡ ​ወእ​መ፡ ​ርእ​የ፡ ​ውእ​ቱ፡
                                  ​አሕ​ማረ፡ ​ዓበ​ይተ፡ ​የሐ​ውር፡ ​ምስ​ሌሆ​ሙ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​አር​ዌሰ፡ ​ይት​ቀሐ​ው፡ ​ሀለ​ዉ፡ ​እለ፡ ​ወጠ​ኑ፡ ​ግብ​ረ፡ ​ሠና​የ፡ ​ወገ​ድለ፡ ​ትሩ​ፈ፡ ​ወገ​ብኡ፡ ​ድኅ​ሪተ፡ ​እን​በለ፡ ​ይብ​ጽሑ፡ ​ኀበ፡ ​መር​ሶ፡ ​መድ​ኀኒ​ት፡
                                  ​ሠና​የ፡ ​ይቤ፡  ​ፊሳ​ልጎ​ስ፡ <fo:inline>[​በእ​ንተ፡]</fo:inline> ​ጵር​ያኖ​ስ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107876LIT4915PhysA#ThreeChildren">
               <fo:inline>I-40) Fol. 96: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the three children</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፴፱። ​ነገ​ር፡ ​በእ​ንተ፡ ​ጽኑ​ዓ፡ ​፫፡ ​ደቂ​ቅ፡ ​ወዳ​ንኤ​ል፡ ​ድኅ​ረ፡ ​ተወ​ድዩ፡ ​ውስ​ተ፡ ​ዕቶ​ን፡ ​ወተ​ገድ​ፉ፡ ​ለአ​ናብ​ስት፡ ​ድኅ​ኑ፤ ​እሞ​ት፤ ​እን​ዘ፡ ​ይሴ​ብሑ፡
                                  ​ለአ​ምላ​ከ፡ ​ዘበ​አማ​ን፤
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​እመ​ሰ፡ ​ድኅ​ኑ፡ ​እሉ፡ ​አኮ፡ ​መን​ክር፡ ​እም​ላዕ​ለ፡ ​ቅዱ​ሳን። ​እስ​መ፡ ​አን​ሥኡ፡ ​ሙታ​ነ፡ ​ወአ​ፍለ​ሱ፡ ​አድ​ባረ፡ ​እን​ዘ፡ ​እግ​ዚእ፡ ​ይረ​ድኦ​ሙ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107894LIT4915PhysA#Ibis">
               <fo:inline>I-41) Fols 96–98: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the ibis</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፵፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​አቢ​ሶር፡ ​ርኩ​ስት፡ ​ውስ​ተ፡ ​ሕግ፡   (fol. 97)   ​በከ​መ፡ ​ጽሑ​ፍ፡ ​ኢት​ክል፡ ​ፀቢ​ተ፡ ​ውስ​ተ፡ ​ዕመ​ቀ፡ ​ባሕ​ር፡ ​ለመ​ሢጠ፡ ​ዓሣ​ት፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ዮና​ስኒ፡ ​እም​ከር​ሠ፡ ​አን​በሪ። ​ወጤ​ቅላ፡ ​ተው​ህበ​ት፡ ​ለአ​ንበ​ሳ፡ ​ወለ​ድብ፡ ​ወድ​ኅነ​ት፡ ​በት​እም​ርተ፡ ​መስ​ቀል። ​ወሶ​ስና፡ ​ወዮ​ዲት፡ ​ወአ​ስቴ​ር። ​ወ፫፡ ​ደቂ​ቅ፡
                                  ​ወኵ​ሎሙ፡ ​ድኅ​ኑ፡ ​በዝ​ንቱ፡ ​አም​ሳል።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107914LIT4915PhysA#WildGoat">
               <fo:inline>I-42) Fols 99–100: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the wild goat</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፵፩፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​አር​ዌ፡ ​ዘስ​ሙ፡ ​ድር​ቆድ​ስ፤ ​ተብ​ህለ፡ ​ውእ​ቱ፡ ​ያፈ​ቅር፡ ​ነዋ​ኀተ፡ ​ወይ​ነብ​ር፡ ​ሲሳ​ዮነ፡ ​ይረ​ክብ፡ ​ውስ​ተ፡ ​አድ​ባር፡ ​ትሑ​ታን፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​እለ፡ ​ይመ​ጽኡ፡ ​እም​ርኁ​ቅ፡ ​እመ​ሂ፡ ​በህ​ብል፡ ​ወበ​እከ​ይ፡
                                  <fo:inline>የአምር፡ (!)</fo:inline> ​በከ​መ፡ ​አእ​መሮ፡ ​ለይ​ሁዳ፡ ​ከመ፡ ​በስ​ዒም፡ ​ያገ​ብኦ። ​ዳዊ​ትኒ፡ <fo:inline>የአምር፡ (!)</fo:inline> ​እግ​ዚአ​ብሔ​ር፡ ​ፍኖ​ተ፡ ​ንጹ​ሐን።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107938LIT4915PhysA#Diamond2">
               <fo:inline>I-43) Fols 101–102: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the diamond</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፵፪፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ድማ​ንጥ​ስ፤ ​ዘው​እቱ፡ ​አደ​ማስ፡ ​እብ​ን፡ ​ጽኑ​ዕ፡ ​ወሐ​ፂን፡ ​ኢይ​ፈጽ​ሖ። ​እሳ​ትኒ፡ ​ኢይ​ክሎ፡ ​ወፄ​ና፡ ​ጢስ፤
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​አድ​ማስ​ኒ፡ ​ኢየ​ሱስ፡ ​ክር​ስቶ​ስ፡ ​ውእ​ቱ፡ ​እስ​መ፡ ​ሀሎ፡ ​ውስ​ተ፡ ​ልብ​ነ፡ ​ወኢ​ምን​ትኒ፡   (fol. 102)   ​ከን​ቱ፡ ​ዲያ​ብሎ​ስ፡ ​አል​ቦ፡ <fo:inline>ዘይደዳቀነ፡ (!)</fo:inline>
                                  ​ኢማ​ዕዜ​ኒ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107962LIT4915PhysA#Elephant">
               <fo:inline>I-44) Fols 102–108: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the elephant</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፵፫፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​አር​ዌ፡ ​ዘስ​ሙ፡ ​ኤል​ባስ፡ ​ዘው​እቱ፡ ​ነጌ፤ ​ዘው​ስተ፡ ​በዳ፡ ​ወው​እቱ፡ ​ጠቢ​ብ፡ ​አር​ዌ፡ ​ወቦ​ቱ፡ ​ፍት​ወት፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ወመ​ጽአ፡ ​ሐዲ​ስ፡ ​ነጌ፡ ​መድ​ኃኒ​ነ፡ ​ወነ​ሥአ፡ ​አር​አያ​ሁ፡ ​ከዊ​ኖ፡ ​ገብ​ረ፤ ​ነሥ​አነ። ​ወአ​ልዓ​ለነ፡ ​ምስ​ሌሁ፡ ​ውስ​ተ፡ ​ሰማ​ያት። ​ዝን​ቱ፡ ​ኮነ፡ ​አም​ሳሊ​ሁ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e107980LIT4915PhysA#Agate">
               <fo:inline>I-45) Fols 108–112: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the agate</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፵፬፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​አኩ​ጢስ፡ ​እብ​ን። ​ሶበ፡ ​ይፈ​ቅድ፡ ​ይኅ​ሥሥ፡ ​ባሕ​ርየ፡ ​ያው​ርድ፡ ​መሥ​ገር​ተ፡ ​ውስ​ተ፡ ​ባሕ​ር፡ ​ወየ​ኀሥ​ር፡ ​በጽ​ኑዕ፡ ​መቃ​ጥኖ፡
                                  ​ወይ​ዌግ​ር፡ ​መሥ​ገር​ቶ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ወዘ​ይፈ​ቅድ፡ ​ኪያ​ሁ፡ ​ይሠ​ይጥ፡ <fo:inline>ኵሉ፡ (!)</fo:inline> ​ጥሪ​ተከ፡ ​ወሀ​ብ፡ ​ለም​ስኪ​ናን። ​ከመ፡ ​ታጥ​ርዮ፡ ​ለባ​ሕር​ይ፡ ​ክቡ​ር፡ ​ዘው​እቱ፡ ​ክር​ስቶ​ስ፡ ​ፀሐ​የ፡
                                  ​ጽድ​ቅ፡ ​ወያ​በር​ህ፡ ​ለኵ​ሉ፡ ​ዓለ​ም።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e108001LIT4915PhysA#DonkeyApe">
               <fo:inline>I-46) Fols 113–114: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the donkey and ape</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፵፭፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ሐለ​ስት​ዮ፡ ​ወበ​እን​ተ፡ ​ሆባ​ይ፡ ​ወው​እቶ​ሙ፡ ​ቤተ፡ ​መን​ግሥ​ት፡ ​ይት​ረከ​ቡ። ​አመ፡ ​፳ወ​፭፡ ​ለመ​ጋቢ​ት፡ ​እመ፡ ​ነቀ​ወ፡ ​፲፪፡ ​ጊዜ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ቀዳ​ሚሁ፡ ፩ ​እም​ሊቃ​ነ፡ ​መላ​እክ​ት፡ ​ደኃ​ሪሁ​ሰ፡ ​ተሰ​ምየ፡ ​ቅሩ​በ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ከማ​ሁ፡ ​ሆባ​ይ፡ ​አል​ቦቱ፡ ​ፍጻ​ሜ። ​ሠና​የ፡ ​ይቤ፡  ​ፊሳ​ልጎ​ስ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e108022LIT4915PhysA#IndianStone">
               <fo:inline>I-47) Fols 114–116: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the Indian stone</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፵፮፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ዕብ​ነ፡ ​ህን​ዳኬ። ​ሀሎ፡ ​እብ​ን፡ ​ዘከ​መዝ፡ ​ፍጥ​ረቱ፡ ​እመ​ቦ፡ ​ዘሐ​መ፡ ​እም​ሰብ​እ፡ ​ወኮ​ነ፡ ​ቅብ​ወ፡ ​ወኃ​ሠሦ፡ ​ዓቃ​ቤ፡ ​ሥራ​ይ፡ ​ለው​እቱ፡
                                  ​ዕብ​ን፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​እማ​የ፡ ​ፍት​ወት፡ ​ዘዲ​ያብ​ሎስ፡ ​ዘመ​ልዓ፡ ​ውስ​ተ፡ ​አል​ባቢ​ነ፡ ​ወወ​ረደ፡ ​ተዓ​ሢሮ፡ ​በመ​ስቀ​ል፡ ​ነሥ​አ፡ ​ሕማ​መነ፡ ​ወፆ​ረ፡ ​ደዌ​ነ፡ ​ወቤ​ዘወ​ነ፡ ​ርእ​ሱ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e108040LIT4915PhysA#Heron">
               <fo:inline>I-48) Fols 116–118: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the heron</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፵፯፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ዖፍ፡ ​ዘስ​ሙ፡ ​አሮ​ድዮ​ን፡ ​ጠቢ​ብ፡ ​ውእ​ቱ፡ ​እም​ኵሉ፡ ​አዕ​ዋፍ፡ ​ኢኮ​ነ፡ ​የኃ​ሥሥ፡ ​ብዙ​ኀ፡
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ከመ፡ ​ንር​ከብ፡ ​ስብ  (fol. 118)  ​ሐተ፡ ​ሰማ​ያዌ፡ ​ወይ​ኩን፡ ​ሕሊ​ናነ፡ ​ውስ​ተ፡ ​ሰማ​ይ። ​ዘባ​ዕዳ​ንሰ፡ ​ክብ​ረ፡ ​ኢት​ኅሥ​ሥ። ​ወት​ረክ​ብ። ​ሠና​የ፡ ​ይቤ፡
                                   ​ፊሳ​ልጎ​ስ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e108063LIT4915PhysA#Sycamore">
               <fo:inline>I-49) Fols 118–122: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: On the sycamore</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፵፰፡ ​ነገ​ር፡ ​በእ​ንተ፡ ​ስቃ​ሮስ፡ ​ዘው​እቱ፡ ​ሰግ​ላ። ​ብፁ​ዕ፡ ​አሞ​ጽ፡ ​ይቤ፡ ​ኢኮ​ንኩ፡ ​ነቢ​የ፡ ​ወኢ​ወል​ደ፡ ​ነቢ​ይ፡ ​አላ፡ ​ሠያ​ጤ፡ ​በለ​ስ፡ ​አነ።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ወበ​ሲሎ፡ ​ሰግ​ላ፡ ​አመ፡ ​ሣል​ስት፡ ​ዕለ​ት፡   (fol. 122)   ​ሲሳ​የ፡ ​ይከ​ውን፡ ​ለኵ​ሉ። ​እግ​ዚእ​ነሂ፡  ​ኢየ​ሱስ፡ ​ክር​ስቶ​ስ፡  ​ተን​ሢኦ፡ ​እሙ​ታን፡
                                  ​በሣ​ልስ​ት፡ ​ዕለ​ት፡ ​ወወ​ሀበ፡ ​ሕይ​ወተ፡ ​ወሥ​ርየ​ተ፡ ​ወሲ​ሲተ፡ ​ኮነ፡ ​ለኵ​ሉ፡ ​ሠና​የ፡ ​ይቤ፡  ​ፊሳ​ልጎ​ስ።
                              </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e108090LIT4915PhysA#Conclusion">
               <fo:inline>I-50) Fols 122–123: <fo:inline xml:lang="en" hyphenate="true">Homily of the blessed Physiologus: Conclusion</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​ፍካ​ሬ፡ ​፵፱፡ ​ነገ​ር፡ ​ዘነ​በበ፡ ​በእ​ንተ፡ ​አራ​ዊት፡ ​ወበ​እን​ተ፡ ​አዕ​ዋፍ፡ ​ወበ​እን​ተ፡ ​ዕፀ​ውኒ፡ ​ዘው​ስቴ​ቶሙ።
                              </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                  
                                  ​አም​ሳል፡ ​ብዙ​ኅ፡ ​ዘዘ​ዚአ​ሁ። ​ስብ​ሐት፡ ​ለእ​ግዚ​አብ​ሔር፡ ​ዘል​ፈ፡ ​አሜ​ን።   (fol. 123)   ​ወአ​ሜን፡ ​ለይ​ኩን፡ ​ለይ​ኩን።
                              </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Additional notes</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. i: Note on the acquisition of the manuscript, written in English by <fo:inline id="d1e108245PRS5782JuelJen">Bent Juel-Jensen</fo:inline>.
                                        It states that the manuscript was donated in March 1982 by <fo:inline id="d1e108247PRS8774sergewh">Śǝrgǝw Ḥabla Śǝllāse</fo:inline>.
                                    </fo:block>
                     <fo:block/>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. x: Short quotation from the chapter on the Indian stone. The quoted passage is on fol. 115.
                                        The note is written upside down in the lower margin of the page, possibly in the same hand as that of the main text.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​የዓ​ሥሮ፡ ​እስ​ከ፡ ፫ ​ሰዓ​ት፡ ​ይክ​ዑ፡ ​አፍ​አ፡ ​ኵሎ፡ ​ማየ፡ ​ዘሰ​ረበ፡ ​ብእ​ሲ፡
                                    </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Varia</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                                        Frequent corrections are executed by crossing out single words in black, red or blue ink, or with one or two lines in red or blue ink over the wrong words
                                        (e.g. fols 11, 16, 119).
                                        The corrections are sometimes accompanied by interlinear additions,
                                        e.g. on 3, 16, 45.
                                        A portion of text consisting of six lines has been crossed out and encircled in red ink on fol. 38.
                                    </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>A white sticker is glued to the inner side of the front board. The name of <fo:inline id="d1e108292PRS5782JuelJen">Bent Juel-Jensen</fo:inline> is printed on it
                                        (‘<fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ቤን​ት፡ ​ዩው​ል፡ ​የን​ሰን።</fo:inline>’) and the signature ‘MS. Aeth. f. 23’ is written in pencil.
                                        An additional sticker, with the signature ‘Ms 47’ on it, is glued below it.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>
                                  The book has a modern <fo:inline id="d1e108307">quarter cover</fo:inline>
                                  in which the spine and the back edge of the boards are covered in red textile and the sides of the boards in brown paper or leather
                                  (photographic reproductions do not permit identifying the material).
                                  The boards have squares that project beyond the edges of the bookblock.
                                </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Foliation</fo:block>
            <fo:block>Pencil and black ink pagination in the upper outer corner (1–124).
                                    The first twelve and the last two pages are not paginated.
                                    They are referred to in this description as fols i–xii and fols xiii–xiv.</fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 1–123: 1
                                    column (12 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 19. The characters per line are 10–13.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            155 × 109 mm (fol. 19).
                                            </fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            98 × 69 mm (fol. 19)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 22 mm, bottom: 38 mm, right: 22 mm, left: 17 mm (fol. 19).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->Mid-twentieth century.. 
                                    Fine and sometimes hasty handwriting. The text is written in black ink up to fol. 36, then in blue ink.
                                <fo:block>Ink: Blue, black, red.</fo:block>
                           <fo:block>Rubrication: 
                                    Two initial lines on the incipit page; holy names; the name of the <fo:inline font-style="italic">Fisālgos</fo:inline>;
                                    elements of the numerals and of the punctuation signs.
                                </fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Condition</fo:block>
            <fo:block>The condition is intact.
                                   The manuscript hardly seems used.
                                </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>mid-twentieth century–1982</fo:inline>
            </fo:block>
            <fo:block>According to Additional note 1,
                      the manuscript was donated to <fo:inline id="d1e108327PRS5782JuelJen">Bent Juel-Jensen</fo:inline>
                      in March 1982.
                      The donor was <fo:inline id="d1e108331PRS8774sergewh">Sergew Hable Selassie</fo:inline>, who had it copied at some time earlier.</fo:block>
            <fo:block>The manuscript entered the Bodleian Libraries as part of the
                      bequest of <fo:inline id="d1e108337PRS5782JuelJen">Bent Juel-Jensen</fo:inline> after his death in 2006.</fo:block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Bibliography</fo:block>Juel-Jensen 1992.</fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLaethf23">https://betamasaheft.eu/BDLaethf23</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
