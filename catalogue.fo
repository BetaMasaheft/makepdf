            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e94907LIT4035SenkessarDL#Teqe29SalDemetreyos">
               <fo:inline>I-3-30-4) Fol. 58va: <fo:inline xml:lang="en" hyphenate="true">Synaxarion: Salām-hymn to Dǝmeṭros</fo:inline>
               </fo:inline>
