      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLaethg43"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. g. 43 (R)</fo:block>
            <fo:block>(Juel-Jensen 38)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment scroll1995×78–85 mm (weight: 49g),  fols, late
                                1960s–early 1970s.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e74345LIT6749PPBinding">
               <fo:inline>I) Fols 1r1–1r32: <fo:inline xml:lang="en" hyphenate="true">Protective prayer for the binding of demons, CAe 6749.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​በስ ፡ ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ፩ ​አም ​ላክ፡ ​ጸሎ​ት፡ ​በእ​ንተ፡ ​ማእ​ሰሮ​ሙ፡
                            ​ለአ​ጋን​ንት፡ ​በስ​ሙ፡ ​ለእ​ግዚ​አብ​ሔር፡ ​አብ፡ ​ምና​ቴር፡ ​በስ​ሙ፡ ​ለእ ​ግዚ ​አብ​ሔር፡ ​ወል​ድ፡ ​አብ​ያቴ​ር፡ ​በስ​ሙ፡ ​ለእ​ግዚ​አብ​ሔር<fo:inline>[፡]</fo:inline>
                            ​መን​ፈስ፡ ​ቅዱ​ስ፡ ​አቅ​ያቴ​ቴር፡ ​ኢየ​ሱስ፡ ​ክር​ስቶ​ስ፡ ​ወል​ደ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ሕያ​ው፡</fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ቡዳ፡ ​ወነ​ሃብ​ት፡ ​ሰብ​አ፡ ​ግብ​ር፡ ​ወጠ​በብ​ት፡ ​ፍጌ​ን፡ ​ወሥ​ራይ፡ ​ቸነ​ፈር፡ ​ወነ​ገር​ጋር፡ ​ድድ​ቅ፡ ​ወጋ​ኔነ፡ ​ቀት​ር፡ ​ይስ​ደዱ፡ ​ወይ​ርኃ​ቁ፡
                                ​እም​ላዕ​ለ፡ ​ገብ​ርከ፡ <fo:inline id="d1e74364PRS13851TaklaM">​ተክ​ለ፡ ​ማር​ያም፡</fo:inline>
                  </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e74373LIT6750PPFera">
               <fo:inline>II) Fols 1r32–1r68: <fo:inline xml:lang="en" hyphenate="true">Protective prayer against pestilence ( ferā ), CAe 6750.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​በስ​መ፡ ​አብ<fo:inline>[፡]</fo:inline> ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡
                                ​ቅዱ​ስ፡ ፩  ​ጸሎ​ት፡ ​በእ​ንተ፡  ​በእ​ንተ፡  ​ሕማ​መ፡ ​ፌራ፡ ​ወአ<fo:inline>&lt;...&gt;</fo:inline>
                            ​ይቤ​ለከ፡ ​እግ​ዚአብ<fo:block hyphenate="true" page-break-after="always"/>​ሔር፡ ​እሎ​ፍ፡ ​በሸ​ጫን፡ ​ንጉ​ሠ፡ ​አጋ​ንን​ት፡ ​ወበ​ሸጫ​ን፡ ​ቀጨ​ር፡ ​ንጉ​ሠ፡ ​ባር​ያ፡ ​ጀሊ​ፍ፡ ​ጅር​ኤል፡ ​ንጉ​ሠ፡ ​ቸነ​ፈር፡ ​ቀሲ​ጥ፡ ​ፈሊ​ጥ፡ ​ወዘ​ባር​ያ፡ ​ንጉ​ሥክ​ሙ፡
                            <fo:inline>ለነጋንት፡ (!)</fo:inline>
                  </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ተማ​ኅፀ​ንኩ፡ ​በቅ​ዱስ፡ ​ጊዮ​ርጊ​ስ፡ ​ወበ​ቅዱ​ስ፡ ​ቂር​ቆስ<fo:inline>[፡]</fo:inline> ​ተማ​ኅፀ​ንኩ፡ ​በሥ​ላሴ፡ ​ዋሕ​ድ፡ ​ተማ​ኅፀ​ንኩ፡
                                ​በት​ሥል​ስቱ<fo:inline>[፡]</fo:inline>
                                ​ወበ​ትስ​ብእ​ቱ፡ ​ተማ​ኅፀ​ንኩ፡  ​በ፲​ወ፪  ​ሐዋ​ርያ​ት፡ ​ተማ​ኅፀ​ንኩ፡ ​በ፲​ወ፭ ​ነቢ​ያት፡ ​ተማ​ኅፀ​ንኩ፡ ​በ፸​ወ፪ ​አር​ድእ​ት፡
                            ​ተማ​ኅፀ​ንኩ፡ ​በእ​ግዚ​እነ፡ <fo:inline>ወአምላነ፡ (!)</fo:inline> ​ወመ​ድኃ​ኒነ፡ ​ኢየ​ሱስ፡ ​ክር​ስቶ​ስ፡ ​አድ​ኅነ​ኒ፡
                                ​እም​ሕማ​መ፡ ፌ 
                                ​ለገ​ብር​ከ፡ <fo:inline id="d1e74411PRS13851TaklaM">​ተክ​ለ፡ ​ማር​ያም።</fo:inline>
                  </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e74420LIT6751PPAynat">
               <fo:inline>III) Fols 1r69–1r97: <fo:inline xml:lang="en" hyphenate="true">Protective prayer against the evil eye (ʿāynat),
                    containing ʾasmāt, CAe 6751.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The prayer’s beginning is close to that of a prayer attested in
                                MS EMIP 227 (Subers Codex 2) (fol. 73r),
                                but the text then continues differently.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ፩ ​አም​ላክ ፡ ​ጸሎ​ት፡
                            ​በእ​ንተ፡ ​ሕማ​መ፡ ​ዓይ​ነት፡ ​ይስ​ድድ​ከ፡ ​እግ​ዚአ​ብሔ​ር፡ ​አን​ተ፡ ​ሰይ​ጣን፡ ​ርጉ​ም፡ ​ዓይ​ነተ፡ ​ዓይ​ን፡ ​ውፃ​እ፡ ​በቀ​ይሕ፡ ​ወጸ​ሊም፡ ​ዮሴ​ፍ፡ ​በከ​መ፡ ​ወፅ​አ፡ ​እም​ሕሱ​ም፡ ​ፈአ​ንት፡
                            ​አበ​ሹን፡ ​ቀበ​ሹን፡ ​ሰሐ​ብን፡ ​ይጐ​ድር​ን፡ ​የብ​ሹን፡ ​ርየ​ቶ፡ ​አን​ተ፡ ​ዓይ​ን፡ ​ውፃ​እ፡</fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ውፃ​እ፡ ​አን​ተ፡ ​ዓይ​ን፡ ​እም፡ ​ሥራየ<fo:inline>[፡]</fo:inline> ​ብእ​ሲ፡ ​ወብ​እሲ​ት፡
                            ​ዓይ​ነ፡ ​እስ​ላም፡ ​ወክ​ርስ​ቲያ​ን፡ ​ዓይ​ነ፡ ​አይ​ሁድ፡ ​ወዓ​ይነ፡ ​አረ​ማው​ያን፡ ​በኃ​ይል​ከ፡ ​ኃይ​ለ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ወበ​ፅን​ዕከ፡ ​ፅን​ዓ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ፃእ፡ ​እም​ላዕ​ለ፡
                            ​ገብ​ርከ። <fo:inline id="d1e74443PRS13851TaklaM">​ተክ​ለ፡ ​ማር​ያም፡</fo:inline>
                  </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e74452LIT1878Marbab">
               <fo:inline>IV) Fols 1r98–1r119: <fo:inline xml:lang="en" hyphenate="true">‘Solomon’s net’ (​መር​በብ​ተ፡ ​ሰሎ​ሞን፡), CAe 1878.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The entire text is reproduced below.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመን ​ፈስ፡ ​ቅዱ​ስ፡ ፩ ​አም​ላክ፡
                                ​ጸሎት<fo:inline>[፡]</fo:inline> ​በእ​ንተ፡ ​መር​በብ​ተ፡ ​ሰሎ​ሞን፡
                            ​በከ​መ፡ ​ረበ​ቦሙ፡ ​ወቀ​ነዮ​ሙ፡ ​ሰሎ​ሞን፡ ​ለአ​ጋን​ንት፡ ​ሰሎ​ሞን፡ ​ሰሎ​ሞ፡ ​ሰሎ​ሞን፡ ​ለአ​ጋን​ንት፡ ​ሰሎ​ሞን፡ ​ሰሎ​ሞን፡ ​ሎፍ​ሐም፡ ​ሎፍ​ሐም፡ ​ሎፍ​ሐም፡ ​ንም​ሎስ፡ ​ንም​ሎስ፡ ​ንም​ሎስ፡
                            ​ዮፍ​ታሔ፡ ​ዮፍ​ታሔ፡ ​ዮፍ​ታሔ፡ ​ዮፍ​ታሔ፡ ​አም​ላከ፡ <fo:inline>ጴሮስ፡ (!)</fo:inline> ​ወጳ​ውሎ​ስ፡ ​ብር​ስባ​ሔል፡ ​ብር​ሃና​ኤል፡ ​አዌ​ን፡ ​ቆጶ​ንዮ​ስ፡ ​ፓፒ​ሮስ፡ ​ዕብ​ኖዲ፡ ​ማስ​ያስ፡ ​ድስ​ቡጠ፡
                            ​ሳዶ​ር፡ ​አላ​ዶር፡ ​ዳና​ት፡ ​አዴ​ራ፡ ​ሮዳ​ስ፡ ​በ፭ ​ቅን​ዋተ፡ ​መስ​ቀሉ፡ ​ለእ​ግዚ​እነ፡ ​ወአ​ምላ​ክነ፡ ​ወመ​ድኃ​ኒነ፡ ​ኢየ​ሱስ፡ ​ክር​ስቶ​ስ፡ ​ከመ፡ ​ኢይ​ቅረ​ቡ፡
                                 ​ወይ​ርኃ​ቁ፡  ​እም​ላዕ​ለ፡ ​ነፍ​ሱ፡ ​ወሥ​ጋሁ፡ ​ለገ​ብር​ከ። <fo:inline id="d1e74470PRS13851TaklaM">​ተክ​ለ፡ ​ማር​ያም።</fo:inline>
                  </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e74480LIT4697MagicPr">
               <fo:inline>V) Fols 1r119–1r165: <fo:inline xml:lang="en" hyphenate="true">‘’ (​ጸሎ​ት፡ ​በእ​ንተ፡ ​ማእ​ሠሮ​ሙ፡ ​ለአ​ጋን​ንት፡), CAe 4697.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡
                                ​ቅዱ​ስ፡  ፩ ​አም​ላክ፡ ​ጸሎ<fo:block hyphenate="true" page-break-after="always"/>​ት፡
                                ​በእ​ንተ፡ ​ማዕ​ሰሮ​ሙ፡ ​ለአ​ጋን​ንት፡  ​ሰላ​ም፡ ​ለከ፡  ​ሰዳ​ዴ፡ ​አጋ​ንን​ት፡ ​ፋኑ​ኤል፡ ​ለእ​ግዚ​አብ​ሔር፡ ​እም​ጽር​ሑ፡
                                ​ከመ፡ ​ኢይ​ስክ​ዩ፡ ​ሰብ​አ፡ ​እለ፡ ​ይኔ​ስሑ፡ ​ኃጣ​ውአ፡ ​ሰብ​እ፡ ​ዘዘ​ዚአ​ሁ፡  ​ሰላ​ም፡ ​ለከ፡  ​ሰዳ​ዴ፡ ​ሰይ​ጣና​ት፡
                            ​ፋኑ​ኤል፡ ​እም​ገጸ፡ ​ፈጣ​ሪ፡ ​ልዑ​ል፡</fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ንሣ​እ፡ ​ዘማ​ኅሌ ት ​የ፡ ​ቡዓ​ዴ፡ ​እለ፡ ​ይሌ​ቅሁ፡ ​ወር​ቆሙ፡ ​በር​ዴ፡ ​መቅ​ደሰ፡
                                ​ኦሪ​ት፡ ​ዘቦ​እኪ፡
                                ​ማር​ያም፡ ​እም​ነ፡ ​ወእ​ሙ፡ ​ለእ ​ግዚ ​እነ፡ ​በሕ​ፅነ፡ ​ሐና፡ ​እም​ኪ፡ ​ተማ​ፀነ፡  ​አዝ​ዝዮ፡ ​ለፋ​ኑኤ​ል፡ ​ይዕ<fo:inline>&lt;...&gt;</fo:inline>​ብ፡ <fo:inline>ኪየ (!)</fo:inline>። 
                                ​በረ​ምኃ፡ ​በረ​ሞ፡ ​መስ​ቀል፡ ​ረጊ​ዞ፡ ​ሰይ​ጣን፡ ​ኦአ​ምላ​ከ፡
                                ​ፋኑ​ኤል፡ ​ዕቀ​በኒ፡ ​ወሰ​ውረ​ኒ፡ ​እመ​ከራ፡ ​ሥጋ፡ ​ወነ​ፍስ፡ ​ወእም ​ሕም ​ሕማ​መ፡ ​ፌራ፡ ​ወን​ዳድ<fo:inline>[፡]</fo:inline> ​ለገ​ብር​ከ፡ <fo:inline id="d1e74520PRS13851TaklaM">​ተክ​ለ፡ ​ማር​ያም፡</fo:inline>
                  </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e74529LIT6752PPSmiths">
               <fo:inline>VI) Fols 1r166–1r176: <fo:inline xml:lang="en" hyphenate="true">Protective prayer against blacksmiths, containing  ʾasmāt 
                , CAe 6752.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The entire text is reproduced below.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ​አ፩ ​አም​ላክ፡ ​ጸሎ ​ት፡ ​በእ​ንተ፡ ​ሕማ​መ፡ ​ነሃ​ብት፡
                            ​ሐረ​ፓሮ​ስ፡ ​አል​ዩድ፡ ​ኢል​ህም​ዩድ፡ ​አር​ክህ​ምዩ​ድ፡ ​ሴር፡ ​ሴር፡ ​ቈቍ​ነስ​ኩክ​ሙ፡ ​በአ​ብ፡ ​አወ​ግዘ​ክሙ፡ ​ወበ​ወል​ድ፡ ​እከ​ልክ​ሙ፡ ​በመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ​ከመ፡ ​ኢታ​ሕም​ሙ፡
                            ​ኀበ፡ ​ነፍ​ሱ፡ ​ወሥ​ጋሁ፡ ​ለገ​ብር​ከ። <fo:inline id="d1e74539PRS13851TaklaM">​ተክ​ለ፡ ​ማር​ያም፡</fo:inline>
                  </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e74548LIT4622Prayer">
               <fo:inline>VII) Fols 1r177–1r190: <fo:inline xml:lang="en" hyphenate="true">‘Protective prayer against colic’ (​ጸሎ​ት፡ ​በእ​ንተ፡ ​ሕማ​መ፡ ​ቍር​ጠት፡), CAe 4622.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The entire text is reproduced below.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡  ​ቅዱ​ስ፡ ፩ ​አም​ላክ፡ ​ጸሎ​ት፡ ​በእ​ንተ፡ ​ሕማ​መ፡ ​ቍር​ፀት፡ ​ዘተ​ፈነ​ወ፡
                                ​እም​ኀበ፡
                                <fo:inline>ወወል፡ (!)</fo:inline> ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ፩ ​አም​ላክ፡ ​ይር​ዳዕ፡ ​ወይ​ዕ፡ ​ወይቤ ዙ ፡ ​ለው​ሉደ፡ ​እጓ​ለ፡ ​እመ​ሕያ​ው፡ ​እንዘ<fo:inline>[፡]</fo:inline>
                            ​ይበ<fo:inline>&lt;...&gt;</fo:inline>​ብዕ፡ ​ከር​ሥ፡ ​ወያ​ጠዊ፡ ​ዓማ​ዑት፡ ​ወያ​ደቅ​ቅ፡ ​አዕ​ፅም​ት፡ ​ሸገ​ር፡ ​ሸገ​ር፡ ​በኃ​ይለ፡ ​ዝን​ቱ፡
                                ​አስ​ማቲ​ከ፡
                                ​አድ​ኅኖ፡ ​እም​ሕማ​መ፡ ​ቍር​ፀት፡ <fo:inline>ለገብከ። (!)</fo:inline>
                     <fo:inline id="d1e74570PRS13851TaklaM">​ተክ​ለ፡ ​ማር​ያም።</fo:inline>
                  </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e74579LIT6753PPWegat">
               <fo:inline>VIII) Fols 1r190–1r198: <fo:inline xml:lang="en" hyphenate="true">Protective prayer against stomachache ( wǝgʿāt ),
                    containing  ʾasmāt 
                , CAe 6753.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The entire text is reproduced below.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​በስ​መ፡ ​አብ፡ ​ወወ​ልድ<fo:inline>[፡]</fo:inline> ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡  ፩ ​አም​ላክ፡ ​ጸሎ​ት፡ ​በእ​ንተ፡ ​ሕማ​መ፡ ​ውግ​አት፡ ​አላ​ህ፡
                                ​ባላ​ህ፡ ​ማላ​ህ፡ ​አድ​ራት፡ ​ወባ​ራት፡ ​ወበ​ኤድ​ራት፡ ​ክን​ቅሮ​ን፡ ​በስ​መ፡ ​ኮን፡ ​ሕት​ም፡ ​ሕማ​መ፡ ​ዕቃ​ሁ፡ ​ለው​ግአ​ት፡ ​እምላ ​ዕላ ​ዕለ፡
                                ​ገብ​ርከ። <fo:inline id="d1e74594PRS13851TaklaM">​ተክ​ለ፡ ​ማር​ያም፡</fo:inline>
                  </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e74603LIT6754PPQwertmat">
               <fo:inline>IX) Fols 1r199–1r204: <fo:inline xml:lang="en" hyphenate="true">Protective prayer against rheumatism (?) ( qʷǝrṭǝmāt ),
                    containing  ʾasmāt 
                , CAe 6754.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The entire text is reproduced below.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ጸሎ​ት፡ ​በእ​ንተ፡ ​ሕማ​መ፡ ​ቍር​ጥማ​ት፡ ​ካኤ​ል፡ ​ካካ​ኤል<fo:inline>[፡]</fo:inline> ​አዶ​ናኤ​ል፡ ​ኢዩ​ኤል፡
                                ​አማ​ኑኤ​ል፡ ​ሰዳ​ዲሆ​ሙ፡ <fo:inline>ለአጋን (!)</fo:inline>
                                ​ወይ​እዜ​ኒ፡ ​ለቍ​ርጥ​ማት፡ ​እም​ላዕ​ለ፡ ​ገብ​ርከ፡ <fo:inline id="d1e74616PRS13851TaklaM">​ተክ​ለ፡ ​ማር​ያም<fo:inline>[፡]</fo:inline>
                     </fo:inline>
                  </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Varia</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>The verso is empty.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>The manuscript contains nearly no scribal corrections. In textual unit V,
                                        a correction is written
                                    above an erasure and omitted characters are written interlineally.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>The name of the owner, mentioned in supplications throughout, was <fo:inline id="d1e74887PRS13851TaklaM">Takla Māryām</fo:inline>.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>4)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Order of textual units and miniatures: Miniature 1, Textual units I–II
                                        (beginning), Miniature 2, Textual units II (end)–V
                                        (beginning), Miniature 3, Textual units V (beginning)–IX,
                                        Miniature 4.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>The three parchment strips of which the scroll is composed are sewn together with narrow parchment
                                strips.A thread is attached through a hole in the bottom margin of the scroll.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>1
                                    column (61 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Number of characters per line: 16–17.The outer margins are delimited by a black line.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            392 × 76 mm ()</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            right: 1–4 mm, left: 1–4 mm, top: 2 mm, bottom: 2 mm ().
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>1
                                    column (76 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Number of characters per line: 15–16.The outer margins are delimited by a black line.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            518 × 75–78 mm ()</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            right: 1–4 mm, left: 1–4 mm, top: 1–2 mm, bottom: 1 mm ().
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>1
                                    column (67 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Number of characters per line: 15–16.The outer margins are delimited by a black line.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            448 × 76–80 mm ()</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            right: 1–4 mm, left: 1–4 mm, top: 1–2 mm, bottom: 2 mm ().
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Pricking and ruling are not visible. Pricking and ruling are not visible. Pricking and ruling are not visible.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->Nineteenth–twenty-first century.. Relatively regular hand. The characters are broad and slightly cursive. The word separator at the end of a line is
                                occasionally omitted or placed at the beginning of the next line. The ligature
                                ​ግዚ is used.<fo:block>Ink: Black, red.</fo:block>
                           <fo:block>Rubrication: Incipits (one or two rubricated lines); name of the owner; the numeral <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​፲ወ፪</fo:inline> in
                                    Textual unit III; the words <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ወይ​ርኃ​ቁ፡</fo:inline>
                                    in Textual unit IV and
                                    <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ሰላ​ም፡ ​ለከ፡</fo:inline> in Textual unit V.</fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Decoration</fo:block>
         <fo:block margin-top="3mm" margin-bottom="3mm" white-space-collapse="true">
                                Much like <fo:inline/>, this scroll appears to have been produced around the 
                                late 1960s or early 1970s shortly before it was purchased by its
                                former owner <fo:inline id="d1e74812PRS5782JuelJen">Bent Juel-Jensen</fo:inline>. 
                                While the first two panels feature motifs that are part of the visual repertoire of Ethiopian crosses, 
                                the third and fourth panel feature elements that did not typically appear on Ethiopian protective scrolls. 
                                The style of the illustrations and the types of pigments used to execute them also corroborate this hypothesis.
                            </fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Miniatures</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em">
            <fo:inline>(178) <fo:inline>A grid unusually made of rectangles rather than squares with a face at its 
                                    centre and eyes at the four corners.</fo:inline>
            </fo:inline>
            <fo:inline>(179) <fo:inline>A cross with volutes at its ends with an eye at the centre of
                                    each volute and a face at its centre.</fo:inline>
            </fo:inline>
            <fo:inline>(180) <fo:inline>A pair of animals (snakes or fishes?) eating each other’s
                                    tails.</fo:inline>
            </fo:inline>
            <fo:inline>(181) <fo:inline>An eight-pointed star flanked by floral elements.</fo:inline>
            </fo:inline>
         </fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Headpieces</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Drawings</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Other</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Condition</fo:block>
            <fo:block>The condition is good.The upper part of the scroll is crumpled due to rolling.</fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>late
                                1960s–early 1970s</fo:inline>
                            The manuscript can be dated palaeographically and by the style of the
                            miniatures to the late 1960s or early 1970s.
                            The name of the owner was <fo:inline id="d1e74918PRS13851TaklaM">Takla Māryām</fo:inline> (see Varia note 3).
                        </fo:block>
            <fo:block>The provenance of the manuscript is unknown.</fo:block>
            <fo:block>The manuscript entered the Bodleian Libraries as part of the
                            bequest of <fo:inline id="d1e74928PRS5782JuelJen">Bent Juel-Jensen</fo:inline> after his death in 2006.</fo:block>
         </fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLaethg43">https://betamasaheft.eu/BDLaethg43</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
