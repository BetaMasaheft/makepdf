      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLaethe35"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. e. 35</fo:block>
            <fo:block>(Juel-Jensen 23)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment codex170×121 mm (weight: 653g), 152 fols (5 p. blank), nineteenth–mid-twentieth century.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40131LIT2701Dawit">
               <fo:inline>I) Fols 4r–121ra: <fo:inline xml:lang="en" hyphenate="true">Psalter, CAe 2701.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40137LIT2000Mazmur">
               <fo:inline>I-1) Fols 4r–115v: <fo:inline xml:lang="en" hyphenate="true">Psalms of David, CAe 2000.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​ተግ​ሣጽ፡ ​ለኵ​ሉ፡ ​ወአ​ስተ​ናሥ​ኦ፡ ​ምግ​ባር።
                                         ​ፍካ​ሬ፡ ​ዘጻ​ድቃ​ን፡ ​ወዘ​ኃጥ​አን። ​መዝ​ሙር፡ ​ዘዳ​ዊት<fo:inline>[፡]</fo:inline>
                                        ፩  ​ብፁ​ዕ፡ ​ብእ​ሲ፡ ​ዘኢ​ሖረ፡ ​በም​ክረ፡ ​ረሢ​ዓን ፨
                                    ​ወዘ​ኢቆ​መ፡ ​ውስ​ተ፡ ​ፍኖ​ተ፡ ​ኃጥ​አን ፨
                                    ​ወዘ​ኢነ​በረ፡ ​ውስ​ተ፡ ​መን​በረ፡ ​መስ​ተሣ​ልቃ​ን።
                                </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​ወአ​ንሰ፡ ​ነሣ​ዕኩ፡ <fo:inline>...</fo:inline> ​፫፡ ​አእ​ባነ፡ 
                                        ​እም​ውስ​ተ፡ ​ፈለ​ግ፡ ​ወወ​ጸፍ​ክዎ፡ ​ዲበ፡ ​ፍጽሙ ፨
                                    ​ወአ​ንሰ፡ ​ነሣ​እኩ፡ ​ዘእ​ምላ​ዕሌ​ሁ፡ ​ሰይፈ ፨
                                    ​ወመ​ተር​ኩ፡ ​ርእሶ ፨ ​ለጐ​ልያድ
                                    ​ወአ​ሰሰ​ልኩ፡ ​ጽዕ​ለተ፡ ​እም​ደቂ​ቀ፡ ​እስ​ራኤል ፨
                                </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40205LIT1828Mahale">
               <fo:inline>I-2) Fols 115v–127v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes, CAe 1828.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40211LIT1828Mahale#Moses1">
               <fo:inline>I-2-1) Fols 115v–116v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: First Song of Moses (​ጸሎ​ቱ፡ ​ለሙ​ሴ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​መኃ​ልየ፡ ​ነቢ​ያት፡ ​ወጸ​ሎቱ፡ ​ለሙ​ሴ፡
                                        ፩  ​ንሴ​ብሖ፡ ​ለእ​ግዚ​አብ​ሔር፡ ​ስቡ​ሐ፡ ​ዘተ​ሰብሐ ፨
                                        ​ፈረ​ሰ፡ ​ወመ​ስተ​ፅዕ​ነ፡ ​ወረ​ወ፡ ​ውስ​ተ፡ ​ባሕ​ር።
                                        ​ረዳ​ኤ፡ ​ወመ​ሰው​ረ፡ ​ኮነ​ኒ፡ ​ለአ​ድኅ​ኖትየ ፨
                                        ​ውእ​ቱ፡ ​አም​ላኪ​የ፡ ​እሴ​ብሖ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ወአ​ስተ​ጋብ​አ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ላዕ​ሌሆ​ሙ፡ ​ማየ፡ ​ባሕር ፤
                                        ​ወደ​ቂቀ፡ ​እስ​ራኤ​ልሰ፡ ​ኃለ​ፉ፡ ​እን​ተ፡ ​የብ​ስ፡ ​ማእ​ከለ፡ ​ባሕር ፤
                                        ​ማይ​ሰ፡ ​ሎሙ፡ ​አረ​ፍት፡ ​በይ​ምን፡ ​ወአ​ረፍ​ት፡ ​በፅ​ግም ፤
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40270LIT1828Mahale#Moses2">
               <fo:inline>I-2-2) Fols 116v–118r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Second Song of Moses (​ጸሎ​ተ፡ ​ሙሴ፡ ​ዘዳ​ግም፡ ​ሕግ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሙሴ፡ ​ዘዳ​ግም፡ ​ሕግ፡
                                        ፪  ​አጽ​ምዕ፡ ​ሰማ​ይ፡ ​ወእ​ንግ​ርከ ፨
                                        ​ወት​ስማ​ዕ፡ ​ምድ​ር፡ ​ቃለ፡ ​አፉ​የ።
                                        ​ወት​ሰፈ​ዎ፡ ​ከመ፡ ​ዝና​ም፡ ​ለነ​ገርየ ፨
                                        ወ<fo:inline> (!)</fo:inline>​ረድ፡ ​ከመ፡ ​ጠል፡ ​ነቢ​ብየ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ወአ​ምዕ​ዑኒ፡ ​በአ​ማል​ክቲ​ሆሙ ፨
                                        ​ወአ​ነ፡ ​አቀ​ንዖ​ሙ፡ ​በዘ​ኢኮ​ነ፡ ​ሕዝብ ፨
                                        ​ወአ​ምዕ​ዖሙ፡ ​በሕ​ዝብ፡ ​በዘ​ኢይ​ሌብዉ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40335LIT1828Mahale#Moses3">
               <fo:inline>I-2-3) Fols 118r–119v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Third Song of Moses (​ጸሎ​ተ፡ ​ሙሴ፡ ​ዘሣ​ልስ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሙሴ፡ ​ዘሣ​ልስ፡ ​ሕግ።
                                        ፫  ​እስ​መ፡ ​እሳ​ት፡ ​ትነ​ድድ፡ ​እመ​ዓትየ ፨
                                        ​ወታ​ውዒ፡ ​እስ​ከ፡ ​ሲኦ​ል፡ ​ታሕ​ተ።
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ይትቤ ቀ ​ል፡ ​ወይ​ትፈ​ደዮ​ሙ፡ ​በቀ​ለ፡ ​ለፀሩ ፨
                                        ​ወይ<fo:inline>[...]</fo:inline>ቤ<fo:inline>[...]</fo:inline>​ሎሙ፡ ​ለጸ​ላእቱ ፨
                                        ​ወያ​ነጽ​ሕ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ምድ​ረ፡ ​ለሕ​ዝቡ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40395LIT1828Mahale#Hannah">
               <fo:inline>I-2-4) Fols 119v–120v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Hannah (​ጸሎ​ተ፡ ​ሓና፡ ​እመ፡ ​ሳሙ​ኤል፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሐና፡ ​እመ<fo:inline>[፡]</fo:inline> ​ሳሙ​ኤል፡ ​ነቢ​ይ።
                                        ፬  ​ጸን​ዓ፡ ​ልብ​የ፡ ​በእ​ግዚ​አብ​ሔር ፨
                                        ​ወተ​ለዓ​ለ፡ ​ቀር​ንየ፡ ​በአ​ምላ​ኪየ፡ ​ወመ​ድኃ​ንየ።
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ወው​እቱ፡ ​ጻድ​ቅ፡ ​ይኴ​ንን፡ ​እስ​ከ፡ ​አጽ​ናፈ፡ ​ምድር ፨
                                        ​ወይ​ሁቦ​ሙ፡ ​ኃይ​ለ፡ ​ለነ​ገሥ​ትነ ፨
                                        ​ወያ​ሌዕ​ል፡ ​ቀር​ነ፡ ​መሲሑ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40447LIT1828Mahale#Hezekiah">
               <fo:inline>I-2-5) Fols 120v–121r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Prayer of Hezekiah (​ጸሎ​ተ፡ ​ሕዝ​ቅያ​ስ፡ ​ንጉ​ሠ፡ ​ይሁ​ዳ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሕዝ​ቅያ​ስ፡  ​ነቢ​ይ፡  ​ንጉ​ሠ፡ ​ይሁ​ዳ፡
                                        ፭  ​አን​ሰ፡ ​እቤ፡ ​በኑ​ኃ፡ ​መዋ​ዕልየ ፨
                                        ​ውስ​ተ፡ ​አና​ቅጸ፡ ​ሲኦ​ል፡ ​ኀደ​ጉ፡ ​ዘተ​ርፈ፡ ​ዓመ​ትየ።
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​እነ​ግር፡ ​ጽድ​ቀከ፡ ​በዳ​ኅናየ ፨
                                        ​ወት​ረ፡ ​እሴ​ብሐ​ከ፡ ​ወእ​ዜም​ር፡ ​ለከ ፨
                                        ​በኵ​ሉ፡ ​መዋ​ዕለ፡ ​ሕይ​ወትየ ፨
                                        ​በቅ​ድመ፡ ​ቤተ፡ ​እግ​ዚአ​ብሔር ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40505LIT1828Mahale#Manasseh">
               <fo:inline>I-2-6) Fols 121r–122r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Prayer of Manasseh (​ጸሎ​ተ፡ ​ምና​ሴ፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ምና​ሴ፡ ​ነቢ​ይ።
                                        <fo:inline> (!)</fo:inline>
                                        ​እግ​ዚኦ፡ ​አኀ​ዜ፡ ​ኵሉ፡ ​ዓለም ፨
                                        ​አም​ላኮ​ሙ፡ ​ለአ​በዊ​ነ።
                                        ​ለአ​ብር​ሃም፡ ​ወለ​ይስ​ሐቅ፡ ​ወለ​ያዕ​ቆብ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​እሴ​ብሐ​ከ፡ ​በኵ​ሉ፡ ​ጊዜ፡ ​ወበ​ኵሉ፡ ​መዋ​ዕለ፡ ​ሐይ​ወትየ ፨
                                        ​እስ​መ፡ ​ኪያ​ከ፡ ​ይሴ​ብሑ፡ ​ኵሉ፡ ​ኃይ​ለ፡ ​ሰማ​ያት ፤
                                        ​ወለ​ከ፡ ​ስብ​ሐት፡ ​ለዓ​ለም፡ ​አሜን ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40562LIT1828Mahale#Jonah">
               <fo:inline>I-2-7) Fols 122r–122v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Jonah (​ጸሎ​ተ፡ ​ዮና​ስ፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ዮና​ስ፡ ​ነቢ​ይ፡
                                        ፯  ​ጸራ​ኅኩ፡ ​በም​ንዳ​ቤየ፡ ​ኀበ፡ ​እግ​ዚአ​ብሔ​ር፡ ​አም​ላኪየ ፤
                                        ​ወሰ​ምዓ​ኒ፡ ​በው​ስተ፡ ​ከር​ሠ፡ ​ሲኦ​ል።
                                        ​ወሰ​ምዓ​ኒ፡ ​ቃልየ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​እለ​ሰ፡ ​ዓቀ​ቡ፡ ​ከን​ቶ፡ ​ወሐ​ሰተ፡ ​ገደ​ፉ፡ ​ሣህ​ሎሙ ፨
                                        ​አን​ሰ፡ ​ምስ​ለ፡ ​ቃለ፡ ​ስብ​ሐት፡ ​በተ​ጋን​ዮ፡ ​እሰ​ውዕ፡ ​ለከ ፤
                                        ​መጠ​ነ፡ ​ጸለ​ይኩ፡ ​በሕ​ይወ​ትየ፡ ​አዓ​ስዮ፡ ​ለእ ​ግዚ ​አብ<fo:inline>[​ሔር]</fo:inline>፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40621LIT1828Mahale#ThreeYouths1">
               <fo:inline>I-2-8) Fols 122v–123v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: First Song of the Three Youths in the Furnace (​ጸሎ​ተ፡ ​ዳን​ኤል፡ ​ነቢ​ይ፡ ​ስብ​ሐት፡ ​ዘእ​ምኣ​ዛር​ያ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ዳን​ኤል፡ ​ነቢ​ይ፡ ​ወስ​ብሐ​ት፡ ​ዘእ​ምአ​ዛር​ያ።
                                        ፰  ​ይት​ባረ​ክ፡ ​እግ​ዚአ​ብሔ​ር፡ ​አም​ላከ፡ ​አበ​ዊነ ፨
                                        ​እኩ​ት፡ ​ወስ​ቡሕ፡ ​ስም​ከ፡ ​ለዓ​ለም።
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ይት​ኃፈ​ሩ፡ ​በኵ​ሉ፡ ​ትዕ​ግል​ቶሙ፡
                                         ​ወይ​ትቀ​ጥቀ​ጥ፡ ​ኃይ​ሎሙ ፨
                                        ​ወያ​እም​ሩ፡ ​ከመ፡ ​አን​ተ፡  ​እግ​ዚአ​ብሔ​ር፡
                                        ​አም​ላክ፡ ​ባሕ​ቲትከ ፨
                                        ​ስቡ​ሕ፡ ​በኵ​ሉ፡ ​ምድ​ር፡ ​ወበ​ኵሉ፡ ​ዓለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40677LIT1828Mahale#ThreeYouths2">
               <fo:inline>I-2-9) Fol. 123v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Second Song of the Three Youths (​ጸሎ​ተ፡ ​ሠለ​ስቱ፡ ​ደቂ​ቅ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ፫ ​ደቂ​ቅ። ​ነቢ​ይ።
                                        ፱  ​ይት​ባረ​ክ፡ ​እግ​ዚአ​ብሔ​ር፡ ​አም​ላከ፡ ​አበ​ዊነ ፨
                                        ​ስቡ​ሕኒ፡ ​ውእ​ቱ፡ ​ወል​ዑል​ኒ፡ ​ውእ​ቱ፡ ​ለዓ​ለም።
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ስቡ​ሕኒ፡ ​አን​ተ፡ ​ወቡ​ሩክ፡ ​አን​ተ፡ ​ለዓ​ለም ፨
                                        ​ቡሩ​ክ፡ ​አን​ተ፡ ​በመ​ልዕ​ልተ፡ ​ሰማ​ያት ፨
                                        ​ስቡ​ሕኒ፡ ​አን​ተ፡ ​ወክ​ቡር፡ ​አን​ተ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40727LIT1828Mahale#ThreeYouths3">
               <fo:inline>I-2-10) Fols 123v–124v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Third Song of the Three Youths (​ኀበ፡ ​ባረ​ኩ፡ ​ኣና​ንያ፡ ​ወኣ​ዛር​ያ፡ ​ወሚ​ሳኤ​ል፡ ​ለእ​ግዚ​አብ​ሔር፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ኀበ፡ ​ባረ​ኩ፡ ​አና​ንያ፡ ​ወአ​ዛር​ያ፡ ​ወሚ​ሳኤ​ል፡ ​ለእ ​ግዚ ​አብ​ሔር፡
                                        ፲  ​ይባ​ርክ​ዎ፡ ​ኵሉ፡ ​ግብ​ረ፡ ​እግ​ዚእ፡ ​ለእ​ግዚ​አብ​ሔር ፤
                                        ​ስቡ​ሕኒ፡ ​ውእ​ቱ፡ ​ወል​ዑል​ኒ፡ ​ውእ​ቱ፡ ​ለዓ​ለም።
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ይ ባ ር ክ ​ዎ፡ 
                                        ​አና​ንያ፡ ​ወአ​ዛር​ያ፡ ​ወሚ​ሳኤ​ል፡
                                        ​ለእ ​ግዚ ​አብ<fo:inline>[​ሔር]</fo:inline>፤ 
                                        ስ ፨
                                        ን ባ ር ኮ ፡ ለ ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱስ ፨
                                        ስ ቡ ሕ ኒ ፡ ው ​እቱ፡
                                        ​ወል​ዑል​ኒ፡ ​ውእ​ቱ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40812LIT1828Mahale#Habakkuk">
               <fo:inline>I-2-11) Fols 124v–126r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Habakkuk (​ጸሎ​ተ፡ ​ዕን​ባቆ​ም፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ዕን​ባቆ​ም፡ ​ነቢ​ይ።
                                        ​፲፩  ​እግ​ዚኦ፡ ​ሰማ​ዕኩ፡ ​ድም​ፀከ፡ ​ወፈ​ራህኩ ፨
                                        ​ርኢ​ኩ፡ ​ግብ​ረከ፡ ​ወአ​ንከ​ርኩ።
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​እግ​ዚአ​ብሔ​ር፡ ​አም​ላኪ​የ፡ ​ወኃ​ይልየ ፨
                                        ​ዘይ​ሠር​ዖን፡ ​ለእ​ገር​የ፡ ​ወለ​ፍጻ​ሜየ ፨
                                        ​ወዲ​በ፡ ​ልዑ​ላት፡ ​ያጼ​ዕነኒ ፨
                                         (fol. 126r)  ​ከመ፡ ​እማ​ዕ፡ ​በመ​ኃል​ይሁ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40867LIT1828Mahale#Isaiah">
               <fo:inline>I-2-12) Fols 126r–126v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Isaiah (​ጸሎ​ተ፡ ​ኢሳ​ይያ​ስ፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ኢሳ​ይያ​ስ፡ ​ነቢ​ይ።
                                        ​፲፪  ​በሌ​ሊት፡ ​ትገ​ይስ፡ ​መን​ፈስ​የ፡ ​ኀቤ​ከ፡ እ ​ግዚ ​ኦ፡ ​አም​ላኪየ ፨
                                        ​እስ​መ፡ ​ብር​ሃን፡ ​ትእ​ዛዝ​ከ፡ ​በዲ​በ፡ ​ምድ​ር።
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ሑር፡ ​ሕዝ​ብየ፡ ​ወባ​እ፡ ​ቤተከ ፨
                                        ​ወዕ​ፁ፡ ​ኆኅ​ተከ። ​ወተ​ኀባ​እ፡ ​ኅዳ​ጠ፡ ​ምዕረ ፨
                                        ​እስ​ከ፡ ​የኃ​ልፍ፡ ​መዓ​ቱ፡ ​ለእ​ግዚ​አብ​ሔር።
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40916LIT1828Mahale#Mary">
               <fo:inline>I-2-13) Fols 126v–127r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Our Lady Mary (​ጸሎ​ተ፡ ​እግ​ዝእ​ትነ፡ ​ማር​ያም፡) or Magnificat</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​እግ​ዝእ​ትነ፡ ​ማር​ያም፡ ​ድን​ግል፡ ወ ላ ​ዲተ፡ ​አም​ላክ፡
                                        ​፲፫  ​ታዓ​ብዮ፡ ​ነፍ​ስየ፡ ​ለእ​ግዚ​አብ​ሔር ፨
                                        ​ወት​ትኃ​ሠይ፡ ​መን​ፈስ​የ፡ ​በአ​ምላ​ኪየ፡ ​ወመ​ድኃ​ንየ፡
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ወተ​ወክ​ፎ፡ ​ለእ​ስራ​ኤል፡ ​ቍል​ዔሁ ፨
                                        ​ወተ​ዘከ​ረ፡ ​ሣህ​ሎ፡ ​ዘይ​ቤሎ​ሙ፡ ​ለአ​በዊነ ፨
                                        ​ለአ​ብር​ሃም፡ ​ወለ​ዘር​ኡ፡ ​እስ​ከ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e40968LIT1828Mahale#Zachariah">
               <fo:inline>I-2-14) Fols 127r–127v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Zachariah (​ጸሎ​ተ፡ ​ዘካ​ርያ​ስ፡ ​ካህ​ን፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ዘካ​ርያ​ስ፡ ​ነቢ​ይ፡
                                        ​፲፬  ​ይት​ባረ​ክ፡ ​እግ​ዚአ​ብሔ​ር፡ ​አም​ላከ፡ ​እስ​ራኤል ፨
                                        ​ዘተ​ሠሃ​ለኒ፡ ​ወገ​ብረ፡ ​መድ​ኃኒ​ተ፡ ​ለሕ​ዝበ፡ ​ዚአ​ሁ።
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ለዘ​ሐወ​ፀነ፡ ​እም​አር​ያም ፨
                                        ​ወሠ​ረቀ፡ ​ከመ፡ ​ያር​እዮ​ሙ፡ ​ብር​ሃኖ ፨
                                        ​ለእ​ለ፡ ​ይነ​ብሩ፡ ​ውስ​ተ፡ ​ጽል​መት፡ ​ወጽ​ላሎ​ተ፡ ​ሞት ፨
                                        ​ከመ፡ ​ያር​ትዕ፡ ​እገ​ሪነ፡ ​ውስ​ተ፡ ​ፍኖ​ተ፡ ​ሰላም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e41022LIT1828Mahale#Simeon">
               <fo:inline>I-2-15) Fol. 127v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Simeon, or Nunc Dimittis (​ጸሎ​ተ፡ ​ስም​ዖን፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ስም​ዖን፡ ​ነቢ​ይ።
                                        ​፲፭  ​ይእ​ዜ፡ ​ትሥ​ዕሮ፡ ​ለገ​ብርከ ፨
                                        ​በሰ​ላም፡ ​እግ​ዚኦ፡ ​በከ​መ፡ ​አዘ​ዝከ።
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ዘአ​ስተ​ዳሎ​ከ፡ ​ቅድ​መ፡ ​ኵሉ፡ ​ሕዝ​ብከ ፨
                                        ​ከመ፡ ​ትክ​ሥት፡ ​ብር​ሃነ፡ ​ለአ​ሕዛብ ፨
                                        ​ወክ​ብረ፡ ​ለሕ​ዝብ​ከ፡ ​እስ​ራኤል ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e41072LIT2362Songof">
               <fo:inline>I-3) Fols 127v–134v: <fo:inline xml:lang="en" hyphenate="true">‘’ (​መሓ​ልየ፡ ​መሓ​ልይ፡), CAe 2362.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​መኃ​ልየ፡ ​መኃ​ልይ፡ ​ዝው​እቱ፡ ​ዘሰ​ሎሞ​ን።
                                    ፩  ​ይስ​ዕመ​ኒ፡ ​በስ​ዕመ​ተ፡ ​አፉሁ ፨
                                    ​አዳ​ም፡ ​አጥ​ባት​ኪ፡ ​እም​ወይ​ን።
                                </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​እን​ዘ፡ ​ይነ​ብር፡ ​ውስ​ተ፡ ​ገነት ፨
                                    ​ካል​አን፡ ​ርእ​ይዎ ፨
                                    ​ቃለ​ከ፡ ​አስ​ምዓኒ ፨
                                    ​ጕይ፡ ​አን​ተ፡ ​ወል​ድ፡ ​እኁ​የ፡ ​ወተ​መሰ​ላ፡ ​ለወ​ይጠል ፤
                                    ​ወከ​መ፡ ​ወሬ​ዛ፡ ​ሃየ​ል፡ ​ውስ​ተ፡ ​አድ​ባር፡ ​ድኁ​ኃን ፨
                                </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e41132LIT2509Weddas">
               <fo:inline>I-4) Fols 135ra–146ra: <fo:inline xml:lang="en" hyphenate="true">‘Praise of Mary’ (​ውዳ​ሴ፡ ​ማር​ያም), CAe 2509.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e41138LIT2509Weddas#Monday">
               <fo:inline>I-4-1) Fols 135ra–136ra: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Monday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴሃ፡ ​ለእ​ግዝ​እት​ነ፡ ​ማር​ያም፡ ​ድን​ግል፡ 
                                        ​ወላ​ዲተ፡ ​አም​ላክ፡ ​ዘይ​ትነ​በብ፡ ​በዕ​ለተ፡ ​ሰኑይ<fo:inline>[፡]</fo:inline>
                                        ​ፈቀ​ደ፡ ​እግ​ዚእ፡ ​ያግ​ዕዞ<fo:inline>[፡]</fo:inline>
                                            ​ለአ​ዳም፡ ​ኅዙ​ነ፡ ​ወትኩ ዘ<fo:inline>[፡]</fo:inline>
                                        ​ልብ፡ ​ወያ​ግብ​ኦ፡ ​ኀበ<fo:inline>[፡]</fo:inline>
                                        ​ዘት​ካት፡ ​መን​በሩ ፨ 
                                        ​ሰአ​ሊ፡ ​ለነ፡ ​ቅድ​ስት ፨
                                        ሠ ​ረቀ፡
                                        ​በሥ​ጋ፡ ​እም​ድን​ግል፡ ​ዘእ​ንበ​ለ፡ ​ዘር​አ፡ ​ብእ​ሲ፡ ​ወአ​ድኃ​ነነ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ወረ​ሰይ​ካ፡ ​ለሔ​ዋን፡ ​አግ​ዓዚ​ተ፡ ​እም  (fol. 136ra)  ​ፃዕ​ረ፡ ​ሞት፡ ​ወወ​ሀብ​ከነ፡ ​መንፈ<fo:inline>ስ (!)</fo:inline>፡ 
                                        ​ልደ​ት፡ ​ባረ​ክና​ከ፡ ​ምስ​ለ፡ ​መላ​እክ​ቲከ ፨
                                        ሰ ፤ 
                                            ለ ፤ 
                                            ቅ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e41205LIT2509Weddas#Tuesday">
               <fo:inline>I-4-2) Fols 136ra–137vb: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Tuesday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​በሠ​ሉስ፡ ​አክ​ሊለ፡ ​ምክ​ህነ፡ ​ወቀ​ዳሚተ<fo:inline>[፡]</fo:inline>
                                        ​መድ​ኃኒ​ትነ፡ ​ወመ​ሠረ​ተ፡
                                        ​ንጽ​ሕነ፡ ​ኮነ፡ በ ​ማር​ያም፡  ​ድን​ግል፡ ​እን​ተ፡ ​ወለ​ደት፡
                                        ​ለነ፡ ​ዘእ​ግዚ​አብ​ሔር፡ ​ቃለ። ​ዘኮ​ነ፡ ​ሰብ​አ፡ ​በእ​ንተ፡ ​መድ​ኃኒ​ትነ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ይሰ​ፍሑ፡ ​ክነ​ፊሆ​ሙ፡ ​ወይ​ብሉ፡ ​ዝን​ቱ፡ ​ውእ​ቱ፡ ​ንጉ​ሠ፡ ​ስብ​ሐት ፨ 
                                        ​መጽ​አ፡ ​ይስ​ረይ፡ ​ኃጢ​አተ፡ ​ዓለ​ም፡ ​በዕ​በየ፡ ​ሣህሉ ፤
                                        ሰ ፤ 
                                            ለ ፤ 
                                            ቅ ፤
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e41250LIT2509Weddas#Wednesday">
               <fo:inline>I-4-3) Fols 137vb–139vb: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Wednesday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​ዘረ​ቡዕ፡ ​ኵሉ፡ ​ሰራ​ዊተ፡ ​ሰማ​ያት፡ ይ ​ብሉ፡
                                        ​ብፅ​ዕት፡ ​አን​ቲ፡ ​ሰማ​ይ፡ ​ዳግ​ሚት፡ ​ዲበ፡ ​ምድር ፨ 
                                        ​ኆኅ​ተ፡ ​ምሥራ  (fol. 138ra)  ​ቅ፡
                                         ​ማር​ያም<fo:inline>[፡]</fo:inline> ​ድን​ግል፡ ​ከብ​ካብ፡ ​ንጹ​ሕ፡
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ወአ​ንሶ​ሰወ፡ ​ምስ​ለ፡ ​ሰብእ ፨ 
                                        ​እስ​መ፡ ​መሐ​ሪ፡ ​ውእ​ቱ፡ ​ወመ​ፍቀሬ<fo:inline>[፡]</fo:inline>
                                        ​ሰብ​እ፡ ​አድ​ኃነ፡ ​ነፍ​ሳቲ​ነ፡
                                        ​በም​ጽአ​ቱ፡ ​ቅዱስ ፤ 
                                        ሰ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e41294LIT2509Weddas#Thursday">
               <fo:inline>I-4-4) Fols 139vb–142ra: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Thursday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​ዘሐ​ሙስ፡ ​ዕፀ፡ ​እን​ተ፡ ​ርእ​የ፡ ​ሙሴ፡ ​በነ​ደ፡ 
                                        ​እሳ​ት፡ ​ውስ​ተ፡ ​ገዳ​ም፡
                                        ​ወአ​ዕፁ​ቂሃ፡ ​ኢት​ውዒ፡ ​ትመ​ስል፡
                                         ​ማር​ያም፡  ​ድን​ግል፡
                                        ​ዘእ​ንበ​ለ፡ ​ርኵ​ስ፡
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ወኮ​ነ፡ ​ሰብ​አ፡ ​ከማ​ነ፡ ​ዘእ​ንበ​ለ፡ ​ኃጢ​አት፡ ​ባሕ​ቲታ፡ ​ወተ​ወል​ደ፡ ​በቤ​ተ፡ ​ልሔ​ም፡ ​በከ​መ፡ ​ሰበ​ኩ፡
                                        ​ነቢ​ያት ፤  ​አድ​ኃነ​ነ፡
                                        ​ወቤ​ዝወ​ነ፡ ​ወረ​ሰየ​ነ፡ ​ሕዝ​በ፡ ​ዚአሁ ፨
                                        ሰ ፤ 
                                            ለ ፤ 
                                            ቅ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e41334LIT2509Weddas#Friday">
               <fo:inline>I-4-5) Fols 142ra–143va: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Friday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​ዘዓ​ርብ፡ ​ቡር​ክት፡ ​አን​ቲ፡ ​እም​አን​ስት፡  ​ወቡ​ሩክ፡ ​ፍሬ፡ ​ከር​ሥኪ፡
                                        ኦ ​ማር​ያም፡  ​ድን​ግል፡  (b)   ​ወላ​ዲተ፡ ​አም​ላክ፡ ​ዘእ​ንበ​ለ፡
                                        ​ርኵስ ፤ 
                                        ​ሠረ​ቀ፡ ​ለነ፡ ​እም​ኔኪ፡ ​ፀሐ​የ፡ ​ጽድ​ቅ፡ ​ወአ​ቅረ​በ፡ ​ታሕ​ተ፡ ​ክነ​ፊሁ፡
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​በእ​ንተ​ዝ፡ ​ንዌ​ድሰ​ኪ፡ ​በከ​መ፡ ​ገብ​ርኤ​ል፡ ​መል​አክ፡ ​እን​ዘ፡ ​ንብል ፨ 
                                        ​ቡር​ክት፡ ​አን​ቲ፡  ​ማር​ያም፡  ​ወቡ<fo:inline>[...]</fo:inline>​ሩክ፡ ​ፍሬ፡
                                        ​ከር​ሥኪ ፨ 
                                        ​ተፈ​ሥሒ፡ ​ኦም​ልዕ​ተ፡ ​ጸጋ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ምስ​ሌኪ፡  ​ሰ፡ ​ለ።
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e41376LIT2509Weddas#Saturday">
               <fo:inline>I-4-6) Fols 143vb–144vb: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Saturday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​ዘቀ​ዳሚ​ት፡ ​ንጽ​ሕት፡ ​ወብ​ርህ​ት፡
                                            ​ወቅድ ​ስት፡ ​በኵ​ሉ፡ ​እን​ተ፡ ​ኃቀ​ፈቶ፡ ​ለእ​ግዚ​እ፡ ​በእ​ራኃ ፤ 
                                        ​ወኵ​ሉ፡ ​ፍጥ​ረት፡ ​ይት​ፌሥ​ሑ፡ ​ምስ​ሌሃ ፤ 
                                        ​እን​ዘ፡ ​ይጸ​ርሑ፡ ​ወይ​ብሉ ፨ 
                                        ​ሰአሊ ፤ 
                                        ​ለነ ፤ 
                                        ​ቅድ​ስት ፤
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ሰአ​ሊ፡ ​ለነ፡ ​ኀበ፡ ​ወል​ድኪ፡ ​ኄር፡ ​መድ​ኃኒ​ነ፡ ​ይም​ሐረ​ነ፡ ​ወይ​ሠሃ​ለነ፡ ​ይስ​ረይ፡
                                        ​ኃጢ​አተነ ፤
                                        ሰ ፤  ለ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e41426LIT2509Weddas#Sunday">
               <fo:inline>I-4-7) Fols 144vb–146ra: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Sunday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​ዘሰ​ንበ​ተ፡ ​ክር​ስቲ​ያን፡ ​ተሰ​መይ​ኪ፡ ​ፍቅ ​ርተ፡ ​ኦቡ​ርክ​ት፡
                                        ​እም​አን​ስት ፨ 
                                        ​አን​ቲ፡ ​ውእ​ቱ፡ ​ዳግ​ሚት፡ ​ቀመ​ር፡ ​እን​ተ፡ ​ትሰ​መይ፡
                                        ​ቅድ​ስተ፡ ​ቅዱ​ሳን፡
                                        ​ወው​ስቴ​ታ፡ ​ጽላ​ተ፡ ​ኪዳን ፨
                                        ፲  ​ቃላ​ት፡ ​እለ፡ ​ተጽ​ሕፋ፡ ​በአ​ፃብ​ዒሁ፡ 
                                        ​ለእ​ግዚ  (fol. 145ra)  ​አብ​ሔር ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ሰአ​ሊ፡ ​ለነ፡ ​ኀበ፡ ​እግ​ዚእ​ነ፡ ​ወመ​ድኃ​ኒነ፡ ​ኢየ​ሱስ፡ ​ክር​ስቶስ ፨ 
                                        ​ያጽ​ንዓ​ነ፡ ​በር​ትዕ​ት፡ ​ሃይ​ማኖ​ት፡ ​ውስ​ተ፡ ​አሚ​ነ፡ ​ዚአሁ ፤ 
                                        ​ይፀ​ግወ​ነ፡ ​ሣህ​ሎ፡
                                        ​ወም​ሕረ​ቶ፡ ​ይስ​ረይ፡ ​ኃጢ​አተ<fo:inline>[፡]</fo:inline>
                                        ​በብ​ዝኃ፡ ​ምሕ​ረቱ ፨ 
                                        ​ሰአሊ ፤ 
                                        ​ለነ ፤ 
                                        ​ቅድ​ስት ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e41485LIT1113Anqasa">
               <fo:inline>I-5) Fols 146rb–151rb: <fo:inline xml:lang="en" hyphenate="true">‘Gate of Light’ (​አን​ቀጸ፡ ​ብር​ሃን፡), CAe 1113.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​ውዳ​ሴ፡ ​ወግ​ናይ፡ ​እሙ<fo:inline>[፡]</fo:inline>
                                        ​ለአ​ዶና​ይ፡ ​ዘእ​ግዝ​እት​ነ፡ ​ማር​ያም፡
                                        <fo:inline>[...]</fo:inline>
                                    ​ቅድ​ስት፡ ​ወብ​ፅዕ​ት፡ ​ስብ​ሕት፡ ​ወቡ​ርክት<fo:inline>[፡]</fo:inline>
                                    ​ክብ​ርት ፤  ​ወል​ዕል​ት፡ <fo:inline>አንቀ፡ (!)</fo:inline>
                                    ​ብር​ሃን፡ ​መዓ​ርገ፡ ​ሕይ​ወት፡ ​ወማ​ኅደ​ረ፡ ​መለ​ኮት፡ ​ቅድ​ስተ፡ ​ቅዱ​ሳን ፨
                                </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    
                                    ​ስብ​ሐት፡ ​ለኪ፡ ​ኦወ​ላዲ​ተ፡ ​እግ​ዚአ፡ ​ኵሉ ፤ 
                                    ​አኰ​ቴት፡ ​ወክ​ብር፡ ​ለአ​ብ፡ ወ  (b)  ​ወል​ድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱስ ፨ 
                                    ​ይእ​ዜኒ፡ ​ወዘ​ልፈ​ኒ፡ ​ወለ​ዓለ​መ፡ ​ዓለ​ም፡ ​አሜ​ን፡
                                    ​ወአ​ሜን<fo:inline>[...]</fo:inline>፨ 
                                        ​ወል​ድኪ ፤  ​ሣህሎ ፤ 
                                        ​ይክ​ፍለነ ፨ 
                                        ​ሰአሊ ፤  ​ለነ ፤ 
                                        ​ቅድ​ስት ፨
                                </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Additional notes</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 1r: Note in Gǝʿǝz recording a familial or symbolic kinship between
                                        one ʾAmāra and one Tasfāy.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​አማ​ረ፡ ​ወተ​ስፋ​ይ፡ ​አሀ​ው፡ ​ውእ​ቶሙ፡
                                    </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 1v: Incomplete ownership note in blue pen.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ዝን​ቱ፡ ዊ<fo:inline>...</fo:inline> ​ዝን​ቱ፡ ​ዳዊን
                                    </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>‘
                     Malkǝʾ -hymn to the Sabbath’ (​መል​ክአ፡ ​ሰን​በት፡), CAe 2889.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        Incipit: 
                                            Fol. 2r
                                            ​ሰላ​ም፡ ​ለዝ​ክረ፡ ​ስም​ኪ፡ ​ፀዳ​ለ፡ ​ምሥ ​ራቅ፡ ​ወም​ዕራ​ብ።
                                            ​ሰሜ​ን፡ ​ወደ​ቡብ ፨
                                            ​ሰን​በተ፡ ​ክር​ስቲ​ያን፡ ​ቅድ​ስት፡ ​መር​ዓተ፡  ​በግ​ዑ፡
                                            ​ለአብ ፨ 
                                            ​በመ​ዓል​ት፡ ​ወበ​ሌሊ​ት፡ ​በቃ​ለ፡ ​ኵሉ፡ ​ንባብ ፨ 
                                            ​ይት​ፌሥ​ሑ፡ ​ብኪ፡ ​አሕ​ዛብ፡ ​ወሕ​ዝብ ፨
                                        ... 
                                    </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>4)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 4r: Introduction to ms_i1.1 added secondarily in red.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        Incipit: 
                                            ​ነዓ፡ ​ኀቤ<fo:inline>&lt;...&gt;</fo:inline>፡ ​ዳዊ​ት፡ ​ንጉ​ሠ፡ ​እስ​ራኤ​ል፡
                                        ... 
                                    </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>5)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Scribbles in pen, e.g. on fols 4r, 5r, 6r, 53r;
                                        Gǝʿǝz names of the week in some of the latter parts of the manuscript:
                                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ዘሐ​ሙስ</fo:inline> (on 80r, 87r),
                                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                           <fo:inline>ዘዓበርብ (!)</fo:inline>
                        </fo:inline> (on 93r).</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>6)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>The Gǝʿǝz/Amharic names of the weekdays have been written in pencil the upper margin:
                                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ዘሰ​ኑይ</fo:inline> (on fols 4r, 10r, 17r),
                                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ዘሰ​ሉስ</fo:inline> (on fols 24r, 33r, 40r),
                                        <fo:inline font-family="Ludolfus">​ዘሮብ</fo:inline> (on fols 45r, 53v, 64r),
                                        <fo:inline font-family="Ludolfus">​ዘሐሙ</fo:inline>/<fo:inline font-family="Ludolfus">​ዘሐ​ሙስ</fo:inline>
                                        (on fols 64r, 71v, 77r),
                                        <fo:inline font-family="Ludolfus">​ዘዓ​ርብ</fo:inline> (on fols 89r, 101r),
                                        <fo:inline font-family="Ludolfus">​ዘቀ​ዳሚት</fo:inline> (on fols 104r, 110r),
                                        <fo:inline font-family="Ludolfus">​ዘሰ​ንበ​ት፡ ​ክር</fo:inline> (on fol. 116r),
                                        .</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>7)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 127v: The Gǝʿǝz names of the weekdays have been written in pencil the upper margin.
                                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ዘቀ​ዳሚ​ት፡ <fo:inline>ሰሎጥ (!)</fo:inline>
                        </fo:inline> (on fol. 127v),
                                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ዘቀ​ዳሚ​ት፡</fo:inline> (on fols 128v),
                                        scribbles on fol. 129r.
                                    </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>8)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 152v: Ownership note of <fo:inline id="d1e42242PRS14989GabraEgz">Gabra ʾƎgziʾabǝḥer</fo:inline>.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ዝንቱ<fo:inline>[፡]</fo:inline> ​ዳዊት<fo:inline>[፡]</fo:inline>
                           <fo:inline>[...]</fo:inline> ​ዘገ​ብረ፡ <fo:inline>እዚአብሔር፡ (!)</fo:inline>
                                        ​ፀፃ​ዳሊ<fo:inline>[፡]</fo:inline>
                           <fo:inline>በኖበ አቡ (!)</fo:inline> ​አለቃ<fo:inline>[፡]</fo:inline>
                                        ገ<fo:inline>[ብ]</fo:inline>ረ<fo:inline>[፡]</fo:inline> እ
                                    </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Varia</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                                        Letters and words have been erased (e.g. fols 43v, 71r, 148rb),
                                        sometimes with angular symbols filling the lines,
                                        and letters have been marked for deletion by over- and underlining
                                        or encircling
                                        (e.g. fols 9r, 87r, 96r),
                                        or blotted out (e.g. 14r, 64v, 81v).

                                        Letters and words have been added interlineally (e.g. fols 21v, 36r, 63v),
                                        over erasures (e.g. 13v, 76r, 150rb),
                                        and, at least once, in the upper margin with a <fo:inline font-style="italic">tamallas</fo:inline>-sign
                                        indicating their position in the text (e.g. , 57v, ).

                                        Compressed script (e.g. 4r, 104v, 116v), line take-ups
                                        (e.g. 4r, 51r, 91v), and, more rarely, line take-downs (e.g. 24v, 53r)
                                        are used.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>A white sticker is glued to the inner side of the front board, in the middle. The name
                                        of <fo:inline id="d1e42308PRS5782JuelJen">Bent Juel-Jensen</fo:inline> is printed on it
                                        (‘<fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ቤን​ት፡ ​ዩው​ል፡ ​የን​ሰን።</fo:inline>’) and the signatures ‘MS Aeth. e. 35’ is written in pencil.
                                        An additional sticker, with the signature ‘Ms 23’ on it, is glued below the previous one.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 59r: Secondary note marking the midpoint of ms_i1.1.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>4)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 2v, 5r, 105v, 106r, 152v: Scribbles and pen trials. Crude drawings of crosses (fols 4r, 6r).</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>5)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 2r, 3r, 151rb–152r: Erased notes in the originally empty spaces, with occasional letters still decipherable.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>
                                      The book is bound in wooden boards covered with reddish-brown blind-tooled leather.
                                    
                                      The boards are cut to the same size as the bookblock and present external shallow bevels.
                                      On the inner surface of the lower board, in the middle, remnants of a greyish substance are present,
                                      which perhaps was used to glue a <fo:inline id="d1e42362">mirror</fo:inline>.
                                    
                                      Full brown leather cover, once red, as can be seen from the turn-ins.
                                      The turn-ins have been trimmed out, and they form butt mitres at the corners.
                                      An <fo:inline id="d1e42368">additional leather patch</fo:inline> has been added along the inner margin of the boards to fill the gap between the turn-ins.
                                      The cover shows a fine blind-tooled decoration, identical on both sides of the cover. The turn-ins and the spine are also decorated.
                                      The decoration consists of three concentric frames surrounding a central rectangular panel featuring a diamond-shaped cross
                                      surmounted by a roof-like frame and above it a diamond shape.
                                      Frames composed by the repetition of single tools, enclosed between <fo:inline id="d1e42371">double straight lines</fo:inline>,
                                      alternate with empty ones.
                                      Proceeding from the outer to the inner frame, the repeating decoration motifs are <fo:inline id="d1e42374">criss-cross</fo:inline> and
                                      <fo:inline id="d1e42377">X-forms</fo:inline>.
                                      Dotted lines between double straight lines form the cross.
                                      At the ends of the arms of the cross there are four <fo:inline id="d1e42380">double circles</fo:inline>.
                                      Groups of four double circles are also stamped at the intersections of the double straight lines.
                                      In the areas at the foot of the cross, the triple straight lines form two triangles, each surmounted by four double circles.
                                      Concentric frames of double straight lines decorate the turn-ins.
                                      On the spine, <fo:inline id="d1e42384">triple straight lines</fo:inline> delimit four panels in which double straight lines cross each other diagonally, forming eight-pointed stars.
                                      In the middle of which, a double circle was stamped.
                                    
                                      The endbands are missing but their turn-ins have been preserved.
                                    
                                      Chainstitch sewing on four sewing stations (two pairs); periodic fold pattern; Z-plied threads.
                                      Between each pair of sewing stations there are two thread lengths.
                                    
                                  At the head and tail are preserved the short horizontal stitches used to pierce the leather on the spine
                                  in two points (at the head and tail), thus fixing the endbands to the cover.
                                
                                  The manuscript is provided with a leather two-piece single-walled satchel with a hanging strap,
                                  which passes through two flaps on the bottom panels of both cases.
                                
                                  Threads of various colours are inserted in the outer margins for navigating the text.
                                  More specifically, a red <fo:inline id="d1e42406">leaf string marker</fo:inline> is inserted in the outer margin of fols 4, 40, 109, 127, 145 and a
                                  green <fo:inline id="d1e42411">leaf string marker</fo:inline> is inserted in the upper margin of fols 10, 45, 64, 77, 104, 134.
                                </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Foliation</fo:block>
            <fo:block>Pencil foliation in the upper right corner carried out by the Bodleian Library
                                    in January 2020 (1–152).</fo:block>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Quire structure</fo:block>
         <fo:block>16 quires. A<fo:inline font-size="7pt" vertical-align="text-top">2+1 (Fols 1r–3v)</fo:inline> – I<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 4r–13v)</fo:inline> – II<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 14r–23v)</fo:inline> – III<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 24r–33v)</fo:inline> – IV<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 34r–43v)</fo:inline> – V<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 44r–53v)</fo:inline> – VI<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 54r–63v)</fo:inline> – VII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 64r–73v)</fo:inline> – VIII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 74r–83v)</fo:inline> – IX<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 84r–93v)</fo:inline> – X<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 94r–103v)</fo:inline> – XI<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 104r–113v)</fo:inline> – XII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 114r–123v)</fo:inline> – XIII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 124r–133v)</fo:inline> – XIV<fo:inline font-size="7pt" vertical-align="text-top">8+2 (Fols 134r–143v)</fo:inline> – XV<fo:inline font-size="7pt" vertical-align="text-top">8+1 (Fols 144r–152v)</fo:inline>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 4r–134v: 1
                                    column (24 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 24r.The characters per line are 5–25.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            164 × 116 mm (fol. 24r).
                                            </fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            114 × 99 mm (fol. 24r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 18 mm, bottom: 34 mm, right: 10 mm, left: 8 mm (fol. 24r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 135ra–151rb: 2
                                    columns (24 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 144r.The characters per line per column are 7–11.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            164 × 116 mm (fol. 24r).
                                            </fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            112 × 89 mm (fol. 144r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 18 mm, bottom: 33 mm, right: 18 mm, left: 8 mm, intercolumn: 6 mm (fol. 144r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Ruling and pricking are visible. Both primary and ruling pricks are visible. The upper and bottom lines are written above the ruling.
                                     Ruling and pricking are visible. Both primary and ruling pricks are visible. The upper and bottom lines are written above the ruling.
                                     Ruling pattern: 1E!-1E!/0-0/0-0/C.  Ruling pattern: 1E!-1E!-1E!1E!/0-0/0-0/C.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->nineteenth–mid-twentieth century.. Trained hand. The handwriting remains uniform throughout the
                                    manuscript. It is characterized by finely shaped, regularly spaced
                                    characters.<fo:block>Ink: Black, red.</fo:block>
                           <fo:block>Rubrication: Several groups of lines on
                                    the incipit page of the Book of Psalms (fol. 4r) as well as
                                    the title, number, and second line of each psalm (on fol. 77r,
                                    the psalm title covers two rubricated lines and is followed by two lines written in black
                                    and two rubricated lines); the explanations of the Hebrew letters in Ps 118,
                                    the names of the Hebrew letters, and the first line of each section of Ps 118;
                                    the letter <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">ስ</fo:inline> in the abbreviation
                                    found at the end of most lines of Ps 135 (fols 106r–106v);
                                    the letters <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">ይ</fo:inline>, <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">ብ</fo:inline> and
                                    <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">ዎ</fo:inline> in the word
                                    <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ይሴ​ብሕ​ዎ፡</fo:inline> in Ps 148 (fol. 114r);
                                    the letters <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">ብ</fo:inline> and <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">ዎ</fo:inline> (including the
                                    word divider) in the word <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ሰብ​ሕዎ፡</fo:inline> in Ps 150 (fol. 115r);
                                    title line, number, and first line of each of the Canticles;
                                    the letters <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">ይ</fo:inline>, <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">ር</fo:inline> and
                                    <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">ዎ</fo:inline> (including the word divider) in the word
                                    <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ይሴ​ብሕ​ዎ፡</fo:inline> in the Third song of the Three Youths (fols 123v–124v);
                                    title line, number, and first line of each section of Song of Songs;
                                    several groups of lines of the incipit page of Praise of Mary (fol. 135r);
                                    the first letter(s) of each repetition of the refrains in the Praise of Mary
                                    and the Gate of Light;
                                    the first two lines of each week-day section of the Praise of Mary as well as two
                                    lines in the first occurrence of the refrain; the word
                                    <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​እግ​ዚአ​ብሔ​ር፡</fo:inline>
                                    and the name of <fo:inline id="d1e41961PRS6819Mary">St Mary</fo:inline>; elements of
                                    the punctuation marks, text dividers, and numerals.</fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Decoration</fo:block>
         <fo:block margin-top="3mm" margin-bottom="3mm" white-space-collapse="true">The image on fol. 3v was probably executed
                        in the 1900s. The bands are likely
                        contemporary with the writing </fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Miniatures</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em">
            <fo:inline>(66) Fol. 3v: <fo:inline>An archangel coloured with pencil crayons.
                               </fo:inline>
            </fo:inline>
         </fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Headpieces</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em">
            <fo:inline>(16) Fols 4r, 10r, 16v, 23v, 40r, 45r, 53r, 64r, 71v, 77r, 89r, 101r, 104r, 109v, 115v, 127v: <fo:inline>Slender bands, filled with geometric patterns and, in some cases, with triangular or circular elements at their tips,
                                  mark some of the incipits and take up about a line of space.
                               </fo:inline>
            </fo:inline>
            <fo:inline>(17) Fol. 135r: <fo:inline>Wider oblong band filled with a fish scale pattern.
                               </fo:inline>
            </fo:inline>
         </fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Drawings</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Other</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Other details</fo:block>
                                  Threads of various colours are inserted in the outer margins for navigating the text.
                                  More specifically, a red <fo:inline id="d1e42406">leaf string marker</fo:inline> is inserted in the outer margin of fols 4, 40, 109, 127, 145 and a
                                  green <fo:inline id="d1e42411">leaf string marker</fo:inline> is inserted in the upper margin of fols 10, 45, 64, 77, 104, 134.
                                <fo:block>Holes and tears resulting from parchment making have been carefully repaired by sewing, e.g. on fols 51, 62, 128.
                                    Holes at the end of the bookblock have not been repaired, e.g. on 113, 151, 152.
                                    </fo:block>
            <fo:block/>
            <fo:block/>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Condition</fo:block>
            <fo:block>The condition is good.
                                  It presents traces of use, especially on the lower outer corners,
                                  which intensify fols 92v–101r. Folios present stains of various origins. The ink is smudged on 144.
                                  Tears that occurred after the parchment making have been repaired by sewing and with patches, e.g. on fols 31, 78, 96.
                                    A tear on 38 has not been repaired, and the lower outer corner of the folio has been cut away.
                                  A loss is present on fol. 110, perhaps burned. The endbands are missing, and only their tiedowns are preserved.
                                  The sewing is broken at a few points, e.g. between fol. 18v and fol. 19r, , between 18v and fol. 19r,
                                  and between fol. 138v and fol. 139r.
                                  The leather cover is abraded.
                                </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>nineteenth–mid-twentieth century</fo:inline>
                            The manuscript can be dated palaeographically to period between the nineteenth and the mid-twentieth century.
                            A secondary owner was <fo:inline id="d1e42427PRS14989GabraEgz">Gabra ʾƎgziʾabǝḥer</fo:inline>
                            (see Additional note 8).
                        </fo:block>
            <fo:block>The manuscript was purchased by <fo:inline id="d1e42436PRS5782JuelJen">Bent Juel-Jensen</fo:inline> 
                        through the bookseller <fo:inline id="d1e42438PRS13559Thomas">Alan G. Thomas</fo:inline>.</fo:block>
         </fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLaethe35">https://betamasaheft.eu/BDLaethe35</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
