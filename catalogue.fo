      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLeu1"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. f. 36</fo:block>
            <fo:block>(Bodleian Ullendorff 1, EMIP 03467)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment codex171×155 mm, 155 fols, 17 quires, mid-seventeenth–mid-nineteenth century.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e116353LIT2000Mazmur">
               <fo:inline>I) Fols 1r–138v: <fo:inline xml:lang="en" hyphenate="true">Psalms of David, CAe 2000.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                     <fo:inline>[...]</fo:inline>​ካሬ፡ ​ዘጻ​ድቃ​ን፡ ​ወኃ​ጥአ​ን፡ ​መዝ​ሙር፡ ​ዘዳ​ዊት፡
                                ፩  ​ብፁ​ዕ፡ ​ብእ​ሲ፡ ​ዘኢ​ሖረ፡ ​በም​ክረ፡ ​ረሲ​አን ፨
                                ​ወዘ​ኢቆ​መ፡ ​ውስ​ተ፡ ​ፍኖ​ተ፡ ​ኃጥ​አን።
                                ​ወዘ​ኢነ​በረ፡ ​ውስ​ተ፡ ​መን​በረ፡ ​መስ​ተሣ​ልቃን ፨
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ወረ​ገመ​ኒ፡ ​በአ​ማል​ክቲሁ ፨
                                ​ወአ​ንሰ፡ ​ነሣ​እኩ፡ ​ዘእ​ምላ​ዕሌ​ሁ፡ ​ሰይፈ ፨
                                ​ወመ​ተር​ኩ፡ ​ርእሶ ፨
                                ​ወአ​ሰሰ​ልኩ፡ ​ጽእ​ለተ፡ ​እም​ደቂ​ቀ፡ ​እስ​ራኤል ፨
                            </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e116415LIT1828Mahale">
               <fo:inline>II) Fols 139r–154v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes, CAe 1828.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ማኅ​ልየ፡ ​ነቢ​ያት፡ ​ወጸ​ሎቱ፡ ​ለሙ​ሴ፡ <fo:inline>[...]</fo:inline>
                                ፩  ​ንሴ​ብሖ፡ ​ለእ​ግዚ​አብ​ሔር፡ <fo:inline>ስቡሐ፡ (!)</fo:inline> ​ዘተ​ሰብሐ ፨
                                ​ፈረ​ሰ፡ ​ወመ​ስተ​ፅዕ​ነ፡ ​ወረ​ወ፡ ​ውስ​ተ፡ ​ባሕ​ር።
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ዘአ​ስተ​ዳሎ​ከ፡ ​ቅድ​መ፡ ​ኵሉ፡ ​ሕዝ​ብከ ፨
                                ​ከመ፡ ​ትክ​ሥት፡ ​ብር​ሃነ፡ ​ለአ​ሕዛብ ፨
                                ​ወክ​ብረ፡ ​ለሕ​ዝብ​ከ፡ ​እስ​ራኤል ፨
                            </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Additional notes</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 144v: Unclear note written in Amharic in an untrained hand in the lower margin.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus">
                           <fo:inline>የታሀሳሥ፡ (!)</fo:inline> ​ቅዱ​ሥ፡ ​ሚካ​የል</fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 148v: Record written in Amharic in the upper margin.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus">የ<fo:inline id="d1e116797PRS13978Walde">​ወል​ዴ፡</fo:inline> ፭ ​ጨው</fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 148v: Record written in Amharic in the upper margin.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus">የ<fo:inline id="d1e116811PRS13979Gade">​ገዴ፡</fo:inline> ፪ ​ጨው</fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Varia</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>The manuscript contains very few scribal corrections. Rarely, omitted characters or verses are added above the
                                        line (e.g. fols 66r, 115v), and corrections are added over erasures (e.g. fols 115v, 140r).
                                        Occasional line take-ups (e.g. 3r, 108v, 140r) and take-downs (e.g. fol. 140r).</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 108v, 109r, 134v, 138v, 139r, 155v: Crudely written scribbles of the trinitarian formula (fol. 108v) and other partly illegible and erased
                                        words and characters in the margins.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 120r: A rubricated text has been erased between Psalms 120 and 121.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>4)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 139v: A crudely drawn human figure in the inner margin.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>5)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>A white sticker is glued to the inner side of the front board. The signature ‘MS. Eth. E.U. I’ is printed on it.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>
                                  The book is bound in wooden boards partially covered with brown leather <fo:inline id="d1e116880">quarter cover</fo:inline>.
                                  The outer side of the boards is polished and a dark finishing is present. On the inner sides, the signs of the working tools are visible.
                                
                                  The boards are flush with the bookblock and have external shallow bevels. The grain runs vertically.
                                  The front board is broken in half and was repaired by passing a thread of animal origin through holes drilled along the fracture.
                                
                                  The boards and the spine are partially covered with plain brown leather.
                                
                                  Chainstitch sewing on four sewing stations (two pairs); periodic fold pattern. Two Z-plied threads are used.
                                  The sewing starts from the front board.
                                
                                  The spine of the manuscript has been wrapped in an additional piece of parchment whose extensions are pasted to the inner sides of the boards.
                                </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Foliation</fo:block>
            <fo:block>Pencil foliation in the upper right corner (1–154). One folio after fol. 135
                                    had been skipped in the original foliation and has then been
                                    foliated fol. 136a, , with the original 136,  becoming 136b.</fo:block>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Quire structure</fo:block>
         <fo:block white-space-collapse="true">All quires have been reinforced with modern parchment strips sewn on with a running stitch; the folios are probably partly detached.</fo:block>
         <fo:block>17 quires. I<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 1r–10v)</fo:inline> – II<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 11r–20v)</fo:inline> – III<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 21r–30v)</fo:inline> – IV<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 31r–40v)</fo:inline> – V<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 41r–50v)</fo:inline> – VI<fo:inline font-size="7pt" vertical-align="text-top">6 (Fols 51r–56v)</fo:inline> – VII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 57r–66v)</fo:inline> – VIII<fo:inline font-size="7pt" vertical-align="text-top">6 (Fols 67r–72v)</fo:inline> – IX<fo:inline font-size="7pt" vertical-align="text-top">10+2 (Fols 73r–84v)</fo:inline> – X<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 85r–92v)</fo:inline> – XI<fo:inline font-size="7pt" vertical-align="text-top">10+1 (Fols 93r–103v)</fo:inline> – XII<fo:inline font-size="7pt" vertical-align="text-top">6 (Fols 104r–109v)</fo:inline> – XIII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 110r–119v)</fo:inline> – XIV<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 120r–129v)</fo:inline> – XV<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 130r–138v)</fo:inline> – XVI<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 139r–146v)</fo:inline> – XVII<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 147r–154v)</fo:inline>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 1r–155v: 1
                                    column (16–17 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 2r.The characters per line are 16–31.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            170 × 152 mm (fol. 2r).
                                            </fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            117 × 128 mm (fol. 2r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 19 mm, bottom: 34 mm, right: 16 mm, left: 8 mm (fol. 2r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Ruling and pricking are visible. Both primary and ruling pricks are visible. The upper and bottom lines are written above the ruling.
                                     Ruling pattern: 1A-1A/0-0/0-0/C.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->Mid-seventeenth–mid-nineteenth century.. Slightly irregular hand. Characters are broadly spaced.
                                    The vowel markers of ን and ግ
                                    are extended; the vowel marker of the 5th order is always closed.<fo:block>Ink: Black, red.Black, red.</fo:block>
                           <fo:block>Rubrication: One red line, alternating with black lines, at the beginning of the Psalms of David and the Canticles;
                                    titles and numbers of Psalms; elements of punctuation marks and text dividers.</fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Other details</fo:block>
            <fo:block>Small holes from the parchment making process, e.g. on fols 66, 115.</fo:block>
            <fo:block/>
            <fo:block/>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Condition</fo:block>
            <fo:block>The condition is good.The borders of the folios are darkened by use. Small stains throughout. The upper margins show traces of
                                humidity (e.g. fols 134v–135r).</fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>mid-seventeenth–mid-nineteenth century</fo:inline>
                            The manuscript contains no indications regarding its original owner(s) or place
                            of production. It can be dated palaeographically to the period between
                            the
                            mid-seventeenth and the mid-nineteenth century.
                        </fo:block>
            <fo:block>It was purchased in 1952 at
                            Sotheby’s by
                            <fo:inline id="d1e116916PRS9622Ullendor">Edward Ullendorff</fo:inline>.</fo:block>
            <fo:block>The manuscript entered the Bodleian Libraries as part of the bequest of <fo:inline id="d1e116921PRS9622Ullendor">Edward Ullendorff</fo:inline> after his death in 2011.</fo:block>
         </fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLeu1">https://betamasaheft.eu/BDLeu1</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
