   <fo:page-sequence master-reference="Aethiopica-master">
      <fo:flow flow-name="xsl-region-body" font-family="Ludolfus">
         <fo:block-container font-size="12pt"
                             space-before="25.2pt"
                             space-after="12.24pt"
                             font-family="Ludolfus"
                             font-weight="700"
                             text-align="center"
                             display-align="center">
            <fo:block>The Catalogue of Dabra Maso</fo:block>
         </fo:block-container>
         <fo:block font-size="12pt"
                   space-before="25.2pt"
                   space-after="12.24pt"
                   font-family="Ludolfus"
                   font-weight="700"
                   text-align="center"
                   display-align="center">Denis Nosnitsin</fo:block>
         <fo:block text-align="center"
                   font-size="20pt"
                   font-style="italic"
                   space-before="2em"
                   space-after="2em"/>
      </fo:flow>
   </fo:page-sequence>
   <fo:page-sequence initial-page-number="auto-odd"
