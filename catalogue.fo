      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLaethe34"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. e. 34</fo:block>
            <fo:block>(Arch. O. e. 12, Juel-Jensen 12, Bodleian Aeth. e. 29)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment codex193×179 mm (weight: 204g), I+4+I fols ( blank), mid-seventeenth–mid-eighteenth century.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <!--<msItem xml:id="ms_i1">

                        </msItem>-->
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>
                                The book has a modern non-Ethiopian binding in cardboard boards, fully covered with brown leather.
                              
                                  The boards exceed the size of the illuminated folios to protect them.
                              
                                Full brown plain leather cover. On the front cover is stamped
                                the name of <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ቤን​ት፡ ​ዩው​ል፡ ​የን​ሰን።</fo:inline> in gold characters.
                              
                                  The book is housed in a modern cardboard slipcase covered in green cloth, which folios the spine exposed.
                              </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Foliation</fo:block>
            <fo:block>The manuscript has not been foliated.</fo:block>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Quire structure</fo:block>
         <fo:block>1 quire. I<fo:inline font-size="7pt" vertical-align="text-top">4 (Fols 1r–4v)</fo:inline>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 1v–4r: 
                                    column ( written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on painted area and margin dimensions taken from fol. 4r.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            130 × 130 mm (fol. 4r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 5 mm, bottom: 28 mm, right: 16 mm, left: 4 mm (fol. 4r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->Mid-seventeenth–mid-eighteenth century.. 
                                    Fine hand, responsible for the captions.
                                <fo:block>Ink: Black.</fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Decoration</fo:block>
         <fo:block margin-top="3mm" margin-bottom="3mm" white-space-collapse="true">The illustrations grouped in this volume were first studied by their former
                             owner, Bent Juel-Jensen, who assigned them, with reason, to the period between
                             <fo:inline>1650 and 1750</fo:inline> and
                             attributed them to the so-called <fo:inline id="d1e14422PRS12971GroundHornbill">Gound Hornbill Artist</fo:inline>.</fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Miniatures</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em">
            <fo:inline>(5) Fol. 1v: <fo:inline>The miniature depicts several members of the Zāgʷe dynasty.
                                   The five standing Holy Men
                                   are identified by captions as:
                              <fo:inline id="d1e14434PRS10325Yemreha">Yǝmrǝḥanna Krǝstos</fo:inline>,
                              <fo:inline id="d1e14436PRS6152Lalibala">Lālibalā</fo:inline>,
                               <fo:inline id="d1e14438PRS7437Naakkwe">Naʾakkʷǝto Laʾab</fo:inline>, and
                               <fo:inline id="d1e14440PRS5111harbay">Ḥarbāy</fo:inline>;
                                   it is unclear if the last figure represents the Aksumite King
                               <fo:inline id="d1e14443PRS4327GabraMa">Gabra Masqal</fo:inline>
                                   since this was also the regal name used by several rulers of the Zāgʷe dynasty.
                                   All five men have a <fo:inline id="d1e14445">halo</fo:inline> and a <fo:inline id="d1e14447">codex</fo:inline> in their right hand.
                                   <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                     <fo:inline id="d1e14451PRS10325Yemreha">​ይም​ርሐ​ነ፡ ​ክር​ስቶ​ስ፡</fo:inline>
                     <fo:inline id="d1e14454PRS6152Lalibala">​ላሊ​በላ፡</fo:inline>
                     <fo:inline id="d1e14457PRS7437Naakkwe">​ነአ​ኵቶ፡ ​ለአ​ብ፡ </fo:inline>
                     <fo:inline id="d1e14460PRS5111harbay">​ሃር​ቤ፡</fo:inline> ​ገብ​ረ፡ ​መስ​ቀል፡</fo:inline>
               </fo:inline>
            </fo:inline>
            <fo:inline>(6) Fol. 2v: <fo:inline>Three Holy Men.
                                   The one in the centre, in an <fo:inline id="d1e14475">orans pose</fo:inline>,  is
                                   <fo:inline id="d1e14478PRS4306GabraMa">Gabra Manfas Qǝddus</fo:inline>. The two smaller figures at his
                                   side are <fo:inline id="d1e14480PRS7049Michael">Michael</fo:inline>, to the right and
                                   <fo:inline id="d1e14482PRS7840Phanuel">Phanuel</fo:inline>, to the right.
                                   The <fo:inline id="d1e14485">angels</fo:inline> hold a <fo:inline id="d1e14488">sword</fo:inline>;
                                   all three figures have a <fo:inline id="d1e14490">halo</fo:inline>.
                                   <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em"> ​ሚካ​ኤል
                                       <fo:inline>&lt;...&gt;</fo:inline>
                                      ​አቡ​ነ፡ ​ገብ​ረ፡ ​መን​ፈስ፡ ​ቅዱ​ስ፡ ​ፋኑ​ኤል፡ ​መል​አክ፡</fo:inline>
               </fo:inline>
            </fo:inline>
            <fo:inline>(7) Fol. 3r: <fo:inline>Five Holy Men with
                                <fo:inline id="d1e14508">swords</fo:inline>, identified, from left to right, as
                                <fo:inline id="d1e14511PRS3126Claudius">Claudius</fo:inline>
                  <fo:inline id="d1e14513PRS2548Basilide">Basilides</fo:inline>
                  <fo:inline id="d1e14515PRS7025Mercury">Mercurius</fo:inline>
                  <fo:inline id="d1e14518PRS9470Theodore">Theodore Stratelates</fo:inline>
                  <fo:inline id="d1e14520PRS9744Victor">Victor</fo:inline>
                                The warrior <fo:inline id="d1e14522">saints</fo:inline>, who hold a <fo:inline id="d1e14525">sword</fo:inline> and have a <fo:inline id="d1e14527">halo</fo:inline>,
                                are unusually not shown on horseback.
                                <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ፋሲ​ለደ​ስ፡ ​ገላ​ውዴ​ዎስ፡ ​መርቆ<fo:inline>ራ (!)</fo:inline>​ዎስ፡ ​ቴዎ​ድሮ​ስ፡ ​ፊቅ​ጦር፡፡</fo:inline>
                  <!-- It can be ሬ (with "squeezed" loop), I would just write መርቆሬዎስ MV 24.04.2024 -->
               </fo:inline>
            </fo:inline>
            <fo:inline>(8) Fol. 4r: <fo:inline>The Crucifixion
                                   with the <fo:inline id="d1e14547">dead Jesus</fo:inline> on the
                                   <fo:inline id="d1e14550">Cross</fo:inline>. <fo:inline id="d1e14553PRS6819Mary">St Mary</fo:inline>, to the left, is identified by the caption
                                   <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​እግ​ዝእ​ት፡ ​ማር​ያም፡</fo:inline>.
                                   <fo:inline id="d1e14560PRS5695John">John the Apostle</fo:inline>, to the right, is identified by the caption
                                   <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ዮሐ​ንስ፡ ​ረድ​እ፡</fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ፀሐ​ይ፡ ​ጸል​መ፡ ​ዘተ​ሰቅለ<fo:inline>[፡]</fo:inline> ​እግ​ዚእ​ነ፡ ​ወር​ኅ፡ ​ደመ።</fo:inline>
               </fo:inline>
            </fo:inline>
         </fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Headpieces</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Drawings</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Other</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Condition</fo:block>
            <fo:block>The condition is good.
                                  The illuminated folios are damaged by water on the upper external corner,
                                  which has caused the parchment support to warp and turn yellow.
                                  Insects or rodents presumably caused the losses on the lower outer corners of the leaves.
                                </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline id="d1e14614">
                  <fo:inline id="d1e14616LOC3010Ethiop">Ethiopia</fo:inline>
               </fo:inline>
               <fo:inline>mid-seventeenth–mid-eighteenth century</fo:inline>
                            The manuscript can be dated to the period between the mid-seventeenth and
                            the mid-eighteenth century
                            based on the style of the miniatures and their captions.
                        </fo:block>
            <fo:block>Acquired in 1973 by <fo:inline id="d1e14627PRS5782JuelJen">Bent Juel-Jensen</fo:inline> in
                        <fo:inline id="d1e14629LOC4244Laliba">Lālibalā (town)</fo:inline>
                        (see Juel-Jensen 1977,  63–64).</fo:block>
            <fo:block>The manuscript entered the Bodleian Libraries as part of the
                        bequest of <fo:inline id="d1e14639PRS5782JuelJen">Bent Juel-Jensen</fo:inline> after his death in 2006.</fo:block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Bibliography</fo:block>Juel-Jensen 1977; Thomas 1990.</fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLaethe34">https://betamasaheft.eu/BDLaethe34</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
