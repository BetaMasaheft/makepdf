      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLaethg35"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. g. 35</fo:block>
            <fo:block>(Juel-Jensen 28)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment codex61×57 mm (weight: 61g), 48 fols (4 p. blank), 7 quires, mid-seventeenth–mid-nineteenth century.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e49038LIT2866RepCh147">
               <fo:inline>I) Fols 1r–22r: <fo:inline xml:lang="en" hyphenate="true">‘Malkǝʾ-hymn to St George’ (​መል​ክአ፡ ​ጊዮ​ርጊ​ስ፡), CAe 2866.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                 (fol. 1r)  ​ሰላ​ም፡ ​ለዝ​ክረ፡ ​ስም​ከ፡ ​ዘሰ ​ሌዳ፡ ​ሞገ​ስ፡ ​መጽ​ሐፉ ፨
                                    ​ዘያ​ሜኒ፡ ​ኵሎ፡ ​ወያ​ስተሴ ፉ ፨  ​ጥዑ​መ፡ ​ዜና፡
                                 ​ጊዮ​ርጊ​ስ፡  ​ለሐ​ሊበ፡
                                        ​እጐ​ል፡ ​ሱታፉ ፨  ​ሰላ​ምከ፡ ​ወረ​ድኤ​ትከ፡ ​በላ​ዕሌ​የ፡
                                            ​አዕ​ረፉ ፨  ​አኮ፡ ​ለም​ዕር፡ ​ዳዕ​ሙ፡
                                        ​ለዝ​ላፉ ፨
                                          <!--  <hi rend="rubric">ሰ</hi> ለድማኅከ፡ በ<pb n="1v"/>ቅብዓ፡ ደመ፡ ሰም፡
                                            ዘተሴረየ<hi rend="rubric" rendition="#partialRubric">፨</hi> አመ፡ ተወቅዓ፡ ርእስከ፡ በሰፌልያ፡ ሥቃየ፡ ጊ<hi rend="rubric">ዮርጊ</hi> ልዳዊ፡ ቃውመ፡
                                                ነፍስየ፡ እንበለ፡ ይፌጽማ፡ ከናፍርየ፡ ስመ፡
                                            ዚአከ፡ ስምየ<hi rend="rubric" rendition="#partialRubric">፤</hi>
                                በጊዜ፡ <choice resp="MV"><sic>ምንዳቢ፡</sic><corr>ምንዳቤ፡</corr></choice> በለኒ፡ ሐለውኩከ፡ 
                                ዝየ<hi rend="rubric" rendition="#partialRubric">፨</hi>-->
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                              <!--  <hi rend="rubric">ሰ</hi> ለፍልሰተ፡ ሥጋ<pb n="21v"/>ከ፡ ውስተ፡ ልዳዊ፡ ታዕካ<hi rend="rubric" rendition="#partialRubric">፨</hi> ለብሔረ፡
                                ፋርስ፡ ባቲ፡
                                ለሰምዐ<supplied reason="omitted" resp="DR">፡</supplied> ሥቃይ፡ ድኅረ፡ ፈጸምካ<hi rend="rubric" rendition="#partialRubric">፨</hi>
                                <hi rend="rubric">ጊ፡</hi> ፍሱሕ፡
                                መሥተፍሳሄ፡ አልባብ፡ ከመ፡ ምሕርካ<hi rend="rubric" rendition="#partialRubric">፨</hi> ፍልሰተ፡ ሥጋከ፡ <sic>ለፍልሰ</sic><supplied reason="omitted" resp="DR">፡</supplied>
                                ድንግል፡ ተውሰካ<hi rend="rubric" rendition="#partialRubric">፤</hi> በዐለ፡ ትንሣኤ፡ ዕለተ፡ ዋካ፡ ትመስል፡ ፋሲካ<hi rend="rubric" rendition="#partialRubric">፨</hi>-->
                               ​ተወ​ከፍ<fo:inline>[፡]</fo:inline>  (fol. 22r)   ​ሰላ​ምየ፡ ​ዘን​ተ፡ ​ስብ​ሐተ፡
                                ​ወደ​ባቤ ፨ 
                                ​ከመ፡ ​ፄና፡ ​ሰሂ​ን፡ ​ወመ​ዐዘ፡ ​ከርቤ ፨ ጊ  ​ኵነ​ኔ፡ ​በኪ​ዳን​ከ፡
                                ​ዓቃቤ ፨ 
                                ​አን​ተ፡ ​ምስ​ከይ​የ፡ ​በጊ​ዜ፡ ​ምን​ዳቤ ፨  ​ተሰ​ጠው፡ ​ቃል​የ፡ ​ወሰ​ልጥ፡ ​ዘይቤ ፨ ፨
                            </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e49114LIT2799RepCh83">
               <fo:inline>II) Fols 22v–24r: <fo:inline xml:lang="en" hyphenate="true">Salāmtā-hymn to St George, CAe 2799.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                 (fol. 22v)  ​ሰ፡ ​ጊዮ​ርጊስ<fo:inline>[፡]</fo:inline> ​ዘል​ዳ፡ ​መሥ​ተጽ​እነ፡ ​ፈረ​ስ፡
                                ​ፀዐዳ ፤  ​ሰማ​ዕተ፡
                                 ​ማር​ያም<fo:inline>[፡]</fo:inline> ​ድን​ግል፡ ​ለፍ​ቁር፡
                                ​ወልዳ ፨  ​ለጥ​በብ፡ ​ሕን​ፃ፡ ​ማኅ​ፈዳ ፨
                                ሰ  ​ሥቃ​የ፡ ​ስም<fo:inline>[፡]</fo:inline> ​ዕጉ​ስ፡ ​በእ​ንተ፡ ​ኢየ​ሱስ፡
                                ​ክር​ስቶስ ፨  ​ሥጋ​ከኒ፡ ​ክፉ​ል፡ ​እስ​ከ፡ ​ርብ​ዕ፡ ​ወሥ​ልሥ ፨ 
                                ​ምእ​ዝከ​ኒ፡ ​እም​ናር​ዶስ ፨
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ሰ  ​አፈ​ቅረ​ከ፡ ​ልብየ ፨  ​ወአ​ኮ፡ ​አፉየ ፨ 
                                ​ኢታ​ሰት​ት፡ ​አባ፡ ​ማኅ​ለትየ<fo:inline>[፡]</fo:inline>  (fol. 24r)   ​ተወ​ኪፈ​ከ፡ ​ሀበ​ኒ፡
                                ​አሰ​ብየ ፨  ​ለነ​ዳይ ፨ 
                                ​ጊዮ​ርጊ<fo:inline>[፡]</fo:inline> ​ወር​ቅየ ፨ 
                                ​ኦእ​ግዚ​እየ፡ ​ኢየ​ሱስ፡ ​ክር​ስቶ​ስ፡ ​በእ​ንተ፡ ​ክዕ​ወተ፡ ​ደሙ፡ ​ለቅ​ዱስ ፨ 
                                ​ጊዮር<fo:inline>[፡]</fo:inline> ​ሰማ​ዕት​ከ፡ ​መሐ​ረኒ፡ ​ወተ​ሣሃ​ለኒ፡ ​ሊተ፡ ​ለገ​ብር​ከ፡ <fo:inline>[...]</fo:inline>
                  </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e49203LIT3082RepCh362">
               <fo:inline>III) Fols 24v–44v: <fo:inline xml:lang="en" hyphenate="true">‘Malkǝʾ-hymn of the Covenant of Mercy’ (​መል​ክአ፡ ​ኪዳ​ነ፡ ​ምሕ​ረት፡), CAe 3082.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                 (fol. 24v)  ​እግ​ዚአ​ብሔ​ር፡ ​አብ፡ ​ወሃ ​ቤ፡ ​ብር​ሃን፡ ​ዘይ​ሤለ​ስ፡
                                 ​በአ​ካሉ። ​እን​ዘ፡ ​ተዋ​ህዶ<fo:inline>[፡]</fo:inline> ​ያጸ​ንዕ፡ ​በመ​ለኮ​ቱ፡
                                ​ወኃ​ይሉ ፨  ​ዓይ​ነ፡ ​ሕሊ​ናየ፡ ​ያብ​ርህ፡ ​በማ​ኅቶተ<fo:inline>[፡]</fo:inline>
                                ​ጥበ​ብ፡ ​ስነ፡ ​ፀዳሉ ፨  ​ከመ<fo:inline>[፡]</fo:inline>
                                ​ይር​አይ፡ ​ገጸ፡ ​ነገ​ር፡ ​ለኪ​ዳን​ከ፡ ​ዘይ​ደሉ ፨
                                ​ማር​ያም፡  ​እግ​ዝእ​ተ፡ ​ኵሉ፡ ​ዘታ​ሕቱ፡ ​ወላ​ዕሉ ፨
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ነዓ​ኵቶ<fo:inline>[፡]</fo:inline> ​ለእ​ግዚ​አብ​ሔር፡ ​ዘፀ​ውዓ​ነ፡
                                ​በጽ​ዋዔ ፨  ​ተዝ​ካረ፡ ​ኪዳ​ንኪ፡ ​ንግ​በር<fo:inline>[፡]</fo:inline>
                                ​በቅ​ድመ፡ ​ምን​ዱባን<fo:inline>[፡]</fo:inline> (fol. 44v)  
                                ​ጉባዔ ፨  ​ተወ​ጠዊ፡ ​ባሕ​ቱ፡
                                 ​ማር​ያም<fo:inline>[፡]</fo:inline> ​አመ፡ ​ትን​ሣኤ፡ ​ወአ​ንብ​ሪ፡ ​በር​እሰ<fo:inline>[፡]</fo:inline>
                                ​ነፍ​ሱ፡ ​አክ​ሊላ​ተ፡ ​መን​ግሥ​ት፡ ​ሱባዔ ፤  ​ለነ​ባቤ፡ ​ዝን​ቱ፡ ​ድር​ሳን፡
                                 ፵ ወ ፪ ኤ ፨ ፨ ፨
                            </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e49297LIT2812RepCh96">
               <fo:inline>IV) Fols 44v–46v: <fo:inline xml:lang="en" hyphenate="true">Tarafa malkǝʾ to the Malkǝʾa kidāna mǝḥrat, CAe 2812.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ሰላ​ም፡ ​ለኪ፡ ​ኪዳ​ነ፡ ​ምሕ  ​ተስ​ፋየ፡ ​ዘታ​ጸድ​ቂ፡ ​ኃጥአ ፨ 
                                ​ወዘ​ተኃ​ሰሲ፡  ፩
                                 (fol. 45r)   ​በግዓ ፤ 
                                ​ዘተ​ገፈ፡ ​እም​ነ፡ <fo:inline>ተወዘተኃጥአ (!)</fo:inline>፨
                                ​ሰላ  ​ኪዳነ<fo:inline>[፡]</fo:inline> ​ምሕ​ረት፡ ​ሐው​ልት፡ ​ዘተ​ከለ​ኪ፡ ​እግ​ዚእ፡ ​ትእ​ምር​ተ፡
                                ​አድ​ኀኖ፡ ​ትኩ​ኒ፡ ​በኵ​ሉ፡ ​ኃጥአ ፨
                                <!--ፍቅርኪ ዘይጸንዕ<hi rend="rubric" rendition="#partialRubric">፨</hi>-->
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                <!--<hi rend="rubric">ሰላ<supplied reason="omitted" resp="DR">፡</supplied></hi> ኪዳነ፡ ምሕረት፡ አረበነ፡ መንግሥት፡
                                ላዕሉ<hi rend="rubric" rendition="#partialRubric">፨</hi> ዘያፈቅረኪ፡ በተስፋ፡ ይሄሉ። እስመ፡ አመ፡
                                ይከውን፡ ትንሣኤ፡ ኵሉ<hi rend="rubric" rendition="#partialRubric">፨</hi>-->
                                ሰ<fo:inline>[፡]</fo:inline> ​በስ​መ፡ ​ኪዳ​ንኪ፡ ​ቤተ፡ ​ለዘ​ሀነ​ጸ፡
                                ​ገብ​ርኪ ፨  ​ወለ​እለ፡ ​ጸለ​ይነ፡ ​በስ​ምኪ፡
                                 ​ማር​ያም፡ 
                                ​ፈትቲ<fo:inline>[፡]</fo:inline> (fol. 46v)  <fo:inline>እምበረኪትኪ (!)</fo:inline>፡ ​ጸል​ዪ፡ ​ወሰ​አሊ፡ ​ኀበ፡ ​ኄር፡
                                ​ወል​ድኪ ፨ ፨
                            </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Varia</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Very rarely, several words have been erased (fols 13v, 20r).
                                        Spaces for rubrication have been left unfilled on three openings,
                                        (6v–8r, , 15v–16r,
                                        and fols 21v–22r).</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 24r: A name has been erased in the supplication at the end of ms_i2.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>A white sticker with the name of <fo:inline id="d1e49646PRS5782JuelJen">Bent Juel-Jensen</fo:inline> printed (‘<fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ቤን​ት፡ ​ዩው​ል፡ ​የን​ሰን።</fo:inline>’), and the signature ‘Ms.
                                        Aeth. g. 35’ written in pencil is glued onto
                                        the inner side of the front board.
                                        The dating, textual content and shelfmark of the book (‘C 18’, ‘Wedassie Giyorgis’,
                                        ‘Wedassie Maryam (short)’, and ‘MS Aeth JJ 28’) are indicated in pencil on fol. ir. The end of the pencil note is illegible.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>
                                  The book is bound in wooden boards.
                                
                                  The boards are flush with the bookblock and have shallow external bevels. The grain runs vertically.
                                  The external surface of the boards is polished, while the inner surface exhibits signs of the working tool.
                                
                                  Chainstitch sewing on three sewing stations; continuous fold pattern; Z-plied thread.
                                  The bookblock was probably originally sewn on two sewing stations as the boards present only two sites for board attachment.
                                  The manuscript has been resewn adding a third sewing station at a short distance from the second one. The quires also present an unused sewing hole above the first sewing station.
                                  The ends of the thread are knotted in the centrefold of the last quire.
                                
                                  The manuscript is provided with a leather one-piece single-walled satchel with the remnant of a hinging strap.
                                  The satchel is equipped with a long flap extending from the left side panel and a main pointed flap extending from the back to the front
                                  panel to cover the opening of the book compartment.
                                  The fragment of a narrow leather hanging strap passes through two flaps extending from the bottom panel of the case.
                                </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Foliation</fo:block>
            <fo:block>Pencil foliation in the upper right corner carried out by the Bodleian Library
                                    in January 2020 (i–ii+1–46).</fo:block>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Quire structure</fo:block>
         <fo:block>7 quires. A<fo:inline font-size="7pt" vertical-align="text-top">2 (Fols ir–iiv)</fo:inline> – I<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 1r–8v)</fo:inline> – II<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 9r–16v)</fo:inline> – III<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 17r–24v)</fo:inline> – IV<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 25r–32v)</fo:inline> – V<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 33r–40v)</fo:inline> – VI<fo:inline font-size="7pt" vertical-align="text-top">6 (Fols 41r–46v)</fo:inline>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 1r–46v: 1
                                    column (9–10 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 1r.The characters per line are 12–14.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            62 × 55 mm (fol. 1r).
                                            </fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            36 × 41 mm (fol. 1r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 9 mm, bottom: 17 mm, right: 9 mm, left: 5 mm (fol. 1r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Ruling and pricking are visible. Both primary and ruling pricks are visible. The upper and bottom lines are written above the ruling. Ruling pattern: 1A-1A/0-0/0-0/C.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->Mid-seventeenth–mid-nineteenth century.. Mediocre hand. Change of nib on fol. 24v.<fo:block>Ink: Black, red.</fo:block>
                           <fo:block>Rubrication: Incipits of the texts (two lines alternating with a black line on fol. 1r;
                                    holy names; the words <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ሰላም</fo:inline> and <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ጊዮ​ርጊስ</fo:inline> in abbreviated form;
                                    numerals and elements of the numerals and of the punctuation signs.</fo:block>
                           <fo:block>Abbreviations: <fo:list-block provisional-distance-between-starts="6mm"
                                             provisional-label-separation="6mm"
                                             start-indent="cm">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()">
                                       <fo:block>
                                          <fo:inline>1)</fo:inline>
                                       </fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block hyphenate="true">
                                          <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ሰ፡</fo:inline> or <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ሰላ</fo:inline> for <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ሰላ​ም፡</fo:inline> (e.g. fols 14r, 26r, 45r);
                                    </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()">
                                       <fo:block>
                                          <fo:inline>2)</fo:inline>
                                       </fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block hyphenate="true">
                                          <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">ጊ</fo:inline> or <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ጊዮ፡</fo:inline> for <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ጊዮ​ርጊ​ስ፡</fo:inline> (e.g. fols 5v, 14r, 18r).
                                    </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Other details</fo:block>
            <fo:block>The height of fols ir–iiv is inferior to the rest of the manuscript.</fo:block>
            <fo:block/>
            <fo:block/>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Condition</fo:block>
            <fo:block>The condition is deficient.The folios show only slight traces of use.
                                  However, the sewing has become undone since the thread broke in many points with the risk of leaves displacement.
                                  Both boards are detached from the bookblock, together with q1.</fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>mid-seventeenth–mid-nineteenth century</fo:inline>
                            The manuscript can be dated palaeographically to the period between the
                            mid-seventeenth and the mid-nineteenth century.
                            A name, possibly of the original owner, has been erased in a supplication (see Varia note 2).
                        </fo:block>
            <fo:block>The provenance of the manuscript is unknown.</fo:block>
            <fo:block>The manuscript entered the Bodleian Libraries as part of the
                            bequest of <fo:inline id="d1e49700PRS5782JuelJen">Bent Juel-Jensen</fo:inline> after his death in 2006.</fo:block>
         </fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLaethg35">https://betamasaheft.eu/BDLaethg35</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
