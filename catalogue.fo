                     <fo:block font-size="9pt" font-family="Ludolfus" text-align="right"/>
                  </fo:table-cell>
               </fo:table-row>
            </fo:table-body>
         </fo:table>
      </fo:static-content>
      <fo:static-content flow-name="xsl-footnote-separator">
         <fo:block space-before="5mm" space-after="5mm">
            <fo:leader leader-length="30%" rule-thickness="0pt"/>
         </fo:block>
      </fo:static-content>
      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLeu5"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. d. 25</fo:block>
            <fo:block>(Bodleian Ullendorff 5)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment codex256×228 mm (weight: 1581g), 66 fols, 8 quires, first half of the eighteenth century.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e120211LIT1340EnochE">
               <fo:inline>I) Fols 1ra–66vc: <fo:inline xml:lang="en" hyphenate="true">Book of Enoch, CAe 1340.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ዘሄ​ኖክ፡ ​ነቢ​ይ፡ በ ​ረከ​ተ፡ ​አም​ላኩ፡   (b)  ​ተሀ​ሉ፡ ​ምስ​ለ፡ ፍ ​ቁሩ፡ ​ገብ​ረ፡
                                ​እግ​ዚአ  (c)  ​ብሔ​ር፡ ​አቡ​ነ፡ ​ሄኖ​ክ፡  ​ለዓ​ለመ፡ ​ዓለ​ም።
                            </fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ቃለ፡ ​በረ​ከት፡ ​ዘሄ​ኖክ፡ ​ዘከ​መ፡ ​ባረ​ከ፡ ኅ ​ሩያ​ነ፡ ​ወጻ​ድቃ​ነ፡ ​እለ፡ ​ሀለ​ዉ፡ ​ይኩ​ኑ፡  ​በዕ​ለተ፡ ​ምን​ዳቤ፡
                                    ​ለአ​ሰስ​ሎ፡ ​ኵሉ፡ እ ​ኩያ​ን፡ ​ወረ​ሲዓ​ን፡ ​አው​ሥአ፡ ​ሄኖ​ክ፡ ​ወይ​ቤ፡ ​ብእ​ሲ፡ ​ጻድ​ቅ፡ ​ዘእ​ምኀ​በ፡ ​እግ​ዚአ​ብሔ​ር። ​እን​ዘ፡ ​አዕ​ይን​ቲሁ፡ ​ክሡ​ታት።
                                ​ወይ​ሬኢ፡  ​ራእ​የ፡ ​ቅዱ​ሰ፡ ​ዘበ​ሰማ​ያት፡ ​ዘአ​ርአ​ዩኒ፡  ​መላ​እክ​ት።
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                
                                ​ወይ​ሬእ​ይዎ​ሙ፡ ​ለእ​ለ፡ ​ተወ​ልዱ፡ ​በጽ​ልመ​ት፡ ​እን​ዘ፡ ​ይት​ወደ​ዩ፡ ​በጽ​ልመ​ት፡ ​እን​ዘ፡ ​ይት​ወሐ​ውሁ፡ ​ጻድ​ቃን፡ ​ወይ​ጸር​ሑ። ​ወይ​ሬእ​ይዎ​ሙ፡ ​ኃጥ​አን፡
                                ​እን​ዘ፡ ​ይበ​ርሁ። ​ወየ​ሐው​ሩ፡ ​እሙ​ንቱ​ሂ፡ ​በኀ​በ፡ ​ተጽ​ሕፈ፡ ​ሎሙ፡ ​መዋ​ዕል፡ ​ወአ​ዝማ​ን።
                            </fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ተፈ​ጸመ፡ ​መጽ​ሐፈ፡ ​ሄኖ​ክ፡ ​ወስ​ብሐ​ት፡ ለ ​እግ​ዚአ​ብሔ​ር፡ ​አሜ​ን።
                            </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Varia</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Corrections over erasure on fols 1rc, 66vb.
                                        <!-- Further information on the scribal phenomena might be retrieved after inspecting or photographing the entire MS -->
                                    </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>The manuscript has no shelfmark label.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>The supplication formula on the incipit page of the text mentions Gabra
                                        ʾƎgziʾabǝḥer (lit. ‘the servant of God’), followed by an erasure,
                                        over which the name of a certain <fo:inline id="d1e120528PRS14014Henok">ʾAbuna Henok</fo:inline> has been added.
                                        While it can be assumed that <fo:inline id="d1e120531PRS14014Henok">ʾAbuna Henok</fo:inline> was a later owner,
                                        it is unclear whether Gabra ʾƎgziʾabǝḥer, styled as <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ፍቁሩ</fo:inline> (‘His beloved’), indicates the name of the original
                                        owner of the manuscript or is an epithet of <fo:inline id="d1e120537PRS14014Henok">ʾAbuna Henok</fo:inline>.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>
                                       The book is bound in wooden boards.
                                     
                                       The boards are flush with the bookblock and have shallow external and internal bevels. The grain runs vertically.
                                       Both the internal and external surfaces of the boards are polished.
                                     
                                       Chainstitch sewing on four sewing stations (two pairs).
                                     
                                       The small holes close to the head and tail of the quires are probably what remains of quire tackets.
                                     </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Foliation</fo:block>
            <fo:block>Pencil foliation in the upper right corner (1–66).</fo:block>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Quire structure</fo:block>
         <fo:block space-after="3mm">
            <fo:footnote>
               <fo:inline font-size="7pt" vertical-align="text-top">509</fo:inline>
               <fo:footnote-body text-align="justify" text-indent="0">
                  <fo:list-block>
                     <fo:list-item>
                        <fo:list-item-label>
                           <fo:block>
                              <fo:inline vertical-align="text-top" font-size="9pt">509</fo:inline>
                           </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                           <fo:block hyphenate="true"
                                     space-before="0.45cm"
                                     font-size="9pt"
                                     line-height="11pt"
                                     margin-left="0.45cm">
                                        Decorated quire marks are written in the upper inner margin of the first folio of all quires.
                                    </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:footnote-body>
            </fo:footnote>
         </fo:block>
         <fo:block>8 quires. I<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 1r–8v)</fo:inline> – II<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 9r–16v)</fo:inline> – III<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 17r–24v)</fo:inline> – IV<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 25r–32v)</fo:inline> – V<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 33r–40v)</fo:inline> – VI<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 41r–48v)</fo:inline> – VII<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 49r–56v)</fo:inline> – VIII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 57r–66v)</fo:inline>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 1ra–66vc: 3
                                    columns (22 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 33r. The characters per line are 7–9.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            255 × 227 mm (fol. 33r).
                                            </fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            183 × 182 mm (fol. 33r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 30 mm, bottom: 43 mm, right: 28 mm, left: 18 mm, intercolumn: 16 mm (fol. 33r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic">Punctuation</fo:block>
            <fo:block>
               <fo:block linefeed-treatment="preserve">Single chains of red and black small semicircles are used as dividers after the title
                                        (fol. 1r) and before and after the subscription (fol. 66vc).
                                     </fo:block>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Ruling and pricking are visible. Both primary and ruling pricks are visible. The upper and bottom lines are written above the ruling. Ruling pattern: 1A-1A-1A1A-1A1A/0-0/0-0/C.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->First half of the eighteenth century.. Fine and regular handwriting. Characters are uniformly spaced.
                                <fo:block>Ink: Black, red.</fo:block>
                           <fo:block>Rubrication: 
                                    Several groups of lines on the incipit page, alternating with black lines; the titles and incipits of the single chapters; holy names;
                                    elements of the punctuation signs, text dividers, and numerals, included quire marks.
                                </fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Condition</fo:block>
            <fo:block>The condition is good.
                                    Some folios are slightly stained, especially at the upper corners.
                                </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>first half of the eighteenth century</fo:inline>
                            The manuscript can be dated palaeographically to the first half of the eighteenth century.
                            The supplication formula on the incipit page of the text mentions Gabra
                            ʾƎgziʾabǝḥer (lit. ‘the servant of God’), followed by an erasure,
                            over which the name of a certain <fo:inline id="d1e120576PRS14014Henok">ʾAbuna Henok</fo:inline> has been added.
                            While it can be assumed that <fo:inline id="d1e120579PRS14014Henok">ʾAbuna Henok</fo:inline> was a later owner,
                            it is unclear whether Gabra ʾƎgziʾabǝḥer, styled as <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ፍቁሩ</fo:inline> (‘His beloved’), indicates the name of the original
                            owner of the manuscript or is an epithet of <fo:inline id="d1e120585PRS14014Henok">ʾAbuna Henok</fo:inline>.
                        </fo:block>
            <fo:block>
                            The provenance of the manuscript is unknown.
                            The book was acquired by <fo:inline id="d1e120591PRS9622Ullendor">Edward Ullendorff</fo:inline> at some time before
                            1978. It was consulted and collated in Knibb’s edition of the book of Enoch with siglum Ull
                            (<inline xmlns="http://www.w3.org/1999/XSL/Format">Knibb 1978</inline>). For a very concise description of the manuscript, see
                            Knibb 1978,  26.
                        </fo:block>
            <fo:block>The manuscript entered the Bodleian Libraries as part of the bequest of <fo:inline id="d1e120606PRS9622Ullendor">Edward Ullendorff</fo:inline> after his death in 2011.</fo:block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Bibliography</fo:block>Knibb 1978; Knibb 1978.</fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLeu5">https://betamasaheft.eu/BDLeu5</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
