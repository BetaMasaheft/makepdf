      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLeu8"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. g. 52 (R)</fo:block>
            <fo:block>(Bodleian Ullendorff 8)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment scroll1943×82–84 mm, 723×84 mm, c. 400×c. 82 mm, c. 850×c. 82 mm (weight: 35g),  fols, twentieth century.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e122330LIT1763Legend">
               <fo:inline>I) Fols 1r1–1r63: <fo:inline xml:lang="en" hyphenate="true">Legend of St Susǝnyos and Wǝrzǝlyā (general record), CAe 1763.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ ​ስ፡ ​ቅዱ​ስ፡ ፩ ​አም​ላክ። ​ጸሎ​ት፡
                                ​በእ ​ንተ፡ ​ቅዱ​ስ፡ ​ሱስ​ንዮ​ስ፡ ​አሰ​ስሎ<fo:inline>[፡]</fo:inline>
                                ​ደዌ፡ ​እም​ሕፃ​ናት፡ ​እለ፡ ​ይጠ​ብዉ<fo:inline>[፡]</fo:inline>
                                ​ጥበ፡ ​እሞ​ሙ፡ ​አይ፡ ​ይበ​ቍዓ፡ ​ለብ ​እሲ​ት፡ ​ፅን​ስት።
                            </fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ወሀ​ሎ፡ ፩ ​ብእ​ሲ፡ ​ዘስሙ<fo:inline>[፡]</fo:inline>
                                    ​ሱስ​ንዮ​ስ፡ ​ወአ​ውሰ​በ፡ ​ብእ​ሲተ<fo:inline>[፡]</fo:inline>
                                ​ወወ​ለደ​ት፡ ​ውሉ​ደ፡ ​ወለ​ቀዳ​ማዊ<fo:inline>[፡]</fo:inline>
                                ​ወቦ​አት፡ ​ውር​ዝል​ያ። ​ወቀ​ተለ​ቶ፡ ​ለወ​ልድ​የ። ​ወይ​ቤላ፡ ​ምን​ተ፡ ​ያበ​ክየ​ኪ፡ ​ኦብ​እሲ​ቶ።
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ወዓ​ርገ፡ ​በጾ​ታ፡ ፯ ​መዓ​ርገ፡ ​ሊቃ​ነ፡ ​መላ​እል​ት፡
                                 ሚ ካ ኤ ​ል፡
                                 ወ ገ ብ ር ኤ ​ል፡
                                ሱ ራ ፌ ​ል፡ 
                                ወ ኪ ሩ<fo:inline>[ቤ]</fo:inline>​ል፡ 
                                ወ ራ ጕ ኤ ​ል፡ 
                                 ዑ ራ ኤ ​ል፡ 
                                ወ ሩ ፋ ኤ ​ል፡ 
                                ወ ሰ ዳ ክ ያ ​ል፡ 
                                ​እሉ፡ እ<fo:inline>መ (!)</fo:inline>​ንቱ፡ ​መሐ​ልኩ፡ ​ለከ፡ ​ከመ፡ ​ኢይ​ቅረ​ብ፡ ​ኀበ፡ ​ሀሎ፡ ​ስም​ከ፡
                                ​አው፡ <fo:inline>ሊህቅ፡ (!)</fo:inline> ​አው፡ ​ውር​ዝው፡ ​አው፡ ​ተባ​ዕተ፡ ​አው፡ ​አን​ስተ።
                            </fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ጸሎ​ቱ፡ ​ወበ​ረከ​ቱ፡ ​ለቅ​ዱስ፡  ​ሱስ​ንዮ​ስ፡ 
                                ​የሃ​ሉ፡ ​ምስ​ለ፡ ​ፍቁ​ሩ፡ <fo:inline id="d1e122437PRS15041HaylaMaryam">​ኃይ​ለ፡  ​ማር​ያም፡</fo:inline>
                  </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e122448LIT7715Sebhat">
               <fo:inline>II) Fols 1r64–1r74: <fo:inline xml:lang="en" hyphenate="true">‘Glory to God in the heavens, and peace on Earth…’ (​ስብ​ሐት፡ ​ለእ​ግዚ​አብ​ሔር፡ ​በሰ​ማያ​ት፡ ​ወሰ​ላም፡ ​በም​ድር፡), CAe 7715.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The entire text is reproduced below.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ስብ​ሐት፡ ​ለእ​ግዚ​አብ​ሔር፡ ​በሰ​ማያ​ት፡ ​ወሰ​ላም፡ ​በምድ ​ር፡ ​ሥም​ረቱ፡ ​ለሰ​ብእ፡
                                ​እስመ<fo:inline>[፡]</fo:inline> ​ሠዓ​ረ፡ ​ዘት​ካት፡ ​መን​በሮ፡ ​ወነ​ሠተ፡ ​ምክ​ሮ፡ ​ለጸ​ላኢ፡
                                ​ከማ​ሁ፡ ​ሠዓ​ሮሙ፡ ​ለአ​ጋን​ንት፡ ​ወለ​ሰይ​ጣና​ት፡ ​ለባ​ርያ፡ ​ወለ​ትግ​ሬዳ፡ ​ወለ​ሾተ​ላይ፡ ​እም​ላዕ​ለ፡ ​ዓመ​ትከ፡
                                <fo:inline id="d1e122461PRS15042WalattaDengel">​ወለ​ተ፡  ​ድን​ግል፡</fo:inline> ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​አሜ​ን።
                            </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e122472LIT7701PPDrowningWedn">
               <fo:inline>III) Fols 1r75–1r97: <fo:inline xml:lang="en" hyphenate="true">‘Prayer for the drowning, for Wednesday’ (​ጸሎ​ተ፡ ​መሥ​ጥም፡ ​ዘዕ​ለተ፡ ​ርቡ​ዕ፡), CAe 7701.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The central part of the text contains several repetitions of the characters <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">ሟ</fo:inline>,
                                <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">ሯ</fo:inline>, and <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">ፏ</fo:inline>.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ፩ ​አም​ላክ፡ ​ጸሎ ​ተ፡ ​መሥ​ጥም፡ ​ዘዕ​ለተ፡
                                <fo:inline>ሩ (!)</fo:inline>ቡ ​ዕ፡ ​ዓቃ​ቢሃ፡ ​ቅዱ​ስ፡ ​ሩፋ​ኤል፡ 
                                ​ወኮ​ከባ​ኒ፡ ​አጣ​ርጅ፡ ​ጨት ኩ ​ታኤ​ል፡ ​ጨት ኩ ​ታኤ​ል፡
                                ​ቆት​ኤል፡ ​ቆት​ኤል ፨ ፨
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ፃዕ፡ ​መን​ፈስ፡ ​ርኩ​ስ፡ ​በስ​ሙ፡ ​ለኢ​የሱ ​ስ፡ ​ክር​ስቶ​ስ፡ ​በዝ​ቃለ፡ ​መለኮ ​ትከ፡
                                ​ዕቀ​ባ፡ ​ወአ​ድኅ<fo:inline>ኖ (!)</fo:inline>፡ ​ወአ​ቁም፡ ​ፍሬ፡ ​ውስ​ተ፡ ​ማኅ​ፀና፡ ​ለዓ​መት​ከ፡
                                <fo:inline id="d1e122515PRS15042WalattaDengel">​ወለ​ተ፡  ​ድን​ግል፡</fo:inline>
                                ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​አሜ​ን። ።
                            </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e122526LIT7714Zentu">
               <fo:inline>IV) Fols 1r98–1r109: <fo:inline xml:lang="en" hyphenate="true">‘This is the name of the Trinity: fearful seal of life for the believers’ (​ዝን​ቱ፡ ​ስመ፡ ​ሥላ​ሴ፡ ​ግሩ​ም፡ ​ማኅ​ተመ፡ ​ሕይ​ወት፡ ​ለም​እመ​ናን፡), CAe 7714.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The entire text is reproduced below.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                            ​ዝን​ቱ፡ ​ስመ፡ ​ሥላ​ሴ፡ ​ግሩ​ም፡ ​ማኅ​ተመ፡ ​ሕይ​ወት፡ ​ለም​እመ ​ናን። ​ወማ​ኅተ​መ፡ ​መን​ሱት፡
                            ​ለረ​ሲዓ​ን። ​ዝን​ቱ፡ ​ስመ፡  ​ሥላ​ሴ፡  ​ሕማ​ሙ፡ ​ለሰ​ይጣ​ን። ​ወመ​ግረ​ሪሆ​ን፡ ​ለአ​ጋን​ንት፡
                            ​እኩ​ያን። ​ዝን​ቱ፡ ​ስመ፡  ​ሥላሴ<fo:inline>[፡]</fo:inline>
                     <fo:inline>ደምስ፡ (!)</fo:inline> ​ኪኖ​ሙ፡ ​ለመ​ርያ​ን። ​ወሠ​ዓር፡ ​ምክ​ሮሙ፡ ​ለመ​ካር​ያን። ​በዝ​ስመ፡  ​ሥላ​ሴ፡ 
                            ​ተማ​ኅፀ​ንኩ፡ ​አነ፡ ​ዓመ​ትከ፡ <fo:inline id="d1e122551PRS15042WalattaDengel">​ወለ​ተ፡  ​ድን​ግል፡</fo:inline>
                            ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​አሜ​ን፡
                        </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e122563LIT7157PPMalkFan">
               <fo:inline>V) Fols 1r110–1r128: <fo:inline xml:lang="en" hyphenate="true">Beginning of Malkǝʾa Fānuʾel, CAe 7157.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The text only contains the first stanza of the malkǝʾ followed by two 
                                masgabiyā-stanzas, the second of which is also attested in other contexts
                                (see e.g. <fo:inline/>, fol. 120r). The entire text is reproduced below.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ሰላ​ም፡ ​ለተ​ፈጥ​ሮት​ከ፡ ​ምስ​ለ፡  ​መላ​እክ​ት፡ ​ኅቡ​ረ።
                                ​እን​ዘ፡ ​ኢት​ከው​ን፡ ​ቅድ​መ፡ ​ወኢ​ትዳ​ኃር፡ ​ድኅ​ረ።
                                ​ሰዳ​ዴ፡ ​አጋ​ንን​ት፡  ​ፋኑ​ኤል፡  ​እም​ላዕ​ለ፡ ​ሰብ​እ፡ ​ወት​ረ።
                                ​ስድ​ዶሙ፡ ​ለአ​ጋን​ንት፡ ​ወአ​ርእ​ዮሙ፡ ​ኃሣ​ረ።
                                ​ከመ፡ ​ኢይ​ግበ​ሩ፡ ​ኪያ​የ፡ ​ማኅ​ደረ ፨ ፨ ፨
                                ​ሰላ​ም፡ ​ለከ፡ ​ፋኑ​ኤል፡ ​ጰጥ​ሮስ<fo:inline>[፡]</fo:inline> ​ካህ​ነ፡
                                    ​ውሳ ጤ ፡ ​ወአ​ፍአ።
                                    ​ለእ​መ፡  ​በዕ​ለት፡ ​አበ​ስኩ፡ ​በበ​ሰብ​ዕ፡ ​፸።
                                    ​ፍት​ሐኒ፡ ​እግ​ዚኦ፡ ​በከ​መ፡ ​ተሠ​ርዓ።
                                 ​ሰላ​ም፡  ​ለኪ፡  ​ማር​ያም፡  ​እም​ነ። ​ወእ​ሙ፡ ​ለእ​ግዚ​እነ።
                                ​ለህ​ጽነ፡ ​ሐና፡ ​ተማ​ኅፀ​ነ። <fo:inline>ፈኒውዮ፡ (!)</fo:inline> ​ለፋ ​ኑኤ​ል። 
                                ​ይዕ​ቀብ<fo:inline>[፡]</fo:inline> ​ኪያ​ነ፡ ​በረ​ምሐ፡ ​መስ​ቀል፡ ​ረጊ​ዞ፡ ​ሰይ​ጣነ፡
                            </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e122618LIT7700PPBazentu">
               <fo:inline>VI) Fols 1r129–1r144: <fo:inline xml:lang="en" hyphenate="true">‘By this name, Hezekiah defeated Sennacherib…’ (​በዝ​ንቱ፡ ​ስም፡ ​ሞኦ፡ ​ሕዝ​ቅያ​ስ፡ ​ለሰ​ናክ​ሬም።), CAe 7700.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ​አም​ላክ፡ ​በዝ​ንቱ፡  ​ስም፡ ​ሞኦ፡ ​ሕዝ​ቅያ​ስ፡
                                ​ለሰ​ናክ​ሬም። ​በዝ​ንቱ፡ ​ስም፡ ​አው​ደቆ፡  ​ዳዊ​ት፡  ​ለጎ​ልያ​ድ። ​በዝ​ንቱ፡ ​ስም፡ ​አስ​ጠሞ፡
                                ​ሙሴ፡ ​ለፈ​ርዖ​ን።
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​ወአ​ቁም፡ ​ፍሬ፡ ​ውስ​ተ፡ ​ማኅ​ፀና፡ ​ሀባ፡ ​ፍሬ፡ ​ቡሩ​ከ፡ ​ወኅ​ሩየ፡ ​ዘከ​መ፡ ​ወሀ​ብካ፡ ለ ​ኤል​ሳቤ​ጥ፡ 
                                ዮ ​ሐንስ ​ሃ፡ ​ቡሩ​ከ፡ ​ወጻ​ድቀ፡ ​ወል​ዳ፡ ​ለዓ​መት​ከ፡
                                <fo:inline id="d1e122639PRS15042WalattaDengel">​ወለ<fo:inline>[...]</fo:inline>​ድን​ግል፡</fo:inline>
                                ​አሜ​ን።
                            </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e122654LIT7404LukeOneThirSev">
               <fo:inline>VII) Fols 1r145–1r146: <fo:inline xml:lang="en" hyphenate="true">Luke 1:37, CAe 7404.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                            ​እስ​መ፡ ​አል​ቦ፡ ​ዘይ​ሰአ​ኖ፡ ​ለእ​ግዚ​አብ​ሔር ፨
                        </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Varia</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>The verso is blank.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>At least on one occasion, an erroneous character has been marked for deletion by dashes or lines above and below.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>The name of the owners <fo:inline id="d1e122810PRS15041HaylaMaryam">Ḫayla Māryām</fo:inline> and
                                        <fo:inline id="d1e122813PRS15042WalattaDengel">Walatta Dǝngǝl</fo:inline> are mentioned in supplications.
                                    </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>4)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>On several of the miniatures, the words <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ንግ​ሥት፡ ​አዜ​ብ፡</fo:inline>
                                        (Nǝgǝśt ʾAzeb, "The Queen of (?) the South") have been written.
                                    It is possible that this is the name of a secondary owner.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>5)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Order of textual units and miniatures: Miniature 1, Textual units I–II, Miniature 2,
                                        Textual units III–IV (beginning), Miniature 3,
                                        Textual units IV (end)–V (beginning), Miniatures 4–5,
                                        Textual unit V (end), Miniature 6, Textual units VI–VII.
                                    </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>The three parchment strips are sewn together with narrow parchment strips.
                                    The strip connecting Strip 2 and
                                    Strip 3
                                    is alternately in blue and red.A narrow parchment strip is attached through a hole in the middle of the upper part of the scroll.
                                    The manuscript is provided with a small case of the kind typically used for codices.
                                </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>1
                                    column (146 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Number of characters per line: 10–14.The outer margins are delimited by patterns of different types. In the upper part of the scroll, the margins are
                               marked by patterns in black, red, and blue. In the middle part, the right margin continues the same pattern as above, whereas the
                               left side is decorated with black, red, and blue horizontal lines. In the lower part, the margins are marked by simpler blue and
                               red lines.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Pricking and ruling are mostly visible.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->Nineteenth–twenty-first century.. Modern script, somewhat irregular. Word separator is occasionally omitted when the end of a word
                                    coincides with the end of the line.<fo:block>Ink: Black, pinkish red.</fo:block>
                           <fo:block>Rubrication: Beginnings of prayers; holy names; every second letter in the angelic names
                                    in the first text; elements of punctuation marks.
                                    </fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Decoration</fo:block>
         <fo:block margin-top="3mm" margin-bottom="3mm" white-space-collapse="true">An elaborate band, filled with interlace and irregular geometric patterns, runs around the 
                                entirety of the text up to the point where the upper parchment strip is joined with the
                                lower. The lower section of the scroll also includes a band, but this is executed with a faded colour and 
                                is only sparsely filled in some area. Horizontal bands, filled with x-shaped and intertwined motifs cut 
                                across the vertical bands marking textual sections. The scroll features six angels 
                                with unsheathed swords and scabbards at its top and between textual sections. They alternate with textual
                                elements with the exception of the fourth and fifth that are placed directly one above the other. 
                                The angels wear neck crosses and are partially coloured with red and pale blue of varying depth. 
                                The lowermost section of the scroll features faded talismanic symbols instead of an angel. The style of the
                                images suggests they were executed in the twentieth century.
                            </fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Miniatures</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em">
            <fo:inline>(314) <fo:inline>Bust of an angel.</fo:inline>
            </fo:inline>
            <fo:inline>(315) <fo:inline>Unidentified standing angel.</fo:inline>
            </fo:inline>
            <fo:inline>(316) <fo:inline>Bust of an angel.</fo:inline>
            </fo:inline>
            <fo:inline>(317) <fo:inline>Standing angel.</fo:inline>
            </fo:inline>
            <fo:inline>(318) <fo:inline>Standing angel.</fo:inline>
            </fo:inline>
            <fo:inline>(319) <fo:inline>Bust of an angel.</fo:inline>
            </fo:inline>
         </fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Headpieces</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Drawings</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Other</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Condition</fo:block>
            <fo:block>The condition is good.The lower margins are slightly crumpled.
                                    A small hole is present near the the lower margin.</fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>twentieth century</fo:inline>
                            The manuscript can be dated palaeographically and by the style of the
                            miniatures to the twentieth century.
                            The names <fo:inline id="d1e122866PRS15041HaylaMaryam">Ḫayla Māryām</fo:inline> and
                            <fo:inline id="d1e122869PRS15042WalattaDengel">Walatta Dǝngǝl</fo:inline> are mentioned in supplications.
                        </fo:block>
            <fo:block>The manuscript entered the Bodleian Libraries as part of the bequest of <fo:inline id="d1e122875PRS9622Ullendor">Edward Ullendorff</fo:inline> after his death in 2011.</fo:block>
         </fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLeu8">https://betamasaheft.eu/BDLeu8</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
