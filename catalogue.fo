      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLaethe32"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. e. 32</fo:block>
            <fo:block>(Juel-Jensen 18)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment codex220×187 mm (weight: 1801g), 122 fols (1 p. blank), 13 quires, mid-seventeenth–mid-nineteenth century.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e30562LIT2701Dawit">
               <fo:inline>I) Fols 3r–121ra: <fo:inline xml:lang="en" hyphenate="true">Psalter, CAe 2701.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e30568LIT2000Mazmur">
               <fo:inline>I-1) Fols 3r–92v: <fo:inline xml:lang="en" hyphenate="true">Psalms of David, CAe 2000.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​ተግ<fo:inline>[...]</fo:inline>፡ ​ለኵ​ሉ፡ ​ለጻ​ድቃ​ን፡ ​ወለ​ኃጥ​አን።
                                     ​አር​አያ፡ ​ፍካ​ሬ፡ ​ዘጻ​ድቃ​ን፡ ​ወዘ​ኃጥ​አን።
                                         ​መዝ​ሙር፡ ​ዘዳ​ዊት፡ ​ሃሌ፡ ​ሉያ
                                    ​ብፁ​ዕ፡ ​ብእ​ሲ፡ ​ዘኢ​ሖረ፡ ​በም​ክረ፡ ​ረሲ​አን ፨
                                    ​ወዘ​ኢቆ​መ፡ ​ውስ​ተ፡ ​ፍኖ​ተ፡ ​ኃጥ​አን ፨
                                    ​ወዘ​ኢነ​በረ፡ ​ውስ​ተ፡ ​መን​በረ፡ ​መስ​ተሣ​ልቃ​ን።
                                </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​ወአ​ንሰ፡ ​ነሣ​ዕኩ፡ ​ዘእ​ምው​ስተ፡ ​አፍ​ላግ፡ ​ሰለ​ስተ፡ ​አዕ​ባነ ፨
                                    ​ወወ​ጸፍ​ክዎ፡ ​መን​ገለ፡ ​ገጹ ፨
                                    <fo:inline>አሚሃ፡ (!)</fo:inline> ​ወድ​ቀ፡ ​በኃ​ይለ፡ ​እግ​ዚአ​ብሔር ፨
                                    ​ወመ​ተር​ኩ፡ ​ርእ​ሶ፡ ​ለጐ​ልያድ ፨
                                    ​ወአ​ሰሰ​ልኩ፡ ​ፅዕ​ለተ፡ ​እም​ደቂ​ቀ፡ ​እስ​ራኤል ፨
                                </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e30638LIT1828Mahale">
               <fo:inline>I-2) Fols 92v–102v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes, CAe 1828.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e30644LIT1828Mahale#Moses1">
               <fo:inline>I-2-1) Fols 92v–93v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: First Song of Moses (​ጸሎ​ቱ፡ ​ለሙ​ሴ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ማኅ​ልየ፡ ​ነቢ​ያት፡ ​ወጸ​ሎቱ፡ ​ለሙ​ሴ።
                                        ​ንሴ​ብሖ፡ ​ለእ​ግዚ​አብ​ሔር፡ ​ስቡ​ሐ፡ ​ዘተ​ሰብሐ ፨
                                        ​ፈረ​ሰ፡ ​ወመ​ስተ​ፅዕ​ነ፡ ​ወረ​ወ፡ ​ውስ​ተ፡ ​ባሕር ፨
                                        ​ረዳ​ኤ፡ ​ወመ​ሰው​ረ፡ ​ኮነ​ኒ፡ ​ለአ​ድኅ​ኖትየ ፨
                                        ​ውእ​ቱ፡ ​አም​ላኪ​የ፡ ​እሴ​ብሖ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ወአ​ስተ​ጋብ​አ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ላዕ​ሌሆ​ሙ፡ ​ማየ፡ ​ባሕር ፨
                                        ​ወደ​ቂቀ፡ ​እስ​ራኤ​ል፡ ​ኃለ​ፉ፡ ​እን​ተ፡ ​የብ​ስ፡ ​በማ​ዕከ​ለ፡ ​ባሕር ፨
                                        ​ማይ​ሰ፡ ​ቆመ፡ ​ሎመ፡ ​አረ​ፍተ፡ ​በይ​ምን፡ ​ወአ​ረፍ​ተ፡ ​በጽ​ግም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e30702LIT1828Mahale#Moses2">
               <fo:inline>I-2-2) Fols 93v–94v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Second Song of Moses (​ጸሎ​ተ፡ ​ሙሴ፡ ​ዘዳ​ግም፡ ​ሕግ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሙሴ፡ ​ዘዳ​ግም፡ ​ሕግ።
                                        ፪  ​አጽ​ምእ፡ ​ሰማ​ይ፡ ​ወእ​ንግ​ርከ። ​ወት​ስማ​ዕ፡ ​ምድ​ር፡ ​ቃለ፡ ​አፉየ ፨
                                        ​ወት​ሴፈ​ዎ፡ ​ከመ፡ ​ዝና​ም፡ ​ለነ​ገር​የ። ​ወይ​ረድ፡ ​ከመ፡ ​ጠል፡ ​ነቢ​ብየ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ወአ​ምዕ​ዑኒ፡ ​በአ​ማል​ክቲ​ሆሙ ፨
                                        ​ወአ​ነ፡ ​አቀ​ንኦ​ሙ፡ ​በዘ​ኢኮ​ነ፡ ​ሕዝበ ፨
                                        ​ወአ​ምዕ​ዖሙ፡ ​ለሕ​ዝብ፡ ​በዘ​ኢይ​ሌብው ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e30752LIT1828Mahale#Moses3">
               <fo:inline>I-2-3) Fols 94v–96r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Third Song of Moses (​ጸሎ​ተ፡ ​ሙሴ፡ ​ዘሣ​ልስ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሙሴ፡ ​ዘሣ​ልሳ​ይ፡ ​ሕግ።
                                        ፫  ​እስ​መ፡ ​እሳ​ት፡ ​ትነ​ድድ፡ ​እመ​ዓትየ ፨
                                        ​ወታ​ውዒ፡ ​እስ​ከ፡ ​ሲኦ​ል፡ ​ታሕተ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ይት​ቤቀ​ል፡ ​ወይ​ትፈ​ደዮ​ሙ፡ ​በቀ​ለ፡ ​ለፀሩ ፨
                                        ​ወይ​ትቤ​ቀሎ​ሙ፡ ​ለጸ​ላእቱ ፨
                                        ​ወያ​ነጽ​ሕ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ምድ​ረ፡ ​ለሕ​ዝቡ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e30803LIT1828Mahale#Hannah">
               <fo:inline>I-2-4) Fols 96r–96v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Hannah (​ጸሎ​ተ፡ ​ሓና፡ ​እመ፡ ​ሳሙ​ኤል፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሐና፡ ​እመ<fo:inline>[፡]</fo:inline> ​ሳሙ​ኤል፡ ​ነቢ​ይ።
                                        ፬  ​ፀን​ዓ፡ ​ልብ​የ፡ ​በእ​ግዚ​አብ​ሔር ፨
                                        ​ወተ​ለዓ​ለ፡ ​ቀር​ንየ፡ ​በአ​ምላ​ኪየ፡ ​ወመ​ድኃ​ንየ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውእ​ቱ፡ ​ጻድ​ቅ፡ ​ይኴ​ንን፡ ​እስ​ከ፡ ​አጽ​ናፈ፡ ​ምድር ፨
                                        ​ወይ​ሁቦ​ሙ፡ ​ኃይ​ለ፡ ​ለነ​ገሥ​ትነ ፨
                                        ​ወያ​ሌዕ​ል፡ ​ቀር​ነ፡ ​መሲሁ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e30856LIT1828Mahale#Hezekiah">
               <fo:inline>I-2-5) Fols 96v–97r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Prayer of Hezekiah (​ጸሎ​ተ፡ ​ሕዝ​ቅያ​ስ፡ ​ንጉ​ሠ፡ ​ይሁ​ዳ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሕዝ​ቅያ​ስ፡ ​ንጉ​ሠ፡ ​ይሁ​ዳ።
                                         (fol. 97r)  ፭  ​አን​ሰ፡ ​ዕቤ፡ ​በኑ​ኃ፡ ​መዋ​ዕልየ ፨
                                        ​ውስ​ተ፡ ​አና​ቅጸ፡ ​ሲኦ​ል፡ ​ኃደ​ጉ፡ ​ዘተ​ረፈ፡ ​ዓመ​ትየ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​እነ<fo:inline>[...]</fo:inline>​ግር፡ ​ጽድ​ቀከ፡ ​በዳ​ኅና​የ። ​ወት​ረ፡ ​እሴ​ብሐ​ከ፡ ​ወእ​ዜም​ር፡ ​ለከ ፤
                                        ​በኵ​ሉ፡ ​መዋ​ዕለ፡ ​ሕይ​ወት​የ። ​በቅ​ድመ፡ ​ቤተ፡ ​እግ​ዚአ​ብሔር ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e30905LIT1828Mahale#Manasseh">
               <fo:inline>I-2-6) Fols 97r–98r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Prayer of Manasseh (​ጸሎ​ተ፡ ​ምና​ሴ፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ምና​ሴ፡ ​ነቢ​ይ።
                                         (fol. 97v)  ፮  ​እግ​ዚኦ፡ ​አኃ​ዜ፡ ​ኵሉ፡ ​ዓለ​ም። ​አም​ላኮ​ሙ፡ ​ለአ​በዊነ ፨
                                        ​ለአ​ብር​ሃም፡ ​ወለ​ይስ​ሐቅ፡ ​ወለ​ያዕ​ቆብ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​እሴ​ብሐ​ከ፡ ​በኵ​ሉ፡ ​ጊዜ፡ ​ወበ​ኵሉ፡ ​መዋ​ዕለ፡ ​ሐይ​ወትየ ፨
                                        ​እስ​መ፡ ​ኪያ​ከ፡ ​ይሴ​ብሑ፡ ​ኵሉ፡ ​ኃይ​ለ፡ ​ሰማ​ያት ፨
                                        ​ወለ​ከ፡ ​ስብ​ሐት፡ ​ለዓ​ለመ፡ ​ዓለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e30956LIT1828Mahale#Jonah">
               <fo:inline>I-2-7) Fols 98r–98v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Jonah (​ጸሎ​ተ፡ ​ዮና​ስ፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ዮና​ስ፡ ​ነቢ​ይ።
                                        ፯  ​ጸራ​ኅኩ፡ ​በም​ንዳ​ቤየ፡ ​ኀበ፡ ​እግ​ዚአ​ብሔ​ር፡ ​አም ​ላኪ የ ፨
                                        ​ወሰ​ምዓ​ኒ፡ ​በው​ስተ፡ ​ከር​ሠ፡ ​ሲኦ​ል። ​ወሰ​ምዓ​ኒ፡ ​ቃልየ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​እለ​ሰ፡ ​ዓቀ​ቡ፡ ​ከን​ቶ፡ ​ሐሰ​ተ፡ ​ገደ​ፉ፡ ​ሣህ​ሎሙ ፨
                                        ​አን​ሰ፡ ​ምስ​ለ፡ ​ቃለ፡ ​ስብ​ሐት፡ ​በተ​ጋን​ዮ፡ ​ዕሠ​ውዕ፡ ​ለከ ፨
                                        ​መጠ​ነ፡ ​ጸለ​ይኩ፡ ​በሕ​ይወ​ትየ፡ ​አአ​ስዮ፡ ​ለእ​ግዚ​አብ​ሔር ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31009LIT1828Mahale#ThreeYouths1">
               <fo:inline>I-2-8) Fols 98v–99r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: First Song of the Three Youths in the Furnace (​ጸሎ​ተ፡ ​ዳን​ኤል፡ ​ነቢ​ይ፡ ​ስብ​ሐት፡ ​ዘእ​ምኣ​ዛር​ያ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ዳን​ኤል፡ ​ነቢ​ይ፡ ​ስብ​ሐት፡ ​ዘእ​ምአ​ዛር​ያ።
                                        ፰  ​ይት​ባረ​ክ፡ ​እግ​ዚአ​ብሔ​ር፡ ​አም​ላከ፡ ​አበ​ዊነ ፨
                                        ​እኩ​ት፡ ​ወስ​ቡሕ፡ ​ስም​ከ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ወይ​ትኃ​ፈሩ፡ ​በኵ​ሉ፡ ​ትእ​ግል​ቶሙ፡ ​ወይ​ትቀ​ጥቀ​ጥ፡ ​ኃይ​ሎሙ ፤
                                        ​ወያ​እም​ሩ፡ ​ከመ፡ ​አን​ተ፡ ​እግ​ዚአ​ብሔ​ር፡ ​አም​ላክ፡ ​ባሕ​ቲትከ ፨
                                        ​ስቡ​ሕ፡ ​በኵ​ሉ፡ ​ምድ​ር፡ ​ወበ​ኵሉ፡ ​ዓለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31059LIT1828Mahale#ThreeYouths2">
               <fo:inline>I-2-9) Fols 99r–99v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Second Song of the Three Youths (​ጸሎ​ተ፡ ​ሠለ​ስቱ፡ ​ደቂ​ቅ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሰለ​ሥቱ፡ ​ደቂ​ቅ።
                                        ፱  ​ይት​ባረ​ክ፡ ​እግ​ዚአ​ብሔ​ር፡ ​አም​ላከ፡ ​አበ​ዊነ ፨
                                         (fol. 99v)  ​ስቡ​ሕኒ፡ ​ውእ​ቱ፡ ​ወል​ዑል​ኒ፡ ​ውእ​ቱ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ስቡ​ሕኒ፡ ​አን​ተ፡ ​ወክ​ቡር​ኒ፡ ​አን​ተ፡ ​ለዓ​ለም ፨
                                        ​ቡሩ​ክ፡ ​አን​ተ፡ ​በመ​ልዕ​ልተ፡ ​ሰማ​ያት ፨
                                        ​ስቡ​ሕኒ፡ ​አን​ተ፡ ​ወቡ​ሩክ​ኒ፡ ​አን​ተ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31111LIT1828Mahale#ThreeYouths3">
               <fo:inline>I-2-10) Fols 99v–100r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Third Song of the Three Youths (​ኀበ፡ ​ባረ​ኩ፡ ​ኣና​ንያ፡ ​ወኣ​ዛር​ያ፡ ​ወሚ​ሳኤ​ል፡ ​ለእ​ግዚ​አብ​ሔር፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ኀበ፡ ​ባረ​ኩ፡ ​አና​ንያ፡ ​ወአ​ዛር​ያ፡ ​ወሚ​ሳኤ​ል፡ ​ለእ​ግዚ​አብ​ሔር።
                                        ፲  ​ይባ​ርክ​ዎ፡ ​ኵሉ፡ ​ግብ​ረ፡ ​እግ​ዚእ፡ ​ለእ​ግዚ​አብ​ሔር ፨
                                        ​ስቡ​ሕኒ፡ ​ውእ​ቱ፡ ​ወል​ዑል​ኒ፡ ​ውእ​ቱ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ይባ​ርክ​ዎ፡ ​አና​ንያ፡ ​ወአ​ዛር​ያ፡ ​ወሚ​ሳኤ​ል፡ ​ለእ​ግዚ​አብ​ሔር ፨
                                        ​ንባ​ርኮ፡ ​ለአ​ብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱስ ፨
                                        ​ስቡ​ሕኒ፡ ​ውእ​ቱ፡ ​ወል​ዑል​ኒ፡ ​ውእ​ቱ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31161LIT1828Mahale#Habakkuk">
               <fo:inline>I-2-11) Fols 100r–101v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Habakkuk (​ጸሎ​ተ፡ ​ዕን​ባቆ​ም፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ዕን​ባቆ​ም፡ ​ነቢ​ይ።
                                        ​፲፩  ​እግ​ዚኦ፡ ​ሰማ​ዕኩ፡ ​ድም​ፀከ፡ ​ወፈ​ራህኩ ፨
                                        ​ርኢ​ኩ፡ ​ግብ​ረከ፡ ​ወአ​ንከ​ርኩ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​እግ​ዚአ​ብሔ​ር፡ ​አም​ላኪ​የ፡ ​ወኃ​ይልየ ፨
                                        ​ዘይ​ሠር​ዖን፡ ​ለእ​ገር​የ፡ ​ወለ​ፍጻ​ሜየ ፨
                                        ​ወዲ​በ፡ ​ልዑ​ላት፡ ​ያጼ​ዕነ​ኒ። ​ከመ፡ ​ዕማ​ዕ፡ ​በማ​ኅል​ይሁ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31211LIT1828Mahale#Isaiah">
               <fo:inline>I-2-12) Fols 101v–102r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Isaiah (​ጸሎ​ተ፡ ​ኢሳ​ይያ​ስ፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ኢሳ​ይያ​ስ፡ ​ነቢ​ይ።
                                        ​፲፪  ​በሌ​ሊት፡ ​ትገ​ይስ፡ ​መን​ፈስ​የ፡ ​ኀቤ​ከ፡ ​እግ​ዚኦ፡ ​አም​ላኪየ ፨
                                        ​እስ​መ፡ ​ብር​ሃን፡ ​ትእ​ዛዝ​ከ፡ ​በዲ​በ፡ ​ምድር ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ሑር፡ ​ሕዝ​ብየ፡ ​ወባ​ዕ፡ ​ቤተ​ከ።  ​ወዕ​ፁ፡ ​ኆኅ​ተከ ፨
                                        ​ወተ​ኃብ​ኦ፡ ​ኅዳ​ጠ፡ ​ምዕ​ረ። ​እስ​ከ፡ ​የኀ​ልፍ፡ ​መዓ​ቱ፡ ​ለእ​ግዚ​አብ​ሔር ፤
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31255LIT1828Mahale#Mary">
               <fo:inline>I-2-13) Fol. 102r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Our Lady Mary (​ጸሎ​ተ፡ ​እግ​ዝእ​ትነ፡ ​ማር​ያም፡) or Magnificat</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​እግ​ዝእ​ትነ፡ ​ማር​ያም፡ ​ወላ​ዲተ፡ ​አም​ላክ።
                                        ​፲፫  ​ተዓ​ብዮ፡ ​ነፍ​ስየ፡ ​ለእ​ግዚ​አብ​ሔር ፨
                                        ​ወት​ትኃ​ሠይ፡ ​መን​ፈስ​የ፡ ​በአ​ምላ​ኪየ፡ ​ወመ​ድኃ​ንየ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ወተ​ወክ​ፎ፡ ​ለእ​ስራ​ኤል፡ ​ቍል​ዔሁ ፨
                                        ​ወተ​ዘከ​ረ፡ ​ሣህ​ሎ፡ ​ዘይ​ቤሎ​ሙ፡ ​ለአ​በዊነ ፨
                                        ​ለአ​ብር​ሃም፡ ​ወለ​ዘር​ኡ፡ ​እስ​ከ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31305LIT1828Mahale#Zachariah">
               <fo:inline>I-2-14) Fols 102r–102v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Zachariah (​ጸሎ​ተ፡ ​ዘካ​ርያ​ስ፡ ​ካህ​ን፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ዘካ​ርያ​ስ፡ ​ነቢ​ይ።
                                        ​፲፬  ​ይት​ባረ​ክ፡ ​እግ​ዚአ​ብሔ​ር፡ ​አም​ላከ፡ ​እስ​ራኤል ፨
                                         (fol. 102v) <fo:inline>ዘተሣለኒ፡ (!)</fo:inline> ​ወገ​ብረ፡ ​መድ​ኃኒ​ተ፡ ​ለሕ​ዝበ፡ ​ዚአሁ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ለዘ​ሐወ​ፀነ፡ ​እም​አር​ያም ፨
                                        ​ወሠ​ረቀ፡ ​ከመ፡ ​ያር​እዮ​ሙ፡ ​ብር​ሃኖ ፨
                                        ​ለእ​ለ፡ ​ይነ​ብሩ፡ ​ውስ​ተ፡ ​ጽል​መት፡ ​ወጽ​ላሎ​ተ፡ ​ሞት ፨
                                        ​ከመ፡ ​ያር​ትዕ፡ ​እገ​ሪነ፡ ​ውስ​ተ፡ ​ፍኖ​ተ፡ ​ሰላም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31362LIT1828Mahale#Simeon">
               <fo:inline>I-2-15) Fol. 102v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Simeon, or Nunc Dimittis (​ጸሎ​ተ፡ ​ስም​ዖን፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ስም​ዖን፡ ​ነቢ​ይ።
                                        ​፲፭  ​ይእ​ዜ፡ ​ሠዓ​ሮ፡ ​ለገ​ብር​ከ። ​በሰ​ላም፡ ​እግ​ዚኦ፡ ​በከ​መ፡ ​አዘ​ዝከ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                     <fo:inline>[...]</fo:inline>​አስ​ተዳ<fo:inline>[...]</fo:inline>​ቅድ​መ፡ ​ኵሉ፡
                                        ​ሕዝብ<fo:inline>[...]</fo:inline>፨
                                        <fo:inline>[...]</fo:inline>​መ፡ ​ትክ​ሥት፡ ​ብር​ሃነ፡ ​ለአ​ሕዛብ ፨
                                        ​ወክ​ብረ፡ ​ለሕ​ዝብ​ከ፡ ​እስ​ራኤል ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31412LIT2362Songof">
               <fo:inline>I-3) Fols 103r–108r: <fo:inline xml:lang="en" hyphenate="true">‘’ (​መሓ​ልየ፡ ​መሓ​ልይ፡), CAe 2362.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​መኃ​ልየ፡ ​መኃ​ልይ፡ ​ዝው​እቱ፡ ​ዘሰ<fo:inline>[...]</fo:inline>​ሞን።
                                    ​ይስ​ዕመ​ኒ፡ ​በስ​ዕመ​ተ፡ ​አፉ​ሁ። ​አዳ​ም፡ ​አጥ ባ ​ትኪ፡ ​እም​ወይን ፨
                                </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​እን​ዘ፡ ​ይነ​ብር፡ ​ውስ​ተ፡ ​ገነ​ት፡ ​ካል​ዓን፡ ​ርእ​ይዎ ፨
                                    ​ዓፀ​ደ፡ ​ወይ​ን፡ ​ሊተ፡ ​እም​አን​ፃር​የ። ​ቃለ​ከ፡ ​አስ​ምዓኒ ፨
                                    ​ጕየ​ይ፡ ​አን​ተ፡ ​ወል​ድ፡ ​እኁ​የ፡ ​ወተ​መሰ​ላ፡ ​ለወ​ይጠል ፨
                                    ​ወእ​መ፡ ​አኮ፡ ​ከመ፡ ​ወሬ​ዛ፡ ​ኃየ​ል፡ ​ውስ​ተ፡ ​አድ​ባረ፡ ​ድሁ​ሀን ፨
                                </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31465LIT2509Weddas">
               <fo:inline>I-4) Fols 108va–117ra: <fo:inline xml:lang="en" hyphenate="true">‘Praise of Mary’ (​ውዳ​ሴ፡ ​ማር​ያም), CAe 2509.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31471LIT2509Weddas#Monday">
               <fo:inline>I-4-1) Fols 108va–109rb: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Monday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴሃ፡ ​ለእ​ግዝ​እት​ነ፡ ​ማር​ያም፡ ​ወላ​ዲተ፡ ​አም​ላክ፡  ​ዘይ​ትነ​በብ፡ <fo:inline>በእተ፡ (!)</fo:inline> ​ሰኑ​ይ፡ ​ፈቀ​ደ፡ ​እግ​ዚእ፡
                                        ​ያግ​ዕዞ፡ ​ለአ ​ዳም፡ ​ሕዙ​ነ፡ ​ወት​ኩዘ፡ ​ልብ<fo:inline>[፡]</fo:inline> ​ወያ​ግብ​ኦ፡ ​ኀበ፡
                                            ​ዘት​ካት<fo:inline>[፡]</fo:inline> ​ዘት​ካት፡  ​መን​በሩ፡
                                        ​ሰአ​ሊ፡ ​ለነ፡ ​ቅድ​ስት ፨ ​ሠረቀ<fo:inline>[፡]</fo:inline>
                                        ​በሥ​ጋ፡ ​እም​ድን​ግል፡ ​ዘእ​ንበ​ለ፡ ​ዘር​አ፡ ​ብእ​ሲ፡ ​ወአ​ድኃ​ነነ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                     <fo:inline>ወረሰይ፡ (!)</fo:inline> ​ለሔ​ዋን፡ ​አግ​ዓዚ​ተ፡ ​እም​ፃዕ​ረ፡ ​ሞት፡ ​ወወ​ሀብ​ከነ፡ ​መን​ፈሰ፡ ​ልደ​ት፡ ​ባረ​ክና​ከ፡ ​ምስ​ለ፡ ​መላ​እክ​ቲከ፡
                                         ሰ<fo:inline>[፡]</fo:inline> ​ለ፡ ቅ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31525LIT2509Weddas#Tuesday">
               <fo:inline>I-4-2) Fols 109rb–110vb: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Tuesday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​በሰ​ሉስ፡  ​አክ​ሊለ፡ ​ምክ​ህነ፡ ​ወቀ​ዳሚ​ተ፡ ​መድ​ኃኒ​ትነ፡ ​ወመ​ሠረ​ተ፡
                                        ​ንጽ​ሕነ፡ ​ኮነ፡ በ ​ማር​ያ፡  ​ድን​ግል፡ ​እን​ተ፡ ​ወለ​ደት፡
                                        ​ለነ<fo:inline>[፡]</fo:inline>
                                        ​ዘእ​ግዚ​አብ​ሔር፡ ​ቃለ፡ ​ዘኮ​ነ፡ ​ሰብ​አ፡ ​በእ​ንተ፡ ​መድ​ኃኒ​ትነ፡
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ይሰ​ፍሑ፡ ​ክነ​ፊሆ​ሙ፡ ​ወይ​ብሉ፡ ​ዝን​ቱ፡ ​ውእ​ቱ፡ ​ንጉ​ሠ፡ ​ስብ​ሐት፡ ​መጽ​አ፡ ​ይስረ  (b)  ​ይ፡ ​ኃጢ​አተ፡ ​ዓለ​ም፡ ​በዕ​በየ<fo:inline>[፡]</fo:inline>
                                        ​ሣህ​ሉ፡
                                         ​ሰ፡ ​ለ፡ ቅ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31561LIT2509Weddas#Wednesday">
               <fo:inline>I-4-3) Fols 110vb–112rb: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Wednesday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​በረ​ቡዕ<fo:inline>[፡]</fo:inline> ​ኵሉ፡ ​ሠራ​ዊተ፡ ​ሰማ​ያት፡ ​ይብ​ሉ፡ ​ብፅ​ዕት<fo:inline>[፡]</fo:inline>
                                        ​አን​ቲ፡ ​ሰማ​ይ፡ ​ዳግ​ሚት፡ ​ዲበ<fo:inline>[፡]</fo:inline> ​ምድ​ር፡ ​ኆኅ​ተ፡ ​ምሥ​ራቅ፡
                                         ​ማር<fo:inline>[፡]</fo:inline> ​ድን​ግል፡ ​ከብ​ካብ፡ ​ንጹ​ሕ፡
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ወአ​ንሶ​ሰወ፡ ​ምስ​ለ፡ ​ሰብእ<fo:inline>[፡]</fo:inline> ​እስ​መ፡ ​መሐ​ሪ፡ ​ውእ​ቱ፡ ​መፍ​ቀሬ፡ ​ሰብ​እ፡ ​አድ​ኃነ፡ <fo:inline>ነፍሳተነ፡ (!)</fo:inline>
                                        ​በም​ጽአ​ቱ፡ ​ቅዱስ<fo:inline>[፡]</fo:inline>
                                        ​ሰ፡ ​ለ፡ ቅ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31612LIT2509Weddas#Thursday">
               <fo:inline>I-4-4) Fols 112rb–114ra: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Thursday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​ዘሐ​ሙስ<fo:inline>[፡]</fo:inline> ​ዕፀ፡ ​እን​ተ፡ ​ርእ​የ፡ ​ሙሴ፡ ​በነ​ደ፡ ​እሳ​ት፡ ​ውስ​ተ፡ ​ገዳም<fo:inline>[፡]</fo:inline>
                                        ​ወአ​ዕጹ​ቂሃ፡ ​ኢት​ውዒ፡ ​ትመ​ስል፡
                                         ​ማርያ<fo:inline>[፡]</fo:inline> ​ድን​ግል<fo:inline>[፡]</fo:inline>
                                        ​ዘእ​ንበ​ለ፡ ​ርኩ​ስ፡
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ወኮ​ነ፡ ​ሰብ​አ፡ ​ከማ​ነ፡ ​ዘእ​ንበ​ለ፡ ​ኃጢ​አት፡ ​ባሕ​ቲታ፡ ​ወተ​ወል​ደ፡ ​በቤተ<fo:inline>[፡]</fo:inline> ​ልሔ​ም፡ ​በከ​መ፡ ​ሰበ​ኩ፡ ​ነቢ​ያት፡ ​አድ​ኃነ​ነ፡
                                        ​ወቤ​ዘወ​ነ፡ ​ወረ​ሰየ​ነ፡ ​ሕዝ​በ፡ ​ዚአ​ሁ፡
                                         ​ሰ፡ ​ለ፡ ቅ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31654LIT2509Weddas#Friday">
               <fo:inline>I-4-5) Fols 114ra–115rb: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Friday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​በዓ​ርብ<fo:inline>[፡]</fo:inline> ​ቡር​ክት፡ ​አን​ቲ፡ ​እም​አን​ስት፡ ​ወቡ​ሩክ፡ ​ፍሬ፡ ​ከር​ሥኪ፡
                                        ኦ ​ማርያ<fo:inline>[፡]</fo:inline> ​ወላ​ዲተ፡ ​አም​ላክ፡ ​ዘእ​ንበ​ለ፡ ​ርኩ​ስ፡
                                        ​ሠረ​ቀ፡ ​ለነ፡ ​እም​ኔኪ፡ ​ፀሐ​የ፡ ​ጽድ​ቅ፡ ​ወአ​ቅረ​በነ፡ ​ታሕ​ተ፡ ​ክነ​ፊሁ፡
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​በእ​ንተ​ዝ፡ ​ንዌ​ድሰ​ኪ፡ ​በከ​መ፡ ​ገብ​ርኤ​ል፡ ​መል  (b)  ​አክ፡ ​እን​ዘ፡ <fo:inline>ይብል፡ (!)</fo:inline>
                                        ​ቡር​ክት<fo:inline>[፡]</fo:inline>
                                        ​አን​ቲ፡  ​ማርያ<fo:inline>[፡]</fo:inline> ​ወቡ​ሩክ፡ ​ፍሬ፡ ​ከር​ሥኪ፡
                                        ​ተፈ​ሥሒ፡ ​ኦም​ልዕ​ተ፡ ​ጸጋ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ምስ​ሌኪ፡  ​ሰ፡ ​ለ፡ ቅ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31705LIT2509Weddas#Saturday">
               <fo:inline>I-4-6) Fols 115rb–116ra: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Saturday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳሴ<fo:inline>[፡]</fo:inline> ​በቀ​ዳሚ​ት፡ ​ሰን​በት<fo:inline>[፡]</fo:inline> ​ንጽ​ሕት፡ ​ወብ​ርህ​ት፡
                                         ​ወቅ​ድስ​ት፡ ​በኵ​ሉ፡ ​እን​ተ፡ ​ሐቀ​ፈቶ<fo:inline>[፡]</fo:inline> ​ለእ​ግዚ​እ፡ ​በእ​ራኃ፡
                                        ​ወኵሉ<fo:inline>[፡]</fo:inline>
                                        ​ፍጥ​ረት፡ ​ይት​ፌሥ​ሑ፡ ​ምስ​ሌሃ፡ ​እን​ዘ፡ ​ይጸ​ርሑ፡ ​ወይ​ብሉ፡  ​ሰ፡ ​ለ፡ ቅ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ሰአሊ<fo:inline>[፡]</fo:inline> ​ለነ፡ ​ኀበ፡ ​ወል​ድኪ፡ ​ኄር፡ ​መድ​ኃኒ​ነ፡ ​ይም​ሐረ​ነ፡ ​ወይ​ሣሃ​ለነ፡ ​ይስ​ረይ፡ ​ኃጢ​አተ​ነ፡
                                         ​ሰ፡ ​ለ፡ ቅ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31749LIT2509Weddas#Sunday">
               <fo:inline>I-4-7) Fols 116ra–117ra: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Sunday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​በሰ​ንበት<fo:inline>[፡]</fo:inline> ​ተሰ​መይ​ኪ፡ ​ፍቅ​ርተ፡ ​ኦቡ​ርክ​ት፡ ​እም​አን​ስት፡
                                        ​አንቲ<fo:inline>[፡]</fo:inline>
                                        ​ውእ​ቱ፡ ​ዳግ​ሚት፡ ​ቀመር<fo:inline>[፡]</fo:inline> ​እን​ተ፡ ​ትሰ​መይ፡
                                        ​ቅድ​ስተ<fo:inline>[፡]</fo:inline> ​ቅዱ​ሳን፡
                                        ​ወው​ስቴ​ታ፡ ​ጽላ​ተ፡ ​ኪዳ​ን፡
                                         ፲  ​ቃላ​ት፡ ​እለ፡ ተ  (b)  ​ጽሕ​ፋ፡ ​በአ​ፃብ​ዒሁ፡ ​ለእ​ግዚ​አብ​ሔር፡
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ሰአ​ሊ፡ ​ለነ፡ ​ኀበ፡ ​እግ​ዚእ​ነ፡ ​ወመ​ድኃ​ኒነ፡ ​ኢየ​ሱስ፡ ​ክር​ስቶ​ስ፡
                                        ​ያጽ​ንዓ​ነ፡ ​በር​ትዕ​ት፡ ​ሃይ​ማኖ​ት፡ ​ውስ​ተ፡ ​አሚ​ነ፡ ​ዚአ​ሁ፡ ​ይጸ​ግወ​ነ፡ ​ሣህ​ሎ፡
                                        ​ወም​ሕረ​ቶ፡ ​ይስ​ረይ፡ ​ኃጢ​አተ​ነ፡ ​በብ​ዝኃ፡ ​ምሕ​ረቱ፡  ​ሰ፡ ​ለ፡ ቅ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e31792LIT1113Anqasa">
               <fo:inline>I-5) Fols 117ra–121ra: <fo:inline xml:lang="en" hyphenate="true">‘Gate of Light’ (​አን​ቀጸ፡ ​ብር​ሃን፡), CAe 1113.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​ወእ​ምዝ<fo:inline>[፡]</fo:inline> ​ንጽ​ሕፍ፡ ​ዝክ​ረ፡ ​ውዳ​ሴሃ፡
                                        ​ለእ​ግዝ​እት ነ<fo:inline>[፡]</fo:inline> ​ውዳ​ሴ፡ ​ወግ​ናይ፡ ​እሙ፡ ​ለአ​ዶና​ይ፡ ​ቅድ​ስት፡
                                    ​ወብ​ፅዕ​ት፡ ​ስብ​ሕት<fo:inline>[፡]</fo:inline> ​ወቡ​ርክ​ት፡ ​ክብ​ርት፡ ​ወል​ዕል​ት፡ ​አን​ቀጸ፡ ​ብር​ሃን፡
                                    ​ማዕ​ርገ፡ ​ሕይ​ወት፡ ​ወማ​ኅደረ<fo:inline>[፡]</fo:inline> (b)   ​መለ​ኮት፡ ​ቅድ​ስተ፡ ​ቅዱ​ሳን፡ ​አን​ቲ፡ ​ውእ​ቱ፡ ​ኦእ​ግዝ​እት​ነ፡
                                    ​ወላ​ዲተ፡ ​አም​ላክ፡
                                     ​ማር​ያም<fo:inline>[፡]</fo:inline> ​ድን​ግል፡ ​ተሰ​መይ​ኪ፡
                                    ​ሥም​ረተ፡ ​አብ<fo:inline>[፡]</fo:inline>
                  </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    
                                  ​ስብ​ሐት፡ ​ለኪ፡ ​ኦወ​ላዲ​ተ፡ ​እግ​ዚአ፡ ​ኵሉ፡ ​አኰ​ቴት፡ ​ወክ​ብር፡ ​ለአ​ብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ​ኵሎ፡ ​ጊዜ፡ ​ይእ​ዜኒ፡ ​ወዘ​ልፈ​ኒ፡ ​ወለ​ዓለ​መ፡ ​ዓለ​ም፡ ​አሜ​ን፡ ​ወአ​ሜን፡
                                  ​ለይ​ኩን፡ ​ለይ​ኩን፡ ​ወል​ድኪ፡ ​ሣህ​ሎ፡ ​ይክ​ፍለ​ነ፡ ​ሰአ​ሊ፡ ​ለነ፡ ​ቅድ​ስት ፨
                                    ፨ ፨
                                </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Additional notes</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 1r: Pen trial followed by a short text written in Amharic. The note is hardly legible due to faded ink.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 1v: Prayer with protective names.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        Incipit: :
                                        <fo:inline>&lt;...&gt;</fo:inline>​መ፡ ​አብ፡ ​በል፡ ​ጸሎ​ት፡ ​በእ​ንተ፡ ​አስ​ማተ፡
                                        <fo:inline>&lt;...&gt;</fo:inline>​ሀበ፡ ​ንዋ​ይ፡ ​አስ​ተራ​ክብ፡ ​አስተ<fo:inline>&lt;...&gt;</fo:inline>​አስ​ተሳል<fo:inline>&lt;...&gt;</fo:inline>
                                        ... 
                                    </fo:inline>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 1v: Note in Amharic and Gǝʿǝz, only partly
                                        legible, describing how to prepare medicine from the olive tree.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus">
                           <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                              <fo:inline>&lt;...&gt;</fo:inline> ​የወ<fo:inline>[ይ]</fo:inline>​ራው​ን፡ ​የቀ​ጠጥ​ና፡ ​ቅጠ​ል፡ ​የጥ<fo:inline>&lt;...&gt;</fo:inline>​ጨገ​ር፡
                                        ​ቅጠ​ል፡ ​ይኅ​ን፡ ​ደቁ​ሶ፡ ​በሚ​ጦሳ​ይ፡ ​ቅቤ​ድግ፡ ​ለኵ​ሉ፡ ​ዘይ​ሴኑ፡ ​ወይ<fo:inline>&lt;...&gt;</fo:inline>​ስተ​ሰ፡ ​ወይ፡ ​በብ​ራና፡ ​እሰር</fo:inline>
                        </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>4)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 1v: Salām-hymn to St Michael, CAe 6703.. The hymn is written in red.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ሰላ​ም፡ ​ለአ​ስተ​ርዕ​ዮት​ከ፡ <fo:inline>ወስተ (!)</fo:inline>፡ ​ደብ​ረ፡ ​ማህ​ው፡ ​ዘዮ​ም፡ ​ዘም​ስለ፡ <fo:inline>ቅብ (!)</fo:inline>
                                        ​ዘይት ፡  ​ጥኡ​ም፡ ​ቃለ ​አዋ​ዲ፡ ​ዮሐ​ንስ፡ ​ዘን​ብረ​ትከ፡
                                        ገ ዳ ም<fo:inline>&lt;...&gt;</fo:inline>​በት​ንባ​ሌከ፡
                                        ​ተፈ​ኒዎ<fo:inline>&lt;...&gt;</fo:inline>​ዕም​ሱክ፡ ​ልኡ​ል፡ ​አዕ​ያም፡ ​ሰከ<fo:inline>&lt;...&gt;</fo:inline>​ሀጥ​አት​የ፡
                                        ​ሚካ ኤ ​ል፡ ​ፍሕ​ም።</fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>5)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 1v: List of the saints commemorated on the beginning of the year, written in red. The note is possibly a supplication.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ምስ​ለ፡ አ<fo:inline>&lt;...&gt;</fo:inline>​ጉኤ​ል፡ ​ስዑ​ል፡ ​በነ​በል​ባል፡ ​ወም​ስለ፡ ​ዮሐ​ንስ፡ ​ድን​ግል፡ ​ወኢ​ዮብ፡ ​ጻድ​ቅ፡
                                        ​ተወ​ካፌ፡ ​ቁስ​ል፡ ​ምስ​ለ፡ ​በር​ተሎ​ሜዎ​ስ፡ ​ሐዋ​ርያ፡ ​ሰባ​ኬ፡ ​ወን​ጌል፡ ​አው​ደ፡ ​አመ​ት፡  <fo:inline>&lt;...&gt;</fo:inline>
                        </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>6)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 1v: Hardly decipherable note in Gǝʿǝz and Amharic, written in red.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>7)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 1v: Admonition of Jesus to his disciples, written in red.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                           <fo:inline>&lt;...&gt;</fo:inline>​ዕን​ተ፡ ​ኢት​ጠፍ​ዕ፡ ​ውስ​ተ፡ ​ለአ​ለም፡ ​ወይ​ቤሎ​ሙ፡ ​ኢየ​ሱስ፡ ​ለአ​ርዳ​ኢሁ፡
                                        ​ኢት​ፁሩ፡ ​ወር​ቀ፡ ​ኢብ​ሩረ፡ ​ወኢ​አል​ባሰ፡ ​ክቡ​ረ፡ ​ይሒ​ይስ፡ ​ምጽ​ወት፡ እ<fo:inline>[ም]</fo:inline>​ዘጊ​ቦቱ፡
                                    ​ዘወ​ርቅ።</fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>8)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 1v: Prayer, probably to Mary, written in red.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ንኢ<fo:inline>[፡]</fo:inline>
                                        ​ርግ​ብየ፡ ​ወንኢ<fo:inline>[፡]</fo:inline> ​ሠና​ይት​የ፡ ​ትና​ዝዝ​ኒ፡ ​ሀዘነ<fo:inline>[፡]</fo:inline> ​ልብ​የ፡ ​ንኢ፡<fo:inline>&lt;...&gt;</fo:inline> ​ርግ​ብየ፡ ​ወንኢ
                                        ​ሠና​ይት​የ፡ ​ምስ​ለ፡ ​እራ​ጉኤ​ል። ​ስኡል<fo:inline>[፡]</fo:inline> ​በነ​በል​ባል። ​ንበ​ል። ​ምስ​ለ፡ ​ዮሐ​ንስ</fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>9)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 2r: ‘’ (​መጽ​ሐፈ፡ ​ኮቦ​ር፡), CAe 6702..</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">Incipit:  :
                                        ​ለእ​መ፡ ​ኮነ፡ ​ኮቦ​ር፡ ​ዮሐ​ንስ፡ ​በሰ​ኑይ፡ ​አል​ቦ፡ ​ደዌ፡ ​ለሰ​ብእ፡ ​አገ​ሳ፡ ​የሐ​ልቁ፡ ​ዝና​ም፡ ​የሐ​ፅፅ፡ ​መዓ​ር፡ ​ይው​ኅዝ፡
                                        ​ሰገ​ም፡ ​ይሰ​ምር፡ ​ሰና​ይ፡ ​ይሰ​ምር፡ ​ሕፃ​ናት፡ ​ይሙ​ውቱ  ፨ ... </fo:inline>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em"/>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>10)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 2r: Hardly legible note in black and red.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>11)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 2v: Pen trial written in red.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ተግ​ሣጽ፡ ​ለኵ​ሉ፡ ​ጻድ​ቃን፡ ​ወለ​ኃጥ​አን። ​አር​አያ፡ ​ፍካ​ሬ፡ ​ዘጻ​ድቃ​ን፡ ​ወዘ​ኃጥ​አን።
                                        ​መዝ​ሙር፡ ​ዘዳ​ዊት፡ ​ሃሌ፡ ​ሉያ። ​ብፁ​ዕ፡ ብ</fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>12)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 4r: Amharic note mentioning <fo:inline id="d1e32442PRS13846WaldaM">Walda Madḫǝn</fo:inline>, hardly legible.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus">
                           <fo:inline id="d1e32446PRS13846WaldaM">
                              <fo:inline font-style="italic">​መም<fo:inline>&lt;...&gt;</fo:inline>​ሬ፡</fo:inline> 
                                        ​ወል​ደ፡ ​መድ​ኅን፡</fo:inline> ​ሙግ​ት፡ ​ያቃ​ሉ፡ ​ስላት<fo:inline>&lt;...&gt;</fo:inline>​ገቱ​ለኝ፡ ​አቸ​ሙ፡ ​የለ​ሸን፡ ​አሳ​ዘና​ት፡ ​ወሰ​ኔን፡ ​በጨ​ቤ፡ ​ሊቀ​ዳት፡ ​ነበ​ር፡</fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>13)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 7v: Protective formula and supplication mentioning <fo:inline id="d1e32463PRS13847GabraS">Gabra Śǝllāse Getānah</fo:inline>, here indicated as ‘your servant’.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ሰም​ርያ​ለ፡ ​መፍ​ትሐ፡ ​ክን​ክድ​ድ፡ ​ጸን​ል፡ ​ዮና​ብኤ​ል፡ ​ጸር​የ፡ ​ወጸ​ላዕ​ትየ፡ ​ሊተ፡ ​ለገ​ብር​ከ፡ <fo:inline id="d1e32468PRS13847GabraS">​ገብ​ረ፡ ​ሥላሴ<fo:inline>[፡]</fo:inline>
                           </fo:inline>
                        </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>14)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 108r: Ownership note indicating that the manuscript belongs to <fo:inline id="d1e32480PRS13847GabraS">Gabra Śǝllāse Getānah</fo:inline>. The note also mentions his father <fo:inline id="d1e32482PRS13848KidanaQ">Kidāna Qāl Warqu</fo:inline> and his mother <fo:inline id="d1e32484PRS13849Iyaluta">ʾIyaluṭā ʾƎmmanaš</fo:inline>.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ዝመ​ጽሐ​ፍ፡ ዘ<fo:inline id="d1e32489PRS13847GabraS">​ገብ​ረ፡ ​ሥላ​ሴ፡
                                        ​ወጌ​ታነ​ህ፡</fo:inline> ​ወአ​ቡሁ፡
                                        <fo:inline id="d1e32492PRS13848KidanaQ">​ኪዳ​ነ፡ ​ቃል፡ ​ወር​ቁ፡</fo:inline> ​ወእ​ሙ፡ <fo:inline id="d1e32495PRS13849Iyaluta">​ኢየ​ሉጣ፡ ​እመ​ነሽ፡</fo:inline>
                        </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>15)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 121va: Calendaric note in Amharic, only partly legible.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus">
                           <fo:inline>&lt;...&gt;</fo:inline> ​ቀዳ​ሚት፡ ​፰፡ ​የሁ​ድ፡ ​፯፡ ​የሰ​ኞ፡ ​፮፡ ​የማ​ክሰ​ኞ፡ ​፭፡ ​የረ​ቡ፡
                                        ​፬፡ ​የሐ​ሙስ፡ ​፫፡ ​የዓ​ርብ፡ ​፪፡ ​ተው​ሳክ፡ ​ነው<fo:inline>&lt;...&gt;</fo:inline>​አተ፡ ​ጾም፡ ​ተው​ሳክ፡ ​፲ወ<fo:inline>&lt;...&gt;</fo:inline>
                                        ​የደ​ብረ፡ ዘ<fo:inline>&lt;...&gt;</fo:inline>​ወ፬፡ ​የሆ​ሳዕ<fo:inline>&lt;...&gt;</fo:inline>፡ ​፪የ<fo:inline>&lt;...&gt;</fo:inline>፡
                                        ​፯፡ ​የት​ንሣ​ኤ፡ ​፱፡ <fo:inline>&lt;...&gt;</fo:inline>​ኦሪ​ት፡ <fo:inline>&lt;...&gt;</fo:inline>​፳ወ​፰፡
                                        ​ጾመ<fo:inline>[፡]</fo:inline> ​ድኅ​ነት፡ ​፩፡ ​የጾ​መ፡ ​ሐዋ​ርያ​ት፡ ​፯፡ ​ነው፡
                                        <fo:inline>&lt;...&gt;</fo:inline>​ረቀ፡ ​መጥ​ቅ፡ ​ይወ​ጣል፡</fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>16)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 121va–121vb: ‘Reckoning of auspicious and inauspicious (days) On Auspicious Days for Cutting Trees On Moonwood’ (​ሐሳ​በ፡ ​ጽን​ዕት፡ ​ወጽ​ንጽ​ንት፡), CAe 4145..</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        Incipit: :
                                        <fo:inline>&lt;...&gt;</fo:inline>
                           <fo:inline>መስከም፡ (!)</fo:inline>
                                        ፲ ወ<fo:inline>&lt;...&gt;</fo:inline>
                                        ​ፅንዕ<fo:inline>&lt;...&gt;</fo:inline> ​ወእ​ምኔ​ሁ፡ ​ጽንጽ ን ​ት። በ<fo:inline>&lt;...&gt;</fo:inline>​ቅም​ት፡
                                         ፳ ወ ፰  ​ጽን​ጽን​ት፡
                                    ​ወእ​ምኔ​ሁ፡ ​ጽን​ዕት። ... 
                                        </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>17)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 121vb: <fo:inline id="d1e32591">no title provided</fo:inline>. Note listing the feast days of the apostles for each month. The text breaks off abruptly.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">Incipit:  :
                                        ​ሠረ​ቀ፡ ​መስ​ከረ​ም፡ በ ፩  ​በር​ተሎ​ሜዎ​ስ፡ ​ዮሐ​ንስ፡ ​ምጥ​ምቅ፡ ​ሠረ​ቀ፡ ​ጥቅ​ምት፡
                                        በ ፲ ወ ፪ ፡
                                        ​ማቴ​ዎስ፡ ​ወን​ጌላዊ ፨ ... 
                                    </fo:inline>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>18)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 122r: Note written in red. The text, partly effaced and hardly legible, is probably the beginning of a calendaric note in Amharic
                                        (identical to Additional note 17), followed by lines of characters in all vowel orders.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Varia</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Occasional line take-ups at the end of a line (e.g. fols 15v, 43v, 80r).
                                        Omitted characters and words are added interlineally (e.g. fols 7r, 42v, 87r).
                                    Rarely, erroneous words are erased and corrections written above the erasure or interlineally
                                    (e.g. fols 9v, 55r, 90r), and the end of a line is written in compressed script (e.g. fols 11v, 49r).
                                  </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                                        Some Gǝʿǝz characters are visible on the protective strip of parchment which was placed around the lower end of Quire 8,
                                        between fol. 62 and fol. 63, and fol. 72 and fol. 73.
                                        Below the lines of text, remains of two lines of crudely drawn ornamental bands can be seen.
                                    </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                                        Some Gǝʿǝz characters are visible on the protective strip of parchment which was placed around the upper part of Quire 12.
                                    </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>4)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>A white sticker is glued to the inner side of the front board.
                                        The name of <fo:inline id="d1e32707PRS5782JuelJen">Bent Juel-Jensen</fo:inline> is printed on it
                                        (‘<fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ቤን​ት፡ ​ዩው​ል፡ ​የን​ሰን።</fo:inline>’) and the signature ‘MS. Aeth. e. 32’ is written in pencil.
                                        An additional sticker, with the signature ‘Ms 18’ on it, is glued on the bottom of the same side.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>5)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>A white sticker is glued to the inner side of the back board.
                                      A short description of the manuscript’s content and main physical features in English is printed on it. Written
                                      in pencil on the sticker are ‘Ge/x/-’, ‘PB 371’, ‘₤ 40’, and ‘1643’.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>
                              The book is bound in wooden boards.
                            
                              The boards are flush with the first and last quires but are slightly smaller than the central ones.
                              The boards have external bevels and the grain runs vertically. Both outer and inner surfaces of the boards exhibit signs of the working tool.
                              However, the outer surface and the edges are polished and a layer of dark-coloured finish has been added.
                              It is possible that the back board served as a support for other operations since small punched holes are visible on the inner side.
                            
                              Chainstitch sewing on four sewing stations (two pairs) executed with Z-plied threads; the sewing presents a periodic fold pattern except in the first quire
                              where it is continuous and the thread lengths are double between the second and the third sewing station.
                              The ends of the threads are knotted outside the last quire to the chains formed by the sewing on the spine.
                              The sewing broke in few points which have been repaired with a white coloured thread.
                          
                              In the upper external corner of the back board, a hole, possibly the trace of the former presence of a bookmark or a fastening system,
                              is present.
                          
                              Parchment <fo:inline id="d1e32746">guards</fo:inline> placed around the <fo:inline id="d1e32749">spine fold</fo:inline> of the quires fols q8, q12
                              have been sewn during the <fo:inline id="d1e32754">main sewing</fo:inline>, indicating an early repair of the bookblock.
                          </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Foliation</fo:block>
            <fo:block>Pencil foliation in the upper right corner (1–122).</fo:block>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Quire structure</fo:block>
         <fo:block>13 quires. A<fo:inline font-size="7pt" vertical-align="text-top">2 (Fols 1r–2v)</fo:inline> – I<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 3r–12v)</fo:inline> – II<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 13r–22v)</fo:inline> – III<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 23r–32v)</fo:inline> – IV<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 33r–42v)</fo:inline> – V<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 43r–52v)</fo:inline> – VI<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 53r–62v)</fo:inline> – VII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 63r–72v)</fo:inline> – VIII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 73r–82v)</fo:inline> – IX<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 83r–92v)</fo:inline> – X<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 93r–102v)</fo:inline> – XI<fo:inline font-size="7pt" vertical-align="text-top">11 (Fols 103r–113v)</fo:inline> – XII<fo:inline font-size="7pt" vertical-align="text-top">8+1 (Fols 114r–122v)</fo:inline>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 3r–108r: 1
                                    column (25–26 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 23r. The characters per line are 14–30.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            218 × 190 mm (fol. 23r).
                                            </fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            146 × 147 mm (fol. 23r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 22 mm, bottom: 50 mm, right: 30 mm, left: 16 mm (fol. 23r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 108va–121vb: 2
                                    columns (25 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 114r. The characters per line are 13–15.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            218 × 190 mm (fol. 23r).
                                            </fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            151 × 146 mm (fol. 114r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 24 mm, bottom: 39 mm, right: 18 mm, left: 23 mm, intercolumn: 14 mm (fol. 114r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Ruling and pricking are visible. Both primary and ruling pricks are visible. The upper and bottom lines are written above the ruling.
                                     Ruling and pricking are visible. Both primary and ruling pricks are visible. The upper and bottom lines are written above the ruling.
                                     Ruling pattern: 1A-1A/0-0/0-0/C.  Ruling pattern: 1A-1A-1A1A/0-0/0-0/C.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->Mid-seventeenth–mid-nineteenth century.. Irregular, but probably trained, hand. Characters are irregularly spaced, and written lines placed also somewhat irregularly
                                    on the ruled lines.<fo:block>Ink: Black, red.</fo:block>
                           <fo:block>Rubrication: 
                                    Several groups of lines on the incipit pages, alternating with black lines; titles of the psalms and of the
                                    canticles; incipits of the portions of the Song of Songs; the name <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ማር​ያም፡</fo:inline> and its abbreviations;
                                    name and traditional interpretation of the Hebrew letters in Ps 118; the abbreviation standing for the refrain
                                    in the Praise of Mary and the Gate of Light;
                                    elements of the punctuation signs, text dividers, and numerals.
                                </fo:block>
                           <fo:block>Abbreviations: <fo:list-block provisional-distance-between-starts="6mm"
                                             provisional-label-separation="6mm"
                                             start-indent="cm">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()">
                                       <fo:block>
                                          <fo:inline>1)</fo:inline>
                                       </fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block hyphenate="true">Single letters for the entire refrain in the Praise of Mary and the Gate of Light;</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()">
                                       <fo:block>
                                          <fo:inline>2)</fo:inline>
                                       </fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block hyphenate="true">
                                        ​ሰ፡ ​ለ፡ ​ቅ፡ for ​ሰአ​ሊ፡ ​ለነ፡ ​ቅድ​ስት፡ (e.g. fols 109rb, 114ra, 117ra);
                                    </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()">
                                       <fo:block>
                                          <fo:inline>3)</fo:inline>
                                       </fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block hyphenate="true">
                                        ​ማር​ያ፡ or ​ማር፡  for ​ማር​ያም፡ (e.g. fols 112rb, 114ra, 114va);
                                    </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()">
                                       <fo:block>
                                          <fo:inline>4)</fo:inline>
                                       </fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block hyphenate="true">
                                        ​ወ፡ ​ሣ፡ ​ይ፡ ​ሰ፡ ​ለ፡ ​ቅ፡ for ​ወል​ድኪ፡ ​ሣህ​ሎ፡ ​ይክ​ፍለ​ነ፡ ​ሰአ​ሊ፡ ​ለነ፡ ​ቅድ​ስት፡ (e.g. fols 120ra, 120vb).
                                    </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Decoration</fo:block>
         <fo:block margin-top="3mm" margin-bottom="3mm" white-space-collapse="true">Headbands have been executed by an untrained hand and could be contemporary or posterior to the making of the manuscript.</fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Miniatures</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Headpieces</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em">
            <fo:inline>(12) Fol. 3r: <fo:inline>Unfinished frame with an irregular pattern of red and black triangles.
                               </fo:inline>
            </fo:inline>
            <fo:inline>(13) Fols 8r, 13r, 18v, 26r, 31v, 36r, 42v, 50v, 56v, 60v, 70r, 80r: <fo:inline>Smaller bands, marking the beginning of a new groups of ten Psalms and filled with irregular geometric patterns,
                                 are inserted in the space left by the last line of the previous Psalm.</fo:inline>
            </fo:inline>
            <fo:inline>(14) Fol. 103r: <fo:inline>Rectangular frame filled with irregular black and red triangles and topped by stylized crosses (?).
                               </fo:inline>
            </fo:inline>
         </fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Drawings</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Other</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Other details</fo:block>
            <fo:block>Holes on several folios from the parchment making process (e.g. fols 48, 51, 61).</fo:block>
            <fo:block/>
            <fo:block/>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Condition</fo:block>
            <fo:block>The condition is good.
                                  The manuscript shows traces of intensive use. It is damaged by humidity
                                  throughout, in particular at the beginning and end, so that most folios are unevenly deformed and
                                  their lower margins are stained. Protective strips of parchment, which were probably recycled from
                                  another manuscript and on whose inner sides letters can still be read, have been placed around the lower end of Quire 8 and the upper part of Quire 12 .
                                  All edges have been re-trimmed.
                                  On fol.  tears and losses are present.
                                  The sewing is broken at the attachment of the first and third sewing stations with the upper board.
                                  On the spine, are visible the repairs and reinforcements to the original sewing thread made with a white thread.
                                </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>mid-seventeenth–mid-nineteenth century</fo:inline>
                            The manuscript can be dated palaeographically to the period between the
                            mid-seventeenth and the mid-nineteenth century.
                            A secondary ownership note mentions <fo:inline id="d1e32768PRS13847GabraS">Gabra Śǝllāse Getānah</fo:inline>,
                            probably a later owner of the manuscript (see Additional note 14).
                            Another note of unclear content mentions a certain <fo:inline id="d1e32773PRS13846WaldaM">Walda Madḫǝn</fo:inline>, whose role
                            in the manuscript’s history is unknown
                            (see Additional note 12).
                        </fo:block>
            <fo:block>The manuscript was sold by Sotheby’s on
                            6 July 1964 (lot 185) to the
                            publisher
                            Kegan Paul, Trench, Trübner &amp; Co, from whom <fo:inline id="d1e32784PRS5782JuelJen">Bent Juel-Jensen</fo:inline> purchased it.</fo:block>
            <fo:block>The manuscript entered the Bodleian Libraries as part of the
                            bequest of <fo:inline id="d1e32789PRS5782JuelJen">Bent Juel-Jensen</fo:inline> after his death in 2006.</fo:block>
         </fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLaethe32">https://betamasaheft.eu/BDLaethe32</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
   <fo:page-sequence initial-page-number="auto-odd" master-reference="Aethiopica-master">
      <fo:static-content flow-name="rest-region-before-odd">
         <fo:block-container height="100%" display-align="center">
            <fo:table>
               <fo:table-column column-width="30%"/>
               <fo:table-column column-width="40%"/>
               <fo:table-column column-width="30%"/>
               <fo:table-body>
                  <fo:table-row>
                     <fo:table-cell>
                        <fo:block text-align="right"/>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block text-align="center" font-size="9pt" font-family="Ludolfus">Bodleian Aeth. f. 29</fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block font-size="9pt" font-family="Ludolfus" text-align="right">
                           <fo:page-number/>
                        </fo:block>
                     </fo:table-cell>
