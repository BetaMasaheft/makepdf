               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- BIBLIOGRAPHY           -->
         <fo:block id="bibliography"
                   page-break-before="always"
                   font-weight="700"
                   margin-bottom="6.25pt">Bibliography</fo:block>
         <fo:block id="bm_TasfaGiyorgis1956Taammera"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">[Tasfā Gabra Śǝllāse], ed., 1963. ተአምረ፡ ማርያም። ንባቡ፡ በግዕዝ፡ ትርጓሜው፡ በአማርኛ። (Taʾammǝra Māryām: nǝbābu ba-gǝʿz tǝrgwāmew ba-ʾamārǝññā , ‘Miracles of Mary: Its reading in Gǝʿǝz and its translation in Amharic’) (ʾAddis ʾAbabā: Tasfā Gabra Śǝllāse māttamiyā bet, 1963).</fo:block>
         <fo:block id="bm_Budge1923Miracles"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Budge, E. A. [Thompson] W. 1923. One hundred and ten miracles of Our Lady Mary (London: Medici Society, 1923).</fo:block>
         <fo:block id="bm_Bassano1922BiluyKidan"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Da Bassano, F., ed., 1923–1926. ብሉይ፡ ኪዳን። ዘተሰናአወ፡ ምስለ፡ መጻሕፍት፡ ቀደምት፡ ዘብራና፡ ወምስለ፡ መጻሕፍተ፡ ሶርያ፡ ወጽርእ፡ ወዓረብ ። (Bǝluy kidān. Zatasanāʾawa mǝsla maṣāḥǝft qaddamt zabǝrānnā wamǝsla maṣāḥǝfta soryā waṣǝrʾ waʿārab), I–IV (Asmarae: Typis missionis catholicae, 1923–1926).</fo:block>
         <fo:block id="bm_DegeMueller2015Psalter"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Dege-Müller, S. 2015. ‘The Ethiopic Psalter manuscripts: scribal practices and text arrangement’, in A. Bausi, A. Gori, D. Nosnitsin, and E. Sokolinski, eds, Essays in Ethiopian Manuscript Studies: Proceedings of the International Conference Manuscripts and Texts, Languages and Contexts: the Transmission of Knowledge in the Horn of Africa, Hamburg, 17–19 July 2014, Supplement to Aethiopica, 4 (Wiesbaden: Harrassowitz Verlag, 2015), 59–74.</fo:block>
         <fo:block id="bm_2019GnisciGospel"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Delamarter, S. and J. Gnisci 2019. ‘The Psalter in Geʿez’, in J. Gnisci, ed., Treasure of Ethiopia and Eritrea in the Bodleian Library, Oxford (Oxford: Manar al-Athar, University of Oxford, 2019), 37–51.Gnisci, J. 2019. ‘The Gospel in Geʿez’, in J. Gnisci, ed., Treasures of Ethiopia and Eritrea in the Bodleian Library, Oxford, Manar al-Athar Monograph, 5 (Oxford: Manar al-Athar, University of Oxford, 2019), 29–36.</fo:block>
         <fo:block id="bm_Devens2007Mahaleya"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Devens, M. 2007. ‘Mäḥalǝyä näbiyat’, in S. Uhlig, ed., Encyclopaedia Aethiopica, III (Wiesbaden: Harrassowitz Verlag, 2007), 646a-b.</fo:block>
         <fo:block id="bm_Fries1892Weddase"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Fries, K. 1892. ውዳሴ፡ ማርያማ፡ Weddâsê Mârjâm. Ein äthiopischer Lobgesang an Maria, nach mehreren Handschriften herausgegeben und übersetzt. Inaugural-Dissertation zur Erlangung der Doktorwürde bei der Hohen Philosophischen Fakultät der Königlichen Universität Upsala (Leipzig: Gustav Fock, 1892).</fo:block>
         <fo:block id="bm_Getatchew2003Anqasa"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Getatchew Haile 2003. ‘Anqäṣä bǝrhan’, in S. Uhlig, ed., Encyclopaedia Aethiopica, I (Wiesbaden: Harrassowitz Verlag, 2003), 278b–279b.</fo:block>
         <fo:block id="bm_Gleave1951Songof"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Gleave, H. C. 1951. The Ethiopic Version of the Song of Songs, ed., tr. H. C. Gleave (London: Taylor’s Foreign Press, 1951).</fo:block>
         <fo:block id="bm_Grohmann1919Marien"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Grohmann, A. 1919. Aethiopische Marienhymnen, ed., tr. A. Grohmann, Abhandlungen der Sächsischen Akademie der Wissenschaften, 68, Abhandlungen der philologisch-historischen Klasse der Sächsischen Akademie der Wissenschaften, 33/4 (Leipzig: Bei B. G. Teubner, 1919).</fo:block>
         <fo:block id="bm_Heldman2010Psalter"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Heldman, M. E. 2010. ‘Psalter’, in S. Uhlig and A. Bausi, eds, Encyclopaedia Aethiopica, IV (Wiesbaden: Harrassowitz Verlag, 2010), 231a–233a.</fo:block>
         <fo:block id="bm_2017HeldmanYared"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Heldman, M. E. and K. K. Shelemay 2017. ‘Concerning Saint Yared’, in A. C. McCollum, ed., Studies in Ethiopian Languages, Literature, and History: Festschrift for Getatchew Haile Presented by his Friends and Colleagues, Aethiopistische Forschungen, 83 (Wiesbaden: Harrassowitz Verlag, 2017), 65–93.</fo:block>
         <fo:block id="bm_JuelJensen1996MikaelZata"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Juel-Jensen, B. 1996. ‘The Mikael Zata Gospels: A Late Fifteenth Century Ethiopian Manuscript with Miniatures by Nicolo Brancaleone’, The Book Collector, 45/1 (1996), 29–45.</fo:block>
         <fo:block id="bm_Knibb2000Psalms"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Knibb, M. A. 2000. ‘The Ethiopic Translation of the Psalms’, in A. Q. Aejmelaeus, ed., Der Septuaginta-Psalter und seine Tochterübersetzungen (Göttingen: Vandenhoeck &amp; Ruprecht, 2000), 107–122.</fo:block>
         <fo:block id="bm_Lash1972Gateof"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Lash, C. 1972. ‘“Gate of Light”: an Ethiopian Hymn to the Blessed Virgin’, Eastern Church Review, 4; 5 (1972), 36–46; 143–156.</fo:block>
         <fo:block id="bm_Ludolf1701Psalterium"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Ludolf, H. 1701. መጽሐፈ፡ መዝሙራት፡ ዘዳዊት — Psalterium Davidis aethiopice et latine cum duobus impressis &amp; tribus MSStis codicibus diligenter collatum &amp; emendatum, nec non variis lectionibus &amp; notis philologicis illustratum, ut in præfatione pluribus dicetur. Accedunt Æthiopicè tantùm Hymni et Orationes aliquot Vet. et Novi Testamenti, item Canticum Canticorum, cum variis lectionibus &amp; notis (Francofurti ad Moenum: prostat apud Johannem David Zunner et Nicolaum Wilhelmum Helwig, 1701).</fo:block>
         <fo:block id="bm_Tasfa1966Dawit"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Täsfa Gäbrä Śǝllase 1966. መዝሙረ፡ ዳዊት፡ ወጸሎታት፡ ዘነቢያት፡ (Mäzmurä Dawit wäṣälotat zänäbiyat, ‘Songs of David and the prayers of the Prophets’) (Addis Abäba: n.pub., 1966).</fo:block>
         <fo:block id="bm_Weninger2010EAEWeddaseMaryam"
                   margin-bottom="2pt"
                   start-indent="0.5cm"
                   text-indent="-0.5cm">Weninger, S. 2010. ‘Wǝddase Maryam’, in S. Uhlig and A. Bausi, eds, Encyclopaedia Aethiopica, IV (Wiesbaden: Harrassowitz Verlag, 2010), 1173a–74a.</fo:block>
         <!--  break  before Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
