      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLaethb3"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. b. 3</fo:block>
            <fo:block>(Juel-Jensen 25, EMIP 03453)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment codex435×375 mm, 294 fols, 31 quires, 1730–1755.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e43815LIT1560Gospel">
               <fo:inline>I) Fols 5ra–293vb: <fo:inline xml:lang="en" hyphenate="true">Four Gospels, CAe 1560.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e43823LIT2705Introd">
               <fo:inline>I-1) Fols 5ra–14ra: <fo:inline xml:lang="en" hyphenate="true">Introduction to the Gospels, CAe 2705.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e43829LIT4872MaqdemaWangel">
               <fo:inline>I-1-1) Fols 5ra–9vb: <fo:inline xml:lang="en" hyphenate="true">‘Introduction to the Gospels’ (​መቅ​ድመ፡ ​ወን​ጌል፡), CAe 4872.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                         ​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ​አሐ​ዱ፡ ​አም​ላክ ፨
                                         ​ንቀ​ድም፡ ​በረ​ድኤ​ተ፡ ​እግዚ ​አብ​ሔር፡ ​ይት​ባረ​ክ፡ ​ስሙ፡
                                         ​ወይ ​ትለ​ዓል፡ ​ዝክ​ሩ፡ ​ወፍ​ጽም​ናሁ፡ ​ዘእ ​ምኔ​ሁ፡ ​ኵሉ፡ ​ሢመ​ተ፡ ​ኃይ​ል፡ ​ወቦ​ቱ፡  ​ተፍ​ጻሜ​ተ፡ ​ኵሉ፡ ​ስእ​ለት።
                                             ​ወኀቤ ​ሁ፡ ​ምብ​ጻሐ፡ ​ኵሉ፡ ​አስ​ተብ​ቍዖ​ት፡ ​በጽ​ሒፈ፡ ​መቅ​ድመ፡  ፬  ​ወን​ጌላ​ት፡ ​ስቡ​ሐት፡ ወ ፲  ​አቅ​ማራ​ት፡
                                         ​በሰ​ላመ፡  ​እግ​ዚአ​ብሔ​ር፡  ​አሜን ፨
                                     </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                         
                                         ​ቀመ​ር፡ ​ዓሥ​ር፡ ​በዘ​ተሌ​ለየ፡ ​ቦቱ፡ ​ኵሉ፡  ፩  ​እም​ሰባ​ክያ​ን፡  ​፪፻፶  ​መስ​መር፡
                                         ​ማቴ​ዎስ፡  ​፷ወ፪  ​መስ​መር ፨ 
                                         ​ማር​ቆስ፡
                                          ​፲ወ፩  ​መስ​መር። ​ሉቃ​ስ፡  ​፸፪  ​መስ​መር ፨  ​ዮሐ​ንስ፡ ​፺ወ፰
                                         ​መስ​መር ፨
                                     </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e43901LIT4873Stichometry">
               <fo:inline>I-1-2) Fol. 9vb: <fo:inline xml:lang="en" hyphenate="true">Stichometry, CAe 4873.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​ወን​ጌል፡ ​ቅዱ​ስ፡ ​ዘዜ​ነወ፡ ​ማቴ​ዎስ፡ ​ቃሉ፡  ​፳፻​ወ፯፻
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​ወም​ግባ​ራተ፡ ​ቃሎ​ሙ፡ ለ ፬  ​ወን​ጌላ​ት፡  ​፺፻ ወ ​፬፻፡፵ ወ ​፱።  ​ወከ​መዝ፡ ​ኃብ​ሩ፡ ​አር​ባዕ​ቲሆ​ሙ፡ ​ወን​ጌላ​ት፡
                                             ​ለዓ​ለመ፡ ​ዓለም ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e43932LIT4870EvangelistsSymbols">
               <fo:inline>I-1-3) Fol. 9vb: <fo:inline xml:lang="en" hyphenate="true">The Evangelists and their Symbols, CAe 4870.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The entire text is reproduced below.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​ዘብ​እሲ፡ ​ማቴ​ዎስ፡ ​ዘአ​ንበ​ሳ፡ ​ማር ​ቆስ፡ ​ዘላ​ህም፡ ​ሉቃ​ስ፡ ​ዘን​ስር፡ ​ዮሐ​ንስ፡ ​ዘል​ዑለ፡ ​ይሰ​ርር፡ ​ወል​ዑለ፡ ​ይሰ​ብክ፡ ​ቃለ፡ ​ወል​ደ፡  ​እግ​ዚአ​ብሔ​ር፡  ​ለዓ​ለመ፡ ​ዓለ​ም፡
                                             ​አሜን ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e43954LIT1548Gessaw">
               <fo:inline>I-1-4) Fols 9vc–10rb: <fo:inline xml:lang="en" hyphenate="true">Synopsis of classes, CAe 1548.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​በእ​ንተ፡ ​ኅብ​ረተ፡ ​ቃላ​ት፡ ​ዘ፬ ​ወን​ጌላ ​ውያ​ን፡ ​ግጻ​ዌ፡ ​ሥር​ዓት፡ ​ወእ​ንዘ፡ ​ይተ​ሉ፡
                                             ​ረድ​ኤት፡  ፪  ​ጸሐ​ፉ፡ ​ባሕ​ቲቶ​ሙ፡ ​እን​ከ፡ ​ወን​ጌለ፡ ​እም​ሐዋ​ርያ​ት፡ ወ ፪  ​እመ​ትሎ​ሆሙ፡
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​አኮ፡ በ ፳ ወ ፪  ​ሰብ​እ፡ ​ወኢለ ፻  ​አላ፡ ​ለአ​ህጉ​ር፡ ​ወአ​ሕዛ​ብ፡ ​ወለ​ምድ​ር፡ ​ወለ​ባሕ​ር፡ ​ወአ​ላዳ​ክ፡ ​ወለ​ፀር፡ ​ወለ​ኵሉ፡
                                             ​ዓለ​ም፡ ​አእ​መኑ፡ ​በዘ​ኅን፡ ​ዘእ​ግዚ​እነ፡  ​ኢየ​ሱስ፡ ​ክር​ስቶ​ስ፡  ​መር​ሶ፡ ​አብ​አ፡ ​ወመ​ጠዎ፡ ​በእ​ንተ፡ ​ኅብ​ረተ፡
                                             ​ቃላ​ት፡ ​ዘቅ​ዱሳ​ን፡  ፬  ​ወን​ጌል ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e43999LIT4869Disciples">
               <fo:inline>I-1-5) Fol. 10rb: <fo:inline xml:lang="en" hyphenate="true">‘’ (The 72 Disciples ), CAe 4869.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​ዘእ​ምሐ​ዋር​ያተ፡ ​እግ​ዚእ​ነ፡ ​አር​ድእ​ት፡ ​ዘእ​ምኍ​ልቈ፡ ​፸ወ፪ 
                                             ​እም​ኔሆ​ሙ፡ ​ቀሌ​ምን​ጦስ፡ ​ሰበ​ከ፡ ​ወጸ​ሐፈ፡ ​ሕገ፡ ​ቤተ፡ ​ክር​ስቲ​ያን፡
                                             ​ለጳ​ጳሳ​ት፡ ​ወለ​ቀሳ​ውስ​ት፡ ​ወለ​ኵሉ፡ ​ፍጻ​ሜ፡ ​ሢመ​ተ፡ ​ቤተ፡ ​ክር​ስቲ​ያን ፨
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​ማቴ​ዎስ፡  ፩  ​በር​ናባ​ስ፡  ፩  ​ቃሊ​ኖስ፡ ​ጸሐ​ፈ፡ ​በእ​ንቲ​አሁ፡ ​ኀበ፡ ​ጢሞ​ቴዎ​ስ፡ ​ረድ​ኡ፡ ​ለጳ​ውሎ​ስ፡ ​ታዴ​ዎስ፡ ​ወቀ​ለዮጳ ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44028LIT4871OriginalLanguage">
               <fo:inline>I-1-6) Fols 10rb–10rc: <fo:inline xml:lang="en" hyphenate="true">The Original Language, CAe 4871.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ወን​ጌል፡ ​ዘሰ​በከ፡ ​ማቴ​ዎስ፡ ​በል​ሳነ፡ ​ዕብ​ራው​ያን፡ ​በኢ​የሩ​ሳሌ​ም፡ ​ተር​ጐመ፡ ​በል​ሳነ፡ ​ጽር​ዕ፡ ​ምስ​ለ፡ ​ዮሐ​ንስ ፨
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ወግ​ብረ፡ ​ሐዋ​ርያ​ትኒ፡ ​ሉቃ​ስ፡ ​ወን​ጌላ​ዊ፡ ​ተር​ጐመ፡ ​በነ​ገረ፡ ​ጽር​ዕ፡ ​እን​ዘ፡ ​ዕብ​ራይ​ስጥ፡ ​ሀሎ፡ ​ወን​ጌል፡ ​ዘዜ​ነወ፡ ​ዮሐ​ንስ፡ ​ተር​ጐመ፡ ​ዮሐ​ንስ፡ ​ጳጳ​ስ፡ ​በነ​ገረ፡ ​ጽርዕ ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44051LIT4874EpiscopalSees">
               <fo:inline>I-1-7) Fol. 10rc: <fo:inline xml:lang="en" hyphenate="true">Note on the Episcopal Sees of the Four Evangelists, CAe 4874.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The entire text is reproduced below.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​መና​ብር​ቲሆ​ሙ፡ ​ለለ​አሐዱ ፨  ​ዘማ​ቴዎ​ስ፡ ​ሮሜ፡ ​ዘማ​ርቆ​ስ፡ ​እለ፡ ​እስ​ክን​ድር​ያ፡ ​ዘሉ​ቃስ፡ ​አን​ጾኪ​ያ፡ ​ዘዮ​ሐን​ስ፡ ​ኤፌ​ሶን ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44071LIT1349EpistlEusebius">
               <fo:inline>I-1-8) Fols 10rc–10vc: <fo:inline xml:lang="en" hyphenate="true">Epistle of Eusebius to Carpianus (General record), CAe 1349.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​አሞ​ንዮ​ስ፡ ​እስ​ክን​ድር​ያዊ፡ ​በብ​ዙኅ፡ ​አስ​ተሐ​ምሞ፡ ​ወጽ​ሒቅ፡ ​ገብ​ረ፡ ​ወኃ​ደገ፡ ​ለነ፡
                                             ​ቃለ፡ ​ዘከ​መ፡ ​ኃብ​ሩ፡  ፬  ​ወን​ጌላት ፨  ​ወእ​ምዝ፡ ​አር​እስ​ተ፡
                                              ም ​ንባ​ባት ፨
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ኀበ​ሂ፡ ​አዘዘ ፨  ​ኀበ​ሂ፡ ​ገሠጸ ፨ 
                                             ​ኀበ​ሂ፡ ​መሀረ ፨  ​ኀበ​ሂ፡ ​ነበረ ፨ 
                                             ​ወት​እም​ርት፡ ​ኀበ፡ ​አኀ​ዙ፡ ​ትእ​ምር​ተ፡ ​መስ​ቀል ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44123LIT4875Reliability">
               <fo:inline>I-1-9) Fols 10vc–11ra: <fo:inline xml:lang="en" hyphenate="true">Introduction on the Reliability of the Gospels, CAe 4875.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ማዕ​ርገ፡ ​ወን​ጌል፡ ​ወዝ​ማሬ፡ ​ዘበ​አማ​ን፡ ​በተ​አም​ራት፡ ​ግሁ​ዳት፡ ​እም​ኀበ፡ ​ኵሎ​ሙ፡ ​ሐዋ​ርያ​ት፡ ​ወመ​ንክ​ራት፡ ​መዋ​ዔ፡ ​ኵሉ፡ ​ልቡ​ናት፡
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ወው​እቶ​ሙ፡ ​ማቴ​ዎስ፡ ​ወማ​ርቆ​ስ፡ ​ሉቃ​ስ፡ ​ወዮ​ሐንስ ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44144LIT1558Matthew#BiographyMatthew">
               <fo:inline>I-1-10) Fols 11ra–11rb: <fo:inline xml:lang="en" hyphenate="true">Gospel of Matthew (Collection): Biography of Matthew</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ወለ​ማቴ​ዎስ፡ ​ስሙ፡ ​ሌዊ፡ ​ዘበ​ትር​ጓሜ​ሁ፡ ​ኅሩ​ይ፡ ​ውእ​ቱ፡ ​እም​ነገ​ደ፡ ​ይሳ​ኮር፡ ​እም​ሀገ​ረ፡ ​ናዝ​ሬት ፨ 
                                             ​ስመ፡ ​አቡ​ሁ፡ ​ዱቅ፡ ​ወስ​መ፡ ​እሙ፡ ​ካሩ​ትስያ ፨
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ወሰ​በከ፡ ​ባቲ፡ ​በህ​ንድ፡ ​ወበ​ኢየ​ሩሳ​ሌም ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44170LIT1558Matthew#EusebianSectionsMatthew">
               <fo:inline>I-1-11) Fol. 11rb: <fo:inline xml:lang="en" hyphenate="true">Gospel of Matthew (Collection): Statement about the Eusebian Sections in the Gospel of Matthew</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​ወኍ​ልቈ፡ ​አር​እስ​ተ፡ ​ወን​ጌሉ፡  ​፫፻፶ ወ ፭
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​ወም​ዕራ​ፋቲ​ሁ፡ ​በል​ሳነ፡ ​ሮሜ፡  ​፷፰ ቱ ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44195LIT1224Canons">
               <fo:inline>I-1-12) Fols 12ra–14ra: <fo:inline xml:lang="en" hyphenate="true">Canons of Eusebios (General record), CAe 1224.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44203LIT1558Matthew">
               <fo:inline>I-2) Fols 15ra–94vb: <fo:inline xml:lang="en" hyphenate="true">Gospel of Matthew (Collection), CAe 1558.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44209LIT1558Matthew#MatthewGospel">
               <fo:inline>I-2-1) Fols 15ra–94va: <fo:inline xml:lang="en" hyphenate="true">Gospel of Matthew (Collection): Gospel of Matthew</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​በስ​መ፡
                                              ​ብስ​ራተ፡ ​አብ፡ ​ቅዱ​ስ፡ ማ ​ቴዎስ ፤  ​ሐዋ​ርያ፡
                                             ​አሐ​ዱ፡  ​እም​ዓሠ​ርቱ፡ ​ወክል ​ኤቱ፡ ​አር​ዳኢሁ ፨ 
                                             ​ጸሎ  (b)  ​ቱ፡ ​ወበ​ረከ​ቱ፡ ​የሀ​ሉ፡ ም ​ስለ፡ ​ንጉ​ሥነ፡ ​ዋሕ​ድ፡
                                             <fo:inline id="d1e44231PRS5617IyasuII">​ኢያሱ</fo:inline>፡  ​ወን​ግሥ​ትነ፡
                                                 <fo:inline id="d1e44234PRS2682BerhanM">​ወለ​ተ፡
                                                     ​ጊዮ​ርጊ​ስ፡</fo:inline> ​ለዓ​ለመ፡   (a)  
                                             ​ዓለ​ም፡ ​አሜን ፤ 
                                             ​ወአ  (b)  ​ሜን ፤ ​ለይ​ኩን፡
                                             ​ለይ​ኩን ፤
                                         </fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​መጽ​ሐፈ፡ ​ልደ​ቱ፡ ​ለእግ ​ዚእ​ነ፡ ​ኢየ​ሱስ፡ ​ክርስ ​ቶስ፡ ​ወል​ደ፡ ​ዳዊ​ት፡ ​ወል ​ደ፡ ​አብ​ርሃም ፨ 
                                             ​አብር ​ሃም፡ ​ወለ​ዶ፡ ​ለይ​ስሐ​ቅ፡  ​ወይ​ስሐ​ቅ፡ ​ወለ​ዶ፡ ​ለያ​ዕቆብ ፨
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ወና​ሁ፡ ​አነ፡ ​ሀሎ​ኩ፡ ​ምስ​ሌክ​ሙ፡ ​በኵ​ሉ፡ ​መዋ​ዕል፡ ​እስ​ከ፡ ​ኅል​ቀተ፡ ​ዓለም ፨ 
                                             ​አሜን ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44288LIT1558Matthew#PostscriptMatthew">
               <fo:inline>I-2-2) Fols 94va–94vb: <fo:inline xml:lang="en" hyphenate="true">Gospel of Matthew (Collection): Colophon of the Gospel of Matthew</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​ተፈ​ጸመ፡ ​ጽሕ​ፈተ፡  ​ወኮ​ነ፡ ​ጽሒ​ፎቱ፡ ​በም​ድረ፡ ​ፍል​ስጥ​ኤም፡
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​በቀ​ዳሚ​ሁ፡ <fo:inline>ዓም፡ (!)</fo:inline>
                                             ​ዘእ​ምቀ​ላው​ዴዎ​ስ፡
                                             ​ቄሳ​ር፡ ​ንጉ​ሠ፡ ​ሮም ፨ 
                                             ​ወስ​ብሐ​ት፡ ​ለእ​ግዚ​አብ​ሔር፡ ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​ዘልፈ ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44325LIT1882MarkGo">
               <fo:inline>I-3) Fols 95ra–145rb: <fo:inline xml:lang="en" hyphenate="true">Gospel of Mark (Collection), CAe 1882.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44331LIT1882MarkGo#BiographyMark">
               <fo:inline>I-3-1) Fols 95ra–95va: <fo:inline xml:lang="en" hyphenate="true">Gospel of Mark (Collection): Biography of Mark</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​በስ​መ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ሕያ​ው፡ ​እስ​ከ፡ ​ለዓ​ለም፡ ​ወበ​ኢየ​ሱስ፡ ​ክር​ስቶ​ስ፡  ​ቀዳ​ማዊ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ​ማሕ​የዊ ፨                                              ​ዝን​ቱሰ፡ ​ማር​ቆስ፡ ​ሐዋ​ርያ፡ ​ሊቀ፡ ​ጳጳ​ሳት፡ ​ቅዱ​ስ፡ ​ወድ​ንግ​ል። ​ወኮ​ነ፡ ​ስሙ፡ ​ቅድ​መ፡ ​ዮሐ​ንስ፡ ​በከ​መ፡ ​ዘከ​ሮ፡ ​ሉቃ​ስ፡ ​በኣ​ብር​ክሲ​ስ፡ ​ስማ፡ ​ለእ​ሙ፡
                                            ​ዝን​ቱሰ፡ ​ማር​ቆስ፡ ​ሐዋ​ርያ፡ ​ሊቀ፡ ​ጳጳ​ሳት፡ ​ቅዱ​ስ፡ ​ወድ​ንግ​ል፡ ​ወኮ​ነ፡ ​ስሙ፡ ​ቅድ​መ፡ ​ዮሐ​ንስ፡
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ወአ​ዕረ​ፈ፡ ​አመ፡  ፴ ​ሁ፡ ​ለሚ​ያዝ​ያ፡
                                             በ ፲ ወ ፬ ፡
                                                 ​ዓመ​ተ፡ ​መን​ግሥ​ቱ፡ ​ለቀ​ላው​ዴዎ​ስ፡ ​ቄሳ​ር፡ ​ወኵ​ሉ፡ ​ኑኃ፡ ​ንብ​ረቱ፡
                                              ፸  ​ዓመት ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44371LIT1882MarkGo#EusebianSectionsMark">
               <fo:inline>I-3-2) Fol. 95va: <fo:inline xml:lang="en" hyphenate="true">Gospel of Mark (Collection): Statement about the Eusebian Sections in the Gospel of Mark</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​ወኍ​ልቈ፡ ​ምዕ​ራፋ​ቲሁ፡ ​ንኡ​ሳን፡ ​፪፻፴ ወ ​፯።
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ወም​ዕራ​ፋቲ​ሁ፡ ​እን​ተ፡ ​ተተ​ርጐ​መት፡ ​በል​ሳነ፡ ​ቅብ​ጥ፡  ፶ ወ ፬  ​ወበ​ሮሜ፡  ፵ ወ ፰ ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44408LIT1882MarkGo#TituliMark">
               <fo:inline>I-3-3) Fols 95va–95vb: <fo:inline xml:lang="en" hyphenate="true">Gospel of Mark (Collection): Tituli of the Gospel of Mark</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ፩  ​ዘጋ​ኔን ፨
                                             ፪  ​ሐማ​ተ፡ ​ጴጥ​ሮስ ፨
                                             ፫  ​እለ፡ ​ተፈ​ወሱ፡ ​እም​ብዙ​ኃ፡ ​ደዌ​ሆሙ ፨
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​፵፮  ​ዘከ​መ፡ ​አግ​ብኦ፡ ​ይሁዳ ፨
                                             ​፵፯  ​ዘከ​መ፡ ​ክሕ​ዶ፡ ​ጴጥ​ሮስ ፨
                                             ​፵፰  ​ስእ​ለተ፡ ​ሥጋ​ሁ፡ ​ለእ​ግዚ​እነ ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44468LIT6725Letter">
               <fo:inline>I-3-4) Fols 96ra–96vb: <fo:inline xml:lang="en" hyphenate="true">Letter from Patriarch John XVII to King ʾIyāsu II, CAe 6725.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​መጽ​ሐፈ፡ ​መል​እክ​ት፡ ​ዘተ​ፈነ​ወት፡ ​እም<fo:inline id="d1e44474PRS5712JohnXVI">​ዮሐ​ንስ፡</fo:inline> ​ገብ​ረ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ዘተ​ሰም​የ፡
                                             ​ዘጸ​ጋሁ፡ ​ወተ​ሠይ​መ፡  ​በፈ​ቃዱ፡  ​ለተ​ልእ​ኮ፡ ​መን​በር፡ ​ማር​ቆሳ​ዊ፡ ​በሀ​ገረ፡ ​ዓባ​ይ፡
                                             ​እለ፡ ​እስ​ክን​ድር​ያ፡ ​ወት​ዕይ​ንተ፡ ​ኢየ​ሩሳ​ሌም፡ ​ወገ​ዳማ​ተ፡ ​ምስ​ር፡ ​ወበ​ሐው​ርተ፡ ​ኢት​ዮጵ​ያ፡ ​ሰላ​መ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ቅዱ​ስ፡ ​ሕይ​ወተ፡ ​ሥጋ፡ ​ወኵ​ሉ፡ ​ነፍ​ስ፡
                                             <fo:inline>ይኀድር፡ (!)</fo:inline> ​ዝን​ቱ፡
                                             ​ሰላ​ም፡ ​መን​ፈሳ​ዊ፡ ​ላዕ​ለ፡ ​ውሉ​ድነ፡ ​ውሉ​ደ፡ ​መን​ግሥ​ት፡ ​ልዑ​ላን፡ ​በሥ​ልጣ​ን፡ ​ወዕ​በይ፡ ​ወክ​ብር፡ ​ወዓ​ዲ፡ ​ይኀ​ድር፡ ​ጸጋ፡
                                              አ ​ምላ​ካዊ፡ ​ወበ​ረከ​ት፡ ​ሰማ​ያዊ፡ ​ላዕ​ሌከ፡ ​ኦወ​ልድ​ነ፡
                                             ​ቡሩ​ክ፡ ​ወወ​ሬዛ፡ ​ሠና​ይ፡ ​ዘነ​በር​ከ፡ ​በመ​ንበ​ረ፡ ​ነገ​ሥት፡ ​መሲ​ሐዊ​ያን፡
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ወይ​ኩን፡ ​ፍቱ​ሐ፡ ​ወቡ​ሩከ፡ ​በአ​ፈ፡ ​አበ​ዊነ፡ ​ሐዋ​ርያ​ት፡ ​ንጹ​ሐን፡ ​ወበ​አፈ፡ ​ሊቃ​ውን​ተ፡ ​ቤተ፡ ​ክር​ስቲ​ያን፡ ​ቅድ​ስት፡ ​ወበ​አፈ፡ ​ኵሎ​ሙ፡ ​ሊቃ​ነ፡ ​ጳጳ​ሳት፡ ​ቅዱ​ሳን፡ ​ወአ​ፉየ፡ ​አነ፡ ​ዮሐ​ንስ፡
                                             ​ላዕ​ክ፡ ​በጸ​ጋ፡ ​መን​በር፡ ​ማር​ቆሳ​ዊ፡ ​ወሰ​ላመ፡ ​እግ​ዚአ​ብሔ​ር፡ <fo:inline>ይኀድር፡ (!)</fo:inline> ​ላዕ​ሌክ​ሙ፡ ​ወስ​ብሐ​ት፡ ​ለእ​ግዚ​አብ​ሔር፡ ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​አሜ​ን።
                                             ​ወተ​ጽሕ​ፈ፡ ​በዘ​መነ፡ ​ዮሐ​ንስ፡ ​ወን​ጌላ​ዊ፡ ​በእ​ደ፡
                                             <fo:inline id="d1e44492PRS5712JohnXVI">
                        <fo:inline font-style="italic">​አባ፡</fo:inline> ​ዮሐ​ንስ፡</fo:inline> ​ሊቀ፡ ​ጳጳ​ሳት፡
                                             ​ዘእ​ለ፡ ​እስ​ክን​ድር​ያ፡ ​አመ፡ ​፳ወ፭ ​ለመ​ስከ​ረም፡ ​ወበ ​፲፻​ወበ​፬፻​ወ፷ ​እም​ዓመ​ተ፡
                                             ​ሰማ​ዕታ​ት፡  ​ንጹ​ሐን።
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44506LIT1882MarkGo">
               <fo:inline>I-3-5) Fols 97ra–145rb: <fo:inline xml:lang="en" hyphenate="true">Gospel of Mark (Collection), CAe 1882.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44512LIT1882MarkGo#MarkGospel">
               <fo:inline>I-3-5-1) Fols 97ra–145rb: <fo:inline xml:lang="en" hyphenate="true">Gospel of Mark (Collection): Gospel of Mark</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
    ​ብስ​ራተ፡ ​አብ፡ ​ቅዱ​ስ፡ ማ ​ሪ፡ ​ማር​ቆስ፡ ​ወን​ጌላዊ ።
    ​አሐ​ዱ፡ ​እም​ሰብ​አ፡ ​ወክ ​ልኤ​ቱ፡
    ​አር​ድእት ፨ 
    ​በረ  (b)  ​ከተ፡ ​አም​ላኩ፡ ​ወሀ​ብተ፡  ​ረድ​ኤቱ፡ ​ትኩ​ን፡ ​ምስ​ለ፡
     ​ንጉ​ሥነ፡ <fo:inline id="d1e44535PRS5617IyasuII">​ኢያ​ሱ፡</fo:inline> ​ወን​ግሥ ​ትነ፡
    <fo:inline id="d1e44539PRS2682BerhanM">​ወለ​ተ፡ ​ጊዮ​ርጊ​ስ፡</fo:inline> ​ለዓ​ለመ፡ ​ዓለ​ም፡
    ​አሜን ፨
     (a)   ​ወአ​ሜን ፨ 
    ​ለይ​ኩን ፨
</fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                                 ​ቀዳ​ሚሁ፡ ​ለወ​ንጌ​ለ፡ እ ​ግዚ​እነ፡ ​ኢየ​ሱስ፡ ​ክርስ ​ቶስ፡ ​ወል​ደ፡
                                                     ​እግ​ዚኣብ ​ሔር፡ ​በከ​መ፡ ​ጽሑፍ ፨ ​ውስ​ተ፡ ​መጽ​ሐፈ፡
                                                 ​ነቢያ ት ፨
                                             </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                                 ​ወወ​ፂኦ​ሙ፡ ​እሙ​ንቱ፡ ​ሰበ  (b)  ​ኩ፡ ​በኵ​ለሄ፡ ​እን​ዘ፡ ​እግ​ዚእ፡ ​ይረ​ድእ ፤ 
                                                 ​ወቃ​ሎ፡ ​ያጸ​ንዕ፡ ​በተ​አም​ር፡ ​ዘይ​ተሉ፡ ​አሜን ፨
                                             </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44589LIT1882MarkGo#MarkPostscript">
               <fo:inline>I-3-5-2) Fol. 145rb: <fo:inline xml:lang="en" hyphenate="true">Gospel of Mark (Collection): Postscript of the Gospel of Mark</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​መል​አ፡ ​ጽሕ​ፈተ፡  ​ወኮ​ነ፡
                                             ​ጸሐ​ፎ፡ ​በል​ሳነ፡ ​ሮሜ ፤  ​ዘአ​ፍር​ንጊ፡ ​ዘሀ​ገረ፡ ​ሮምያ ፨
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​በዓ​ሠር​ቱ፡ ​ወአ​ሐዱ፡ ​ዓመቱ ፤  ​በራ​ብዒ​ት፡ ​ዓመቱ ፤ 
                                             ​ለቀ​ላው​ድዮ​ስ፡ ​ቄሳ​ር፡ ​ንጉ​ሠ፡ ​ሮም​ያ፡ ​ወስ​ብሐት ፤ 
                                             ​ለእ​ግዚ​አብ​ሔር፡ ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​አሜ​ን፡ ​ወአ​ሜን ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44638LIT1812GospelLuke">
               <fo:inline>I-3-6) Fols 145va–228ra: <fo:inline xml:lang="en" hyphenate="true">Gospel of Luke (Collection), CAe 1812.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44644LIT1812GospelLuke#LukeGospelPreface">
               <fo:inline>I-3-6-1) Fol. 145va: <fo:inline xml:lang="en" hyphenate="true">Gospel of Luke (Collection): Preface to the Gospel of Luke</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44650LIT1812GospelLuke#SupplicationPrefaceLuke">
               <fo:inline>I-3-6-1-1) Fol. 145va: <fo:inline xml:lang="en" hyphenate="true">Gospel of Luke (Collection): Supplication in the Preface to the Gospel of Luke</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                                 ​በስ​መ፡ ​አብ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ዘይት ​ወሐ​ድ፡  ​በህ​ላዌ፡ ​መለ ​ኮት፡
                                                 ​ወይ ​ሤለ​ስ፡ ​በአ​ካላ​ት፡
                                                     ​ወበ​ገጻ​ት፡ ሕ ​ያው፡ ​ወማ​ሕየ​ዌ፡ ​ዘመ​ሐረ​ነ፡ ​በስ​ንዓ​አሁ፡ ​እም​ድኅ​ረ፡
                                                     ​ስሕ​ተት፡ <fo:inline>ወፁረት፡ (!)</fo:inline> ​ወመ​ርሐ​ነ፡ ​ድኅ​ረ፡ ​ተኃ​ጐልነ ፨
                                             </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                                 
                                                 ​ሎቱ፡ ​ይደ​ሉ፡ ​ስብ​ሐት፡ ​ለክ​ቡረ፡ ​ክቡ​ራን፡ ​ወአ​ልቦ፡ ​ካል​እ፡ ​አም​ላክ፡ ​ዘእ​ንበ​ሌሁ ፨
                                             </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44682LIT1812GospelLuke#TitlePrefaceLuke">
               <fo:inline>I-3-6-1-2) Fol. 145va: <fo:inline xml:lang="en" hyphenate="true">Gospel of Luke (Collection): TitlePrefaceLuke</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The entire text is reproduced below.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                                 
                                                 ​ንወ​ጥን፡ ​በረ​ድኤ​ተ፡ ​እግ​ዚአ​ብሔ​ር፡
                                                 ​በጽ​ሒፈ፡ ​ወን​ጌል ፤ 
                                                 ​መብ​ስር፡ ​እን​ተ፡ ​ዘሉ​ቃስ፡ ​ኅሩ​ይ፡ ​ወሥ​ሙር፡</fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44700LIT1812GospelLuke#BiographyLuke">
               <fo:inline>I-3-6-2) Fols 145va–146ra: <fo:inline xml:lang="en" hyphenate="true">Gospel of Luke (Collection): Biography of Luke</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ወኮ​ነ፡ ​ሉቃ​ስ፡ ​ዐቃ​ቤ፡ ​ሥራ​ይ፡ ​በአ​ንጾ​ኪያ ፨ 
                                             ​ወረ​ድኦ፡ ​ለእ​ግዚ​እነ፡ ​ኢየ​ሱስ፡ ​ክር​ስቶስ ፨ 
                                             ​ወው​እቱ፡ ​እም​ኍል​ቈ፡ ​ሰብ​አ፡ ​አር​ድእ​ት፡ ​ኅሩ​ያን፡
                                             ​ወቀ​ለዮ​ጳሂ፡ ​እሉ፡ ​አስ​ተር​አየ፡ ​ሎሙ፡ ​እግ​ዚእ​ነ፡ ​በዕ​ለተ፡ ​ትን​ሣኤ፡ ​ውስ​ተ፡ ​ፍኖ​ት፡ ​ኢማ​ኁስ ፨
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ወአ​እረ​ፈ፡ ​ከዊ​ኖ፡ ​ሰማ​ዕተ፡ ​በሮ​ምያ፡ ​አመ፡
                                              ፲ ወ ፪ ፡
                                             ​ለወ​ርኃ፡ ​ጥቅ​ምት፡
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44732LIT1812GospelLuke#EusebianSectionsLuke">
               <fo:inline>I-3-6-3) Fol. 146ra: <fo:inline xml:lang="en" hyphenate="true">Gospel of Luke (Collection): Statement about the Eusebian Sections in the Gospel of Luke</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ወኍ​ልቈ፡ ​ምዕ​ራፉ​ሰ፡ ​ዘኀ​ብሩ፡ ​ባቲ፡
                                              ፹ ወ  ፫ ፡
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ወበ​ካል​ዕሰ፡ ​ጽሕ​ፈት፡
                                              ​፴፻ ፡
                                             ​ውእቱ  ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44762LIT1812GospelLuke#TituliLuke">
               <fo:inline>I-3-6-4) Fols 146ra–146va: <fo:inline xml:lang="en" hyphenate="true">Gospel of Luke (Collection): Tituli of the Gospel of Luke</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ፩  ​ጸሐፍ ፨
                                             ፪  ​ኖሎት ፨
                                             ፫  ​ስም​ዖን፡ ​ካህን ፨
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​፹፩  ​ዘከ​መ፡ ​ነስ​ሐ፡ ​ፈያ​ታዊ ፨
                                             ​፹፪  ​በእ​ንተ፡ ​ሥዕ​ላተ፡ ​ሥጋሁ ፨
                                             ​፹፫  ​ቀለ​ዮጳ፡ ​ወካ​ልኡ ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44817LIT2713Luke">
               <fo:inline>I-3-6-5) Fols 147ra–227vc: <fo:inline xml:lang="en" hyphenate="true">‘Gospel of Luke’ (​ብስ​ራተ፡ ​ሉቃ​ስ፡), CAe 2713.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44823LIT1812GospelLuke#LukeGospel">
               <fo:inline>I-3-6-5-1) Fols 147ra–227vb: <fo:inline xml:lang="en" hyphenate="true">Gospel of Luke (Collection): Gospel of Luke</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                                 ​ብስ​ራተ፡ ​አብ፡ ​ትሩ​ፍ፡  ​ሉቃ​ስ፡ ​ወን​ጌላዊ ፨ 
                                                 አ ​ሐዱ፡ ​እም​ሰብ​ዓ፡ ​ወክ ​ልኤ​ቱ፡
                                                 ​አር​ድእት ፨ 
                                                 ​ጸሎ​ቱ፡ ​በረ​ከቱ፡ የ  (b)  ​ሀሉ፡ ​ምስ​ለ፡
                                                     ​ንጉ​ሥነ፡ <fo:inline id="d1e44842PRS5617IyasuII">​ኢያ​ሱ፡</fo:inline> ​ወን​ግሥ​ትነ፡
                                                 <fo:inline id="d1e44846PRS2682BerhanM">​ወለ​ተ፡ ​ጊዮ​ርጊ​ስ።</fo:inline>
                                                 ​ለዓ ​ለመ፡ ​ዓለ​ም፡ ​አሜን ፨  ​ወአ​ሜን ፨
                                                 ፨
                                             </fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                                 ​እስ​መ፡ ​ብዙ​ኃን፡ ​እለ፡  ​አኀ​ዙ፡ ​ይው​ጥኑ፡ ​ወይ ​ንግ​ሩ፡ ​ወይ​ምን​ሀሩ፡ ሥ ​ርዓ​ተ፡
                                                 ​ዜና፡ ​ግብ​ር፡ ዘ ​ንሕ​ነ፡
                                                 ​ጠየ​ቅና​ሁ፡ ​በእ ​ንተ፡ ​ግብ​ር፡ ​ዘአ​ምኑ፡ ​በላ​ዕሌ​ነ፡ ​በከ​መ፡ ​አይ​ድዑ​ነ፡ ​እል​ክቱ፡ ​እለ፡ ​ቀደ​ሙነ፡ ​ርእ​የቶ፡
                                                 ​ወተ​ልእ​ክዎ፡ ​ለቃ​ለ፡ ​ፈቃድ  (b)  ​ከ፡ ​ሊተ​ኒ፡ ​ረት​ዓኒ፡ ​ካዕ ​በ፡ ​ከመ፡ ​እጽ​ሐፍ፡ ​ለከ ፨
                                             </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                                 
                                                 ​ወነ​በሩ፡ ​በቤ​ተ፡ ​መቅ​ደስ፡ ​እን​ዘ፡ ​ይሴ​ብሕ​ዎ፡ ​ወይ​ባር​ክዎ፡ ​ለእ​ግዚ​አብ​ሔር፡ ​ዘልፈ ፨
                                             </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44898LIT1812GospelLuke#PostscriptLuke">
               <fo:inline>I-3-6-5-2) Fol. 228ra: <fo:inline xml:lang="en" hyphenate="true">Gospel of Luke (Collection): Colophon of the Gospel of Luke</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                                 ​መል​አ፡ ​ጽሕ​ፈተ፡   ​እን​ተ፡ 
                                                     ​ጸሐ​ፎ፡ ​በዮ​ናኒ፡ ​በሀ​ገረ፡ ​መቄ​ዶን​ያ፡
                                             </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                                 ​በዓ​መት፡ ​ዐሠ​ርቱ፡ ​ወአ​ርባ​ዕቱ፡ ​እመ​ንግ​ሥተ፡ ​አቅ​ሎን​ድዮ​ስ፡ ​ቄሳር ፨ 
                                                 ​ወስ​ብሐ​ት፡ ​ለእ​ግዚ​አብ​ሔር፡ ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​ወትረ ፨
                                             </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44927LIT1693John">
               <fo:inline>I-3-7) Fols 229ra–293vb: <fo:inline xml:lang="en" hyphenate="true">Gospel of John (Collection), CAe 1693.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e44933LIT1693John#JohnGospel">
               <fo:inline>I-3-7-1) Fols 229ra–293va: <fo:inline xml:lang="en" hyphenate="true">Gospel of John (Collection): Gospel of John</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​በስ​መ፡ ​እግ​ዚአ​ብሔ ​ር፡ ​ፈጣ​ሪ፡ ​ሕያ​ው፡ ​ቀዳ ​ማዊ፡ ​ዘሀ​ሎ፡ ​ወይሄ ​ሉ፡ ​እስ​ከ፡ ​ለዓ​ለም ፤ 
                                             ​ብስ​ራተ፡ ​ዮሐ​ንስ፡ ​ሐዋ  (b)  ​ርያ፡ ​ፈጻ​ሜ፡ ​ብስ​ራት፡  
                                             ​በረ​ከተ፡ ​አም​ላኩ፡ ት ​ኩን፡ ​ምስ​ለ፡ ​ንጉ​ሥነ፡ <fo:inline id="d1e44952PRS5617IyasuII">​ኢያ​ሱ፡</fo:inline> ​ወን​ግሥ​ትነ፡
                                             <fo:inline id="d1e44956PRS2682BerhanM">​ወለ​ተ፡ ​ጊዮ​ርጉ​ስ፡</fo:inline>
                                             ለ  (a)  ​ዓለ​መ፡ ​ዓለ​ም፡ ​አሜ​ን፡   (b)  ​ወአ​ሜን፡ ​ለይ​ኩን ፨
                                         </fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​ቀዳ​ሚሁ፡ ​ቃል፡ ​ውእ ​ቱ፡ ​ወው​እቱ፡ ​ቃል፡ ​ኀበ፡  ​እግ​ዚአ​ብሔ​ር፡ ​ውእ ​ቱ፡ ​ወእ​ግዚ​አብ​ሔር፡
                                              ​ውእ​ቱ፡ ​ቃል፡ ​ወከማ ​ሁ፡ ​ቀዳ​ሚሁ፡ ​እም​ቀዲ​ሙ፡ ​ሀሎ፡ ​ኀበ፡ ​እግ​ዚአ​ብሔር ፨ 
                                             ​ወኵ​ሉ፡ ​ቦቱ፡ ​ኮነ ፤  ​ወዘ​እን​በሌ​ሁሰ፡ ​አል​ቦ፡ ​ዘኮ​ነ፡
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​ወሶ​በ፡ ​ተጽ​ሕፈ፡ ​ኵሉ፡  ​በበ፡   ​አሐ​ዱ፡ ​እም​ኢያ​ግመ​ሮ፡ ​ዓለ​ም፡ ​ጥቀ ፨ 
                                             ​መጻ​ሕፍ​ቲሁ፡ ​ዘተ​ጽሕፈ ፨  ​አሜን ፨  ​ወአ​ሜን ፨                                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e45015LIT1693John#Postscript">
               <fo:inline>I-3-7-2) Fol. 293vb: <fo:inline xml:lang="en" hyphenate="true">Gospel of John (Collection): Colophon of the Gospel of John</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             ​መል​አ፡  ​እን​ተ፡ ​ጸሐ​ፋ፡ ​በዮ​ናኒ፡ ​ለሰ​ብአ፡ ​ሀገ​ረ፡ ​ኤፌ​ሶን።
                                         </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                             
                                             ​በሰ​መን​ቱ፡ ​ዓመ​ተ፡ ​መን​ግሥ​ቱ፡ ​ለኔ​ሮን፡ ​ቄሳር ፨ 
                                             ​ወስ​ብሐ​ት፡ ​ለእ​ግዚ​አብ​ሔር፡
                                             ​ለዓ​ለመ፡ ​ዓለም ፨  ​ወትረ ፨ 
                                             ​አሜን ፨
                                         </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Additional notes</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 1va–1vb: Record in Gǝʿǝz and Amharic by King <fo:inline id="d1e45587PRS5636IyoasI">ʾIyoʾas I</fo:inline> and Queen <fo:inline id="d1e45589PRS2682BerhanM">Bǝrhān Mogasā</fo:inline>,
                                        granting lands to Daǧǧāzmāčč ʾƎšate, probably to be identified with <fo:inline id="d1e45591PRS3856esateof">ʾƎšate of Qʷārā</fo:inline>, in recognition of his deeds in war. The record mentions ‘the children of Daǧǧ ʾazmāč Waraññā’, who might possibly be identified with <fo:inline id="d1e45593PRS9880Waldaew">Walda ʾƎwosṭātewos</fo:inline>.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ንሕ​ነ፡ ​ንጉ​ሠ፡ ​ነገ​ሥት፡ <fo:inline id="d1e45598PRS5636IyoasI">​ኢዮ​አስ፡</fo:inline> ​ወን​ግሥ​ት፡
                                        <fo:inline id="d1e45601PRS2682BerhanM">​ወለ​ተ፡ ​ጊዮ​ርጊ​ስ፡</fo:inline> ​ናሁ፡ ​ወሀ​ብና​ሁ፡ ​ለደ​ጃዝ​ማች፡ <fo:inline id="d1e45604PRS3856esateof">​እሸ​ቴ፡</fo:inline> ​እም​ብሔ​ረ፡
                                        ​አገ​ው፡ <fo:inline font-family="Ludolfus">​ደሮ​ምን። ​ድማ​ማን። ​ሶሪ​ትን። ​አነ​ጉሳ​ን። ​ዲኃ​ን።
                                        ​መን​ገሃ​ን። ​ቻጃ​ን። ​ኩን​ዘና​ን። ​አል​ችን። ​ቻጃ፡ ​ሙሃ​ን። ​ሙል​ን። <fo:inline id="d1e45609LOC7009Zobent">​ዞብ​ንት​ን።</fo:inline> ​ናጽ​ጋሪ​ን።
                                        <fo:inline id="d1e45612LOC3569Gomar">​ጎመ​ርን።</fo:inline> ​የጃ​ዎች ን ፡ ​አገ​ር።  ​ስህ​ሳን። ​እነ​ባበ​ራን።  ​ደገ​ሐን።
                                        ​ጆመ​ራን። ​ድኩ​ን። ​ባሪ​ችች​ን። ​ደረ​ብብ​ን።
                                        የ<fo:inline id="d1e45618PRS9880Waldaew">
                                 <fo:inline font-style="italic">​ደጅ፡ ​አዝ​ማች፡</fo:inline> ​ወረ​ኛ፡</fo:inline> ​ልጃ​ች፡ ​አካ​ፍለ​ው፡ ​ካስ​ር፡ ​አን​ድ፡ ​ያነ​ሱት​ን፡ ​አገ​ር፡ ​ጉደ​ራን። ​ባር​ዛፍ​ላን። ​ከመ፡ ​ይቀ​ድስ፡ ​ቦሙ፡ ​በታ​ቦተ፡ ​ቍስ​ቋም፡ ​እን​ተ፡ ​ይእ​ቲ፡ ​ደብ​ረ፡ ​ፀሐ​ይ።
                                          (b)   ​ምክ​ንያ​ተ፡ ​ውሂ​ቦት​ነሰ፡ ​ፍዳ፡ ​ዘመ​ቻሁ፡ ​መን​ገለ፡ ​ጋላ፡ ​ወቀ​ተሎ​ሙ፡ ​ለጂ​ዳ፡
                                            ​ወጨ​ሌሐ፡ ​ወአ​እመ​ኖሙ፡ ​ለኵ​ሎሙ፡ ​ሰብ​አ፡ ​ጋላ።</fo:inline>
                        </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 1vb: Amharic record of a transaction dated to the year of the World 7260, i.e. 1767, in which
                                        <fo:inline id="d1e45635PRS13903Hirut">Hirut</fo:inline> pawns land
                                        to <fo:inline id="d1e45637PRS13904Baytafa">Bāyṭafā</fo:inline>, with an extensive list of witnesses.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus">
                                        ​በ፸​፻ወ​፪፻፺ ​አመ​ተ፡ ​ዓለ​ም፡ ​በዘ​መነ፡ ​ዮሐ​ንስ፡ ​በመ​ስከ​ረም፡ ​በ፳፯ ​ቀን፡ 
                                        ​ማክ​ሰኞ፡
                                        የ<fo:inline id="d1e45645PRS13902Mammo">
                              <fo:inline font-style="italic">​ሊቄ፡</fo:inline> ​ማሞ፡</fo:inline> ​ልጅ፡
                                        <fo:inline id="d1e45650PRS13903Hirut">
                              <fo:inline font-style="italic">​ወይ​ዘሮ፡</fo:inline> ​ሂሩ​ት፡</fo:inline> ​የበ​ለሳ​ውን፡ ፩ ​ጋሻ፡ ​ሪም፡ ​የጋ​ሻ፡ ​እኩ​ል፡ ​ጃኑ​ህ፡ ​የጋ​ሻ፡
                                        ​እኩ​ል፡ ​እን​ጨና​ቆ፡ ​በ፪ ​ወቄ​ት፡ ​ካላ​ድ፡ <fo:inline id="d1e45655PRS13904Baytafa">
                              <fo:inline font-style="italic">​ላቤ​ቶ፡</fo:inline> ​ባይ​ጠፋ፡</fo:inline> ​አሲ​ዛለ​ች፡
                                        ​መሳ​ክር​ቱ፡ <fo:inline id="d1e45660PRS13905Batru">​ሊቀ፡ ​ጠበ​ብት፡ ​በት​ሩ፡</fo:inline>
                           <fo:inline id="d1e45664PRS13906Maqabo">​ርእ​ሰ፡ ​ደብ​ር፡ ​ማቀ​ቦ፡</fo:inline>
                           <fo:inline id="d1e45667PRS13907WaldaG">​መም​ሕር፡ ​ወል​ደ፡ ​ጌር​ጊስ፡</fo:inline>
                           <fo:inline id="d1e45670PRS13908WaldaE">​ግራ፡ ​ጌታ፡ ​ወል​ደ፡ ​እግ​ዚእ፡</fo:inline>
                           <fo:inline id="d1e45673PRS13922Mikael">
                              <fo:inline font-style="italic">​አባ፡ </fo:inline>​ሚካ​ኤል፡</fo:inline>
                           <fo:inline id="d1e45678PRS13913Semrat">​ሥም​ረት፡</fo:inline>
                           <fo:inline id="d1e45681PRS13914Yared">​ያሬ​ድ፡</fo:inline>
                           <fo:inline id="d1e45685PRS13915Salomon">​ሰሎ​ሞን፡</fo:inline>
                           <fo:inline id="d1e45688PRS13916Zaffaru">​ዘፈ​ሩ፡</fo:inline>
                           <fo:inline id="d1e45691PRS13917WaldaY">​ወል​ደ፡ ​ዮሐ​ንስ፡</fo:inline>
                           <fo:inline id="d1e45694PRS13918Seffet">​ጽፍ​ጥ፡</fo:inline>
                           <fo:inline id="d1e45697PRS13919Biyadgo">
                              <fo:inline font-style="italic">​አባ፡</fo:inline> ​ቢያ​ድጎ፡</fo:inline>
                           <fo:inline id="d1e45702PRS13920Wasan">​ወሰ​ን፡</fo:inline> ​የሊ​ቀ፡ ​ጠበ​ብት፡ ​ሎሌ፡
                                        <fo:inline id="d1e45706PRS13921WaldaK">​ወል​ደ፡ ​ኪሮ​ስ፡</fo:inline>
                           <fo:inline id="d1e45709PRS13910WaldaM">​አለ​ቃ፡ ​ወል​ደ፡ ​መለ​ኮት፡</fo:inline>
                           <fo:inline id="d1e45712PRS13909HabtaR">​አለ​ቃ፡ ​ሐብ​ተ፡ ​ሩፋ​ኤል፡</fo:inline>
                           <fo:inline id="d1e45714PRS13911Keflu"> ​አለ​ቃ፡
                                            ​ክፍ​ሉ፡</fo:inline>
                           <fo:inline id="d1e45717PRS13912TaklaG">​አቤ​ቶ፡ ​ተክ​ለ፡ ​ጌር​ጊስ፡</fo:inline> ​ጻፊ፡ <fo:inline id="d1e45720PRS13911Keflu">​ክፍ​ሉ፡ ​ወል​ደ፡ ​አረ​ጋይ፡</fo:inline> ​የቃ​ሐ፡ ​ዘወ​ልድ፡ ​ልጅ፡ ​አደ​ሩ፡
                                        ​የበ​ጋው​ን፡ ​አዝ​መራ፡ ​የም​ድሩ​ን፡ ​ይብ​ላ፡ ​በሰ​ኔ፡ ​ወር​ቁ፡ ​ባል​ሰጥ፡ ​ምድ​ሩን፡ ​ለቅ​ቄአ​ለሁ፡ ​ብለ​ው፡
                                    ​አፄ፡ ​ይሙ​ቱ፡ ​አሉ፡</fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 5r: Ownership note written in black ink in the upper margin, stating that this manuscript belonged to
                                        <fo:inline id="d1e45731INS0101MadhaneAlam">Madḫāne ʿĀlam</fo:inline>.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ወን​ጌል፡ ​ዘቅ​ዱስ፡ <fo:inline id="d1e45736INS0101MadhaneAlam">​መድ​ኃኔ፡ ​ዓለ​ም፡</fo:inline>
                        </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>4)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 11va: Amharic record on the appointment of an official by <fo:inline id="d1e45746PRS10450YosabI">Yosāb II</fo:inline>, dated to a year and seven months
                                        after King <fo:inline id="d1e45748PRS5618IyasuII">ʾIyāsu III</fo:inline>’s reign.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus">
                           <fo:inline id="d1e45752PRS5618IyasuII">
                              <fo:inline font-style="italic">​አፄ፡</fo:inline> ​ኢያ​ሱ፡</fo:inline> ​በነ​ገሡ፡ ​በዓ​መት፡ ​ከ፯ ​ወር​ኅ፡ ​እኔ፡
                                        <fo:inline id="d1e45757PRS10450YosabI">​ኢዮ​ሳብ፡</fo:inline> ​ባደ​ባባ​ይ፡ ​ቁሜ፡ ​ከን​ጉሡ፡ ​ከእ​ጨጌ​ው፡ ​ከሊ​ቃው​ንቱ፡ ​ከመ​ኳን​ንቱ፡ ​ያድ​ባራ​ቱ፡
                                    ​ሊቃ​ውን​ት፡ ​እዱ​ግነ​ት፡ ​የሾ​መ፡ ​ንጉ​ሥ፡ ​የተ​ላከ፡ ​መኰ​ነን፡ ​እሾ​ማለ​ሁ፡ ​ያለ፡ በ ​፫፻​፲ወ፰ በ ​፲ወ፪
                                    ​ሐዋ​ርያ​ት፡ ​እጨ​ጌም፡ ​አቡ​ን፡ ​ገዝ​ተዋ​ሉ፡</fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>5)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 11va: Amharic record in the same hand as Additional note 4, possibly of a donation from King
                                        <fo:inline id="d1e45771PRS5618IyasuII">ʾIyāsu III</fo:inline> to the Church. Five lines have been erased in the middle of the text. </fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus">የ<fo:inline id="d1e45776LOC6168Walaqa">​ወለ​ቃው​ንም፡</fo:inline> ​መሰ​ክ፡ ​ቀድ​ሞም፡ ​የጳ​ጳሳ​ት፡ ​ነበ​ር፡ ​አሁ​ንም፡ ​አፄ፡ ​ኢያ​ሱ፡ ​ላቡ​ን፡ ​ሰጥ​ተዋ​ሉ፡
                                        <fo:inline>[...]</fo:inline>
                                        ​የታ​ዘዙ​ቱ፡ <fo:inline id="d1e45781PRS13923Basalotu">
                              <fo:inline font-style="italic">​ሌቄ፡</fo:inline> ​በጸ​ሎቱ፡</fo:inline> ​ነዎ፡
                                        ​አብ​ዝኃ​ራን​ም፡ <fo:inline id="d1e45786PRS13924YabboB">
                              <fo:inline font-style="italic">​ባዛ​ዥ፡</fo:inline> ​ያቦ፡ ​ባር​ያ፡</fo:inline> ​እጅ፡ ​የነ​በረ​ውን፡
                                        ​፲፭ ​ጋሻ፡ <fo:inline id="d1e45791PRS8073Ramha">
                              <fo:inline font-style="italic">​ባላ​ምበ​ራስ፡</fo:inline> ​ረም​ኃና፡</fo:inline>
                           <fo:inline id="d1e45797PRS13923Basalotu">
                              <fo:inline font-style="italic">​ሌቄ፡</fo:inline> ​በጸ​ሎቱ፡</fo:inline> ​ቍስ​ቋም፡ ​ይቀ​ድሱ​በት፡ ​ብለ​ዋል፡ ​ይሕ​ነን፡ ​ያፈ​ረሰ፡
                                    በ ​፫፻​፲ወ​፰፡ ​በ፲​ወ፪ ​ሐዋ​ርያ​ት፡ ​ቃል፡ በ<fo:inline id="d1e45802PRS10450YosabI">
                              <fo:inline font-style="italic">​አቡ​ነ፡</fo:inline> ​ዮሳ​ብ፡</fo:inline>
                                        በ<fo:inline id="d1e45807PRS13628Tasfu">
                              <fo:inline font-style="italic">​እጨ​ጌ፡</fo:inline> ​ተስ​ፉ፡</fo:inline> ​ቃል፡ ​እን​ደ፡ ​ንስ​ጥሮ​ስ፡ ​ውጉ​ዝ፡ ​ነው፡
                                    </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>6)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 11v: Hardly legible stamp, probably by <fo:inline id="d1e45821PRS10450YosabI">Yosāb II</fo:inline>, whose name
                                        (<fo:inline font-style="italic">ʾAnbā</fo:inline> Yūsāb) is given next to it. Between the stamp is written, from right to left:
                                    <fo:inline baseline-shift="2pt"
                                   font-size="14pt"
                                   font-family="Scheherazade"
                                   writing-mode="rl">انبا يوساب</fo:inline>, <fo:inline baseline-shift="2pt"
                                   font-size="14pt"
                                   font-family="Scheherazade"
                                   writing-mode="rl">بسم الله الرووف الرحيم المجد لله في العلا</fo:inline>,
                                        and <fo:inline baseline-shift="2pt"
                                   font-size="14pt"
                                   font-family="Scheherazade"
                                   writing-mode="rl">حَرمة</fo:inline>.
                                    </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>7)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 96r: Hardly legible stamp, probably by <fo:inline id="d1e45847PRS10450YosabI">Yosāb II</fo:inline>, whose name
                                        (<fo:inline font-style="italic">ʾAnbā</fo:inline> Yūsāb) is given next to it. Between the stamp is written, from right to left:
                                        <fo:inline baseline-shift="2pt"
                                   font-size="14pt"
                                   font-family="Scheherazade"
                                   writing-mode="rl">بسم الله الرووف الرحيم المجد لله في العلا</fo:inline> .
                                    </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>8)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 294ra: Inventory in Amharic, listing books produced during the tenure of <fo:inline id="d1e45867PRS2266Ayente">ʾAyǝnte</fo:inline>.</fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus">በ<fo:inline id="d1e45872PRS2266Ayente">
                              <fo:inline font-style="italic">​መም​ህሬ፡</fo:inline> ​አይ​ንቴ፡</fo:inline>
                                        ​ሽመ​ት፡ ​የተ​ጻፈ፡ ፪  ​ስን​ክሳ​ር፡  ፩ ​ታም​ር፡
                                        ፪  ​ጉባ​ኤ፡ ​መል​ክ፡  ፩  ​ወን​ጌል፡</fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Varia</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 2ra–4va: Only four lines at the top and bottom of fols 2–3 are ruled, on which the beginnings of the Gospels of Matthew and Luke
                                    are written incompletely. Fol. 4 is ruled throughout and contains the beginning of the Gospel of Luke.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>The manuscript contains numerous scribal corrections throughout: erasures (e.g. fols 100va, 230va, 268vb);
                                        corrections written over the erasures (e.g. 95rb, 262ra, 288vb), mostly in condensed script
                                        (e.g. 104rb, 206va, 291vb). Rarely, erased spaces are marked by black and red lines
                                        (e.g. fols 214vb, 234rb, 260vb).
                                        A cross and a single stroke pointing to corrections
                                        are used occasionally
                                        in the margins (e.g. fols 103r, 235v). Rarely, omitted words have been added interlineally
                                        (e.g. 233rb, 236rb, 293ra) or in the margin (e.g. 230rb, with use of
                                        <fo:inline font-style="italic">tamallas</fo:inline>-sign).
                                        Words repeated by dittography are encircled on 235vb, 275rb.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ማቴ​ዎስ፡</fo:inline> is written in red ink in the middle of the upper margin  on
                                        fols 65r–74r, <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ሉቃ​ስ፡</fo:inline>, with irregularities on approximately
                                        every second folio from fols 147r–214r.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>4)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:inline id="d1e45944PRS13900WaldaD">​ዘወ​ልደ፡ ​ዳዊ​ት፡</fo:inline> (on fols 117r, 138v) and
                                        <fo:inline id="d1e45949PRS13901Zaparaqlitos">​ዘዘ​ጰራ​ቅሊ​ጦስ፡</fo:inline> (on fols 148r), presumably indicating
                                    scribes of parts of the manuscript,
                                    are written in the bottom margin. On fol. 107r, a rectangle drawn on the lower margin is visible, in which
                                    writing has been erased.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>5)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 1ra: An erased note in the upper part of the left column.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>6)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 8r: ‘<fo:inline id="d1e45971PRS13962Lockhart">W. s. a. Lockhart</fo:inline>’ written in red pencil the upper margin.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>7)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 1r: ‘473’ written in pencil in the upper margin of fols 1r. On 110,
                                        a piece of paper with ‘3828’ printed on it either placed or glued on the parchment.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>
                                  The book is bound in wooden boards covered with reddish-brown blind-tooled leather. The inner sides of the front and back boards are decorated with textile <fo:inline id="d1e46007">inlays</fo:inline>
                                  with floral pattern in yellow and red colour.
                                
                                  The boards are cut to the same size as the bookblock and present external shallow bevels.
                                
                                  Full reddish-brown leather cover.
                                  The turn-ins have been trimmed out and at the corners they form butt mitres.
                                  An <fo:inline id="d1e46016">additional leather patch</fo:inline> has been added along the inner margin of the boards to fill the gap between the turn-ins.
                                  The cover shows a fine blind-tooled decoration, identical on both
                                  sides of the cover. The turn-ins and the edges are also decorated.
                                  The decoration consists of eleven concentric frames surrounding a central rectangular panel featuring a Latin cross.
                                  Frames composed by the repetition of single tools, enclosed between <fo:inline id="d1e46019">triple straight lines</fo:inline>,
                                  alternate with empty ones with <fo:inline id="d1e46022">double circles</fo:inline> at the corners.
                                  Proceeding from the outer to the inner frame, the repeating decoration motifs are <fo:inline id="d1e46025">criss-crosses</fo:inline> (in two variants),
                                  <fo:inline id="d1e46028">straight strapwork</fo:inline> elements, <fo:inline id="d1e46032">curve strapwork</fo:inline> elements, <fo:inline id="d1e46035">wavy lines</fo:inline>
                                  with <fo:inline id="d1e46038">double circles</fo:inline> between them, and <fo:inline id="d1e46041">curve strapwork</fo:inline> elements in a smaller variant.
                                  The cross is formed by <fo:inline id="d1e46044">X-form</fo:inline> motifs separated by dots between triple straight lines (see also    Winslow 2015,  235; 239).
                                  Triple straight lines decorate the turn-ins, outlining their margins. On the spine, they cross each other diagonally, forming a diamond pattern
                                  with <fo:inline id="d1e46056">double circles</fo:inline> at the intersections. Two <fo:inline id="d1e46059">single straight lines</fo:inline> run along the edges of the boards.
                                
                                  Brown <fo:inline id="d1e46065">slit-braid</fo:inline> endbands are present.
                                
                                  Chainstitch sewing on four sewing stations (two pairs); periodic fold pattern; Z-plied threads.
                                  Between each pair of sewing stations there are two lengths of thread.
                                
                                  The spine is formed by two overlapping layers of leather. The endbands are sewn through the first layer so that
                                  the tie-downs are hidden under the second layer.
                                  To obtain a sufficiently wide cover for the boards, two pieces of leather were sewn together. The seam is positioned along the spine.
                                
                                  A pink string and a green textile ribbon, presumably with the function of bookmarkers, are found between the pages.
                                  More specifically, the pink string is between fol. 15 and fol. 16, and
                                  the green ribbon between 203 and fol. 204.
                                </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Foliation</fo:block>
            <fo:block>Pencil foliation in the upper right corner (1–294).</fo:block>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Quire structure</fo:block>
         <fo:block>31 quires. A<fo:inline font-size="7pt" vertical-align="text-top">4 (Fols 1r–4v)</fo:inline> – I<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 5r–14v)</fo:inline> – II<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 15r–24v)</fo:inline> – III<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 25r–34v)</fo:inline> – IV<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 35r–44v)</fo:inline> – V<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 45r–54v)</fo:inline> – VI<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 55r–64v)</fo:inline> – VII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 65r–74v)</fo:inline> – VIII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 75r–84v)</fo:inline> – IX<fo:inline font-size="7pt" vertical-align="text-top">12 (Fols 85r–96v)</fo:inline> – X<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 97r–106v)</fo:inline> – XI<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 107r–116v)</fo:inline> – XII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 117r–126v)</fo:inline> – XIII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 127r–136v)</fo:inline> – XIV<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 137r–146v)</fo:inline> – XV<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 147r–156v)</fo:inline> – XVI<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 157r–166v)</fo:inline> – XVII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 167r–176v)</fo:inline> – XVIII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 177r–186v)</fo:inline> – XIX<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 187r–196v)</fo:inline> – XX<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 197r–206v)</fo:inline> – XXI<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 207r–214v)</fo:inline> – XXII<fo:inline font-size="7pt" vertical-align="text-top">12 (Fols 215r–226v)</fo:inline> – XXIII<fo:inline font-size="7pt" vertical-align="text-top">0+2 (Fols 227r–228v)</fo:inline> – XXIV<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 229r–238v)</fo:inline> – XXV<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 239r–248v)</fo:inline> – XXVI<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 249r–258v)</fo:inline> – XXVII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 259r–268v)</fo:inline> – XXVIII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 269r–278v)</fo:inline> – XXIX<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 279r–288v)</fo:inline> – XXX<fo:inline font-size="7pt" vertical-align="text-top">6 (Fols 289r–294v)</fo:inline>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 4ra–4va, 15ra–94vb, 97ra–145vb, 147ra–294rb: 2
                                    columns (17 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">This is the main layout of the text of the Gospels.
                                        Data on text area and margin dimensions taken from fol. 23r.The characters per line per column are 11–13. On fol. 95r and fol. 145v,
                                        which are written in a smaller script on the same layout, the characters per line per column are
                                        16–18.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            441 × 382 mm (fol. 23r).
                                            </fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            294 × 287 mm (fol. 23r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 60 mm, bottom: 88 mm, right: 64 mm, left: 29 mm, intercolumn: 26 mm (fol. 23r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 5ra–11rb: 3
                                    columns (27 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">The characters per line per column are 17–19.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            441 × 382 mm (fol. 23r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 12ra–14ra: 
                                    column ( written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">The characters per line per column are 17–19.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            441 × 382 mm (fol. 23r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>4)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 95va–96vb: 2
                                    columns (33 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 96r.The characters per line per column are 24–27.The number of ruled lines is 17. An additional line of text is written between ruled lines.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            441 × 382 mm (fol. 23r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>5)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 146ra–146va: 3
                                    columns (33 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 146r.The characters per line per column are 6–24.The three columns of the <fo:inline font-style="italic">tituli</fo:inline> have been written on a page ruled for a two-column-layout.
                                        The number of ruled lines is 17. An additional line of text is written between ruled lines.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            441 × 382 mm (fol. 23r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Ruling and pricking are visible. Both primary and ruling pricks are visible. The upper and bottom lines are written above the ruling. Ruling and pricking are visible. Both primary and ruling pricks are visible. The upper and bottom lines are written above the ruling. Ruling and pricking are visible. Both primary and ruling pricks are visible. Ruling and pricking are visible. Both primary and ruling pricks are visible. The upper and bottom lines are written above the ruling. Ruling and pricking are visible. Both primary and ruling pricks are visible. The upper and bottom lines are written above the ruling. Ruling pattern: 1A-1A-1A1A/0-0/0-0/C.  Ruling pattern: 1A-1A-1A1A-1A1A/0-0/0-0/C.  Ruling pattern: Grid ruling pattern to accomodate the layout of the Eusebian canons.  Ruling pattern: 1A-1A-1A1A/0-0/0-0/C.  Ruling pattern: 1A-1A-1A1A/0-0/0-0/C.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->1730–1755 (scribe: Zaṗarāqliṭos Walda Dāwit) . 
                                    Regular handwriting, trained hand, gʷǝlḥ-script. Characters are big and evenly spaced.
                                    Zaṗarāqliṭos is mentioned in red ink in the lower margin of fol. 148r.
                                    Walda Dāwit
                                    
                                    is mentioned in black ink in the lower margin of fols 117r, 138v.
                                    The two different names mentioned suggest at least two scribes were involved in the copying,
                                    but no discontinuity in the hand can be observed throughout the manuscript.
                                    The script of the Introductions to the Gospels is smaller than that of the main text.<fo:block>Ink: Black, red.</fo:block>
                           <fo:block>Rubrication: Single lines and groups of lines at the beginning of sections; single lines alternating with black lines
                                    at the beginning of each Gospel; chapter indications; holy names; names mentioned in the supplications;
                                    numerals and elements of numerals and punctuation signs.</fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Other details</fo:block>
            <fo:block>Few tears resulting from parchment making are found on fols 133, 176, 202
                                       and have been repaired by sewing. Fol. 14 is cut off after the first column.
                                        <fo:inline id="d1e45070PRS6665Mangasa">Leul Ras Mangashia Seyoum</fo:inline>, who provided his expertise on the manuscript to Bent Juel-Jensen,
                                    takes the material to be horse vellum (cp.
                                        Juel-Jensen 1981,  65).</fo:block>
            <fo:block/>
            <fo:block/>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Condition</fo:block>
            <fo:block>The condition is good.
                                  The leaves are intact and show only minor deformation around the margin due to humidity.
                                  Most damage is affecting the binding.
                                  The sewing has become loose so that fol. q31 is almost detached from the bookblock.
                                  Insects caused the losses present on the cover, especially on the spine. The spine is torn and a part is missing at the head.
                                  A tear on the tail edge has been repaired by sewing it with a black thread. The tailband is fragmentary.
                                  Water stains are present on the upper board.
                                </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>1730–1755</fo:inline>
                            The manuscript was produced by the scribes
                            <fo:inline id="d1e46100PRS13901Zaparaqlitos">Zaṗarāqliṭos</fo:inline> and
                            <fo:inline id="d1e46102PRS13900WaldaD">Walda Dāwit</fo:inline>
                            during the reign of <fo:inline id="d1e46104PRS5617IyasuII">ʾIyāsu II</fo:inline> (r. 1730–1755), who is mentioned together with
                            <fo:inline id="d1e46106PRS2682BerhanM">Bǝrhān Mogasā</fo:inline> in supplications. A further narrowing of this dating hinges on the interpretation of the letter from
                            to (fols 96ra–96vb), dated to 1743 as part of the original process of production or as later addition.
                            <!--letter from who to who??-->
                        </fo:block>
            <fo:block>
                            The manuscript belonged to <fo:inline id="d1e46118INS0101MadhaneAlam">Madḫāne ʿĀlam</fo:inline> (see Additional note 1) .
                            It is likely that, like most manuscripts of the <fo:inline id="d1e46123INS0101MadhaneAlam">Madḫāne ʿĀlam</fo:inline> collection, it had
                            belonged to a church in the
                            <fo:inline id="d1e46125LOC3577Gondar">Gondar</fo:inline> area, from where it was taken by  <fo:inline id="d1e46127PRS9430Tewodros">Tewodros II</fo:inline>
                            and brought to <fo:inline id="d1e46130INS0101MadhaneAlam">Madḫāne ʿĀlam</fo:inline>. It was then looted by the British
                            <fo:inline id="d1e46132PRS7484Napier">Napier</fo:inline>
                            expedition in
                            1868 and brought to the United Kingdom very probably by its member <fo:inline id="d1e46137PRS13962Lockhart">William Stephen Alexander Lockhart</fo:inline>, whose name is written
                            on fol. 8r.
                            The manuscript was put up for sale on 9 July 1979 at
                            Sotheby’s (‘Property of a gentleman’, lot 72) and acquired by <fo:inline id="d1e46144PRS5782JuelJen">Bent Juel-Jensen</fo:inline>,
                            through
                            the bookseller <fo:inline id="d1e46146PRS13559Thomas">Alan G. Thomas</fo:inline>, for a three-figure sum
                            (cp. <inline xmlns="http://www.w3.org/1999/XSL/Format">Juel-Jensen 1981</inline>; Thomas 1990,  392).</fo:block>
            <fo:block>The manuscript entered the Bodleian Libraries as part of the
                               bequest of <fo:inline id="d1e46159PRS5782JuelJen">Bent Juel-Jensen</fo:inline> after his death in 2006.</fo:block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Bibliography</fo:block>Winslow 2015; Juel-Jensen 1981; Thomas 1990.</fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLaethb3">https://betamasaheft.eu/BDLaethb3</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
   <fo:page-sequence initial-page-number="auto-odd" master-reference="Aethiopica-master">
      <fo:static-content flow-name="rest-region-before-odd">
         <fo:block-container height="100%" display-align="center">
            <fo:table>
               <fo:table-column column-width="30%"/>
               <fo:table-column column-width="40%"/>
               <fo:table-column column-width="30%"/>
               <fo:table-body>
                  <fo:table-row>
                     <fo:table-cell>
                        <fo:block text-align="right"/>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block text-align="center" font-size="9pt" font-family="Ludolfus">Bodleian Aeth. f. 32</fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block font-size="9pt" font-family="Ludolfus" text-align="right">
                           <fo:page-number/>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block-container>
      </fo:static-content>
      <fo:static-content flow-name="rest-region-before-even">
         <fo:block-container height="100%" display-align="center">
            <fo:table>
               <fo:table-column column-width="30%"/>
               <fo:table-column column-width="40%"/>
               <fo:table-column column-width="30%"/>
               <fo:table-body>
                  <fo:table-row>
                     <fo:table-cell>
                        <fo:block font-size="9pt" font-family="Ludolfus" text-align="left">
                           <fo:page-number/>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block text-align="center" font-size="9pt" font-family="Ludolfus">
                           <fo:inline>Eliana</fo:inline>
                           <fo:inline>Dal</fo:inline>
                           <fo:inline>Sasso</fo:inline>, <fo:inline>Jacopo</fo:inline>
                           <fo:inline>Gnisci</fo:inline>, <fo:inline>Jonas</fo:inline>
                           <fo:inline>Karlsson</fo:inline>, <fo:inline>Dorothea</fo:inline>
                           <fo:inline>Reule</fo:inline>, <fo:inline>Massimo</fo:inline>
                           <fo:inline>Villa</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block font-size="9pt" font-family="Ludolfus" text-align="right"/>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block-container>
