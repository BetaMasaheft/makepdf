      <fo:static-content flow-name="rest-region-before-first">
         <fo:table>
            <fo:table-column column-width="30%"/>
            <fo:table-column column-width="40%"/>
            <fo:table-column column-width="30%"/>
            <fo:table-body>
               <fo:table-row>
                  <fo:table-cell>
                     <fo:block text-align="right"/>
                  </fo:table-cell>
                  <fo:table-cell>
                     <fo:block text-align="center" font-size="9pt" font-family="Ludolfus"/>
                  </fo:table-cell>
                  <fo:table-cell>
                     <fo:block font-size="9pt" font-family="Ludolfus" text-align="right"/>
                  </fo:table-cell>
               </fo:table-row>
            </fo:table-body>
         </fo:table>
      </fo:static-content>
      <fo:static-content flow-name="xsl-footnote-separator">
         <fo:block space-before="5mm" space-after="5mm">
            <fo:leader leader-length="30%" rule-thickness="0pt"/>
         </fo:block>
      </fo:static-content>
      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLeu2"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. g. 48</fo:block>
            <fo:block>(Bodleian Ullendorff 2)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment codex70×58 mm (weight: 55g), 40 fols, 5 quires, 1954/55.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e117156LIT2246salotz">
               <fo:inline>I) Fols 3r–39r: <fo:inline xml:lang="en" hyphenate="true">The prayer of Our Lady Mary which she prayed at Golgotha on 21 Sane, CAe 2246.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ፩ ​አም​ላክ፡ ዛ ​ቲ፡ ​ጸሎ​ት፡ ​ዘእ​ግዝ​እት​ነ፡
                                 ​ማር​ያም፡  ​ወላ​ዲተ፡ ​አም​ላክ፡ ​እሙ፡
                                 ​ለብ​ርሃ​ን፡ ​ቅድ​ስት፡ ​ድን​ግል፡ ​ወን​ጽሕ​ት፡ ​ዘጸ​ሐፈ፡ ​አብር ​ኮሮ​ስ፡ <fo:inline>ረድዕ፡ (!)</fo:inline> ​ዮሐ​ንስ፡
                                 ​ጸሎ​ታ፡ ​ወበ​ረከ​ታ፡ ​የሀ​ሉ፡ ​ምስ​ለ፡ ​ገብ​ራ፡
                                    <fo:inline id="d1e117176PRS13999WaldaM">​ወል​ደ፡ ​ሚካ​ኤል፡</fo:inline> ​ለዓ​ለመ፡ ​ዓለ​ም፡
                                    ​አሜን ፨ 
                                ​ዘጸ  (fol. 3v)  ​ለየ​ት፡ ​ባቲ፡ ​አመ፡
                                 ፳ ወ ፩ 
                                ​ለወ​ርኃ፡ ​ሰኔ፡ ​በደ​ብረ፡ ​ጎል​ጎታ፡ ​ዝው​እቱ፡ ​መቃ​ብረ፡ ​እግ​ዚእ​ነ፡
                                 ​ኢየ​ሱስ፡ ​ክር​ስቶ​ስ፡  ​ዘሎ​ቱ፡ ስ<fo:inline>[ብ]</fo:inline>​ሐት፡ ​እስ​ከ፡ ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​አሜን ፨
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                
                                ​ወት​ብል፡ ​ስብ​ሐት፡ ​ለከ፡ ​አኰ​ቴት፡ ​ለመ​ንግ​ሥትከ ፨  ​ወስ​ብሐ​ት፡ ​ለአ​ቡከ፡ ​ኄር፡
                                ​ሰማ​ያዊ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ​ማኅ​የዊ ፨  ​ይእ​ዜኒ፡ ​ወዘ​ልፈ​ኒ፡ ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​አሜ​ን፡
                                  (fol. 39v)   ​አሜ​ን፡ ​ለይ​ኩን፡ ​ለይ​ኩን፡
                                 ​ኦእ​ግዝ​እት​የ፡  ​ማር​ያም፡  ​በዝ​ንቱ፡ ​ጸሎ​ትኪ፡ ​ወበ​ዝን​ቱ፡ ​ቃለ፡ ​ኪዳ​ንኪ፡ ​ዕቀ​ብኒ፡ <fo:inline>ወአድኅንኒ፡ (!)</fo:inline>
                                    ​እመ​ከራ፡ ​ሥጋ፡ ​ወነ​ፍስ፡ ​ሊተ፡ ​ለኃ​ጥእ፡
                                <fo:inline>ገብርከ፡ (!)</fo:inline>
                     <fo:inline id="d1e117223PRS13999WaldaM">​ወል​ደ፡
                                ም<fo:inline>&lt;...&gt;</fo:inline>ር<fo:inline>&lt;...&gt;</fo:inline> ​ንግ​ዳ፡ ​ብሩ።</fo:inline>
                                  በ ፲ ወ ፱ ፡
                                       ፻ ፵ ወ ፯ 
                                      ​ዓመ​ተ፡ ​ምሕ​ረት ፨ 
                                ​ወጸ​ሐፊ​ሁ፡ <fo:inline id="d1e117255PRS14000WaldaA">
                        <fo:inline font-style="italic">​አባ፡</fo:inline> ​ወል​ደ፡ ​አረ​ጋዊ።</fo:inline>
                     <fo:inline font-family="Ludolfus">​ጠያ​ቂ፡</fo:inline>
                     <fo:inline id="d1e117263PRS14001GabraI">​ገብ​ረ። ​ኢየ​ሱስ።</fo:inline>
                  </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Varia</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>The only scribal corrections visible are occasional
                                         omitted characters written above the line (e.g. fols 4r, 8v, 20r).</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>The manuscript was produced for <fo:inline id="d1e117477PRS13999WaldaM">Walda Mikāʾel ʾƎngǝdā Bǝrru</fo:inline>, who is mentioned in supplications within the main text
                                        (e.g. fols 3r, 13v, 16v, mostly simply as <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ወል​ደ፡ ​ሚካ​ኤል፡</fo:inline>), and in
                                        the final supplication on fol. 39v. This final
                                        supplication also includes the date of the manuscript’s
                                        production 1947 E.C. (1954/55), the name of the scribe,
                                        <fo:inline id="d1e117486PRS14000WaldaA">Walda ʾAragāwi</fo:inline>, and mentions
                                        a ‘<fo:inline font-family="Ludolfus">​ጠያቂ</fo:inline>’ by the name of <fo:inline id="d1e117492PRS14001GabraI">Gabra ʾIyasus</fo:inline>.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block> A white sticker, on which is written ‘MS Eth. E.U.II Prayers of B. V. Mary on Golgotha on 21 Säne’,
                                        is glued with adhesive tape to the inner front board.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>
                                       The book is bound in wooden boards.
                                     
                                       The boards are flush with the bookblock and have shallow external bevels. The grain runs vertically.
                                       The inner surface and the edges of the boards are rough.
                                     
                                       Chainstitch sewing on two sewing stations (one pair); S-plied thread.
                                       In the first quire, between the sewing stations, there is one length of thread. In the rest of the quires there are double lengths.
                                       The sewing is closed in the last quire, by knotting the ends of the thread to each other.
                                     
                                       The small holes close to the tail of the quires are probably what remains of quire tackets.
                                     </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Foliation</fo:block>
            <fo:block>Pencil foliation in the upper right corner (1–40).</fo:block>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Quire structure</fo:block>
         <fo:block>5 quires. A<fo:inline font-size="7pt" vertical-align="text-top">2 (Fols 1r–2v)</fo:inline> – II<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 3r–12v)</fo:inline> – III<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 13r–22v)</fo:inline> – IV<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 23r–32v)</fo:inline> – V<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 33r–40v)</fo:inline>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 3r–39v: 1
                                    column (12 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 13r.The characters per line are 14–18.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            72 × 58 mm (fol. 13r).
                                            </fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            58 × 50 mm (fol. 13r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 3 mm, bottom: 12 mm, right: 8 mm, left: 2 mm (fol. 13r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Ruling pricks are visible. The upper line is written mostly above the
                                        ruling, but occasionally (e.g. on fols 30–35 below it. The bottom line is written above the
                                        ruling. Ruling pattern (fols 1–40): 0-0/0-0/0-0/C.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->fol. 39v. 1954–1955 (scribe: Walda ʾAragāwi) . Modern bulky script, somewhat irregular.<fo:block>Ink: Black, red.</fo:block>
                           <fo:block>Rubrication: Incipit (two times two red lines alternating with black lines); holy names; names of the persons involved in
                                    the manuscript production;
                                    the words <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ተዘ​ከር፡</fo:inline> and <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​አም​ሕለ​ከ፡</fo:inline>
                                    and <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​መሐ​ልኩ፡ ​ለኪ፡</fo:inline> in the main text;
                                    elements of numerals and punctuation marks.</fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Decoration</fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Miniatures</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Headpieces</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em">
            <fo:inline>(26) Fol. 3r: <fo:inline>Black and red ornamental band.</fo:inline>
            </fo:inline>
         </fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Drawings</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Other</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Condition</fo:block>
            <fo:block>The condition is intact.The manuscript shows no damage.</fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>1954/55</fo:inline>
                            The manuscript was produced in 1954/55 (1947 E.C.) by the scribe <fo:inline id="d1e117538PRS14000WaldaA">Walda ʾAragāwi</fo:inline>
                            for <fo:inline id="d1e117540PRS13999WaldaM">Walda Mikāʾel ʾƎngǝdā Bǝrru</fo:inline>, who is mentioned in supplications,
                            mostly simply as <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ወል​ደ፡ ​ሚካ​ኤል፡</fo:inline> (see Varia note 2).
                        </fo:block>
            <fo:block>The manuscript was acquired by <fo:inline id="d1e117551PRS9622Ullendor">Edward Ullendorff</fo:inline>. No further information
                        regarding its provenance is known.</fo:block>
            <fo:block>The manuscript entered the Bodleian Libraries as part of the bequest of <fo:inline id="d1e117556PRS9622Ullendor">Edward Ullendorff</fo:inline> after his death in 2011.</fo:block>
         </fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLeu2">https://betamasaheft.eu/BDLeu2</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
   <fo:page-sequence initial-page-number="auto-odd" master-reference="Aethiopica-master">
