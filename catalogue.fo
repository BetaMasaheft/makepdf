                     <fo:block text-align="left"/>
                  </fo:table-cell>
               </fo:table-row>
            </fo:table-body>
         </fo:table>
      </fo:static-content>
      <fo:static-content flow-name="rest-region-before-first">
         <fo:table>
            <fo:table-column column-width="30%"/>
            <fo:table-column column-width="40%"/>
            <fo:table-column column-width="30%"/>
            <fo:table-body>
               <fo:table-row>
                  <fo:table-cell>
                     <fo:block text-align="right"/>
                  </fo:table-cell>
                  <fo:table-cell>
                     <fo:block text-align="center" font-size="9pt" font-family="Ludolfus"/>
                  </fo:table-cell>
                  <fo:table-cell>
                     <fo:block font-size="9pt" font-family="Ludolfus" text-align="right"/>
                  </fo:table-cell>
               </fo:table-row>
            </fo:table-body>
         </fo:table>
      </fo:static-content>
      <fo:static-content flow-name="xsl-footnote-separator">
         <fo:block space-before="5mm" space-after="5mm">
            <fo:leader leader-length="30%" rule-thickness="0pt"/>
         </fo:block>
      </fo:static-content>
      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLaethg31"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. g. 31</fo:block>
            <fo:block>(Juel-Jensen 20)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment codex70×52 mm (weight: 56g), 52 fols (7 p. blank), 9 quires, 1700–1827.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e34851LIT2246salotz">
               <fo:inline>I) Fols 1r–31v: <fo:inline xml:lang="en" hyphenate="true">The prayer of Our Lady Mary which she prayed at Golgotha on 21 Sane, CAe 2246.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ​፩አ ​ምላ​ክ።  ​ዛቲ፡  ​ጸሎ​ት፡ ​ዘእ​ግዝ​እት​ነ፡ ​ቅድ​ስት፡ ​ድን​ግል፡
                                 ​በ፪​ኤ፡ ​ማር​ያም፡ ​ወላ​ዲተ፡ ​አም​ላክ፡
                            </fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                             ​ጸሎ​ታ፡  ​ወበ​ረከ​ታ፡ ​የሃ​ሉ፡ ​ምስ  ​ለ፡ ​ገብ​ራ፡ <fo:inline id="d1e34879PRS13732WaldaGi">​ወል​ደ፡
                                 ​ጊዮ​ርጊ​ስ፡</fo:inline> ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​አሜ​ን።
                            </fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                             
                                ​ዘጸ​ለየ​ት፡ ​ባቲ፡ ​አመ፡ ​፳ወ፩ ​ለወ​ርኃ፡ ሰ  (fol. 1v)  ​ኔ፡ ​በደ​ብረ፡ ​ጎል​ጎታ፡ ​ዘው​እቱ፡ ​መቃ​ብረ፡ ​እግ​ዚእ​ነ፡  ​ኢየ​ሱስ፡ ​ክር​ስቶ​ስ፡  ​እን​ዘ፡
                             ​ትብ​ል፡ ​እግ​ዚእ​የ፡ ​ወአ​ምላ​ኪየ፡ ​ወል​ድየ፡ ​ወን​ጉሥ​የ፡ ​ዘተ​ወለ​ድከ፡ ​እም​ኔየ፡ ​በፈ​ቃከ፡
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                            
                            ​ወት​ሴብ​ሖ፡ ​ለእ​ግዚ​አብ​ሖእ​ር፡ ​ወት​ብል፡ ​ይት​አኰ​ት፡ ​ስም​ከ፡ ​ወይት  (fol. 31r)  ​ባረ​ክ፡ ​መን​ግሥ​ትከ፡ ​ምስ​ለ፡ ​አቡ​ከ፡ ​ኄር፡ ​ሰማ​ያዊ፡ ​ወም​ስለ፡ ​መን​ፈስ፡ ​ቅዱ​ስ፡
                            ​ማኅ​የዊ፡ ​ኵሎ፡ ​ጊዜ፡ ​ይእ​ዜኒ፡ ​ወዘ​ልፈ​ኒ፡ ​ወለ​ዓለ​መ፡ ​ዓለ​ም፡ ​አሜ​ን፡ ​ወአ​ሜን፡ ​ለይ​ኩን።
                        </fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                             
                             ​ኦእ​ግዝ​እት​የ፡  ​ማር​ያም፡  ​ጸሎ​ትኪ፡ ​ወስ​እለ​ትኪ፡ ​ወም​ሕረ​ቱ፡   (fol. 31v)   ​ለፍ​ቁር፡ ​ወል​ድኪ፡ ​የሃ​ሉ፡ ​መስ​ለ፡ ​ገብ​ርኪ፡
                             <fo:inline id="d1e34911PRS13731WaldaIy">​ወል​ደ፡ ​ኢየ​ሱስ፡</fo:inline> ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​አሜ​ን።
                         </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e34920LIT6572Ardaihu">
               <fo:inline>II) Fols 33r–46v: <fo:inline xml:lang="en" hyphenate="true">‘The Twelve Disciples of Jesus Christ questioned him’ (​ተስ​እል​ዎ፡ ​፲ወ፩ ​አር​ዳኢ​ሁ፡ ​ለኢ​የሱ​ስ፡ ​ክር​ስቶ​ስ፡), CAe 6572.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                ​በስ​መ፡ ​አብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ፡ ፩ ​አም  ​ወዘ​ንተ፡ ​ነገ​ረ፡ ​እም​ድኅ​ረ፡ ​ፈጸ​ሙ። ​ወካ​ዕበ፡ ​ተስ​እል​ዎ፡
                                ​፲ወ፩ ​አር​ዳኢ​ሁ፡ ​ለኢ​የሱ​ስ፡ ​ክር​ስቶ​ስ፡ ​ወይ​ቤል​ዎ። ​ወና​ሁ፡ ​ወሀ​ብከ​ነ፡ ​ኵሎ፡ ​ዘሰ​አል​ናከ፡ ​ወአ​ርአ​ይከ​ነ፡ ​ብር​ሃነ፡ ​ዘኢ​ይጠ​ፍኣ፡ ​እስ​ከ፡ ​ለዓ​ለም፤ ወ  (fol. 33v)  ​ትፍ​ሥሕ​ተ፡
                                ​ዘኢ​የሐ​ልቅ፡ ​ለት​ውል​ደ፡ ​ትው​ልድ። ​ወይ​እዜ​ኒ፡ ​አር​አየ​ነ፡ ​አር​አያ​ሁ፡ ​ለደ​ይን፡ ​ከመ፡ ​ናእ​ምር፡ ​ወን​ለቡ፡ ​አም​ሳሊ​ሁ፡
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                            
                            ​ወአ​ንተ​ሂ፡ ​ዘን​ተ፡ ​ጸሎ​ተ፡ ​ለአ​መ፡ ​ተአ​መን​ከ፡ ​ኵሉ፡ ​ይት​ገበ​ር፡ ​ለከ፡ ​በዝ​ንቱ፡ ​ጸሎ​ት። ​ወማ​የ፡ ​ጸሎ​ትሂ፡ ​ኢይ​ትከ​ዓው፡ ​ውስ​ተ፡ ​ምድ​ር። ​እስ​መ፡ ​ክቡ​ር፡ ​ወቅ​ዱስ፡
                              (fol. 46v)   ​ውእ​ቱ፡ ​በአ​ምሳ​ለ፡ ​ደሙ፡ ​ለክ​ርስ​ቶስ፡ ​መን​ጽሔ፡ ​ኃጢ​አት፡ ​ወሥ​ጋሁ፡ ​ይኩ​ኖ፡ ​ሎቱ፡ ​ለገ​ብር​ከ፡ <fo:inline id="d1e34943PRS13732WaldaGi">​ወል​ደ፡
                                 ​ጊዮ​ርጊ​ስ፡</fo:inline> ​ለዓ​ለመ፡ ​ዓለ​ም፡ ​አሜ​ን።
                        </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e34954LIT6581SalotaFe">
               <fo:inline>III) Fols 47r–48r: <fo:inline xml:lang="en" hyphenate="true">‘Prayer for the deconsecration of the water’ ( ​ጸሎ​ተ፡ ​ፍት​ሐተ፡ ​ማይ፡), CAe 6581.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                
                                ​ጸሎ​ተ፡ ​ፍት​ሐተ፡ ​ማይ፡
                            </fo:inline>
                  <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                
                             ​እግ​ዚእ፡ ​እግ​ዚኦ፡ ​እግ​ዚአ​ብሔ​ር፡ ​አኃ​ዜ፡ ​ኵሉ፡ ​አን​ተ፡ ​ዘፈ​ጠር​ከ፡ ​ኵሎ፡ ​በጥ​በብ​ከ፡ ​እም​ኀበ፡ ​ኢሀ​ሎ፡ ​ዘበ​አማ​ን፡ ​አን​ተ፡ ​አስ​ተጋ​ባእ​ኮሙ፡ ​ለማ​ያት፡ ​ትካ​ት፡ ​ውስ​ተ፡
                             ፩ ​ምግ​ባእ፡ ​ወወ​ሰን​ኮሙ፡ ​እም​ጥን​ተ፡ ​ዓለ​ም፡ ​በዕ​በየ፡ ​ኃይ​ልከ፡ ​ወአ​እም​ሮት​ከ፡ ​ዘኢ​ይት​ረከ​ብ።
                            </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                            
                            ​ይበ​ርሁ፡ ​በብ​ርሃ​ነ፡ ​መለ​ኮት​ከ፡ ​ንስ​እለ​ከ፡ ​ወና​ስተ​በቍ​ዓከ፡ ​ከመ፡ ​ትሜ​ጦ፡ ​ለዝ​ንቱ፡ ​ማይ፡ ​ኀበ፡ ​ዘቀ​ዳሚ፡ ​ርስ  (fol. 48r)  ​ቱ፡ ​ከመ፡ ​ይግ​ባእ፡ ​ዳግ​መ፡ ​ከመ፡ ​ቀዳ​ሚ፡
                            ​ወለ​ነሰ፡ ​ይኩ​ነነ፡ ​ረዳ​ኤ፡ ​ወባ​ላሔ፡ ​ንሰ​ብሖ፡ ​ለአ​ብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱ​ስ። ​ይእ​ዜኒ፡ ​ወዘ​ልፈ​ኒ፡ ​ወለ​ዓለ​መ፡ ​ዓለ​ም፡ ​አሜ​ን።
                        </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Additional notes</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 31v: 
                                    Poorly understandable note written in an untrained hand. It mentions <fo:inline id="d1e35260PRS13732WaldaGi">Walda Giyorgis</fo:inline>, whose name also occurs in
                                    several supplication formulas throughout the manuscript.
                                    </fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ወል​ደ፡ ​ጊዮ​ርጊ​ስ፡ ​ምን​ሱቅ<fo:inline>[፡]</fo:inline> ​ገዛ​ኡት፡ ​በኑሰ<fo:inline>[፡]</fo:inline> ​ዘለ​ጠአ።</fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Varia</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                                        Erroneously omitted words and letters have occasionally been added interlineally (e.g. on fols 1r, 8r, 24v). Erasures on e.g. 2v, 3r, 41v.
                                       One line on 30v has been erased and replaced by two lines written in smaller script.
                                        A stanza has been added in a secondary hand in the lower margin of fol. 25v and in the upper margin of fol. 26r.
                                    </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. iv: The following inscription is written in black ink: ‘582 Ethiopic ms’, probably the manuscript shelfmark in
                                        <fo:inline id="d1e35295PRS13736Frederick">Frederick North</fo:inline>’s book collection.
                                        Other writings have been added in pencil on the same page: ‘O. L. 2 A.’ on the top, ‘Frederick North (1766–1827) 5th
                                            Earl of Guilford’ at the bottom, another poorly legible writing, and the shelfmark ‘Ethiop. Ms 20’ in the lower inner corner.
                                    </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. iir: <fo:inline id="d1e35304PRS13736Frederick">Frederick North</fo:inline>’s bookplate is glued to the folio. The bookplate hosts <fo:inline id="d1e35306PRS13736Frederick">Frederick North</fo:inline>’s family coat of
                                        arms in which a lion stands among three lilies and a crescent, as well as his French motto <fo:inline font-family="Ludolfus">‘La vertu est la seule noblesse’</fo:inline>.
                                        The shelfmark ‘n° 582’ has been written in black ink on the bookplate.
                                    </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>4)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>A white sticker is glued to the inner side of the front board. The name of <fo:inline id="d1e35317PRS5782JuelJen">Bent Juel-Jensen</fo:inline> is printed on it
                                        (‘<fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ቤን​ት፡ ​ዩው​ል፡ ​የን​ሰን።</fo:inline>’) and the signature ‘MS. Aeth. g. 31’ is written in pencil below it.
                                    </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>
                                Binding in cardboard boards covered with dark red blind-tooled leather.
                                The edges are gauffred and gilded with floral pattern. A red, textured, and shining textile
                                  has been pasted to the inner sides of both boards and to the recto of the first and the verso of the last guard folios
                              
                                The boards have squares that project beyond the edges of the bookblock.
                              
                                Full dark red leather cover.
                                The cover shows a fine blind-tooled decoration, identical on both sides of the cover. The turn-ins, the edges, and the spine are also decorated.
                                The elaborate blind-tooled decoration is executed with small hand tools. A frame formed by oval motifs borders the central
                                panel inside which is a lozenge formed by the same motifs. On the free spaces are volutes, descending pearls, small stars, flowers, ivy leaves, and dolphin heads.
                              
                                Stuck-on endbands are present.
                              
                                The sewing is all-along on five sewing stations. Between the sewing stations is present one lenght of thread.
                                The original sewing was presumably on two or three sewing stations.
                              
                                The spine is rounded.
                              </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Foliation</fo:block>
            <fo:block>Pencil foliation in the upper right corner (1–48).
                                    Two guard folios each at the beginning and end of the manuscript
                                are not foliated. They are referred to respectively as fols i–ii and fols iii–iv in this description.</fo:block>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Quire structure</fo:block>
         <fo:block>9 quires. A<fo:inline font-size="7pt" vertical-align="text-top">2 (Fols ir–iiv)</fo:inline> – I<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 1r–8v)</fo:inline> – II<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 9r–16v)</fo:inline> – III<fo:inline font-size="7pt" vertical-align="text-top">6 (Fols 17r–22v)</fo:inline> – IV<fo:inline font-size="7pt" vertical-align="text-top">6 (Fols 23r–28v)</fo:inline> – V<fo:inline font-size="7pt" vertical-align="text-top">4 (Fols 29r–32v)</fo:inline> – VI<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 33r–40v)</fo:inline> – VII<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 41r–48v)</fo:inline> – B<fo:inline font-size="7pt" vertical-align="text-top">2 (Fols iiir–ivv)</fo:inline>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>1
                                    column (11–12 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 1r.The characters per line are 8–11.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Leaf dimensions:
                                            64 × 51 mm (fol. 1r).
                                            </fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            49 × 36 mm (fol. 1r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 8 mm, bottom: 6 mm, right: 7 mm, left: 7 mm (fol. 1r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Ruling and pricking are barely visible. Primary and ruling pricks are rarely visible (e.g. fol. 40).  The upper and bottom lines are written above the ruling. Ruling pattern: 1A-1A/0-0/0-0/C.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->Eighteenth century.. 
                                    Mediocre handwriting.
                                <fo:block>Ink: Black, red.</fo:block>
                           <fo:block>Rubrication: 
                                    One or two lines on the incipit pages, sometimes alternating with black lines;
                                    refrains in full or in abbreviated form (e.g. <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ተዘ​ከር፡</fo:inline>, <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​አም​ህለ​ከ፡</fo:inline>, <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​መሐ​ልኩ፡</fo:inline>);
                                    holy names; names of the individuals who commissioned or owned the manuscript; elements of the punctuation signs, text dividers, and numerals.
                                </fo:block>
                           <fo:block>Abbreviations: <fo:list-block provisional-distance-between-starts="6mm"
                                             provisional-label-separation="6mm"
                                             start-indent="cm">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()">
                                       <fo:block>
                                          <fo:inline>1)</fo:inline>
                                       </fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block hyphenate="true">
                                        ​አ፡ ​ኦ፡ ​ወ፡ or ​አ፡ ​ኦወ​ል፡
                                            ​ወፍ፡ for ​አም​ህለ​ከ፡ ​ኦወ​ልድ​የ፡ ​ወፍ​ቁር​የ፡ (fols 5r–9r);
                                    </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()">
                                       <fo:block>
                                          <fo:inline>2)</fo:inline>
                                       </fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block hyphenate="true">
                                        ​ዘ፡ ​እ፡ for ​ዘይ​ትሜ​ሰል፡ ​እመ​ሂ፡ (fols 19v–20v);
                                    </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()">
                                       <fo:block>
                                          <fo:inline>3)</fo:inline>
                                       </fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block hyphenate="true">
                                        ​መ፡ or ​መሐ፡ for ​መሐ​ልኩ፡ (fols 25r–29r).
                                    </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Condition</fo:block>
            <fo:block>The condition is good.
                                  The edges of the textblock have been re-trimmed, with loss of text on the upper margin of fols 26r.
                                    Some folios have stains of unspecified origin, e.g. on 5v, 25r, 26v.
                                    ir, ivv are glued to the binding. The leather cover is slightly damaged at the edges and presents a superficial abrasion
                                    on the outer surface of the front board.
                                </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>1700–1827</fo:inline>
                            The manuscript can be dated palaeographically to the eighteenth century. An absolutely certain terminus ante quem
                             for
                             its production is the year 1827, in which its later owner <fo:inline id="d1e35373PRS13736Frederick">Frederick North</fo:inline> died (see Varia note 2.)
                        </fo:block>
            <fo:block>The name of the original owner or patron, <fo:inline id="d1e35381PRS13731WaldaIy">Walda ʾIyasus</fo:inline>, is indicated in the main hand as
                            <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ገብ​ርኪ፡</fo:inline>, ‘your servant’, in the supplication formula on fol. 31v.
                            The name of a secondary owner, <fo:inline id="d1e35388PRS13732WaldaGi">Walda Giyorgis</fo:inline>, is indicated in Additional note 1 and is overwritten in part or
                            in full in numerous supplication formulas, e.g. on fols 1r, 16v, 29v.
                            The manuscript also belonged to <fo:inline id="d1e35396PRS13736Frederick">Frederick North</fo:inline> in
                            the early nineteenth century (cp. Varia notes 2 and 3). 
                            <fo:inline id="d1e35401PRS5782JuelJen">Bent Juel-Jensen</fo:inline> acquired the manuscript at auction from
                            Sotheby’s in 1974 (Sotheby’s sale ‘Bibliotheca
                            Phillippica Medieval and Oriental Manuscripts’, lot 643).</fo:block>
            <fo:block>The manuscript entered the Bodleian Libraries as part of the
                            bequest of <fo:inline id="d1e35409PRS5782JuelJen">Bent Juel-Jensen</fo:inline> after his death in 2006.</fo:block>
         </fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLaethg31">https://betamasaheft.eu/BDLaethg31</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
