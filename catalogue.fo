      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLaethd24"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. d. 24</fo:block>
            <fo:block/>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment codex278×196 mm (weight: 1872g),  fols ( blank), twentieth century.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e124878LIT7743PsalterAmh">
               <fo:inline>I) <fo:inline xml:lang="en" hyphenate="true">Amharic Psalter, CAe 7743.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">It is not known whether the work extends beyond the Book of Psalms.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus">
                                    ​የሁ​ሉ፡ ​ተግ​ሣጽ፡ ​ነው።
                                         ​የኃ​ጥአ​ን፡ ​የጻ​ድቃ​ን፡ ​ምሳ​ሌ። ​የዳ​ዊት፡ ​ምስ​ጋና፡ ​ሃሌ፡ ​ሉያ።
                                         ​ስብ​ሐት፡ ​ለእ​ግዚ​አብ​ሔር፡ ​ማለ​ት፡ ​ነው።
                                    ​በዝ​ንጎ​ች፡ ​ምክ​ር፡ ​ያል​ሄደ፡ ​ክቡ​ር፡ ​ሰው፡ ​ነው ፨
                                    ​በኃ​ጢአ​ተኞ​ችም፡ ​መን​ገድ፡ ​ያል​ቆመ፡ ​ክቡ​ር፡ ​ሰው፡ ​ነው ፨
                                    ​በዋ​ዘኞ​ችም፡ ​መቀ​መጫ፡ ​ያል​ተቀ​መጠ፡ ​ክቡ​ር፡ ​ሰው፡ ​ነው ፨
                                </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>
                                The book is bound in wooden boards covered with red blind-tooled leather. The inner sides of both boards are decorated with textile <fo:inline id="d1e125035">inlays</fo:inline>
                                featuring a yellow floral pattern on a red background.
                              
                                Full red leather cover.
                                The turn-ins have been trimmed out and at the corners they form butt mitres.
                                <fo:inline id="d1e125041">Additional leather patches</fo:inline> have been used to fill the gap between the turn-ins.
                                The turn-ins show a blind-tooled decoration, consisting of crossing <fo:inline id="d1e125044">triple straight lines</fo:inline>
                                and groups of five <fo:inline id="d1e125047">double circles</fo:inline> at the intersections.
                              
                                Dark and light brown <fo:inline id="d1e125053">slit-braid</fo:inline> endbands are preserved.
                              
                              Chainstitch sewing on four sewing stations (two pairs); periodic fold pattern.
                              </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Foliation</fo:block>
            <fo:block>The manuscript is not foliated.</fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>1
                                    column (25 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 6r.The characters per line are 9–25.The second front flyleaf (fol. 2) is ruled according to the following pattern: 1E*-1E*/0/3J-3J-4J/0.
                                    </fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            179 × 147 mm (fol. 6r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 30 mm, bottom: 67 mm, right: 35 mm, left: 15 mm (fol. 6r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Ruling and pricking are visible. Both primary and ruling pricks are visible. Ruling pattern: 1E-1E/0-0/0-0/C.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->Twentieth century.. Trained hand. Characters are regularly spaced.<fo:block>Ink: Black, red.</fo:block>
                           <fo:block>Rubrication: 
                                    Several groups of lines on the incipit pages, alternating with black lines;
                                    elements of the punctuation signs and numerals.
                                </fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>twentieth century</fo:inline>
                            The manuscript can be dated palaeographically to the twentieth century.
                        </fo:block>
            <fo:block>The provenance of the manuscript is unknown.</fo:block>
         </fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLaethd24">https://betamasaheft.eu/BDLaethd24</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
