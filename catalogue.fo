   <fo:bookmark-tree>
      <fo:bookmark internal-destination="BDLaethc14">
         <fo:bookmark-title>Bodleian Aeth. c. 14</fo:bookmark-title>
      </fo:bookmark>
      <fo:bookmark internal-destination="BDLaethd20">
         <fo:bookmark-title>Bodleian Aeth. d. 20</fo:bookmark-title>
      </fo:bookmark>
      <fo:bookmark internal-destination="BDLaethe30">
         <fo:bookmark-title>Bodleian Aeth. e. 30</fo:bookmark-title>
      </fo:bookmark>
   </fo:bookmark-tree>
   <fo:page-sequence master-reference="Aethiopica-master">
      <fo:flow flow-name="xsl-region-body" font-family="Ludolfus">
         <fo:block-container font-size="12pt"
                             space-before="25.2pt"
                             space-after="12.24pt"
                             font-family="Ludolfus"
                             font-weight="700"
                             text-align="center"
                             display-align="center">
            <fo:block>The Ethiopic Manuscripts of the Bodleian Library</fo:block>
         </fo:block-container>
         <fo:block font-size="12pt"
                   space-before="25.2pt"
                   space-after="12.24pt"
                   font-family="Ludolfus"
                   font-weight="700"
                   text-align="center"
                   display-align="center">Eliana Dal Sasso, Jacopo Gnisci, Jonas Karlsson, Dorothea Reule, Massimo Villa</fo:block>
         <fo:block text-align="center"
                   font-size="20pt"
                   font-style="italic"
                   space-before="2em"
                   space-after="2em"/>
      </fo:flow>
   </fo:page-sequence>
   <fo:page-sequence initial-page-number="auto-odd"
                     master-reference="Aethiopica-master"
                     format="i">
      <fo:static-content flow-name="rest-region-before-odd">
