      </fo:static-content>
      <fo:static-content flow-name="rest-region-after-odd">
         <fo:table>
            <fo:table-column column-width="30%"/>
            <fo:table-column column-width="40%"/>
            <fo:table-column column-width="30%"/>
            <fo:table-body>
               <fo:table-row>
                  <fo:table-cell>
                     <fo:block text-align="right"/>
                  </fo:table-cell>
