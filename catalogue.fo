                  </fo:basic-link>, <fo:basic-link internal-destination="d1e70002PRS1386Adam">
                     <fo:page-number-citation ref-id="d1e70002PRS1386Adam"/>
                  </fo:basic-link>
               </fo:block>
            </fo:block>
            <fo:block start-indent="5mm" text-indent="-5mm" margin-bottom="1mm">
               <fo:block>
                  <fo:basic-link external-destination="https://betamasaheft.eu/PRS1467Afse">
                     <fo:inline>ʾAfṣe</fo:inline>
