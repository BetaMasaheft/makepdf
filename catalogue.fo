      <fo:flow flow-name="xsl-region-body"
               font-size="10.5pt"
               line-height="12.5pt"
               font-family="Ludolfus"
               text-align="justify"
               hyphenate="true"><!-- CATALOGUE     -->
         <fo:block id="BDLaethe30"
                   text-align="center"
                   page-break-inside="avoid"
                   page-break-after="avoid"
                   space-before="3mm">
            <fo:block font-weight="800">Bodleian Aeth. e. 30</fo:block>
            <fo:block>(Juel-Jensen 10)</fo:block>
            <fo:block/>
         </fo:block>
         <fo:block text-align="center" space-before="2mm" space-after="3mm"/>
         <fo:block space-before="2mm" space-after="3mm" white-space-collapse="true">Parchment codex174×113 mm (weight: 804g), 140 fols (1 p. blank), 18 quires, early–mid-nineteenth century.</fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Main Contents</fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e8675LIT2701Dawit">
               <fo:inline>I) Fols 1r–136vb: <fo:inline xml:lang="en" hyphenate="true">Psalter, incomplete, CAe 2701.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e8682LIT2000Mazmur">
               <fo:inline>I-1) Fols 1r–107r: <fo:inline xml:lang="en" hyphenate="true">Psalms of David, CAe 2000.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​ተግ​ሣጽ፡ ​ለኵ​ሉ፡ ​እጓ​ለ፡ ​እመ​ሕያ​ው።
                                     ​ፍካ​ሬ፡ ​ዘጻ​ድቃ​ን፡ ​ወዘ​ኃጥ​አን፡ ​መዝ​ሙር፡ ​ዘዳ​ዊት።
                                    ፩  ​ብፁ​ዕ፡ ​ብእ​ሲ፡ ​ዘኢ​ሖረ፡ ​በም​ክረ፡ ​ረሲ​ዓን ፨
                                    ​ወዘ​ኢቆ​መ፡ ​ውስ​ተ፡ ​ፍኖ​ተ፡ ​ኃጥ​አን ፨
                                </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​አሜ​ሃ፡ ​ወድ​ቀ፡ ​በኃ​ይለ፡  ​እግ​ዚአ​ብሔር ፨
                                    ​ወአ​ንሰ፡ ​ነሣ​እኩ፡ ​ዘእ​ምላ​ዕሌ​ሁ፡ ​ሰይፈ ፨
                                    ​ወመ​ተር​ኩ፡ ​ርእ​ሶ፡ ​ለጎ​ልያድ ፨
                                    ​ወአ​ሰሰ​ልኩ፡ ​ጽዕ​ለተ፡ ​እም​ደቂ​ቀ፡ ​እስ​ራኤል ፨
                                </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e8741LIT1828Mahale">
               <fo:inline>I-2) Fols 107r–118r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes, CAe 1828.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e8747LIT1828Mahale#Moses1">
               <fo:inline>I-2-1) Fols 107r–108r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: First Song of Moses (​ጸሎ​ቱ፡ ​ለሙ​ሴ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሙሴ፡ ​ነቢ​ይ፡ ​ዘቀ​ዳሚ​ት፡ ​ሕግ።
                                             ​፩። ​ንሴ​ብሕ፡ ​ለእ​ግዚ​አብ​ሔር፡ ​ስቡ​ሕ፡ ​ዘተ​ሰብ​ሐ።
                                        ​ፈረ​ሰ፡ ​ወመ​ስተ​ፅዕ​ነ፡ ​ወረ​ወ፡ ​ውስ​ተ፡ ​ባሕር ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ወአ​ስተ​ጋብ​አ፡  ​እግ​ዚአ​ብሔ​ር፡  ​ላዕ​ሌሆ​ሙ፡ ​ማየ፡ ​ባሕር ፨
                                        ​ወደ​ቂቀ፡ ​እስ​ራኤ​ልሰ፡ ​ኃለ​ፉ፡ ​እን​ተ፡ ​የብ​ስ፡ ​በማ​ዕከ​ለ፡ 
                                        ​ማይ​ሰ፡ ​ሎመ፡ ​አረ​ፍት፡ ​በይ​ምን፡ ​ወአ​ረፍ​ት፡ ​በጽ​ግም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e8796LIT1828Mahale#Moses2">
               <fo:inline>I-2-2) Fols 108r–109r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Second Song of Moses (​ጸሎ​ተ፡ ​ሙሴ፡ ​ዘዳ​ግም፡ ​ሕግ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሙሴ፡ ​ዘዳ​ግም፡ ​ሕግ።
                                             ​፪።  ​አጽ​ምዕ፡ ​ሰማ​ይ፡ ​ወእ​ንግ​ርከ ፨
                                        ​ወት​ስማ​ዕ፡ ​ምድ​ር፡ ​ቃለ፡ ​አፉየ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ወአ​ምዕ​ዑኒ፡ ​በአ​ማል​ክቲ​ሆሙ ፨
                                        ​ወአ​ነ፡ ​አቀ​ንዖ​ሙ፡ ​በዘ​ኢኮ​ነ፡ ​ሕዝብ ፨
                                        ​ወአ​ምዕ​ዖሙ፡ ​ለሕ​ዝብ፡ ​በዘ​ኢይ​ሌብዉ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e8843LIT1828Mahale#Moses3">
               <fo:inline>I-2-3) Fols 109r–110v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Third Song of Moses (​ጸሎ​ተ፡ ​ሙሴ፡ ​ዘሣ​ልስ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሙሴ፡ ​ዘሣ​ልስ፡ ​ሕግ።
                                             ፫  ​እስ​መ፡ ​እሳ​ት፡ ​ትነ​ድድ፡ ​እመ​ዐትየ ፨
                                        ​ወታ​ውዒ፡ ​እስ​ከ፡ ​ሲኦ​ል፡ ​ታሕተ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ይት​ቤቀ​ል፡ ​ወይ​ትፈ​ደይ፡ ​በቀ​ለ፡ ​ለፀሩ ፨
                                        ​ወይ​ትቤ​ቀሎ​ሙ፡ ​ለፀ​ላእቱ ፨
                                        ​ወያ​ነጽ​ሕ፡  ​እግ​ዚአ​ብሔ​ር፡  ​ምድ​ረ፡ ​ለሕ​ዝቡ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e8894LIT1828Mahale#Hannah">
               <fo:inline>I-2-4) Fols 110v–111v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Hannah (​ጸሎ​ተ፡ ​ሓና፡ ​እመ፡ ​ሳሙ​ኤል፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሐና፡ ​እመ፡ ​ሳሙ​ኤል፡ ​ነቢ​ይ።
                                             ​፬፡  ​ፀን​ዓ፡ ​ልብ​የ፡ በ ​እግ​ዚአ​ብሔር ፨
                                        ​ወተ​ለዓ​ለ፡ ​ቀር​ንየ፡ ​በአ​ምላ​ኪየ፡ ​ወመ​ድኃ​ንየ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ወው​እቱ፡ ​ጻድ​ቅ፡ ​ይኴ​ንን፡ ​እስ​ከ፡ ​አጽ​ናፈ፡ ​ምድር ፨
                                        ​ወይ​ሁቦ​ሙ፡ ​ኃይ​ለ፡ ​ለነ​ገሥ​ትነ ፨
                                        ​ወያ​ሌዕ​ል፡ ​ቀር​ነ፡ ​መሲሑ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e8944LIT1828Mahale#Hezekiah">
               <fo:inline>I-2-5) Fols 111v–112r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Prayer of Hezekiah (​ጸሎ​ተ፡ ​ሕዝ​ቅያ​ስ፡ ​ንጉ​ሠ፡ ​ይሁ​ዳ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሕዝ​ቅያ​ስ፡ ​ንጉ​ሠ፡ ​ይሁ​ዳ።
                                             ​፭፡  ​አን​ሰ፡ ​እቤ፡ ​በኑ​ኃ፡ ​መዋ​ዕልየ ፨
                                        ​ውስ​ተ፡ ​አና​ቅጸ፡ ​ሲኦ​ል፡ ​ኀደ​ጉ፡ ​ዘተ​ረፈ፡ ​ዓመ​ትየ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​እነ​ግር፡ ​ጽድ​ቀከ፡ ​በዳ​ኅናየ ፨
                                        ​ወት​ረ፡ ​እሴ​ብሐ​ከ፡ ​ወእ​ዜም​ር፡ ​ለከ ፨
                                        ​በኵ​ሉ፡ ​መዋ​ዕለ፡ ​ሕይ​ወትየ ፨  
                                        ​በቅ​ድመ፡ ​ቤተ፡  ​እግዚ
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e8998LIT1828Mahale#Manasseh">
               <fo:inline>I-2-6) Fols 112r–113r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Prayer of Manasseh (​ጸሎ​ተ፡ ​ምና​ሴ፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ምና​ሴ፡ ​ነቢ​ይ።
                                             ​፮፡  ​እግ​ዚኦ፡ ​አኃ​ዜ፡ ​ኵሉ፡ ​ዓለም ፨
                                        ​አም​ላኮ​ሙ፡ ​ለአ​በዊነ ፨  ​ለአ​ብር​ሃም፡ ​ወለ​ይስ​ሐቅ፡ 
                                        
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​እሴ​ብሐ​ከ፡ ​በኵ​ሉ፡ ​ጊዜ፡ ​ወበ​ኵሉ፡ ​መዋ​ዕለ፡ ​ሐይ​ወት
                                        ​እስ​መ፡ ​ኪያ​ከ፡ ​ይሴ​ብሑ፡ ​ኵሉ፡ ​ኃይ​ለ፡ ​ሰማ​ያት ፨  (fol. 113r) 
                                        ​ወለ​ከ፡ ​ሰብ​ሐት፡ ​ለዓ​ለመ፡ ​ዓለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9055LIT1828Mahale#Jonah">
               <fo:inline>I-2-7) Fol. 113r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Jonah (​ጸሎ​ተ፡ ​ዮና​ስ፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ዮና​ስ፡ ​ነቢ​ይ።
                                             ​፯፡  ​ጸራ​ኅኩ፡ ​በም​ንዳ​ቤየ፡ ​ኀበ፡  ​እግ​ዚአ​ብሔ​ር፡ አ
                                        ​ወሰ​ምዓ​ኒ፡ ​በው​ስተ፡ ​ከር​ሠ፡ ​ሲኦል ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​እስ​ከ፡ ​ዓቀ​ቡ፡ ​ከን​ቶ፡ ​ወሐ​ሰተ፡ ​ገደ​ፉ፡ ​ሣህ​ሎሙ ፨
                                        ​አን​ሰ፡ ​ምስ​ለ፡ ​ቃለ፡ ​ስብ​ሐት፡ ​በተ​ጋን​ዮ፡ ​እሠ​ውዕ፡ ​ለከ ፨
                                        ​መጠ​ነ፡ ​ጸለ​ይኩ፡ ​በሕ​ይወ​ትየ፡ ​አዓ​ሥዮ፡ ለ ​እግ​ዚአ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9108LIT1828Mahale#ThreeYouths1">
               <fo:inline>I-2-8) Fols 113r–114r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: First Song of the Three Youths in the Furnace (​ጸሎ​ተ፡ ​ዳን​ኤል፡ ​ነቢ​ይ፡ ​ስብ​ሐት፡ ​ዘእ​ምኣ​ዛር​ያ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ዳን​ኤል፡ ​ነቢ​ይ፡ ​ስብ​ሐት፡ ​ዘእ​ምአ
                                            ፰  ​ይት​ባረ​ክ፡  ​እግ​ዚአ​ብሔ​ር፡  ​አም​ላከ፡ ​አበ​ዊነ ፨
                                         ​እኵ​ት፡ ​ወስ​ቡሕ፡ ​ስም​ከ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                         ​ይት​ኃፈ​ሩ፡ ​በኵ​ሉ፡ ​ትእ​ግል​ቶሙ፡ ​ወይ​ትቀ​ጥቅ​ጥ፡  ፨
                                         ​ወያ​እም​ሩ፡ ​ከመ፡ ​አን​ተ፡  ​እግ​ዚአ​ብሔ​ር፡  ​አም​ላክ፡ 
                                        ባ ፨
                                         ​ስቡ​ሕ፡ ​በኵ​ሉ፡ ​ምድ​ር፡ ​ወበ​ኵሉ፡ ​ዓለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9169LIT1828Mahale#ThreeYouths2">
               <fo:inline>I-2-9) Fols 114r–114v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Second Song of the Three Youths (​ጸሎ​ተ፡ ​ሠለ​ስቱ፡ ​ደቂ​ቅ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ሠለ​ስቱ፡ ​ደቂ​ቅ።
                                             ​፱፡  ​ይት​ባረ​ክ፡  ​እግ​ዚአ​ብሔ​ር፡  ​አም​ላከ፡ ​አበ​ዊነ ፨
                                         ​ስቡ​ሕኒ፡ ​ውእ​ቱ፡ ​ወል​ዑል​ኒ፡ ​ውእ​ቱ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ስቡ​ሕኒ፡ ​አን​ተ፡ ​ወቡ​ሩክ፡ ​አን​ተ፡ ​ለዓ​ለም ፨
                                        ​ቡሩ​ክ፡ ​አን​ተ፡ ​በመ​ልዕ​ልተ፡ ​ሰማ​ያት ፨
                                        ​ስቡ​ሕኒ፡ ​አን​ተ፡ ​ወክ​ቡር​ኒ፡ ​አን​ተ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9221LIT1828Mahale#ThreeYouths3">
               <fo:inline>I-2-10) Fols 114v–115r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Third Song of the Three Youths (​ኀበ፡ ​ባረ​ኩ፡ ​ኣና​ንያ፡ ​ወኣ​ዛር​ያ፡ ​ወሚ​ሳኤ​ል፡ ​ለእ​ግዚ​አብ​ሔር፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ኀበ፡ ​ባረ​ኩ፡ ​አና​ንያ፡ ​ወአ​ዛር​ያ፡ ​ወሚ​ሳኤ​ል፡ ​ለእ ​ግዚ አ
                                            ፲ ይ ባ ር ክ ​ዎ፡  ​ኵሉ፡ ​ግብ​ረ፡ ​እግ​ዚእ፡ ​ለእ ​ግዚ ​አብ​ሔር ፨
                                        ስ ቡ ሕ ኒ ፡ ው ​እቱ፡ ​ወል​ዑል​ኒ፡ ​ውእ​ቱ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ይ ባ ር ክ ​ዎ፡  ​አና​ንያ፡ ​ወአ​ዛር​ያ፡ ​ወሚ​ሳኤ​ል፡ 
                                        ​ለእ<fo:inline>[​ግዚ​አብ​ሔር]</fo:inline>፤
                                        ስ ፨
                                        ን ባ ር ኮ ፡  ​ለአ​ብ፡ ​ወወ​ልድ፡ ​ወመ​ንፈ​ስ፡ ​ቅዱስ ፨
                                        ስ ቡ ሕ ኒ<fo:inline>[፡]</fo:inline> 
                                        ው ​እቱ፡ ​ወል​ዑል​ኒ፡ ​ውእ​ቱ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9328LIT1828Mahale#Habakkuk">
               <fo:inline>I-2-11) Fols 115r–116v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Habakkuk (​ጸሎ​ተ፡ ​ዕን​ባቆ​ም፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ዕን​ባቆ​ም፡ ​ነቢ​ይ።
                                             ​፲፩  ​እግ​ዚኦ፡ ​ሰማ​ዕኩ፡ ​ድም​ፀከ፡ ​ወፈ​ራህኩ ፨
                                        ​ርኢ​ኩ፡ ​ግብ​ረከ፡ ​ወአ​ንከ​ርኩ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​እግ​ዚአ​ብሔ​ር፡  ​አም​ላኪ​የ፡ ​ወኃ​ይልየ ፨
                                        ​ዘይ​ሠር​ዖን፡ ​ለእ​ገር​የ፡ ​ወለ​ፍጻ​ሜየ ፨  (fol. 116v) 
                                        ​ወዲ​በ፡ ​ልዑ​ላት፡ ​ያጼ​ዕነኒ ፨  
                                        ​ከመ፡ ​እማ​ዕ፡ ​በመ​ኃልዪ
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9384LIT1828Mahale#Isaiah">
               <fo:inline>I-2-12) Fols 116v–117r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Isaiah (​ጸሎ​ተ፡ ​ኢሳ​ይያ​ስ፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ኢሳ​ይያ​ስ፡ ​ነቢ​ይ።
                                             ​፲፪  ​በሌ​ሊት፡ ​ትገ​ይስ፡ ​መን​ፈስ​የ፡ ​ኀቤ​ከ፡ ​እግ​ዚኦ፡ ​አም<fo:inline>[​ላኪየ ፨]</fo:inline>
                                        ​እስ​መ፡ ​ብር​ሃን፡ ​ትእ​ዛዝ​ከ፡ ​በዲ​በ፡ ​ምድር ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ሑር፡ ​ሕዝ​ብየ፡ ​ወባ​እ፡ ​ቤተከ ፨   ​ወዕ​ፁ፡ ኆ<fo:inline>ኃ (!)</fo:inline>​ተከ ፨
                                        ​ወተ​ኃባ​እ፡ ​ሕዳ​ጠ፡ ​ምዕረ ፨
                                        ​እስ​ከ፡ ​የኃ​ልፍ፡ ​መዐ​ቱ፡ ለ ​እግ​ዚአ​ብሔር ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9441LIT1828Mahale#Mary">
               <fo:inline>I-2-13) Fols 117r–117v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Our Lady Mary (​ጸሎ​ተ፡ ​እግ​ዝእ​ትነ፡ ​ማር​ያም፡) or Magnificat</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​እግ​ዝእ​ትነ፡ ​ማር​ያም፡ ​ድን​ግል፡ ​ወላ​ዲተ፡ ​አም​ላክ።
                                             ​፲፫፡  ​ተዓ​ብዮ፡ ​ነፍ​ስየ፡ ​ለእ​ግዚ​አብ​ሔር ፨
                                        ​ወት​ትኃ​ሠይ፡ ​መን​ፈስ​የ፡ ​በአ​ምላ​ኪየ፡ ​ወመ​ድኃ​ንየ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ወተ​ወክ​ፎ፡ ​ለእ​ስራ​ኤል፡ ​ቍል​ዔሁ ፨
                                        ​ወተ​ዘከ​ረ፡ ​ሣህ​ሎ፡ ​ዘይ​ቤሎ​ሙ፡ ​ለአ​በዊነ ፨  (fol. 117v) 
                                        ​ለአ​ብር​ሃም፡ ​ወለ​ዘር​ኡ፡ ​እስ​ከ፡ ​ለዓ​ለም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9490LIT1828Mahale#Zachariah">
               <fo:inline>I-2-14) Fol. 117v: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Zachariah (​ጸሎ​ተ፡ ​ዘካ​ርያ​ስ፡ ​ካህ​ን፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ጸሎ​ተ፡ ​ዘካ​ርያ​ስ፡ ​ነቢ​ይ።
                                             ​፲፬  ​ይት​ባረ​ክ፡ ​እግ​ዚአ​ብሔ​ር፡ ​አም​ላከ፡ ​እስ​ራኤል ፨
                                        ​ዘተ​ሠሃ​ለኒ፡ ​ወገ​ብረ፡ ​መድ​ኃኒ​ተ፡ ​ለሕ​ዝበ፡ ​ዚአሁ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ለዘ​ሐወ​ጸነ፡ ​እም​አር​ያም ፨  
                                        ​ወሠ​ረቀ፡ ​ከመ፡ ​ያር​እዮ​ሙ፡ 
                                        ​ለእ​ለ፡ ​ይነ​ብሩ፡ ​ውስ​ተ፡ ​ጽል​መት፡ ​ወጽ​ላሎ​ተ፡ ​ሞት ፨
                                        ​ከመ፡ ​ያር​ትዕ፡ ​እገ​ሪነ፡ ​ውስ​ተ፡ ​ፍኖ​ተ፡ ​ሰላም ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9542LIT1828Mahale#Simeon">
               <fo:inline>I-2-15) Fols 117v–118r: <fo:inline xml:lang="en" hyphenate="true">Book of Odes: Song of Simeon, or Nunc Dimittis (​ጸሎ​ተ፡ ​ስም​ዖን፡ ​ነቢ​ይ፡)</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​፲፭ ​ጸሎ​ተ፡ ​ስም​ዖን፡ ​ነቢ​ይ።
                                        ​ይእ​ዜ፡ ​ትሥ​ዕሮ፡ ​ለገ​ብር​ከ። ​በሰ​ላም፡ ​እግ​ዚኦ፡ <fo:inline>[...]</fo:inline>​መ፡ አ
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ዘአ​ስተ​ዳሎ​ከ፡ ​ቅድ​መ፡ ​ኵሉ፡ ​ሕዝ​ብከ ፨
                                        ​ከመ፡ ​ትክ​ሥት፡ ​ብር​ሃነ፡ ​ለአ​ሕዛብ ፨
                                        ​ወክ​ብረ፡ ​ለሕ​ዝብ​ከ፡ ​እስ​ራኤል ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9589LIT2362Songof">
               <fo:inline>I-3) Fols 118r–123v: <fo:inline xml:lang="en" hyphenate="true">‘’ (​መሓ​ልየ፡ ​መሓ​ልይ፡), CAe 2362.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​መኀ​ልየ፡ ​መኀ​ልይ፡ ​ዝው​እቱ፡ ​ዘሰ​ሎሞ​ን።
                                         ​፩፡  ​ይስ​ዕመ​ኒ፡ ​በስ​ዕመ​ተ፡ ​አፉሁ ፨
                                    ​አዳ​ም፡ ​አጥ​ባት​ኪ፡ ​እም​ወይ​ን።
                                </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​እን​ዘ፡ ​ይነ​ብር፡ ​ውስ​ተ፡ ​ገነ​ት፡ ​ካል​አን፡ ​ርእ​ይዎ ፨
                                    ​ቃለ​ከ፡ ​አስ​ምዓኒ ፨
                                    ​ጕይ፡ ​አን​ተ፡ ​ወል​ድ፡ ​እኁ​የ፡ ​ወተ​መሰ​ላ፡ ​ለወይ
                                    ​ወእ​መ፡ ​አኮ፡ ​ከመ፡ ​ወሬ​ዛ፡ ​ኃየ​ል፡ ​ውስ​ተ፡ ​አድ​ባረ፡ 
                                </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9645LIT2509Weddas">
               <fo:inline>I-4) Fols 124ra–133ra: <fo:inline xml:lang="en" hyphenate="true">‘Praise of Mary’ (​ውዳ​ሴ፡ ​ማር​ያም), CAe 2509.</fo:inline>
               </fo:inline>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9651LIT2509Weddas#Monday">
               <fo:inline>I-4-1) Fols 124ra–124vb: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Monday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​ዘሰ​ኑይ። ​ፈቀ​ደ፡ ​እግ​ዚእ፡ ​ያግ​ዕዞ፡ ​ለአ​ዳም፡ ኅ ​ዙነ፡ ​ወት​ኩዘ፡ ​ልብ፡ ​ወያ​ግብ​ኦ፡ ​ኀበ፡ ​ዘት​ካት፡ ​መንበ ​ሩ።
                                            ​ሰአ​ሊ፡ ​ለነ፡ ​ቅድ​ስት። ​ሠረ​ቀ፡ ​በሥ​ጋ፡ ​እም​ድንግ ​ል፡ ​ዘእ​ንበ​ለ፡ ​ዘር​ዓ፡ ​ብእ​ሲ፡ ​ወአ​ድኃ​ነነ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ወረ​ሰይካ<fo:inline>[፡]</fo:inline> ​ለሔ​ዋን፡ ​አግ​ዓዚ​ተ፡ ​እም​ፃዕ​ረ፡ ​ሞት፡ ​ወወ​ሀብ​ከነ፡ 
                                        ​መን​ፈሰ፡ ​ልደ​ት፡ ​ባረ​ክናከ<fo:inline>[፡]</fo:inline> ​ምስ​ለ፡ ​መላ​እክ​ቲከ ፨ 
                                        ​ሰአ​ሊ፡ ​ለነ፡ ​ቅድ​ስት ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">
                  <fo:inline>Musical notation is added interlineally in a secondary hand.</fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9692LIT2509Weddas#Tuesday">
               <fo:inline>I-4-2) Fols 124vb–126rb: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Tuesday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​ዘሠ​ሉስ። ​አክ​ሊለ፡ ​ምክ​ህነ፡ ​ወቀ​ዳሚ​ተ፡  ​መድ​ኃኒ​ትነ፡ ​ወመ​ሠረተ<fo:inline>[፡]</fo:inline>
                                        ​ንጽ​ሕነ፡ ​ኮነ፡ በ ​ማር​ያም<fo:inline>[፡]</fo:inline> ​ድን​ግል፡ ​እን​ተ፡ ​ወለ​ደት፡ ​ለነ፡ ​ዘእ​ግዚ​አብ​ሔር፡ ​ቃለ፡ ​ዘኮ​ነ፡ ​ሰብ​አ፡ ​በእ​ንተ፡ ​መድ​ኃኒ​ትነ፡
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ይሰ​ፍሑ፡ ​ክነ​ፊሆ​ሙ፡ ​ወይ​ብሉ፡ ​ዝን​ቱ፡ ​ውእ​ቱ፡ ​ንጉ​ሠ፡ ​ስብ​ሐት፡ ​መጽ​አ፡ ​ይስ​ረይ፡ ​ኃጢ​አተ፡ ​ዓለ​ም፡ ​በዕ​በየ፡ ​ሣህሉ ፨ 
                                        ሰ ፤  ለ  ​ቅድ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">
                  <fo:inline>Musical notation is added interlineally in a secondary hand.</fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9734LIT2509Weddas#Wednesday">
               <fo:inline>I-4-3) Fols 126rb–128ra: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Wednesday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​ዘረ​ቡዕ። ​ኵሉ፡ ​ሰራ​ዊተ፡ ​ሰማ​ያት፡ ​ይብሉ<fo:inline>[፡]</fo:inline> ​ብፅ​ዕት፡ ​አን​ቲ፡
                                        ​ሰማ​ይ፡ ​ዳግ​ሚት፡ ​ዲበ፡ ​ምድ​ር፡ ​ኆኅ​ተ፡ ​ምሥ​ራቅ፡  ​ማር​ያም፡  (fol. 126va)   ​ድን​ግል፡ ​ከብ​ካብ፡ ​ንጹሕ<fo:inline>[፡]</fo:inline>
                  </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ወአ​ንሶ​ሰወ፡ ​ምስ​ለ፡ ​ሰብ​እ፡ ​እስመ<fo:inline>[፡]</fo:inline> 
                                        ​መሐ​ሪ፡ ​ውእ​ቱ፡ ​መፍ​ቀሬ፡ ​ሰብ​እ፡ ​አድ​ኃነ፡ ​ነፍ​ሳቲ​ነ፡ ​በም​ጽአ​ቱ፡  ​ቅዱስ ፨  
                                        ሰ ፤  ለ ፤  ቅ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">
                  <fo:inline>Musical notation is added interlineally in a secondary hand.</fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9785LIT2509Weddas#Thursday">
               <fo:inline>I-4-4) Fols 128ra–130ra: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Thursday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​ዘሐ​ሙሰ።  ​ዕፀ፡ ​እን​ተ፡ ​ርእየ<fo:inline>[፡]</fo:inline> 
                                        ​ሙሴ፡ ​በነ​ደ፡ ​እሳ​ት፡ ​ውስ​ተ፡ ​ገዳ​ም፡ ​ወአ​ዕፁ​ቂሃ፡ ​ኢት​ውዒ፡ ​ትመ​ስል፡
                                         ​ማር​ያም፡  ​ድን​ግል፡ ​ዘእ​ንበ​ለ፡ ​ርኵ​ስ፡
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ወኮ​ነ፡ ​ሰብ​አ፡ ​ከማ​ነ፡ ​ዘእ​ንበ​ለ፡ ​ኃጢ​አት፡ ​ባሕ​ቲታ፡ ​ወተ​ወል​ደ፡ ​በቤ​ተ፡ ​ልሔ​ም፡ ​በከመ<fo:inline>[፡]</fo:inline> 
                                        ​ሰበ​ኩ፡ ​ነቢ​ያት፡ ​አድ​ኃነ​ነ፡ ​ወቤ​ዘወ​ነ፡ ​ወረ​ሰየ​ነ፡ ​ሕዝ​በ፡ ​ዚአሁ ፨ 
                                        ሰ ፤  ለ  ​ቅድ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">
                  <fo:inline>Musical notation is added interlineally in a secondary hand until fol. 129rb.</fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9832LIT2509Weddas#Friday">
               <fo:inline>I-4-5) Fols 130ra–131rb: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Friday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​ዘዓ​ርብ።  ​ቡር​ክት፡ ​አን​ቲ፡ ​እም​አን​ስት፡ ​ወቡ​ሩክ፡ ​ፍሬ፡ ​ከር​ሥኪ፡ ኦ ​ማር​ያም፡  ​ድን​ግል፡ ​ወላ​ዲተ፡ ​አም​ላክ፡ 
                                        ​ዘእ​ንበለ<fo:inline>[፡]</fo:inline>  ​ርኵ​ስ፡ ​ሠረ​ቀ፡ ​ለነ፡
                                        ​እም​ኔኪ፡ ​ፀሐ​የ፡ ​ጽድቅ ፨  ​ወአ​ቅረ​በነ፡ ​ታሕ​ተ፡ ​ክነ​ፊሁ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​በእ​ንተ​ዝ፡ ​ንዌድ<fo:inline>ስ (!)</fo:inline>ኪ<fo:inline>[፡]</fo:inline> ​በከ​መ፡ ​ገብ​ርኤ​ል፡ 
                                        ​መል​አክ<fo:inline>[፡]</fo:inline> ​እን​ዘ፡ ​ንብ​ል፡ ​ቡር​ክት፡ ​አንቲ<fo:inline>[፡]</fo:inline> 
                                        ​ማር​ያም<fo:inline>[፡]</fo:inline> ​ወቡ​ሩክ፡ ​ፍሬ፡ ​ከር​ሥኪ ፨ 
                                        ​ተፈ​ሥሒ፡ ​ኦምል<fo:inline>[እ]</fo:inline>ተ<fo:inline>[፡]</fo:inline> 
                                        ​ጸጋ፡ ​እግ​ዚአ​ብሔ​ር፡ ​ምስ​ሌኪ ፨  
                                        ሰ ፤  ለ  ቅ ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9904LIT2509Weddas#Saturday">
               <fo:inline>I-4-6) Fols 131rb–132ra: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Saturday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​ዘቀ​ዳሚ​ት፡ ​ሰን​በት።  ​ንጽ​ሕት፡
                                            ​ወብ​ርህ​ት፡
                                         ​ወቅ​ድስ​ት፡
                                         ​በኵ​ሉ፡ ​እን​ተ፡ ​ሐቀ​ፈቶ፡ ​ለእ ​ግዚ ​እ፡ ​በእ​ራኃ ፨   
                                        ​ወኵ​ሉ፡ ​ፍጥ​ረት፡ ​ይት​ፌሥ​ሑ፡ ​ምስ​ሌሃ፡ ​እን​ዘ፡ ​ይጸ​ርሑ፡ ​ወይ​ብሉ ፨  
                                        ሰ ፤  ለ  ቅ ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ሰአ​ሊ፡ ​ለነ፡ ​ኀበ፡ ​ወል​ድኪ፡ ​ኄር፡ ​መድ​ኃኒ​ነ፡ ​ይም​ሐረ​ነ፡ ​ወይ​ሠሃ​ለነ፡ ​ይሥ​ረይ፡ ​ኃጢ​አተነ ፨  
                                        ሰ ፤  ለ  ቅ ፤
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e9953LIT2509Weddas#Sunday">
               <fo:inline>I-4-7) Fols 132ra–133ra: <fo:inline xml:lang="en" hyphenate="true">Praise of Mary: Sunday</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ውዳ​ሴ፡ ​ዘሰ​ንበ​ት፡ ​ክር​ስቲ<fo:inline>[​ያን።]</fo:inline>
                                        ​ተሰ​መይ​ኪ፡ ​ፍቅ​ርተ፡ ​ኦቡ​ርክ​ት፡ ​እም​አን​ስት ፨ 
                                        ​አን​ቲ፡ ​ውእ  (b)  ​ቱ፡ ​ዳግ​ሚት፡ ​ቀመ​ር፡ ​እን​ተ፡ ​ትሰ​መይ<fo:inline>[፡]</fo:inline> 
                                        ​ቅድ​ስተ፡ ​ቅዱ​ሳን<fo:inline>[፡]</fo:inline> ​ወው​ስቴ​ታ፡ ​ጽላ​ተ፡ ​ኪዳ​ን፡
                                         ፲  ​ቃላ​ት፡ ​እለ፡ ​ተጽ​ሕፋ፡ ​በአ​ፃብ​ዒሁ፡ ​ለእ​ግዚ​አብ​ሔር ፨
                                    </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        
                                        ​ሰአ​ሊ፡ ​ለነ፡ ​ኀበ<fo:inline>[፡]</fo:inline> እ ​ግዚ ​እነ፡ 
                                        ​ወመ​ድኃ​ኒነ፡ ​ኢየ​ሱስ፡ ​ክር​ስቶስ ፨ 
                                        ​ያጽ​ንዓ​ነ፡ ​በር​ትዕ​ት፡ ​ሃይ​ማኖት<fo:inline>[፡]</fo:inline> ​ውስ​ተ፡ ​አሚ​ነ፡ ​ዚአሁ ፨  
                                        ​ይጸ​ግወ​ነ፡ ​ሣህ​ሎ፡
                                        ​ወም​ሕረ​ቶ፡ ​ይስ​ረይ፡ ​ኃጢ​አተ​ነ፡ ​በብ​ዝኃ፡ ​ምሕ​ረቱ ፨  
                                        ​ሰአ​ሊ፡ ​ለነ፡ ​ቅድ​ስት ፨
                                    </fo:inline>
               </fo:block>
            </fo:block>
            <fo:block hyphenate="true"
                      font-family="Ludolfus"
                      space-after="3mm"
                      id="d1e10016LIT1113Anqasa">
               <fo:inline>I-5) Fols 133ra–136vb: <fo:inline xml:lang="en" hyphenate="true">‘Gate of Light’ (​አን​ቀጸ፡ ​ብር​ሃን፡), incomplete, CAe 1113.</fo:inline>
               </fo:inline>
               <fo:block start-indent="10mm">The text ends abruptly due to material loss.</fo:block>
               <fo:block start-indent="10mm">Incipit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    ​ውዳ​ሴ፡ ​ወግ​ናይ፡ ​እሙ፡   
                                        ​ቅድ​ስት፡ ​ወብ​ፅዕ​ት፡  ​ስብ​ሕት፡ ​ወቡ​ርክ​ት፡ ​ክብ  (b)  ​ርት፡ ​ወል​ዕል​ት፡ ​አን​ቀጸ፡ ​ብር​ሃን፡
                                    ​መዓ​ርገ፡ ​ሕይ​ወት፡ ​ወማ​ኅደ​ረ፡ ​መለ​ኮት፡ ​ቅድ​ስተ፡ ​ቅዱ​ሳን ፨  
                                    ​አን​ቲ፡ ​ውእ​ቱ፡ ​ኦእ​ግዝ​እት​ነ፡ ​ወላ​ዲተ፡ ​አም​ላክ<fo:inline>[፡]</fo:inline>
                                    ​ማር​ያም<fo:inline>[፡]</fo:inline>  ​ድን​ግል፡ ​ተሰ​መይ​ኪ፡
                                    ​ሥም​ረተ፡ ​አብ፡
                                </fo:inline>
               </fo:block>
               <fo:block start-indent="10mm">Explicit: <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                    
                                    ​አን​ቲ፡ ​በአ​ማን፡ ​ዘኮ​ንኪ፡ ​ምክህ<fo:inline>[፡]</fo:inline> 
                                    ​ለዘ​መደ፡ ​ክር​ስቲ​ያን፡ ​ወብ​ኪ፡ ​ቅሩ​ባነ፡ ​ኮነ፡ ​እም​ድር፡ ​ለማ​ኅደ​ር፡ ​ውስ​ተ፡ ​አር​ያም፡ ​በእ​ንተ፡ ​ተሠ​ግዎ​ቱ፡
                                    ​ለወ​ልደ፡ ​አም​ላክ፡ ​እም​ኔኪ፡ ​ስዕ​ለት፡ ​ለነ​ፍሳ​ቲነ፡ ​ሕይ​ወተ፡ ​ኦጸ​ጋዊ​ተ፡ ​ምሕ​ረት፡ ​ለእ​ለ፡ የ
                                </fo:inline>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Additional notes</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. ir: 
                                        Note mentioning the angels, the martyrs, the Four Living Beasts,
                                        the <fo:inline id="d1e10630PRS12519TwentyFour">Twenty-Four Heavenly Priests</fo:inline>, the fifteen prophets, the twelve apostles,
                                        the four evangelists, the <fo:inline id="d1e10633PRS11432FathersNicaea">318 Fathers</fo:inline>, and <fo:inline id="d1e10636PRS5741Johnthe">John the Baptist</fo:inline>.
                                        The text is incomplete: it starts and ends abruptly. It might be the continuation of Additional note 2. Some letters are hardly legible.
                                    </fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ት፡ ​ሃይ​ማኖ​ት። ​ወጸ​ሐፍ፡ ​አስ​ማቲ​ሆሙ፡ ​ምስ​ለ፡ ​መላ​እክ​ት፡ ​ወሰ​ማዕ​ት፡ ​በጸ​ሎታ፡ ​ለእ​ግዝ​እት​ነ፡ ​ወላ​ዲተ፡ ​አም​ላክ። ​በሊ​ቀ፡ ​መላ​እክ​ት፡ ​ወበ​ገዜ​ናዊ፡ ​ትፍ​ሥሕ​ት፡
                                        ​በሱ​ራፌ​ል፡ ​ወበ​ኪሩ​ቤል። ​ወበ፬ ​እን​ስሳ። ​ወበ​፳ወ፬ ​ካህ​ናተ፡ ​ሰማ​ይ። ​ወበ​ጸሎ​ቶሙ፡ ​ለቅ​ዱሳ​ን፡ ​ወመ​ላእ​ክት። ​በ፲​ወ፭ ​ነቢ​ያት። ​፲ወ፪ ​ሐዋ​ርያ​ት። ​ወበ፬ ​ወን​ጌላ​ውያ​ን።
                                        ​ወበ​፫፻​፲ወ፰ ​ማኅ<fo:inline>[በ]</fo:inline>​ረ፡ ​ቅዱ​ሳን። ​ወበ​ቅዱ​ስ፡ ​ዮሐ​ንስ፡ ​መጥ​ምቅ። ​ድን​ግል፡ ​ወካ​ህን፡ ወ
                                    </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. iiv: 
                                        Note written in the same hand as Additional note 1, prescribing the reading of the ‘Prayer of penance’ (perhaps <fo:inline>“Prayer of the penance over the water” (ጸሎተ፡ ንስሓ፡), CAe 4523</fo:inline>) and containing formulas concerning the remission of sins.
                                    </fo:block>
                     <fo:block>
                        <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">
                                        ​ታን​ብብ፡ ​ጸሎ​ተ፡ ​ንስ​ሐ። ​ወት​ብል፡ ​እግ​ዚእ​ነ፡ ​ወአ​ምላ​ክነ፡ ​ወመ​ድኃ​ኒነ፡ ​ኢየ​ሱስ፡ ​ክር​ስቶ​ስ። ​ንስ​እለ​ከ፡ ​ወና​ስተ​በቍ​ዓከ፡ ​በእ​ንተ፡ ​እሉ፡ ​አግ​ብር​ቲከ፡
                                        ​አበ​ዊነ፡ ​ወአ​ኃዊ​ነ፡ ​እለ፡ ​ቆሙ፡ ​ውስ​ተ፡ ​ቤተ፡ ​ክር​ስቲ​ያን​ከ፡ ​ቅድ​ስት፡ ​እለ፡ ​ሀለ​ዉ፡ ​ውስ​ተ፡ ​ቤተ፡ ​ጸሎ​ት፡ ​ወይ​ኩኑ፡ ​ፍቱ​ሐነ፡ ​በአ​ፈ፡ ​መን​ፈስ፡
                                        ​ቅዱ​ስ፡ ​ወበ​አፈ፡ ​ዚአ​የኒ፡ ​አነ፡ ​ገብ​ርከ፡ ​ኃጥ​እ። ​እገ​ሌ። ​ባር​ኮሙ፡ ​ወስ​ረይ፡ ​ኃጢ​አቶ​ሙ፡ ​ዘገ​ብሩ፡ ​በአ​እም​ሮ፡ ​እመ​ሂ፡ ​በቃ​ል።
                                        ​አው፡ ​በም​ግባ​ር፡ ​ወእ​መሂ፡ ​በሕ​ሊና። ​ፍት​ሖሙ፡ ​እግ​ዚአ
                                    </fo:inline>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block font-style="italic"
                      space-after="3mm"
                      space-before="2mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Varia</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em"
                           white-space-collapse="true">
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Psalms are all numbered, except for Ps 87 (fols 62v). Ps 138 is erroneously indicated as 137 (99v).
                                        The midpoint of the Psalms of David is indicated with the word <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​መን​ፈቁ፡</fo:inline>, encircled in red ink,
                                        on 55r.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 1r, 1v, 2v: Some words are poorly written in green ink and mostly effaced at the side of the text.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>3)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fol. 17r: Writings in a blue pen, in a poor hand, on the upper and lower margin of the text area.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item>
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>4)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>A white sticker is glued to the inner side of the front board. The name of <fo:inline id="d1e10700PRS5782JuelJen">Bent Juel-Jensen</fo:inline> is printed on it
                                        (‘<fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ቤን​ት፡ ​ዩው​ል፡ ​የን​ሰን።</fo:inline>’) and the signature ‘MS. Aeth. e. 30’ is written in pencil.
                                        An additional sticker, with the signature ‘Ms 10’ on it, is glued below it.
                                        The subject of the miniatures, shelfmark, textual content and dating of the book (‘Miniatures: David with his sling. David
                                        killing Potiphar + St. Michael. Ethiopian MS-10, Early-mid 19. Psalter’), barely legible,
                                        are indicated in pencil on fol. ir.</fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Binding</fo:block>
                                  The book is bound in wooden boards covered with reddish-brown tooled leather
                                  and enclosed in a textile chemise.
                                
                                  The boards are cut to the same size as the bookblock and present external shallow bevels. The grain runs vertically.
                                
                                      Reddish-brown front and back leather cover, the spine is missing.
                                      The turn-ins have been trimmed out and at the corners form butt mitres. The two edges are then sewn together.
                                      The cover shows a faint blind tooled decoration, identical on both sides of the cover. The turn-ins are decorated as well.
                                      The decoration consists in three concentric frames surrounding a central rectangular panel featuring a Latin cross.
                                      Frames composed by the repetition of single hand tools enclosed between <fo:inline id="d1e10732">double straight lines</fo:inline>
                                      alternate with empty ones. The outer frame presents a <fo:inline id="d1e10735">criss-cross</fo:inline> motif while in the inner
                                      frame <fo:inline id="d1e10738">wavy lines</fo:inline> form an interlaced motif. The arms of the cross are formed by the repetition of
                                      <fo:inline id="d1e10741">X-form</fo:inline> between possibly single straight lines. <fo:inline id="d1e10744">Double circles</fo:inline> are printed at
                                      the intersections of the double straight lines and at the end of the arms of the cross.
                                      The turn-ins are decorated with <fo:inline id="d1e10748">single straight lines</fo:inline> crossing each other.
                                      The book is wrapped in a protective flower-printed cotton chemise with a long stripe extending from the tailcap
                                      to cover the three edges of the codex.
                                    
                                          Chainstitch sewing on four sewing stations (two pairs); periodic fold pattern. Two Z-plied threads are used.
                                          The sewing starts from the first quire where, for each pair of sewing stations, there is one length of thread in the centre-fold,
                                          while in the rest of the quires there are two.
                                          The notches cut in the upper and lower cover in correspondence with the board attachment sites indicate that the
                                          attachment has been repaired removing only the back cover.
                                    
                                      The rows of holes close to the head and tail of the quires could indicate the former presence of endbands or quire tackets.
                                
                                      A red <fo:inline id="d1e10764">leaf tab marker</fo:inline> is inserted in the upper outer corner of fol. 66.
                                </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Foliation</fo:block>
            <fo:block>Pencil foliation in the upper right corner carried out by the Bodleian Library in January 2020 (i–iii+1–137).</fo:block>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Quire structure</fo:block>
         <fo:block space-after="3mm">
                                         Undecorated quire marks are written in the upper inner margin of the first folio of each quire. Some of them are nearly illegible.
                                     </fo:block>
         <fo:block>18 quires. A<fo:inline font-size="7pt" vertical-align="text-top">3 (Fols ir–iiiv)</fo:inline> – I<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 1r–8v)</fo:inline> – II<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 9r–16v)</fo:inline> – III<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 17r–24v)</fo:inline> – IV<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 25r–32v)</fo:inline> – V<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 33r–40v)</fo:inline> – VI<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 41r–48v)</fo:inline> – VII<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 49r–56v)</fo:inline> – VIII<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 57r–64v)</fo:inline> – IX<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 65r–72v)</fo:inline> – X<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 73r–80v)</fo:inline> – XI<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 81r–88v)</fo:inline> – XII<fo:inline font-size="7pt" vertical-align="text-top">8 (Fols 89r–96v)</fo:inline> – XIII<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 97r–106v)</fo:inline> – XIV<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 107r–116v)</fo:inline> – XV<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 117r–126v)</fo:inline> – XVI<fo:inline font-size="7pt" vertical-align="text-top">10 (Fols 127r–136v)</fo:inline> – B<fo:inline font-size="7pt" vertical-align="text-top">0+1 (Fols 137r–137v)</fo:inline>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Layout</fo:block>
            <fo:list-block provisional-label-separation="1em"
                           provisional-distance-between-starts="2em">
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>1)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 1ra–123v: 1
                                    column (24 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 33r. The characters per line are 10–22.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            128 × 91 mm (fol. 33r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 16 mm, bottom: 27 mm, right: 12 mm, left: 10 mm (fol. 33r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-after="3mm">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>2)</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>Fols 124ra–136vb: 2
                                    columns (24–25 written lines)</fo:block>
                     <fo:block start-indent="10mm" space-before="3mm" space-after="3mm">Data on text area and margin dimensions taken from fol. 127r. The characters per line are 9–12.</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Text area:
                                            125 × 87 mm (fol. 127r)</fo:block>
                     <fo:block page-break-after="avoid"
                               start-indent="10mm"
                               space-before="3mm"
                               space-after="3mm">Margins: 
                                            top: 13 mm, bottom: 32 mm, right: 15 mm, left: 8 mm, intercolumn: 5 mm (fol. 127r).
                                            </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
         </fo:block>
         <fo:block space-before="2mm">
            <fo:block page-break-after="avoid" font-style="italic" space-after="3mm">Ruling and pricking</fo:block>
            <fo:block provisional-label-separation="1em"
                      provisional-distance-between-starts="2em">
               <fo:inline>Ruling and pricking are visible. Both primary and ruling pricks are visible. The upper and bottom lines are written above the ruling.
                                     Ruling and pricking are visible. Both primary and ruling pricks are visible.  The upper line is written above the ruling. The bottom line is written above the ruling.
                                     Ruling pattern: 1A-1A/0-0/0-0/C.  Ruling pattern: 1A-1A-1A1A/0-0/0-0/C.</fo:inline>
            </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Palaeography</fo:block>
            <fo:table>
               <fo:table-column column-number="1" column-width="15%"/>
               <fo:table-column column-number="2" column-width="85%"/>
               <fo:table-body>
                  <fo:table-row space-after="2mm">
                     <fo:table-cell>
                        <fo:block>
                           <fo:inline>Hand 1:</fo:inline>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell>
                        <fo:block hyphenate="true"><!-- {fo:tei2fo($handnote/tei:seg[@type='script'])}{' '}-->First half of the nineteenth century.. 
                                    Fine handwriting, sometimes uneven in size and thickness (e.g. on fols 23r, 24r, 29r).
                                    The graphemes ግ and ዚ in the word ​እግ​ዚአ​ብሔ​ር፡ are occasionally
                                    written with ligature (e.g. on 14v, 31v, 113r).
                              <fo:block>Ink: Black, red.</fo:block>
                           <fo:block>Rubrication: 
                                   Several groups of lines on the incipit pages, alternating with black lines; numbers and titles of the psalms and of the
                                    canticles; incipits and numbers of the songs; holy names; the word <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​መን​ፈቁ፡</fo:inline> indicating the midpoint of the
                                    Psalms of David; names, numbers, and traditional interpretation of the Hebrew letters in Ps 118;
                                    some letters, alternating with black letters, of the first word of each line (generally <fo:inline font-family="Ludolfus" letter-spacing="0.5pt" font-size="0.9em">​ይባ​ርክ​ዎ፡</fo:inline>)
                                    of the Third song of the Three Youths; elements of the punctuation signs, text dividers, and numerals, included quire marks.
                                </fo:block>
                           <fo:block>Abbreviations: <fo:list-block provisional-distance-between-starts="6mm"
                                             provisional-label-separation="6mm"
                                             start-indent="cm">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()">
                                       <fo:block>
                                          <fo:inline>1)</fo:inline>
                                       </fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block hyphenate="true">
                                        ​እግ, ​እግዚ or ​እግ​ዚአ for ​እግ​ዚአ​ብሔ​ር፡ (e.g. fol. 115r);
                                    </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()">
                                       <fo:block>
                                          <fo:inline>2)</fo:inline>
                                       </fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block hyphenate="true">
                                        ስ for ​ስቡ​ሕ፡ (e.g. fol. 115r);
                                    </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()">
                                       <fo:block>
                                          <fo:inline>3)</fo:inline>
                                       </fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block hyphenate="true">
                                        ​ሰ፡ ​ለ፡ ​ቅድ፡ or ​ሰ፡ ​ለ፡ ​ቅ፡ for ​ሰአ​ሊ፡ ​ለነ፡ ​ቅድ​ስት፡ (e.g. fols 126rb, 128ra, 130ra);
                                    </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()">
                                       <fo:block>
                                          <fo:inline>4)</fo:inline>
                                       </fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block hyphenate="true">
                                        ​ወ፡ ​ሣ፡ ​ይ፡ ​ሰ፡ ​ለ፡ ​ቅ፡ for ​ወል​ድኪ፡ ​ሣህ​ሎ፡ ​ይክ​ፍለ​ነ፡ ​ሰአ​ሊ፡ ​ለነ፡ ​ቅድ​ስት፡ (e.g. fols 134ra, 136va).
                                    </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
         <fo:block font-style="italic"
                   space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Decoration</fo:block>
         <fo:block margin-top="3mm" margin-bottom="3mm" white-space-collapse="true">The manuscript contains four framed miniatures that were executed by the same hand and that
                       are comparable to one executed about a century later than the text
                       and opening headpiece (Heldman and Shelemay 2017,  88).</fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Miniatures</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em">
            <fo:inline>(1) Fol. iv: <fo:inline> A portrait of <fo:inline id="d1e10557 PRS3417David">David</fo:inline> with a sword.
                        </fo:inline>
            </fo:inline>
            <fo:inline>(2) Fol. iir: <fo:inline> David beheading Goliath.
                        </fo:inline>
            </fo:inline>
            <fo:inline>(3) Fol. iiir: <fo:inline> David playing the harp .
                        </fo:inline>
            </fo:inline>
            <fo:inline>(4) Fol. 137r: <fo:inline> St Michael slaying a <fo:inline id="d1e10592">demon</fo:inline>.
                        </fo:inline>
            </fo:inline>
         </fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Headpieces</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em">
            <fo:inline>(6) Fol. 1r: <fo:inline>Bichrome interlace band topped by abstract and irregularly arranged floral motifs.</fo:inline>
            </fo:inline>
            <fo:inline>(7) Fol. 71v: <fo:inline>Bichrome chevron band.</fo:inline>
            </fo:inline>
            <fo:inline>(8) Fol. 107r: <fo:inline>Bichrome band filled with flower elements and hourglass motifs.</fo:inline>
            </fo:inline>
         </fo:block>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Drawings</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-after="3mm"
                   space-before="2mm"
                   page-break-inside="avoid"
                   page-break-after="avoid">Other</fo:block>
         <fo:block provisional-label-separation="1em"
                   provisional-distance-between-starts="2em"/>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">Condition</fo:block>
            <fo:block>The condition is good.
                                  Humidity appears to have damaged the parchment, especially towards the end of the manuscript.
                                  Some folios are slightly stained with dirt, e.g. on fols 25v, 36v, 93v, or wax, e.g. on 108r, 114r, 117v.
                                    The text is occasionally barely legible, e.g. on 13v, 14r, 96r.
                                    Some letters have been washed away and poorly rewritten in a secondary hand on fol. 24v.
                                    Traces of intensive use.

                                </fo:block>
         </fo:block>
         <fo:block space-before="2mm" white-space-collapse="true">
            <fo:block font-style="italic"
                      space-after="3mm"
                      page-break-inside="avoid"
                      page-break-after="avoid">History</fo:block>
            <fo:block>
               <fo:inline>early–mid-nineteenth century</fo:inline>
                            The manuscript can be dated palaeographically to the early–mid-nineteenth century.
                        </fo:block>
            <fo:block>Unknown provenance. The manuscript was purchased by <fo:inline id="d1e10783PRS5782JuelJen">Bent Juel-Jensen</fo:inline> under unknown circumstances.</fo:block>
         </fo:block>
         <fo:block space-before="2mm"
                   space-after="3mm"
                   margin-bottom="16.25pt"
                   page-break-before="avoid">URL: <fo:basic-link external-destination="https://betamasaheft.eu/BDLaethe30">https://betamasaheft.eu/BDLaethe30</fo:basic-link>
         </fo:block>
         <!--  break  after Catalogue -->
         <fo:block page-break-after="always"/>
      </fo:flow>
   </fo:page-sequence>
